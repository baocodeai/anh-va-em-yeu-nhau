        txtTogglePostage.textContent = togglePostage.checked ? 'HIỆN' : 'ẨN';
      }
      if (toggleCornerMarks && txtToggleCornerMarks) {
        txtToggleCornerMarks.textContent = toggleCornerMarks.checked ? 'HIỆN' : 'ẨN';
      }
    }

    [toggleSalutation, toggleBadge, toggleDate, toggleQuote, toggleSignature, toggleFoldBtn, togglePostage, toggleCornerMarks].forEach((chk) => {
      chk?.addEventListener('change', updateMiniToggleLabels);
    });

    const btnSave = document.getElementById('btn-adm-save') as HTMLButtonElement | null;
    const btnSaveLabel = document.getElementById('btn-save-label');
    const btnPreview = document.getElementById('btn-adm-preview');
    const btnEmergency = document.getElementById('btn-adm-emergency');

    // Internal State
    let letterState: SurpriseLetterPayload = {
      enabled: false,
      title: 'Gửi Bé Yêu Của Anh 💌',
      content: 'Chào em, hôm nay anh có một bức thư nhỏ gửi tặng em. Chúc em một ngày thật an yên và nhiều niềm vui nhé! Anh yêu em rất nhiều 💖',
      sender: 'ai',
      recipient: 'maze',
      waxColor: 'ruby',
      showOnce: true,
      updatedAt: new Date().toISOString()
    };

    // Load from LocalStorage
    function loadLetterState() {
      try {
        const raw = localStorage.getItem('couple_surprise_letter');
        if (raw) {
          const parsed = JSON.parse(raw);
          letterState = { ...letterState, ...parsed };
        }
      } catch (e) {
        console.warn('Cannot parse couple_surprise_letter:', e);
      }

      // Populate Form
      if (selectRecipient) selectRecipient.value = letterState.recipient || 'maze';
      if (selectWax) selectWax.value = letterState.waxColor || 'ruby';
      if (inputTitle) inputTitle.value = letterState.title || '';
      if (textareaContent) textareaContent.value = letterState.content || '';
      if (checkShowOnce) checkShowOnce.checked = letterState.showOnce !== false;

      // Populate Custom Components
      if (inputSalutation) inputSalutation.value = letterState.salutation || '';
      if (inputBadge) inputBadge.value = letterState.badgeText || '';
      if (inputQuote) inputQuote.value = letterState.bottomQuote || '';
      if (inputSigFrom) inputSigFrom.value = letterState.signatureSignoff || '';
      if (inputSigName) inputSigName.value = letterState.signatureName || '';
      if (inputBtnRead) inputBtnRead.value = letterState.btnReadText || '';
      if (inputBtnFold) inputBtnFold.value = letterState.btnFoldText || '';

      // Populate Visibility Toggles
      if (toggleSalutation) toggleSalutation.checked = letterState.showSalutation !== false;
      if (toggleBadge) toggleBadge.checked = letterState.showBadge !== false;
      if (toggleDate) toggleDate.checked = letterState.showDate !== false;
      if (toggleQuote) toggleQuote.checked = letterState.showQuote !== false;
      if (toggleSignature) toggleSignature.checked = letterState.showSignature !== false;
      if (toggleFoldBtn) toggleFoldBtn.checked = letterState.showFoldBtn !== false;
      if (togglePostage) togglePostage.checked = letterState.showPostage !== false;
      if (toggleCornerMarks) toggleCornerMarks.checked = letterState.showCornerMarks !== false;
      updateMiniToggleLabels();

      updateWordCounts();
      renderSwitchUI(letterState.enabled);
      renderReceiptUI();
      renderCloudTime();
    }

    // Render Toggle Switch UI
    function renderSwitchUI(enabled: boolean) {
      if (!btnToggle) return;
      btnToggle.setAttribute('data-enabled', enabled ? 'true' : 'false');
      btnToggle.classList.toggle('is-active', enabled);
      if (cardSwitch) {
        cardSwitch.classList.toggle('is-active-card', enabled);
      }
      if (switchText) {
        switchText.textContent = enabled ? 'ĐANG BẬT' : 'ĐANG TẮT';
      }
      if (switchHint) {
        if (enabled) {
          switchHint.innerHTML = '✨ <strong style="color: #fda4af;">Thư đang BẬT.</strong> Nàng mở bất kỳ trang web nào sẽ thấy phong thư con dấu sáp hiện ra ngay sau 1.2s!';
        } else {
          switchHint.textContent = 'Thư đang TẮT. Nàng vào web sẽ không thấy phong thư xuất hiện.';
        }
      }
      if (btnSaveLabel) {
        btnSaveLabel.textContent = enabled ? 'LƯU & BẬT GỬI CHO NÀNG NGAY 💖' : 'LƯU NỘI DUNG (ĐANG TẮT) 📁';
      }
    }

    // Render Read Receipt UI
    function renderReceiptUI() {
      if (!receiptCard || !receiptHeading || !receiptDetail || !receiptBadge || !receiptIcon) return;

      const receiptActionRow = document.getElementById('receipt-action-row');

      if (letterState.readAt) {
        receiptCard.classList.add('is-read');
        receiptIcon.textContent = '💖';
        if (receiptActionRow) receiptActionRow.style.display = 'block';
        try {
          const d = new Date(letterState.readAt);
          const timeStr = d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
          const dateStr = d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
          receiptHeading.textContent = 'Bé Đã Đọc Thư 💕';
          receiptDetail.textContent = `Nàng đã bấm "Em đã đọc" lúc ${timeStr} ngày ${dateStr}.`;
          receiptBadge.innerHTML = `<span>✨ Đã đọc lúc ${timeStr}</span>`;
        } catch {
          receiptHeading.textContent = 'Bé Đã Đọc Thư 💕';
          receiptDetail.textContent = 'Nàng đã xác nhận mở đọc bức thư này.';
          receiptBadge.innerHTML = '<span>✨ Đã mở đọc</span>';
        }
      } else {
        receiptCard.classList.remove('is-read');
        receiptIcon.textContent = '⏳';
        if (receiptActionRow) receiptActionRow.style.display = 'none';
        receiptHeading.textContent = 'Chưa Mở Đọc';
        receiptDetail.textContent = 'Nàng chưa mở đọc bức thư này.';
        receiptBadge.innerHTML = '<span>Đang chờ nàng mở...</span>';
      }
    }

    // Nút Gửi Lại Thư Này Cho Bé
    const btnResend = document.getElementById('btn-resend-letter');
    if (btnResend) {
      btnResend.addEventListener('click', async () => {
        if (confirm('💌 Bạn có muốn gửi lại bức thư này cho nàng không?\n\nTrạng thái "Đã đọc" sẽ được xóa để khi nàng mở web, phong thư hoàng gia sẽ xuất hiện trở lại!')) {
          letterState.readAt = undefined;
          letterState.readBy = undefined;
          letterState.enabled = true;
          letterState.updatedAt = new Date().toISOString();
          localStorage.setItem('couple_surprise_letter', JSON.stringify(letterState));
          renderReceiptUI();
          renderSwitchUI(true);
          try {
            await pushDataToFirebase({ surpriseLetter: letterState });
            window.dispatchEvent(new CustomEvent('couple-letter-updated', { detail: letterState }));
            alert('✨ Đã làm mới trạng thái gửi thư! Nàng vào web sẽ thấy phong thư xuất hiện trở lại.');
          } catch {
            alert('⚠️ Đã làm mới trên máy này.');
          }
        }
      });
    }

    // Render Cloud Timestamp
    function renderCloudTime() {
      if (!cloudLastSync) return;
      if (letterState.updatedAt) {
        try {
          const d = new Date(letterState.updatedAt);
          cloudLastSync.textContent = `Cập nhật: ${d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}`;
        } catch {
          cloudLastSync.textContent = 'Cập nhật: Vừa xong';
        }
      }
    }

    // Update Counters
    function updateWordCounts() {
      if (!textareaContent) return;
      const text = textareaContent.value;
      if (charCountEl) charCountEl.textContent = `${text.length} ký tự`;
      if (wordCountEl) {
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;
        wordCountEl.textContent = `${words} từ`;
      }
    }

    if (textareaContent) {
      textareaContent.addEventListener('input', updateWordCounts);
    }

    // Toggle Switch Click
    if (btnToggle) {
      btnToggle.addEventListener('click', () => {
        const currentEnabled = btnToggle.getAttribute('data-enabled') === 'true';
        const nextEnabled = !currentEnabled;
        letterState.enabled = nextEnabled;
        renderSwitchUI(nextEnabled);
      });
    }

    // Inspiration Prompt Chips Click
    document.querySelectorAll('.btn-prompt-chip').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-text');
        if (text && textareaContent) {
          if (textareaContent.value.trim().length > 0) {
            textareaContent.value += '\n\n' + text;
          } else {
            textareaContent.value = text;
          }
          updateWordCounts();
          textareaContent.focus();
        }
      });
    });

    // Save & Push to Firebase
    if (btnSave) {
      btnSave.addEventListener('click', async () => {
        const isEnabled = btnToggle ? btnToggle.getAttribute('data-enabled') === 'true' : false;
        const newTitle = inputTitle ? inputTitle.value.trim() : letterState.title;
        const newContent = textareaContent ? textareaContent.value.trim() : letterState.content;
        const newRecipient = selectRecipient ? (selectRecipient.value as any) : letterState.recipient;
        const newWax = selectWax ? (selectWax.value as any) : letterState.waxColor;
        const newShowOnce = checkShowOnce ? checkShowOnce.checked : true;

        const hasContentChanged = newContent !== letterState.content || newTitle !== letterState.title;
        const isTurningOn = isEnabled && !letterState.enabled;
        // Nếu người dùng bật thư (hoặc đổi nội dung), làm mới trạng thái đọc để người nhận nhận được thông báo
        const shouldResetReadStatus = isEnabled || hasContentChanged || isTurningOn;

        if (isEnabled) {
          // Xóa hash đã đọc và cờ session dismissed trên máy này để kiểm tra được ngay lập tức
          localStorage.removeItem('couple_letter_last_read_hash');
          localStorage.removeItem('couple_letter_last_read_at');
          sessionStorage.removeItem('couple_letter_session_dismissed');
        }

        letterState = {
          ...letterState,
          enabled: isEnabled,
          title: newTitle || 'Thư Tình Gửi Em 💌',
          content: newContent || 'Anh yêu em nhiều lắm!',
          sender: 'ai',
          recipient: newRecipient,
          waxColor: newWax,
          showOnce: newShowOnce,
          updatedAt: new Date().toISOString(),
          readAt: shouldResetReadStatus ? undefined : letterState.readAt,
          readBy: shouldResetReadStatus ? undefined : letterState.readBy,
          badgeText: inputBadge ? inputBadge.value.trim() : undefined,
          salutation: inputSalutation ? inputSalutation.value.trim() : undefined,
          bottomQuote: inputQuote ? inputQuote.value.trim() : undefined,
          signatureSignoff: inputSigFrom ? inputSigFrom.value.trim() : undefined,
          signatureName: inputSigName ? inputSigName.value.trim() : undefined,
          btnReadText: inputBtnRead ? inputBtnRead.value.trim() : undefined,
          btnFoldText: inputBtnFold ? inputBtnFold.value.trim() : undefined,
          showBadge: toggleBadge ? toggleBadge.checked : true,
          showDate: toggleDate ? toggleDate.checked : true,
          showSalutation: toggleSalutation ? toggleSalutation.checked : true,
          showQuote: toggleQuote ? toggleQuote.checked : true,
          showSignature: toggleSignature ? toggleSignature.checked : true,
          showFoldBtn: toggleFoldBtn ? toggleFoldBtn.checked : true,
          showPostage: togglePostage ? togglePostage.checked : true,
          showCornerMarks: toggleCornerMarks ? toggleCornerMarks.checked : true
        };

        // Save local
        localStorage.setItem('couple_surprise_letter', JSON.stringify(letterState));

        // Loading state
        const prevHtml = btnSave.innerHTML;
        btnSave.innerHTML = '<span>⏳ Đang gửi lên Cloud Firebase...</span>';
        btnSave.style.pointerEvents = 'none';

        try {
          const res = await pushDataToFirebase({ surpriseLetter: letterState });
          if (res) {
            window.dispatchEvent(new CustomEvent('couple-letter-updated', { detail: letterState }));
            renderReceiptUI();
            renderCloudTime();
            alert(isEnabled
              ? '💌 THÀNH CÔNG RỰC RỠ!\n\nBức thư tay đã được BẬT và đồng bộ lên Cloud.\nNgay khi bé Maze mở web trên điện thoại hay máy tính, phong thư hoàng gia sẽ xuất hiện!'
              : '📁 ĐÃ LƯU BỨC THƯ (Ở CHẾ ĐỘ TẮT)!\n\nNội dung đã được lưu an toàn. Khi nào bạn muốn bé thấy, chỉ cần bấm BẬT và Lưu nhé!');
          } else {
            window.dispatchEvent(new CustomEvent('couple-letter-updated', { detail: letterState }));
            alert('⚠️ Đã lưu trên máy này nhưng Cloud Firebase chưa kết nối được. Vui lòng kiểm tra internet hoặc cấu hình Firebase!');
          }
        } catch (err: any) {
          alert('⚠️ Lỗi gửi lên Cloud: ' + (err?.message || err));
        } finally {
          btnSave.innerHTML = prevHtml;
          btnSave.style.pointerEvents = 'auto';
        }
      });
    }

    // Preview Button (Bật phong thư trải nghiệm ngay trên trang)
    if (btnPreview) {
      btnPreview.addEventListener('click', () => {
        sessionStorage.removeItem('couple_letter_session_dismissed');

        const previewPayload: SurpriseLetterPayload = {
          enabled: true,
          title: inputTitle ? inputTitle.value.trim() || 'Thư Tình Gửi Em 💌' : 'Thư Tình Gửi Em 💌',
          content: textareaContent ? textareaContent.value.trim() || 'Đây là bản xem thử nội dung thư...' : 'Nội dung xem thử...',
          sender: 'ai',
          recipient: selectRecipient ? (selectRecipient.value as any) : 'maze',
          waxColor: selectWax ? (selectWax.value as any) : 'ruby',
          showOnce: false,
          updatedAt: new Date().toISOString(),
          badgeText: inputBadge ? inputBadge.value.trim() : undefined,
          salutation: inputSalutation ? inputSalutation.value.trim() : undefined,
          bottomQuote: inputQuote ? inputQuote.value.trim() : undefined,
          signatureSignoff: inputSigFrom ? inputSigFrom.value.trim() : undefined,
          signatureName: inputSigName ? inputSigName.value.trim() : undefined,
          btnReadText: inputBtnRead ? inputBtnRead.value.trim() : undefined,
          btnFoldText: inputBtnFold ? inputBtnFold.value.trim() : undefined,
          showBadge: toggleBadge ? toggleBadge.checked : true,
          showDate: toggleDate ? toggleDate.checked : true,
          showSalutation: toggleSalutation ? toggleSalutation.checked : true,
          showQuote: toggleQuote ? toggleQuote.checked : true,
          showSignature: toggleSignature ? toggleSignature.checked : true,
          showFoldBtn: toggleFoldBtn ? toggleFoldBtn.checked : true,
          showPostage: togglePostage ? togglePostage.checked : true,
          showCornerMarks: toggleCornerMarks ? toggleCornerMarks.checked : true
        };

        // Dispatch preview event for global SurpriseLoveLetter component
        window.dispatchEvent(new CustomEvent('open-surprise-letter-preview', { detail: previewPayload }));
      });
    }

    // Emergency Turn Off
    if (btnEmergency) {
      btnEmergency.addEventListener('click', async () => {
        if (confirm('🛑 Bạn có chắc chắn muốn TẮT KHẨN CẤP bức thư này không? Nàng sẽ không thấy thư nữa.')) {
          letterState.enabled = false;
          letterState.updatedAt = new Date().toISOString();
          renderSwitchUI(false);
          localStorage.setItem('couple_surprise_letter', JSON.stringify(letterState));

          try {
            await pushDataToFirebase({ surpriseLetter: letterState });
            window.dispatchEvent(new CustomEvent('couple-letter-updated', { detail: letterState }));
            alert('✅ Đã tắt thư khẩn cấp thành công!');
          } catch {
            alert('⚠️ Đã tắt trên máy này.');
          }
        }
      });
    }

    // Refresh from Cloud Button
    if (btnRefreshCloud) {
      btnRefreshCloud.addEventListener('click', async () => {
        btnRefreshCloud.innerHTML = '<span>⏳ Đang tải từ Cloud...</span>';
        try {
          const cfg = getSavedFirebaseConfig();
          const dbUrl = cfg?.databaseURL || 'https://tinh-cau-ai-maze-default-rtdb.firebaseio.com';
          const resp = await fetch(`${dbUrl.replace(/\/+$/, '')}/couple_data/surpriseLetter.json`);
          if (resp.ok) {
            const cloudLetter = await resp.json();
            if (cloudLetter && typeof cloudLetter === 'object') {
              letterState = { ...letterState, ...cloudLetter };
              localStorage.setItem('couple_surprise_letter', JSON.stringify(letterState));
              loadLetterState();
              window.dispatchEvent(new CustomEvent('couple-letter-updated', { detail: letterState }));
            }
          }
          alert('✅ Đã làm mới dữ liệu mới nhất từ Cloud Firebase!');
        } catch (e: any) {
          alert('⚠️ Không thể tải từ Cloud: ' + (e?.message || e));
        } finally {
          btnRefreshCloud.innerHTML = '<span>🔄 Tải Lại Dữ Liệu Cloud</span>';
        }
      });
    }

    // Listen for Realtime Updates from Cloud
    window.addEventListener('couple-letter-updated', (e: any) => {
      if (e?.detail) {
        letterState = { ...letterState, ...e.detail };
        renderReceiptUI();
        renderCloudTime();
        if (e.detail.enabled !== undefined) {
          renderSwitchUI(e.detail.enabled);
        }
      }
    });

    // Initial Load
    loadLetterState();
  }

  initLetterAdmin();
  document.addEventListener('astro:after-swap', initLetterAdmin);
</script>
