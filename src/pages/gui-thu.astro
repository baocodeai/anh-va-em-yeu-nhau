---
/**
 * =========================================================================
 * TRANG CÀI ĐẶT & ĐIỀU KHIỂN THƯ TAY TÌNH YÊU (DÀNH CHO BẠN TRAI)
 * Đường dẫn: /gui-thu
 * =========================================================================
 * Trang quản trị độc lập, toàn màn hình, hỗ trợ:
 * 1. Bật/Tắt (true/false) hiển thị bức thư phong bì sáp hoàng gia khi nàng vào web.
 * 2. Soạn thảo tiêu đề, nội dung, màu con dấu sáp 3D, chọn người nhận.
 * 3. Thư viện gợi ý mẫu thư nhanh (Sáng sớm, đêm muộn, động viên, nhắc ấm...).
 * 4. Xem trước trực tiếp (Preview) con dấu sáp bung nở ngay trên trang.
 * 5. Theo dõi thời gian thực xem nàng đã mở đọc thư lúc mấy giờ (Read Receipt).
 */
import Layout from '../components/Layout.astro';
import { COUPLE_CONFIG } from '../couple.config';

const { title } = COUPLE_CONFIG;
---

<Layout
  title={`Quản Lý Thư Tay — ${title}`}
  description="Trang cài đặt và điều khiển hiển thị bức thư tay bí mật gửi riêng người yêu."
  canonicalPath="/gui-thu/"
>
  <main class="letter-admin-main">
    <div class="admin-container">
      
      <!-- Top Navigation & Breadcrumb -->
      <nav class="admin-nav-bar">
        <a href="/" class="btn-back-home">
          <span>⬅️ Về Tinh Cầu Tình Yêu</span>
        </a>
        <div class="admin-role-badge">
          <span class="role-icon">👑</span>
          <span class="role-text">Trang Quản Trị Bạn Trai</span>
        </div>
      </nav>

      <!-- Header Section -->
      <header class="admin-header">
        <div class="header-icon-wrap">
          <span class="header-icon">💌</span>
        </div>
        <div class="header-text-wrap">
          <h1 class="header-title gradient-love-text">Cài Đặt &amp; Điều Khiển Thư Tay Cho Nàng</h1>
          <p class="header-subtitle">
            Bật/Tắt công tắc để phong thư niêm phong sáp 3D tự động xuất hiện khi bé Maze mở web.
          </p>
        </div>
      </header>

      <!-- Quick Status Cards Grid -->
      <section class="status-cards-grid">
        <!-- Card 1: Master Switch (Bật / Tắt) -->
        <div class="status-card switch-card" id="card-master-switch">
          <div class="card-head">
            <span class="card-badge">CÔNG TẮC CHÍNH</span>
            <span class="live-indicator-dot" id="live-indicator-dot"></span>
          </div>
          <div class="switch-core">
            <button type="button" class="admin-toggle-switch" id="btn-admin-toggle" data-enabled="false" aria-label="Bật hoặc tắt thư">
              <span class="admin-switch-slider"></span>
              <span class="admin-switch-text" id="admin-switch-text">ĐANG TẮT</span>
            </button>
          </div>
          <p class="switch-status-hint" id="admin-switch-hint">
            Thư đang tắt. Nàng vào web sẽ không thấy phong thư.
          </p>
        </div>

        <!-- Card 2: Read Receipt (Tình trạng đọc thư) -->
        <div class="status-card receipt-card">
          <div class="card-head">
            <span class="card-badge">TÌNH TRẠNG ĐỌC THƯ</span>
            <span class="receipt-status-icon" id="receipt-status-icon">⏳</span>
          </div>
          <div class="receipt-info-wrap">
            <h3 class="receipt-heading" id="receipt-heading">Chưa Mở Đọc</h3>
            <p class="receipt-detail" id="receipt-detail">Nàng chưa mở đọc bức thư này.</p>
          </div>
          <div class="receipt-badge-pill" id="receipt-badge-pill">
            <span>Đang chờ nàng mở...</span>
          </div>
          <div class="receipt-action-row" id="receipt-action-row" style="display: none; margin-top: 10px;">
            <button type="button" class="btn-micro-resend" id="btn-resend-letter" title="Làm mới trạng thái để phong thư lại bung ra khi nàng mở web">
              <span>🔄 Gửi Lại Thư Này Cho Bé</span>
            </button>
          </div>
        </div>

        <!-- Card 3: Cloud RTDB Connection -->
        <div class="status-card cloud-card">
          <div class="card-head">
            <span class="card-badge">ĐỒNG BỘ CLOUD FIREBASE</span>
            <span class="cloud-status-icon" id="cloud-status-icon">🟢</span>
          </div>
          <div class="cloud-info-wrap">
            <h3 class="cloud-heading" id="cloud-sync-heading">Realtime Sẵn Sàng</h3>
            <p class="cloud-detail" id="cloud-last-sync">Cập nhật lần cuối: Vừa xong</p>
          </div>
          <div class="cloud-actions">
            <button type="button" class="btn-micro-sync" id="btn-refresh-cloud" title="Làm mới dữ liệu từ Cloud">
              <span>🔄 Tải Lại Dữ Liệu Cloud</span>
            </button>
          </div>
        </div>
      </section>

      <!-- Main Editor Section -->
      <section class="admin-editor-section">
        <div class="editor-panel">
          <div class="panel-header">
            <h2 class="panel-title">✏️ Soạn Thảo Nội Dung Bức Thư Hoàng Gia</h2>
            <span class="panel-tag">Kiểu 1 · Phong Thư Con Dấu Sáp</span>
          </div>

          <form id="admin-letter-form" class="editor-form" onsubmit="return false;">
            <!-- Row 1: Recipient & Wax Color -->
            <div class="form-grid-2">
              <div class="form-group">
                <label for="adm-letter-recipient" class="admin-label">
                  <span>👤 Người Nhận Thư:</span>
                </label>
                <select id="adm-letter-recipient" class="admin-select">
                  <option value="maze">🌸 Bé Yêu (Maze) — Dành riêng cho nàng</option>
                  <option value="ai">🚀 Anh Yêu (AI)</option>
                  <option value="both">💖 Cả Hai Đứa</option>
                </select>
                <small class="field-hint">Tên người nhận sẽ được in hoa mỹ trên nắp phong bì vintage.</small>
              </div>

              <div class="form-group">
                <label for="adm-letter-wax" class="admin-label">
                  <span>🕯️ Màu Con Dấu Sáp 3D:</span>
                </label>
                <select id="adm-letter-wax" class="admin-select">
                  <option value="ruby">🔴 Đỏ Ruby Hoàng Gia (Sang trọng, kinh điển)</option>
                  <option value="rose">🌸 Hồng Tình Yêu (Ngọt ngào, lãng mạn)</option>
                  <option value="gold">👑 Vàng Hoàng Hôn (Ấm áp, cổ điển)</option>
                </select>
                <small class="field-hint">Con dấu sẽ đổi màu và toả ánh sáng hoàng gia tương ứng.</small>
              </div>
            </div>

            <!-- Row 2: Title -->
            <div class="form-group mt-3">
              <label for="adm-letter-title" class="admin-label">
                <span>📝 Tiêu Đề Bức Thư:</span>
              </label>
              <input
                type="text"
                id="adm-letter-title"
                class="admin-input"
                placeholder="Ví dụ: Gửi bông hoa nhỏ xinh đẹp nhất dải ngân hà của anh..."
                required
              />
            </div>

            <!-- Row 3: Content & Word Counter -->
            <div class="form-group mt-3">
              <div class="textarea-head-row">
                <label for="adm-letter-content" class="admin-label">
                  <span>📜 Lời Nhắn Nhủ / Thư Viết Tay:</span>
                </label>
                <div class="counter-wrap">
                  <span id="adm-char-count" class="counter-badge">0 ký tự</span>
                  <span id="adm-word-count" class="counter-badge">0 từ</span>
                </div>
              </div>
              <textarea
                id="adm-letter-content"
                class="admin-textarea"
                rows="7"
                placeholder="Viết những lời dặn dò, tâm sự hoặc lời yêu thương ngọt ngào của anh gửi đến em tại đây..."
                required
              ></textarea>
            </div>

            <!-- Quick Inspiration Prompt Chips -->
            <div class="inspiration-box mt-3">
              <div class="inspiration-title">
                <span>💡 Gợi Ý Lời Nhắn Nhanh (Bấm để chèn ngay vào thư):</span>
              </div>
              <div class="prompt-chips-flow">
                <button type="button" class="btn-prompt-chip" data-text="Hôm nay trời trở lạnh rồi, em nhớ mặc áo ấm và uống nước ấm đầy đủ nhé. Đừng để bị cảm đấy, anh lúc nào cũng nhớ và thương em nhiều lắm! 💕">
                  🧣 Nhắc mặc ấm &amp; giữ gìn sức khỏe
                </button>
                <button type="button" class="btn-prompt-chip" data-text="Cảm ơn em vì đã luôn dịu dàng và bước vào cuộc đời anh. Mỗi ngày được nhìn thấy nụ cười của em là điều hạnh phúc nhất đối với anh! 💐">
                  💐 Lời cảm ơn ngọt ngào
                </button>
                <button type="button" class="btn-prompt-chip" data-text="Hôm nay em học tập và làm việc có mệt mỏi không? Nếu mệt thì hãy tự thưởng cho mình một giấc ngủ thật ngon nhé, mọi giông bão bên ngoài cứ để anh lo! 🥰">
                  🥰 Động viên khi bé mệt mỏi
                </button>
                <button type="button" class="btn-prompt-chip" data-text="Chúc cô gái nhỏ của anh có một buổi tối thật an lành và mơ những giấc mơ thật đẹp nhé. Trong giấc mơ nhớ chừa một góc nhỏ cho anh với đấy! 🌙✨">
                  🌙 Chúc ngủ ngon mộng đẹp
                </button>
                <button type="button" class="btn-prompt-chip" data-text="Chúc em một ngày mới tràn ngập năng lượng tích cực và những điều may mắn nhất. Anh yêu em muôn ngàn lần! ☀️💖">
                  ☀️ Chào ngày mới ngập tràn yêu thương
                </button>
                <button type="button" class="btn-prompt-chip" data-text="Dù khoảng cách có xa bao nhiêu thì trái tim anh vẫn luôn hướng về em. Chờ ngày hai đứa mình gặp nhau và ôm nhau thật chặt nhé! 🚀✨">
                  🚀 Lời hứa tình yêu bền chặt
                </button>
              </div>
            </div>

            <!-- Detailed Component Customization Box -->
            <div class="custom-components-box mt-3">
              <div class="custom-box-head">
                <span class="custom-box-icon">🎨</span>
                <div class="custom-box-text">
                  <h3 class="custom-box-title">Tùy Biến Chi Tiết Từng Thành Phần Trong Bức Thư</h3>
                  <p class="custom-box-sub">Tự do đổi lời chào, câu châm ngôn kết thư, chữ ký và các nút bấm theo ý bạn.</p>
                </div>
              </div>

              <div class="custom-fields-grid mt-3">
                <!-- Salutation & Badge with Toggles -->
                <div class="form-group">
                  <div class="label-toggle-row">
                    <label for="adm-letter-salutation" class="admin-label" style="margin: 0;">
                      <span>👋 Lời Chào Mở Đầu (Salutation):</span>
                    </label>
                    <label class="switch-pill-label" title="Bật hoặc Tắt lời chào mở đầu">
                      <input type="checkbox" id="adm-toggle-salutation" checked class="mini-toggle-checkbox" />
                      <span class="mini-toggle-text" id="toggle-salutation-txt">HIỆN</span>
                    </label>
                  </div>
                  <input
                    type="text"
                    id="adm-letter-salutation"
                    class="admin-input mt-1"
                    placeholder="Mặc định: Em yêu dấu thương mến, (hoặc Bé iu của anh ơi, Gửi công chúa nhỏ...)"
                  />
                </div>

                <div class="form-group">
                  <div class="label-toggle-row">
                    <label for="adm-letter-badge" class="admin-label" style="margin: 0;">
                      <span>🏷️ Huy Hiệu Nhỏ Góc Trên (Badge):</span>
                    </label>
                    <label class="switch-pill-label" title="Bật hoặc Tắt huy hiệu nhỏ trên cùng">
                      <input type="checkbox" id="adm-toggle-badge" checked class="mini-toggle-checkbox" />
                      <span class="mini-toggle-text" id="toggle-badge-txt">HIỆN</span>
                    </label>
                  </div>
                  <input
                    type="text"
                    id="adm-letter-badge"
                    class="admin-input mt-1"
                    placeholder="Mặc định: 💌 Bức Thư Tình Yêu (hoặc 💐 Điều Bất Ngờ Cho Em)"
                  />
                </div>

                <!-- Date & Bottom Quote with Toggles -->
                <div class="form-group">
                  <div class="label-toggle-row">
                    <label class="admin-label" style="margin: 0;">
                      <span>📅 Dòng Ngày Tháng Thư:</span>
                    </label>
                    <label class="switch-pill-label" title="Bật hoặc Tắt dòng ngày tháng">
                      <input type="checkbox" id="adm-toggle-date" checked class="mini-toggle-checkbox" />
                      <span class="mini-toggle-text" id="toggle-date-txt">HIỆN</span>
                    </label>
                  </div>
                  <small class="field-hint" style="margin-top: 6px;">Tự động hiển thị ngày hiện tại (VD: 13 Tháng 9, 2026).</small>
                </div>

                <div class="form-group">
                  <div class="label-toggle-row">
                    <label for="adm-letter-quote" class="admin-label" style="margin: 0;">
                      <span>💬 Lời Dặn Dò / Châm Ngôn Cuối Thư:</span>
                    </label>
                    <label class="switch-pill-label" title="Bật hoặc Tắt câu quote cuối thư">
                      <input type="checkbox" id="adm-toggle-quote" checked class="mini-toggle-checkbox" />
                      <span class="mini-toggle-text" id="toggle-quote-txt">HIỆN</span>
                    </label>
                  </div>
                  <input
                    type="text"
                    id="adm-letter-quote"
                    class="admin-input mt-1"
                    placeholder='Mặc định: "Mãi luôn thương và đồng hành cùng em qua muôn ngàn vì sao."'
                  />
                </div>

                <!-- Signoff & Signature Name with Toggles -->
                <div class="form-group">
                  <div class="label-toggle-row">
                    <label for="adm-letter-sig-from" class="admin-label" style="margin: 0;">
                      <span>✒️ Lời Đề Từ Trước Chữ Ký:</span>
                    </label>
                    <label class="switch-pill-label" title="Bật hoặc Tắt toàn bộ phần chữ ký">
                      <input type="checkbox" id="adm-toggle-signature" checked class="mini-toggle-checkbox" />
                      <span class="mini-toggle-text" id="toggle-sig-txt">HIỆN</span>
                    </label>
                  </div>
                  <input
                    type="text"
                    id="adm-letter-sig-from"
                    class="admin-input mt-1"
                    placeholder="Mặc định: Thương gửi từ, (hoặc Yêu em ngàn lần, Mãi bên em...)"
                  />
                </div>

                <div class="form-group">
                  <label for="adm-letter-sig-name" class="admin-label">
                    <span>✍️ Tên Chữ Ký Của Bạn:</span>
                  </label>
                  <input
                    type="text"
                    id="adm-letter-sig-name"
                    class="admin-input"
                    placeholder="Mặc định: AI (Anh người yêu 🚀) (hoặc Anh Bảo 💖, Người iu của bé...)"
                  />
                </div>

                <!-- Action Buttons Customization with Toggles -->
                <div class="form-group">
                  <label for="adm-letter-btn-read" class="admin-label">
                    <span>💖 Chữ Trên Nút Xác Nhận Đọc:</span>
                  </label>
                  <input
                    type="text"
                    id="adm-letter-btn-read"
                    class="admin-input"
                    placeholder="Mặc định: 💖 Em Đã Đọc Và Rất Yêu Anh!"
                  />
                </div>

                <div class="form-group">
                  <div class="label-toggle-row">
                    <label for="adm-letter-btn-fold" class="admin-label" style="margin: 0;">
                      <span>🌸 Nút Phụ Gấp Thư Cất Đi:</span>
                    </label>
                    <label class="switch-pill-label" title="Bật hoặc Tắt nút phụ gấp thư">
                      <input type="checkbox" id="adm-toggle-fold-btn" checked class="mini-toggle-checkbox" />
                      <span class="mini-toggle-text" id="toggle-fold-txt">HIỆN</span>
                    </label>
                  </div>
                  <input
                    type="text"
                    id="adm-letter-btn-fold"
                    class="admin-input mt-1"
                    placeholder="Mặc định: 🌸 Gấp Thư Lại Cất Đi"
                  />
                </div>

                <!-- Tem Thư & Dấu Bưu Điện (Postage Stamp & Seal Mark) -->
                <div class="form-group">
                  <div class="label-toggle-row">
                    <label class="admin-label" style="margin: 0;">
                      <span>📯 Tem Thư &amp; Dấu Bưu Điện (Phong Bì):</span>
                    </label>
                    <label class="switch-pill-label" title="Bật hoặc Tắt con dấu tròn COSMIC POST và tem thư tình yêu trên bì thư">
                      <input type="checkbox" id="adm-toggle-postage" checked class="mini-toggle-checkbox" />
                      <span class="mini-toggle-text" id="toggle-postage-txt">HIỆN</span>
                    </label>
                  </div>
                  <small class="field-hint" style="margin-top: 6px;">Con dấu tròn COSMIC POST và tem thư tình yêu ở góc phải phong bì.</small>
                </div>

                <!-- 4 Con Dấu Hoa Văn Góc Thư (Corner Fleurons ❧) -->
                <div class="form-group">
                  <div class="label-toggle-row">
                    <label class="admin-label" style="margin: 0;">
                      <span>❧ 4 Con Dấu Hoa Văn Góc Thư (Giấy Thư):</span>
                    </label>
                    <label class="switch-pill-label" title="Bật hoặc Tắt 4 con dấu họa tiết cổ điển in ở 4 góc tờ giấy">
                      <input type="checkbox" id="adm-toggle-corner-marks" checked class="mini-toggle-checkbox" />
                      <span class="mini-toggle-text" id="toggle-corner-marks-txt">HIỆN</span>
                    </label>
                  </div>
                  <small class="field-hint" style="margin-top: 6px;">Họa tiết in chìm hoàng gia ❧ ở 4 góc tờ giấy da vintage.</small>
                </div>
              </div>
            </div>

            <!-- Checkbox: Show Once Option -->
            <div class="form-checkbox-row mt-3">
              <label class="custom-checkbox-label">
                <input type="checkbox" id="adm-letter-show-once" class="custom-checkbox" checked />
                <span class="checkbox-box"></span>
                <span class="checkbox-text">
                  <strong>Chế độ chỉ hiện 1 lần (Khuyên dùng):</strong> Sau khi nàng bấm nút <em>"Em Đã Đọc Và Rất Yêu Anh"</em> thì bức thư sẽ tự động không hiện lại nữa (trừ khi anh gửi thư mới).
                </span>
              </label>
            </div>

            <!-- Action Buttons Row -->
            <div class="admin-actions-bar mt-4">
              <button type="button" class="btn-admin-save" id="btn-adm-save">
                <span class="btn-icon">💾</span>
                <span class="btn-label" id="btn-save-label">LƯU &amp; BẬT GỬI CHO NÀNG NGAY 💖</span>
              </button>
              
              <button type="button" class="btn-admin-preview" id="btn-adm-preview">
                <span class="btn-icon">👁️</span>
                <span>Mở Xem Thử Thư (Preview)</span>
              </button>

              <button type="button" class="btn-admin-emergency" id="btn-adm-emergency">
                <span class="btn-icon">🛑</span>
                <span>Tắt Thư Khẩn Cấp</span>
              </button>
            </div>
          </form>
        </div>
      </section>

      <!-- Tip & PWA Bookmark Guide -->
      <section class="admin-guide-card mt-4">
        <div class="guide-header">
          <span class="guide-icon">📱</span>
          <h3 class="guide-title">Mẹo Truy Cập Nhanh Cho Bạn Trai:</h3>
        </div>
        <p class="guide-desc">
          Để quản lý thư tay cho nàng bất cứ lúc nào trên điện thoại mà không cần tìm link:
        </p>
        <ul class="guide-list">
          <li><strong>Trên iPhone (Safari):</strong> Bấm nút <em>Chia sẻ (biểu tượng hình vuông có mũi tên lên)</em> &rarr; Chọn <strong>"Thêm vào Màn hình chính" (Add to Home Screen)</strong>.</li>
          <li><strong>Trên Android (Chrome):</strong> Bấm dấu <em>3 chấm ở góc phải</em> &rarr; Chọn <strong>"Thêm vào Màn hình chính" (Add to Home Screen)</strong>.</li>
          <li>Trang quản trị này sẽ xuất hiện trên màn hình điện thoại của bạn như một chiếc app riêng biệt, mở ra là chỉnh sửa thư được ngay!</li>
        </ul>
      </section>

    </div>
  </main>
</Layout>

<style>
  .letter-admin-main {
    min-height: 100vh;
    background: radial-gradient(circle at 50% 10%, rgba(244, 63, 94, 0.12) 0%, rgba(15, 23, 42, 0.98) 65%);
    color: #f8fafc;
    padding: 2rem 1.2rem 4rem;
  }

  .admin-container {
    max-width: 960px;
    margin: 0 auto;
  }

  /* Nav Bar */
  .admin-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.8rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .btn-back-home {
