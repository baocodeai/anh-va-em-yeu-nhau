---
import { HABIT_21_DAYS, DEFAULT_HABIT_START_DATE, HABIT_MILESTONES, DEFAULT_SHIELDS } from '../data/habit21Days';
import { COUPLE_CONFIG } from '../couple.config';

const defaultHabitJSON = JSON.stringify(HABIT_21_DAYS).replace(/</g, '\\u003c');
const defaultStartDate = DEFAULT_HABIT_START_DATE;
const defaultMilestonesJSON = JSON.stringify(HABIT_MILESTONES).replace(/</g, '\\u003c');
const defaultShieldsJSON = JSON.stringify(DEFAULT_SHIELDS).replace(/</g, '\\u003c');
const coupleBoysInfoJSON = JSON.stringify(COUPLE_CONFIG.boysInfo).replace(/</g, '\\u003c');
const coupleGirlsInfoJSON = JSON.stringify(COUPLE_CONFIG.girlsInfo).replace(/</g, '\\u003c');
---

<section class="habit-tracker-section" id="habit-tracker">
  <div class="section-header-wrap">
    <div class="badge-love mb-2">
      <span>✨ Tinh Cầu Thói Quen Vô Tận</span>
    </div>
    <h2 class="section-title gradient-love-text">21 Ngày Cùng Em Rèn Thói Quen Tiếng Anh</h2>
    <p class="section-desc">
      Hành trình rèn luyện đồng pha của <strong>AI (Mặt Trăng 🌙)</strong> &amp; <strong>Maze (Trái Đất 🌍)</strong>. Cùng nhau thắp sáng từng vì sao, bảo vệ chuỗi ngày bằng <strong>Khiên Hộ Mệnh 🛡️</strong> và nâng đỡ nhau qua <strong>Tích Bù Yêu Thương 💖</strong>.
    </p>
  </div>

  <!-- Milestone Infinity Roadmap Selector -->
  <div class="milestone-roadmap-card romantic-card">
    <div class="roadmap-header">
      <span class="roadmap-icon">🌌</span>
      <div>
        <h3 class="roadmap-title gradient-cyan-text">Hành Trình Mở Rộng — Infinity Roadmap</h3>
        <p class="roadmap-desc">Chọn chặng đường thử thách của hai đứa giữa dải ngân hà:</p>
      </div>
    </div>

    <div class="milestone-tabs-grid" id="milestone-tabs-container">
      {HABIT_MILESTONES.map((m) => (
        <button
          type="button"
          class={`milestone-tab-btn ${m.days === 21 ? 'is-active' : ''}`}
          data-days={String(m.days)}
        >
          <span class="milestone-tab-icon">{m.icon}</span>
          <div class="milestone-tab-info">
            <span class="milestone-tab-badge">{m.badge}</span>
            <strong class="milestone-tab-title">{m.title} ({m.days}N)</strong>
          </div>
        </button>
      ))}
    </div>

    <div class="milestone-active-desc-box" id="milestone-desc-box">
      <span class="desc-box-icon" id="milestone-info-icon">🌱</span>
      <span class="desc-box-text" id="milestone-info-text">
        <strong>Chặng 1 (21 Ngày):</strong> Phá vỡ sức ỳ ban đầu và hình thành liên kết thói quen đầu tiên giữa AI &amp; Maze.
      </span>
    </div>
  </div>

  <!-- Start Date Setup & Timeline Hub Card -->
  <div class="habit-start-date-card romantic-card">
    <div class="date-card-header">
      <div class="date-header-left">
        <span class="date-header-icon">📅</span>
        <div>
          <h3 class="date-card-title gradient-rose-text">Lịch Trình &amp; Ngày Bắt Đầu</h3>
          <p class="date-card-sub">Hệ thống tự động phân bổ lịch thực tế tương ứng theo từng ngày</p>
        </div>
      </div>
      <div class="date-today-badge-wrap">
        <span class="badge-love badge-locked-schedule" id="habit-start-lock-badge">🔒 Lịch trình đã niêm phong</span>
        <span class="badge-love" id="habit-today-pill">✨ Hôm nay: Đang tính...</span>
      </div>
    </div>

    <div class="date-picker-control-row" id="date-picker-control-row">
      <div class="date-input-group">
        <label for="habit-start-date-input" class="date-input-label">Chọn ngày bắt đầu (Ngày 1):</label>
        <div class="input-with-button">
          <input
            type="date"
            id="habit-start-date-input"
            class="habit-date-input"
            value={defaultStartDate}
          />
          <button type="button" class="btn-love btn-sm" id="btn-save-start-date">
            <span>💾 Lưu &amp; Khóa Ngày</span>
          </button>
          <button type="button" class="btn-preset-pill btn-lock-toggle" id="btn-toggle-start-lock">
            <span>🔓 Mở Khóa Đổi Ngày</span>
          </button>
        </div>
      </div>

      <div class="quick-preset-btns" id="quick-presets-container">
        <span class="preset-label">Chọn nhanh:</span>
        <button type="button" class="btn-preset-pill" id="btn-preset-today">⚡ Hôm Nay</button>
        <button type="button" class="btn-preset-pill" id="btn-preset-anniversary">💌 Kỷ Niệm (15/08)</button>
        <button type="button" class="btn-preset-pill" id="btn-preset-default">🔄 Mặc Định (20/08)</button>
      </div>
    </div>

    <!-- Calculated Timeline Summary -->
    <div class="timeline-summary-bar">
      <div class="timeline-item">
        <span class="timeline-dot dot-start"></span>
        <span class="timeline-label">Ngày 1 (Bắt đầu):</span>
        <strong class="timeline-val gradient-cyan-text" id="display-start-date">--/--/----</strong>
      </div>
      <div class="timeline-sep">➜</div>
      <div class="timeline-item">
        <span class="timeline-dot dot-end"></span>
        <span class="timeline-label" id="display-end-label">Ngày 21 (Về đích):</span>
        <strong class="timeline-val gradient-rose-text" id="display-end-date">--/--/----</strong>
      </div>
      <div class="timeline-sep">•</div>
      <div class="timeline-item">
        <span class="timeline-label">Tiến trình theo lịch:</span>
        <span class="timeline-val" id="display-calendar-progress" style="color: #fbbf24;">Đang tính...</span>
      </div>
    </div>
  </div>

  <!-- Progress Overview & Shield Inventory Card -->
  <div class="habit-overview-card romantic-card">
    <div class="progress-stats-row">
      <div class="stat-box">
        <span class="stat-number gradient-rose-text" id="habit-stat-completed">
          --<span class="stat-total" id="habit-stat-total-label">/21</span>
        </span>
        <span class="stat-name">Hoàn Thành Đồng Pha 💖</span>
      </div>
      <div class="stat-box">
        <span class="stat-number gradient-cyan-text" id="habit-stat-percent">--%</span>
        <span class="stat-name">Tiến Độ Tinh Cầu</span>
      </div>
      <div class="stat-box">
        <span class="stat-number" id="habit-stat-ai" style="color: #38bdf8;">--</span>
        <span class="stat-name">AI Đã Tích 🚀</span>
      </div>
      <div class="stat-box">
        <span class="stat-number" id="habit-stat-maze" style="color: #f43f5e;">--</span>
        <span class="stat-name">Maze Đã Tích 🌸</span>
      </div>
      <div class="stat-box shield-stat-box">
        <div class="shield-inventory-mini">
          <span class="shield-pill pill-ai-shield" id="display-ai-shields" title="Khiên bảo vệ của AI">🛡️ AI: 2/2</span>
          <span class="shield-pill pill-maze-shield" id="display-maze-shields" title="Khiên bảo vệ của Maze">🛡️ Maze: 2/2</span>
        </div>
        <span class="stat-name">Khiên Hộ Mệnh 🛡️</span>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="progress-bar-container">
      <div class="progress-bar-fill" id="habit-progress-bar" style="width: 0%;"></div>
    </div>

    <!-- Cosmic Portal Milestone Congratulation Container -->
    <div class="cosmic-portal-banner" id="cosmic-portal-box" style="display: none;">
      <div class="portal-particles-glow"></div>
      <div class="portal-content">
        <div class="portal-badge">🌌 CỔNG KHÔNG - THỜI GIAN ĐÃ MỞ!</div>
        <h4 class="portal-title gradient-love-text">Chúc Mừng AI &amp; Maze Đã Hoàn Thành Trọn Vẹn Chặng Đường! 🎉</h4>
        <p class="portal-sub">
          Hai đứa đã cùng nhau thắp sáng toàn bộ vì tinh tú của chặng này. Bạn có muốn bước tiếp vào chặng tiếp theo không?
        </p>
        <button type="button" class="btn-love portal-advance-btn" id="btn-portal-advance">
          <span>🚀 Mở Khóa Chặng Tiếp Theo</span>
        </button>
      </div>
    </div>

    <!-- Dual Check Requirement & Shields Legend -->
    <div class="dual-check-legend">
      <div class="legend-item"><span class="legend-symbol symbol-done">★</span> <span>Cả 2 đã tích</span></div>
      <div class="legend-item"><span class="legend-symbol symbol-shield">🛡️</span> <span>Khiên Hộ Mệnh</span></div>
      <div class="legend-item"><span class="legend-symbol symbol-rescue">💖</span> <span>Tích Bù Yêu Thương</span></div>
      <div class="legend-item"><span class="legend-symbol symbol-ai">👦</span> <span>AI đã tích</span></div>
      <div class="legend-item"><span class="legend-symbol symbol-maze">👧</span> <span>Maze đã tích</span></div>
      <div class="legend-item"><span class="legend-symbol symbol-today">✨</span> <span>Hôm nay</span></div>
      <div class="legend-item"><span class="legend-symbol symbol-locked">🔒</span> <span>Chưa đến ngày (Khóa)</span></div>
    </div>

    <!-- Constellation Track Grid -->
    <div class="constellation-nav-wrap">
      <p class="constellation-guide-text" id="constellation-guide-heading">⭐ Nhấn vào một ngày để xem chi tiết, tích hoàn thành hoặc dùng khiên bảo vệ:</p>
      <div class="constellation-nodes-grid" id="day-selector-strip">
        <!-- Node buttons dynamically rendered by client script -->
      </div>
    </div>
  </div>

  <!-- Day Detail Active Panel -->
  <div class="day-details-container" id="habit-panels-container">
    <article class="day-detail-panel romantic-card active-panel" id="active-day-panel">
      <!-- Dynamic content rendered by client script -->
    </article>
  </div>
</section>

<!-- Inject initial data -->
<script is:inline define:vars={{ defaultHabitJSON, defaultStartDate, defaultMilestonesJSON, defaultShieldsJSON, coupleBoysInfoJSON, coupleGirlsInfoJSON }}>
  window.__INITIAL_HABIT_21__ = JSON.parse(defaultHabitJSON);
  window.__DEFAULT_HABIT_START_DATE__ = defaultStartDate;
  window.__HABIT_MILESTONES__ = JSON.parse(defaultMilestonesJSON);
  window.__DEFAULT_SHIELDS__ = JSON.parse(defaultShieldsJSON);
  window.__COUPLE_BOYS_INFO__ = JSON.parse(coupleBoysInfoJSON);
  window.__COUPLE_GIRLS_INFO__ = JSON.parse(coupleGirlsInfoJSON);
</script>

<style>
  .habit-tracker-section {
    max-width: 980px;
    margin: 3.5rem auto;
    padding: 0 1.2rem;
  }

  .section-header-wrap {
    text-align: center;
    margin-bottom: 2.2rem;
  }

  .section-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 0.8rem;
    letter-spacing: -0.02em;
  }

  .section-desc {
    max-width: 740px;
    margin: 0 auto;
    color: #94a3b8;
    line-height: 1.6;
    font-size: 1.02rem;
  }

  .section-desc strong {
    color: #fda4af;
  }

  /* Milestone Infinity Roadmap */
  .milestone-roadmap-card {
    padding: 1.6rem 2rem;
    margin-bottom: 1.8rem;
    background: radial-gradient(circle at 50% 0%, rgba(168, 85, 247, 0.12) 0%, rgba(11, 17, 32, 0.9) 100%);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 20px;
  }

  .roadmap-header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.2rem;
  }

  .roadmap-icon {
    font-size: 1.8rem;
  }

  .roadmap-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 2px;
  }

  .roadmap-desc {
    font-size: 0.84rem;
    color: #94a3b8;
    margin: 0;
  }

  .milestone-tabs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 1rem;
  }

  .milestone-tab-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.25s ease;
    text-align: left;
    color: #cbd5e1;
  }

  .milestone-tab-btn:hover {
    border-color: #c084fc;
    background: rgba(168, 85, 247, 0.15);
    transform: translateY(-2px);
  }

  .milestone-tab-btn.is-active {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.3), rgba(244, 63, 94, 0.25));
    border-color: #c084fc;
    box-shadow: 0 0 16px rgba(168, 85, 247, 0.35);
    color: #ffffff;
  }

  .milestone-tab-icon {
    font-size: 1.3rem;
  }

  .milestone-tab-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .milestone-tab-badge {
    font-size: 0.65rem;
    color: #d8b4fe;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
  }

  .milestone-tab-title {
    font-size: 0.85rem;
    line-height: 1.2;
  }

  .milestone-active-desc-box {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(30, 41, 59, 0.4);
    border-radius: 10px;
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.84rem;
    color: #cbd5e1;
    line-height: 1.5;
  }

  .desc-box-icon {
    font-size: 1.2rem;
  }

  /* Start Date Card */
  .habit-start-date-card {
    padding: 1.6rem 2rem;
    margin-bottom: 1.8rem;
    background: radial-gradient(circle at 10% 0%, rgba(56, 189, 248, 0.12) 0%, rgba(11, 17, 32, 0.88) 100%);
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 20px;
  }

  .date-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .date-header-left {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .date-header-icon {
    font-size: 1.8rem;
  }

  .date-card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 2px;
  }

  .date-card-sub {
    font-size: 0.84rem;
    color: #94a3b8;
    margin: 0;
  }

  .date-picker-control-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
    padding: 1rem 1.2rem;
    background: rgba(15, 23, 42, 0.6);
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .date-picker-control-row.is-locked {
    background: rgba(15, 23, 42, 0.4);
    border-style: dashed;
    border-color: rgba(148, 163, 184, 0.25);
  }

  .badge-locked-schedule {
    background: rgba(56, 189, 248, 0.15) !important;
    border-color: rgba(56, 189, 248, 0.4) !important;
    color: #7dd3fc !important;
  }

  .badge-editing-schedule {
    background: rgba(251, 191, 36, 0.15) !important;
    border-color: rgba(251, 191, 36, 0.4) !important;
    color: #fde047 !important;
  }

  .date-input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .date-input-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .input-with-button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .habit-date-input {
    background: rgba(2, 6, 23, 0.8);
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: 10px;
    padding: 8px 14px;
    color: #ffffff;
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
    outline: none;
    transition: all 0.2s ease;
  }

  .habit-date-input:focus {
    border-color: #38bdf8;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
  }

  .habit-date-input:disabled {
    background: rgba(15, 23, 42, 0.85);
    border-color: rgba(148, 163, 184, 0.3);
    color: #94a3b8;
    cursor: not-allowed;
    opacity: 0.85;
  }

  .btn-sm {
    min-height: 36px;
    padding: 6px 16px;
    font-size: 0.85rem;
  }

  .btn-lock-toggle {
    background: rgba(56, 189, 248, 0.15);
    border-color: rgba(56, 189, 248, 0.4);
    color: #7dd3fc;
  }

  .btn-lock-toggle:hover {
    background: rgba(56, 189, 248, 0.3);
    border-color: #38bdf8;
    color: #ffffff;
  }

  .quick-preset-btns {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .preset-label {
    font-size: 0.82rem;
    color: #94a3b8;
    margin-right: 2px;
  }

  .btn-preset-pill {
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    padding: 6px 12px;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-preset-pill:hover {
    background: rgba(244, 63, 94, 0.2);
    border-color: #fda4af;
    color: #ffffff;
  }

  .timeline-summary-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.85rem;
    color: #94a3b8;
    flex-wrap: wrap;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .timeline-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .timeline-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-start {
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
  }

  .dot-end {
    background: #f43f5e;
    box-shadow: 0 0 8px #f43f5e;
  }

  .timeline-sep {
    color: #475569;
  }

  /* Overview Card */
  .habit-overview-card {
    padding: 2.2rem 2rem;
    margin-bottom: 2rem;
    background: radial-gradient(circle at 50% 0%, rgba(244, 63, 94, 0.12) 0%, rgba(11, 17, 32, 0.9) 80%);
    border: 1px solid rgba(244, 63, 94, 0.3);
    border-radius: 22px;
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.7), 0 0 30px rgba(244, 63, 94, 0.1);
  }

  .progress-stats-row {
    display: flex;
    justify-content: space-around;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1.8rem;
    flex-wrap: wrap;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .stat-number {
    font-size: 2.2rem;
    font-weight: 800;
    font-family: var(--mono);
    line-height: 1;
  }

  .stat-total {
    font-size: 1.2rem;
    color: #64748b;
  }

  .stat-name {
    font-size: 0.8rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .shield-stat-box {
    gap: 4px;
  }

  .shield-inventory-mini {
    display: flex;
    gap: 6px;
  }

  .shield-pill {
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    font-family: var(--mono);
    border: 1px solid;
  }

  .pill-ai-shield {
    background: rgba(56, 189, 248, 0.15);
    border-color: rgba(56, 189, 248, 0.4);
    color: #7dd3fc;
  }

  .pill-maze-shield {
    background: rgba(244, 63, 94, 0.15);
    border-color: rgba(244, 63, 94, 0.4);
    color: #fda4af;
  }

  .progress-bar-container {
    width: 100%;
    height: 12px;
    background: rgba(30, 41, 59, 0.85);
    border-radius: 9999px;
    overflow: hidden;
    margin-bottom: 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #f43f5e, #c084fc, #38bdf8);
    border-radius: 9999px;
    transition: width 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 16px rgba(244, 63, 94, 0.7);
  }

  /* Cosmic Portal Banner */
  .cosmic-portal-banner {
    background: radial-gradient(circle at 50% 50%, rgba(192, 132, 252, 0.25) 0%, rgba(15, 23, 42, 0.95) 100%);
    border: 2px solid #c084fc;
    border-radius: 18px;
    padding: 1.6rem 1.8rem;
    margin-bottom: 1.6rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 35px rgba(192, 132, 252, 0.4);
    animation: portalPulse 3s infinite ease-in-out;
  }

  @keyframes portalPulse {
