          badgeHtml = '<span class="day-star-badge">★</span>';
        } else if (dayItem.aiCompleted) {
          statusClass = 'is-ai-only';
          badgeHtml = '<span class="partner-node-pill" title="AI đã tích">👦</span>';
        } else if (dayItem.mazeCompleted) {
          statusClass = 'is-maze-only';
          badgeHtml = '<span class="partner-node-pill" title="Maze đã tích">👧</span>';
        }

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `day-node-btn ${statusClass} ${dayItem.day === currentSelectedDay ? 'is-active' : ''} ${isToday ? 'is-today-node' : ''}`;
        btn.setAttribute('data-day', String(dayItem.day));
        btn.title = isLocked
          ? `Ngày ${dayItem.day} (${dInfo.shortDisplay}) — Đang khóa cho đến ngày này 🔒`
          : `Ngày ${dayItem.day} (${dInfo.shortDisplay})`;

        btn.innerHTML = `
          <span class="node-num">${dayItem.day}</span>
          <span class="node-date">${dInfo.shortDisplay}</span>
          ${badgeHtml}
          ${isToday ? '<span class="today-mini-badge">Nay</span>' : ''}
        `;

        btn.addEventListener('click', () => {
          hasUserManuallySelectedDay = true;
          currentSelectedDay = dayItem.day;
          renderHabitUI();
        });

        strip.appendChild(btn);
      });
    }

    const panel = document.getElementById('active-day-panel');
    const dayData = list.find((d) => d.day === currentSelectedDay) || list[0];
    if (!panel || !dayData) return;

    const currentDayInfo = getDayCalendarInfo(startDate, dayData.day);
    const isCurrentDayToday = currentDayInfo.iso === todayIso;
    const isCurrentDayLocked = currentDayInfo.iso > todayIso;
    const boysAvatar = getBoysAvatar();
    const girlsAvatar = getGirlsAvatar();

    let topBadgeHtml = '';
    let feedbackBannerHtml = '';

    if (isCurrentDayLocked) {
      topBadgeHtml = `<span class="badge-love" style="background: rgba(148, 163, 184, 0.15); border-color: rgba(148, 163, 184, 0.35); color: #94a3b8;">🔒 CHƯA ĐẾN NGÀY — ĐANG KHÓA (MỞ: ${currentDayInfo.shortDisplay})</span>`;
      feedbackBannerHtml = `
        <div class="day-status-feedback-banner banner-locked">
          <span>🔒 <strong>Chưa đến ngày này!</strong> Tinh cầu Ngày ${dayData.day} tương ứng với ngày <strong>${currentDayInfo.headingDate}</strong>.<br/>Hệ thống đang tạm khóa và sẽ tự động mở khi đến đúng ngày này để cả hai cùng tích hoàn thành! ✨</span>
        </div>
      `;
    } else if (dayData.rescuedBy) {
      const rescuerName = dayData.rescuedBy === 'ai' ? 'AI (Anh 🚀)' : 'Maze (Em 🌸)';
      topBadgeHtml = `<span class="badge-love" style="background: rgba(244, 63, 94, 0.25); border-color: #f43f5e; color: #fda4af;">💖 ĐÃ ĐƯỢC HỌC BÙ BỞI ${rescuerName.toUpperCase()}</span>`;
      feedbackBannerHtml = `
        <div class="day-status-feedback-banner banner-rescued">
          <span>💖 <strong>Tích Bù Yêu Thương!</strong> Ngày này đã được ${rescuerName} gánh thay với trọn vẹn tình yêu!</span>
        </div>
        ${dayData.rescueNote ? `<div class="rescue-quote-box">💌 Lời nhắn yêu thương: "${dayData.rescueNote}"</div>` : ''}
      `;
    } else if (dayData.aiShieldUsed || dayData.mazeShieldUsed) {
      const shieldUser = dayData.aiShieldUsed && dayData.mazeShieldUsed ? 'Cả hai' : dayData.aiShieldUsed ? 'AI' : 'Maze';
      topBadgeHtml = `<span class="badge-love" style="background: rgba(56, 189, 248, 0.25); border-color: #38bdf8; color: #7dd3fc;">🛡️ KHIÊN HỘ MỆNH KÍCH HOẠT (${shieldUser})</span>`;
      feedbackBannerHtml = `
        <div class="day-status-feedback-banner banner-shielded">
          <span>🛡️ <strong>Khiên Bảo Vệ Đang Hoạt Động!</strong> Năng lượng ngày này đã được bảo lưu trọn vẹn vì sự cố bất khả kháng. Chuỗi sao tinh cầu vẫn an toàn! ✨</span>
        </div>
      `;
    } else if (dayData.completed) {
      topBadgeHtml = `<span class="badge-love badge-green">🎉 ĐÃ HOÀN THÀNH ĐỒNG PHA</span>`;
      feedbackBannerHtml = `
        <div class="day-status-feedback-banner banner-fully-completed">
          <span>💖 <strong>Tuyệt vời!</strong> Cả AI &amp; Maze đã cùng nhau chinh phục Ngày ${dayData.day}! Ngôi sao ngày này đã chính thức tỏa sáng rực rỡ! ⭐</span>
        </div>
      `;
    } else if (dayData.aiCompleted && !dayData.mazeCompleted) {
      topBadgeHtml = `<span class="badge-love" style="background: rgba(56, 189, 248, 0.2); border-color: #38bdf8; color: #7dd3fc;">⏳ AI ĐÃ TÍCH — ĐANG CHỜ MAZE</span>`;
      feedbackBannerHtml = `
        <div class="day-status-feedback-banner banner-waiting">
          <span>🚀 <strong>AI đã hoàn thành phần của mình!</strong> Nhắc <strong style="color: #fda4af;">Maze</strong> vào tích để cùng thắp sáng Ngày ${dayData.day} nhé! 🌸</span>
        </div>
      `;
    } else if (!dayData.aiCompleted && dayData.mazeCompleted) {
      topBadgeHtml = `<span class="badge-love" style="background: rgba(244, 63, 94, 0.2); border-color: #f43f5e; color: #fda4af;">⏳ MAZE ĐÃ TÍCH — ĐANG CHỜ AI</span>`;
      feedbackBannerHtml = `
        <div class="day-status-feedback-banner banner-waiting">
          <span>🌸 <strong>Maze đã hoàn thành phần của mình!</strong> Nhắc <strong style="color: #7dd3fc;">AI</strong> vào tích để cùng thắp sáng Ngày ${dayData.day} nhé! 🚀</span>
        </div>
      `;
    } else {
      topBadgeHtml = `<span class="badge-love badge-gold">⏳ CẢ HAI CHƯA ĐÁNH DẤU</span>`;
      feedbackBannerHtml = `
        <div class="day-status-feedback-banner banner-waiting">
          <span>💫 Cả 2 cùng rèn luyện tiếng Anh hôm nay nhé! <em>(Phải cả AI và Maze cùng tích hoặc dùng khiên bảo vệ)</em></span>
        </div>
      `;
    }

    panel.innerHTML = `
      <div class="panel-main-content">
        <div class="panel-top-row">
          ${topBadgeHtml}

          <div class="day-nav-group">
            <button type="button" class="btn-day-nav" id="btn-prev-day" ${dayData.day <= 1 ? 'disabled' : ''}>
              ‹ Ngày trước
            </button>
            <button type="button" class="btn-day-nav" id="btn-next-day" ${dayData.day >= targetDays ? 'disabled' : ''}>
              Ngày tiếp ›
            </button>
          </div>
        </div>

        <div class="panel-heading-wrap">
          <h3 class="day-heading gradient-love-text">
            Ngày ${dayData.day}
          </h3>
          <p class="day-date-sub">
            📅 ${currentDayInfo.headingDate} ${isCurrentDayToday ? '• <strong style="color: #fbbf24;">✨ HÔM NAY</strong>' : ''}
          </p>
        </div>

        <!-- Dual Partner Checklist 2-Column Grid -->
        <div class="dual-partner-cards-grid">
          <!-- Card 1: AI (Anh) -->
          <div class="partner-check-card card-ai ${isCurrentDayLocked ? '' : (dayData.aiCompleted || dayData.aiShieldUsed || dayData.rescuedBy ? 'is-checked' : '')}">
            <div class="card-partner-header">
              <img src="${boysAvatar}" alt="AI" class="partner-avatar-img" />
              <div class="partner-title-wrap">
                <h4 class="partner-main-name gradient-cyan-text">AI (Anh) 🚀</h4>
                <span class="partner-role-tag">Mặt Trăng Dịu Êm 🌙</span>
              </div>
            </div>

            <div class="partner-status-row">
              <span class="partner-status-pill ${isCurrentDayLocked ? 'status-pill-pending' : (dayData.aiCompleted ? 'status-pill-done-ai' : dayData.aiShieldUsed ? 'status-pill-done-ai' : 'status-pill-pending')}">
                ${isCurrentDayLocked ? `🔒 Khóa (Mở: ${currentDayInfo.shortDisplay})` : dayData.aiShieldUsed ? '🛡️ Đã dùng khiên bảo vệ' : dayData.aiCompleted ? '✓ Đã tích hoàn thành' : '⏳ Chưa tích hoàn thành'}
              </span>
            </div>

            <button
              type="button"
              class="btn-partner-toggle btn-ai-toggle ${isCurrentDayLocked ? 'btn-locked-state' : dayData.aiCompleted ? 'btn-checked' : 'btn-pending'}"
              id="btn-toggle-ai"
              ${isCurrentDayLocked ? 'disabled title="Ngày này thuộc về tương lai, đang khóa!"' : ''}
            >
              ${isCurrentDayLocked ? `🔒 Khóa cho đến ${currentDayInfo.shortDisplay}` : dayData.aiCompleted ? '✓ AI Đã Xong (Bấm để hủy)' : '👦 AI Tích Đã Xong ✨'}
            </button>

            <!-- Shield Button for AI -->
            <button
              type="button"
              class="btn-use-shield-mini"
              id="btn-shield-ai"
              ${isCurrentDayLocked ? 'disabled title="Chưa đến ngày này"' : ''}
            >
              ${dayData.aiShieldUsed ? '🛡️ Hủy Dùng Khiên AI' : `🛡️ Dùng Khiên Hộ Mệnh AI (${shields.ai}/2)`}
            </button>
          </div>

          <!-- Card 2: Maze (Em) -->
          <div class="partner-check-card card-maze ${isCurrentDayLocked ? '' : (dayData.mazeCompleted || dayData.mazeShieldUsed || dayData.rescuedBy ? 'is-checked' : '')}">
            <div class="card-partner-header">
              <img src="${girlsAvatar}" alt="Maze" class="partner-avatar-img" />
              <div class="partner-title-wrap">
                <h4 class="partner-main-name gradient-rose-text">Maze (Em) 🌸</h4>
                <span class="partner-role-tag">Trái Đất Xinh Đẹp 🌍</span>
              </div>
            </div>

            <div class="partner-status-row">
              <span class="partner-status-pill ${isCurrentDayLocked ? 'status-pill-pending' : (dayData.mazeCompleted ? 'status-pill-done-maze' : dayData.mazeShieldUsed ? 'status-pill-done-maze' : 'status-pill-pending')}">
                ${isCurrentDayLocked ? `🔒 Khóa (Mở: ${currentDayInfo.shortDisplay})` : dayData.mazeShieldUsed ? '🛡️ Đã dùng khiên bảo vệ' : dayData.mazeCompleted ? '✓ Đã tích hoàn thành' : '⏳ Chưa tích hoàn thành'}
              </span>
            </div>

            <button
              type="button"
              class="btn-partner-toggle btn-maze-toggle ${isCurrentDayLocked ? 'btn-locked-state' : dayData.mazeCompleted ? 'btn-checked' : 'btn-pending'}"
              id="btn-toggle-maze"
              ${isCurrentDayLocked ? 'disabled title="Ngày này thuộc về tương lai, đang khóa!"' : ''}
            >
              ${isCurrentDayLocked ? `🔒 Khóa cho đến ${currentDayInfo.shortDisplay}` : dayData.mazeCompleted ? '✓ Maze Đã Xong (Bấm để hủy)' : '👧 Maze Tích Đã Xong 💖'}
            </button>

            <!-- Shield Button for Maze -->
            <button
              type="button"
              class="btn-use-shield-mini"
              id="btn-shield-maze"
              ${isCurrentDayLocked ? 'disabled title="Chưa đến ngày này"' : ''}
            >
              ${dayData.mazeShieldUsed ? '🛡️ Hủy Dùng Khiên Maze' : `🛡️ Dùng Khiên Hộ Mệnh Maze (${shields.maze}/2)`}
            </button>
          </div>
        </div>

        <!-- Feedback & Guidance Banner -->
        ${feedbackBannerHtml}

        <!-- Bottom Action Row: Love Rescue & Joint Toggle -->
        <div class="panel-bottom-actions-row">
          <button type="button" class="btn-action-pill btn-action-rescue" id="btn-love-rescue" ${isCurrentDayLocked ? 'disabled title="Ngày này đang khóa"' : ''}>
            ${dayData.rescuedBy ? '🔄 Bỏ Chế Độ Tích Bù' : '💖 Tích Bù Yêu Thương (Gánh Thay)'}
          </button>
          <button type="button" class="btn-action-pill" id="btn-quick-joint-toggle" ${isCurrentDayLocked ? 'disabled title="Ngày này đang khóa"' : ''}>
            ${dayData.completed ? '🔄 Bỏ tích cả hai người' : '⚡ Cả hai cùng tích hoàn thành (Phím tắt)'}
          </button>
        </div>
      </div>
    `;

    const aiToggleBtn = panel.querySelector('#btn-toggle-ai');
    if (aiToggleBtn) {
      aiToggleBtn.addEventListener('click', () => {
        dayData.aiCompleted = !dayData.aiCompleted;
        dayData.aiCompletedDate = dayData.aiCompleted ? new Date().toISOString().slice(0, 10) : undefined;
        recalcDayCompletion(dayData);
        saveStoredHabits(list);
        renderHabitUI();
      });
    }

    const mazeToggleBtn = panel.querySelector('#btn-toggle-maze');
    if (mazeToggleBtn) {
      mazeToggleBtn.addEventListener('click', () => {
        dayData.mazeCompleted = !dayData.mazeCompleted;
        dayData.mazeCompletedDate = dayData.mazeCompleted ? new Date().toISOString().slice(0, 10) : undefined;
        recalcDayCompletion(dayData);
        saveStoredHabits(list);
        renderHabitUI();
      });
    }

    const aiShieldBtn = panel.querySelector('#btn-shield-ai');
    if (aiShieldBtn) {
      aiShieldBtn.addEventListener('click', () => {
        if (dayData.aiShieldUsed) {
          dayData.aiShieldUsed = false;
          shields.ai = Math.min(2, shields.ai + 1);
        } else {
          if (shields.ai <= 0) {
            alert('⚠️ AI đã dùng hết 2 khiên hộ mệnh của chặng này rồi!');
            return;
          }
          dayData.aiShieldUsed = true;
          shields.ai -= 1;
        }
        recalcDayCompletion(dayData);
        saveStoredShields(shields);
        saveStoredHabits(list);
        renderHabitUI();
      });
    }

    const mazeShieldBtn = panel.querySelector('#btn-shield-maze');
    if (mazeShieldBtn) {
      mazeShieldBtn.addEventListener('click', () => {
        if (dayData.mazeShieldUsed) {
          dayData.mazeShieldUsed = false;
          shields.maze = Math.min(2, shields.maze + 1);
        } else {
          if (shields.maze <= 0) {
            alert('⚠️ Maze đã dùng hết 2 khiên hộ mệnh của chặng này rồi!');
            return;
          }
          dayData.mazeShieldUsed = true;
          shields.maze -= 1;
        }
        recalcDayCompletion(dayData);
        saveStoredShields(shields);
        saveStoredHabits(list);
        renderHabitUI();
      });
    }

    const rescueBtn = panel.querySelector('#btn-love-rescue');
    if (rescueBtn) {
      rescueBtn.addEventListener('click', () => {
        if (dayData.rescuedBy) {
          dayData.rescuedBy = undefined;
          dayData.rescueNote = undefined;
        } else {
          const rescuer = confirm('Bấm OK nếu AI là người gánh bù, hoặc Cancel nếu Maze là người gánh bù?') ? 'ai' : 'maze';
          const rescuerName = rescuer === 'ai' ? 'AI' : 'Maze';
          const defaultNote = `${rescuerName} đã học bù bài hôm nay giúp đối phương với trọn vẹn yêu thương! 💖`;
          const note = prompt(`Nhập lời nhắn yêu thương khi học bù (${rescuerName}):`, defaultNote);
          dayData.rescuedBy = rescuer;
          dayData.rescueNote = note || defaultNote;
        }
        recalcDayCompletion(dayData);
        saveStoredHabits(list);
        renderHabitUI();
      });
    }

    const jointToggleBtn = panel.querySelector('#btn-quick-joint-toggle');
    if (jointToggleBtn) {
      jointToggleBtn.addEventListener('click', () => {
        const willComplete = !dayData.completed;
        const nowIso = new Date().toISOString().slice(0, 10);
        dayData.aiCompleted = willComplete;
        dayData.mazeCompleted = willComplete;
        dayData.aiCompletedDate = willComplete ? nowIso : undefined;
        dayData.mazeCompletedDate = willComplete ? nowIso : undefined;
        recalcDayCompletion(dayData);
        saveStoredHabits(list);
        renderHabitUI();
      });
    }

    const prevBtn = panel.querySelector('#btn-prev-day');
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentSelectedDay > 1) {
          hasUserManuallySelectedDay = true;
          currentSelectedDay -= 1;
          renderHabitUI();
        }
      });
    }

    const nextBtn = panel.querySelector('#btn-next-day');
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentSelectedDay < targetDays) {
          hasUserManuallySelectedDay = true;
          currentSelectedDay += 1;
          renderHabitUI();
        }
      });
    }
  }

  function recalcDayCompletion(dayData: any) {
    const isAIHandled = dayData.aiCompleted || dayData.aiShieldUsed;
    const isMazeHandled = dayData.mazeCompleted || dayData.mazeShieldUsed;
    dayData.completed = (isAIHandled && isMazeHandled) || Boolean(dayData.rescuedBy);
    if (dayData.completed && !dayData.completedDate) {
      dayData.completedDate = new Date().toISOString().slice(0, 10);
    } else if (!dayData.completed) {
      dayData.completedDate = undefined;
    }
  }

  function initHabitInteractive() {
    document.querySelectorAll('.milestone-tab-btn').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const days = Number(btn.getAttribute('data-days'));
        if (days && !isNaN(days)) {
          saveStoredTargetDays(days);
          renderHabitUI();
        }
      });
    });

    const portalAdvanceBtn = document.getElementById('btn-portal-advance');
    if (portalAdvanceBtn) {
      portalAdvanceBtn.addEventListener('click', () => {
        const currentDays = getStoredTargetDays();
        let nextDays = 66;
        if (currentDays === 21) nextDays = 66;
        else if (currentDays === 66) nextDays = 100;
        else if (currentDays === 100) nextDays = 365;

        saveStoredTargetDays(nextDays);
        renderHabitUI();
        alert(`🌌 Tuyệt vời! Hai bạn đã chính thức bước qua Cổng Không - Thời Gian vào Chặng ${nextDays} Ngày!`);
      });
    }

    const saveStartDateBtn = document.getElementById('btn-save-start-date');
    const toggleStartLockBtn = document.getElementById('btn-toggle-start-lock');
    const startDateInput = document.getElementById('habit-start-date-input') as HTMLInputElement | null;

    if (saveStartDateBtn && startDateInput) {
      saveStartDateBtn.addEventListener('click', () => {
        const val = startDateInput.value;
        if (val && /^\d{4}-\d{2}-\d{2}$/.test(val)) {
          saveStoredStartDate(val);
          saveStoredStartDateLocked(true);
          hasUserManuallySelectedDay = false;
          renderHabitUI();
          alert(`🔒 Đã lưu & niêm phong ngày bắt đầu: ${val.split('-').reverse().join('/')}! Lịch trình đã được khóa cố định.`);
        } else {
          alert('Vui lòng chọn ngày hợp lệ!');
        }
      });

      startDateInput.addEventListener('change', () => {
        const val = startDateInput.value;
        if (val && /^\d{4}-\d{2}-\d{2}$/.test(val)) {
          saveStoredStartDate(val);
          renderHabitUI();
        }
      });
    }

    if (toggleStartLockBtn) {
      toggleStartLockBtn.addEventListener('click', () => {
        const currentlyLocked = getStoredStartDateLocked();
        if (currentlyLocked) {
          const ok = confirm('🔓 Bạn có muốn mở khóa để thay đổi ngày bắt đầu lịch trình không?');
          if (ok) {
            saveStoredStartDateLocked(false);
            renderHabitUI();
          }
        } else {
          saveStoredStartDateLocked(true);
          renderHabitUI();
          alert('🔒 Lịch trình ngày bắt đầu đã được niêm phong cố định!');
        }
      });
    }

    const presetToday = document.getElementById('btn-preset-today');
    if (presetToday) {
      presetToday.addEventListener('click', () => {
        saveStoredStartDate(getTodayIso());
        renderHabitUI();
      });
    }

    const presetAnniversary = document.getElementById('btn-preset-anniversary');
    if (presetAnniversary) {
      presetAnniversary.addEventListener('click', () => {
        saveStoredStartDate('2026-08-15');
        renderHabitUI();
      });
    }

    const presetDefault = document.getElementById('btn-preset-default');
    if (presetDefault) {
      presetDefault.addEventListener('click', () => {
        saveStoredStartDate('2026-08-20');
        renderHabitUI();
      });
    }

    window.addEventListener('couple-cloud-updated', () => {
      renderHabitUI();
    });

    renderHabitUI();
  }

  initHabitInteractive();
  document.addEventListener('astro:after-swap', initHabitInteractive);
</script>
