---
import { HABIT_21_DAYS } from '../data/habit21Days';

const defaultHabitJSON = JSON.stringify(HABIT_21_DAYS).replace(/</g, '\\u003c');
---

<section class="habit-tracker-section" id="habit-tracker">
  <div class="section-header-wrap">
    <div class="badge-love mb-2">
      <span>✨ Thói Quen 21 Ngày Tinh Cầu</span>
    </div>
    <h2 class="section-title gradient-love-text">21 Ngày Cùng Em Rèn Thói Quen Tiếng Anh</h2>
    <p class="section-desc">
      Mỗi ngày là một vì sao được thắp sáng. Hãy cùng nhau kiên trì mỗi ngày và đánh dấu hoàn thành chặng đường 21 ngày của hai đứa!
    </p>
  </div>

  <!-- Progress Overview Card -->
  <div class="habit-overview-card romantic-card">
    <div class="progress-stats-row">
      <div class="stat-box">
        <span class="stat-number gradient-rose-text" id="habit-stat-completed">
          --<span class="stat-total">/21</span>
        </span>
        <span class="stat-name">Ngày Đã Hoàn Thành</span>
      </div>
      <div class="stat-box">
        <span class="stat-number gradient-cyan-text" id="habit-stat-percent">--%</span>
        <span class="stat-name">Hành Trình Tinh Cầu</span>
      </div>
      <div class="stat-box">
        <span class="stat-number" id="habit-stat-remaining" style="color: #fbbf24;">--</span>
        <span class="stat-name">Ngày Còn Lại</span>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="progress-bar-container">
      <div class="progress-bar-fill" id="habit-progress-bar" style="width: 0%;"></div>
    </div>

    <!-- 21-Day Constellation Track -->
    <div class="constellation-nav-wrap">
      <p class="constellation-guide-text">⭐ Bấm vào một ngày để xem và đánh dấu hoàn thành:</p>
      <div class="constellation-nodes-grid" id="day-selector-strip">
        <!-- 21 node buttons dynamically rendered / updated by script -->
      </div>
    </div>
  </div>

  <!-- Day Detail Active Panel -->
  <div class="day-details-container" id="habit-panels-container">
    <article class="day-detail-panel romantic-card active-panel" id="active-day-panel">
      <!-- Dynamic content rendered by client script -->
    </article>
  </div>
</section>

<!-- Inject initial data -->
<script is:inline define:vars={{ defaultHabitJSON }}>
  window.__INITIAL_HABIT_21__ = JSON.parse(defaultHabitJSON);
</script>

<style>
  .habit-tracker-section {
    max-width: 920px;
    margin: 3.5rem auto;
    padding: 0 1.2rem;
  }

  .section-header-wrap {
    text-align: center;
    margin-bottom: 2.2rem;
  }

  .section-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 0.8rem;
    letter-spacing: -0.02em;
  }

  .section-desc {
    max-width: 680px;
    margin: 0 auto;
    color: #94a3b8;
    line-height: 1.6;
    font-size: 1rem;
  }

  /* Overview Card */
  .habit-overview-card {
    padding: 2.2rem 2rem;
    margin-bottom: 2rem;
    background: radial-gradient(circle at 50% 0%, rgba(244, 63, 94, 0.12) 0%, rgba(11, 17, 32, 0.9) 80%);
    border: 1px solid rgba(244, 63, 94, 0.3);
    border-radius: 22px;
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.7), 0 0 30px rgba(244, 63, 94, 0.1);
  }

  .progress-stats-row {
    display: flex;
    justify-content: space-around;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.8rem;
    flex-wrap: wrap;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .stat-number {
    font-size: 2.4rem;
    font-weight: 800;
    font-family: var(--mono);
    line-height: 1;
  }

  .stat-total {
    font-size: 1.3rem;
    color: #64748b;
  }

  .stat-name {
    font-size: 0.82rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .progress-bar-container {
    width: 100%;
    height: 12px;
    background: rgba(30, 41, 59, 0.85);
    border-radius: 9999px;
    overflow: hidden;
    margin-bottom: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #f43f5e, #c084fc, #38bdf8);
    border-radius: 9999px;
    transition: width 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 16px rgba(244, 63, 94, 0.7);
  }

  /* 21 Nodes */
  .constellation-guide-text {
    font-size: 0.95rem;
    color: #cbd5e1;
    margin-bottom: 1.2rem;
    text-align: center;
    font-weight: 500;
  }

  .constellation-nodes-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  :global(.day-node-btn) {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(11, 17, 32, 0.85);
    backdrop-filter: blur(10px);
    color: #cbd5e1;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    user-select: none;
    font-family: var(--mono);
  }

  :global(.day-node-btn:hover) {
    transform: translateY(-2px) scale(1.08);
    border-color: #fda4af;
    box-shadow: 0 0 18px rgba(244, 63, 94, 0.4);
    color: #ffffff;
  }

  :global(.day-node-btn.is-active) {
    border-color: #38bdf8;
    box-shadow: 0 0 22px rgba(56, 189, 248, 0.7), inset 0 0 10px rgba(56, 189, 248, 0.35);
    color: #ffffff;
    transform: scale(1.14);
  }

  :global(.day-node-btn.is-completed) {
    background: linear-gradient(135deg, rgba(244, 63, 94, 0.4), rgba(192, 132, 252, 0.5));
    border-color: rgba(244, 63, 94, 0.7);
    color: #ffffff;
    box-shadow: 0 0 16px rgba(244, 63, 94, 0.35);
  }

  :global(.day-star-badge) {
    position: absolute;
    top: -5px;
    right: -5px;
    font-size: 0.8rem;
    color: #fbbf24;
    text-shadow: 0 0 8px rgba(251, 191, 36, 0.95);
  }

  /* Active Day Panel */
  .day-details-container {
    margin-top: 1.5rem;
  }

  .day-detail-panel {
    padding: 2.2rem 2.4rem;
    background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.08) 0%, rgba(11, 17, 32, 0.92) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.7);
  }

  :global(.panel-main-content) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.8rem;
    text-align: center;
  }

  :global(.panel-top-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 1.2rem;
  }

  :global(.day-nav-group) {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  :global(.btn-day-nav) {
    padding: 6px 14px;
    font-size: 0.86rem;
    font-weight: 600;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(15, 23, 42, 0.6);
    color: #cbd5e1;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :global(.btn-day-nav:hover:not(:disabled)) {
    background: rgba(244, 63, 94, 0.2);
    border-color: #fda4af;
    color: #ffffff;
  }

  :global(.btn-day-nav:disabled) {
    opacity: 0.35;
    cursor: not-allowed;
  }

  :global(.panel-info-body) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }

  :global(.day-heading) {
    font-size: 2.4rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  :global(.panel-actions-center) {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  :global(.btn-toggle-day-status) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 15px 38px;
    font-size: 1.15rem;
    font-weight: 700;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: none;
    outline: none;
  }

  :global(.btn-toggle-day-status.btn-mark-pending) {
    background: linear-gradient(135deg, #f43f5e 0%, #ec4899 50%, #c084fc 100%);
    color: #ffffff;
    box-shadow: 0 4px 25px rgba(244, 63, 94, 0.45);
  }

  :global(.btn-toggle-day-status.btn-mark-pending:hover) {
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 8px 32px rgba(244, 63, 94, 0.65);
  }

  :global(.btn-toggle-day-status.btn-mark-completed) {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.2) 0%, rgba(16, 185, 129, 0.25) 100%);
    color: #86efac;
    border: 1px solid rgba(34, 197, 94, 0.4);
    box-shadow: 0 4px 20px rgba(34, 197, 94, 0.25);
  }

  :global(.btn-toggle-day-status.btn-mark-completed:hover) {
    transform: translateY(-2px);
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(244, 63, 94, 0.25) 100%);
    border-color: rgba(244, 63, 94, 0.5);
    color: #fda4af;
    box-shadow: 0 4px 20px rgba(244, 63, 94, 0.3);
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 1.7rem;
    }
    .habit-overview-card {
      padding: 1.5rem 1.2rem;
    }
    .day-detail-panel {
      padding: 1.6rem 1.2rem;
    }
    :global(.day-heading) {
      font-size: 1.8rem;
    }
    :global(.btn-toggle-day-status) {
      width: 100%;
      padding: 14px 20px;
      font-size: 1.05rem;
    }
  }
</style>

<script>
  import { pushDataToFirebase } from '../lib/firebaseClient';

  const HABIT_STORAGE_KEY = 'couple_habit_21';

  function getStoredHabits(): any[] {
    try {
      const stored = localStorage.getItem(HABIT_STORAGE_KEY);
      if (stored) return JSON.parse(stored);
    } catch {}
    const initial = (window as any).__INITIAL_HABIT_21__ || [];
    localStorage.setItem(HABIT_STORAGE_KEY, JSON.stringify(initial));
    return initial;
  }

  function saveStoredHabits(list: any[]) {
    localStorage.setItem(HABIT_STORAGE_KEY, JSON.stringify(list));
    pushDataToFirebase({ habit21: list, lastUpdatedBy: 'HabitTracker' }).catch(() => {});
  }

  let currentSelectedDay = 1;

  function renderHabitUI() {
    const list: any[] = getStoredHabits();
    const totalDays = 21;
    const completedCount = list.filter((d) => d.completed).length;
    const percentage = Math.round((completedCount / totalDays) * 100);

    // Update Overview Stats
    const completedEl = document.getElementById('habit-stat-completed');
    const percentEl = document.getElementById('habit-stat-percent');
    const remainingEl = document.getElementById('habit-stat-remaining');
    const progressBar = document.getElementById('habit-progress-bar');

    if (completedEl) completedEl.innerHTML = `${completedCount}<span class="stat-total">/${totalDays}</span>`;
    if (percentEl) percentEl.textContent = `${percentage}%`;
    if (remainingEl) remainingEl.textContent = `${totalDays - completedCount}`;
    if (progressBar) progressBar.style.width = `${percentage}%`;

    // Render 21 Constellation Node Buttons
    const strip = document.getElementById('day-selector-strip');
    if (strip) {
      strip.innerHTML = '';
      list.forEach((dayItem) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `day-node-btn ${dayItem.completed ? 'is-completed' : 'is-pending'} ${dayItem.day === currentSelectedDay ? 'is-active' : ''}`;
        btn.setAttribute('data-day', String(dayItem.day));
        btn.title = `Ngày ${dayItem.day}: ${dayItem.completed ? 'Đã hoàn thành' : 'Chờ hoàn thành'}`;
        btn.innerHTML = `
          <span class="day-num">${dayItem.day}</span>
          ${dayItem.completed ? '<span class="day-star-badge">★</span>' : ''}
        `;

        btn.addEventListener('click', () => {
          currentSelectedDay = dayItem.day;
          renderHabitUI();
        });

        strip.appendChild(btn);
      });
    }

    // Render Active Panel Detail
    const panel = document.getElementById('active-day-panel');
    const dayData = list.find((d) => d.day === currentSelectedDay) || list[0];
    if (!panel || !dayData) return;

    const formattedCompletedDate = dayData.completedDate
      ? dayData.completedDate.split('-').reverse().join('/')
      : 'Ghi nhận';

    panel.innerHTML = `
      <div class="panel-main-content">
        <div class="panel-top-row">
          <span class="badge-love ${dayData.completed ? 'badge-green' : 'badge-gold'}">
            ${dayData.completed ? `✓ Đã Hoàn Thành (${formattedCompletedDate})` : '⏳ Đang Chờ Hoàn Thành'}
          </span>

          <div class="day-nav-group">
            <button type="button" class="btn-day-nav" id="btn-prev-day" ${dayData.day <= 1 ? 'disabled' : ''}>
              ‹ Ngày trước
            </button>
            <button type="button" class="btn-day-nav" id="btn-next-day" ${dayData.day >= 21 ? 'disabled' : ''}>
              Ngày tiếp ›
            </button>
          </div>
        </div>

        <div class="panel-info-body">
          <h3 class="day-heading gradient-love-text">
            Ngày ${dayData.day}
          </h3>
        </div>

        <div class="panel-actions-center">
          <button 
            type="button" 
            class="btn-toggle-day-status ${dayData.completed ? 'btn-mark-completed' : 'btn-mark-pending'}" 
            id="btn-toggle-day"
          >
            ${dayData.completed ? '✓ Đã Hoàn Thành (Bấm để bỏ đánh dấu)' : '★ Đánh Dấu Hoàn Thành'}
          </button>
        </div>
      </div>
    `;

    // Toggle button event
    const toggleBtn = panel.querySelector('#btn-toggle-day');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        dayData.completed = !dayData.completed;
        if (dayData.completed) {
          dayData.completedDate = new Date().toISOString().slice(0, 10);
        } else {
          dayData.completedDate = undefined;
        }
        saveStoredHabits(list);
        renderHabitUI();
      });
    }

    // Previous day button event
    const prevBtn = panel.querySelector('#btn-prev-day');
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentSelectedDay > 1) {
          currentSelectedDay -= 1;
          renderHabitUI();
        }
      });
    }

    // Next day button event
    const nextBtn = panel.querySelector('#btn-next-day');
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentSelectedDay < 21) {
          currentSelectedDay += 1;
          renderHabitUI();
        }
      });
    }
  }

  function initHabitInteractive() {
    // Listen for Realtime Cloud Updates from Firebase
    window.addEventListener('couple-cloud-updated', () => {
      renderHabitUI();
    });

    renderHabitUI();
  }

  initHabitInteractive();
  document.addEventListener('astro:after-swap', initHabitInteractive);
</script>
