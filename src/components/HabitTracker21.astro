---
import { HABIT_21_DAYS } from '../data/habit21Days';

const defaultHabitJSON = JSON.stringify(HABIT_21_DAYS).replace(/</g, '\\u003c');
---

<section class="habit-tracker-section" id="habit-tracker">
  <div class="section-header-wrap">
    <div class="badge-love mb-2">
      <span>✨ Thói Quen 21 Ngày Tinh Cầu</span>
    </div>
    <h2 class="section-title gradient-love-text">21 Ngày Cùng Em Rèn Thói Quen Tiếng Anh</h2>
    <p class="section-desc">
      Mỗi ngày là một vì sao được thắp sáng. Dù chỉ là 15 phút bên nhau, từng từ vựng và câu nói đều là minh chứng cho sự kiên trì và tình yêu của hai đứa.
    </p>
  </div>

  <!-- Progress Overview Card -->
  <div class="habit-overview-card romantic-card">
    <div class="progress-stats-row">
      <div class="stat-box">
        <span class="stat-number gradient-rose-text" id="habit-stat-completed">
          --<span class="stat-total">/21</span>
        </span>
        <span class="stat-name">Ngày Đã Hoàn Thành</span>
      </div>
      <div class="stat-box">
        <span class="stat-number gradient-cyan-text" id="habit-stat-percent">--%</span>
        <span class="stat-name">Hành Trình Tinh Cầu</span>
      </div>
      <div class="stat-box">
        <span class="stat-number" id="habit-stat-remaining" style="color: #fbbf24;">--</span>
        <span class="stat-name">Ngày Cùng Chinh Phục Tiếp</span>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="progress-bar-container">
      <div class="progress-bar-fill" id="habit-progress-bar" style="width: 0%;"></div>
    </div>

    <!-- 21-Day Constellation Track -->
    <div class="constellation-nav-wrap">
      <p class="constellation-guide-text">⭐ Chọn một ngày để xem và cập nhật nhật ký học tập của Maze &amp; AI:</p>
      <div class="constellation-nodes-grid" id="day-selector-strip">
        <!-- 21 node buttons dynamically rendered / updated by script -->
      </div>
    </div>
  </div>

  <!-- Day Detail Active Panel (Dynamic) -->
  <div class="day-details-container" id="habit-panels-container">
    <article class="day-detail-panel romantic-card active-panel" id="active-day-panel">
      <!-- Dynamic content rendered by client script -->
    </article>
  </div>

  <!-- Dedicated Notion / Medium Zen Love Journal Studio Modal for 21 Days -->
  <div class="crud-modal-overlay" id="habit-edit-modal" aria-hidden="true">
    <div class="crud-modal-card zen-journal-card romantic-card">
      
      <!-- 1. Zen Hero Cover Banner -->
      <div class="zen-cover-hero" id="habit-cover-hero-wrap">
        <div class="zen-cover-constellation-bg">
          <div class="zen-cover-nebula"></div>
          <div class="zen-cover-badge-pill" id="habit-cover-day-badge">⭐ Chặng Học 21 Ngày</div>
        </div>
        <div class="zen-cover-gradient"></div>

        <button type="button" class="zen-modal-close-btn" id="habit-modal-close" aria-label="Đóng">&times;</button>
      </div>

      <!-- 2. Main Scrollable Zen Journal Book -->
      <form id="habit-edit-form" class="zen-journal-form">
        <input type="hidden" id="form-day-num" value="1" />

        <div class="zen-scrollable-content">
          <!-- Big Seamless Title & Theme -->
          <div class="zen-title-container">
            <textarea
              id="form-day-title"
              class="zen-title-textarea"
              rows="1"
              required
              placeholder="Tên chặng / Tiêu đề ngày học..."
            ></textarea>
            <input
              type="text"
              id="form-day-theme"
              class="zen-theme-input"
              required
              placeholder="Chủ đề bài học (ví dụ: Daily Routines & Love Words)..."
            />
          </div>

          <!-- Interactive Metadata Tag Bar -->
          <div class="zen-meta-row">
            <!-- Số ngày -->
            <div class="zen-pill-item">
              <span class="zen-pill-icon">🗓️</span>
              <span class="zen-pill-text" id="habit-pill-day-text">Ngày 1 / 21</span>
            </div>

            <!-- Người chắp bút đang chọn -->
            <div class="zen-pill-item zen-pill-author">
              <span class="zen-pill-icon">✍️</span>
              <select id="form-habit-author" class="zen-pill-select" title="Chọn người chắp bút">
                <option value="both">Cả hai đứa 💖</option>
                <option value="maze">Maze 🌸</option>
                <option value="ai">AI 🚀</option>
              </select>
            </div>

            <!-- Trạng thái hoàn thành -->
            <div class="zen-pill-item zen-pill-status">
              <label class="zen-checkbox-pill" title="Đánh dấu hoàn thành ngày học">
                <input type="checkbox" id="form-day-completed" />
                <span id="label-day-completed-text">★ Hoàn thành</span>
              </label>
            </div>

            <!-- Ngày hoàn thành -->
            <div class="zen-pill-item zen-pill-date" id="group-day-completed-date" style="display: none;">
              <span class="zen-pill-icon">📅</span>
              <input
                type="date"
                id="form-day-completed-date"
                class="zen-pill-input"
                title="Ngày hoàn thành"
              />
            </div>
          </div>

          <!-- Sticky Format & View Toolbar -->
          <div class="zen-sticky-toolbar">
            <div class="zen-tools-group">
              <button type="button" class="zen-tb-btn" data-action="bold" title="In đậm (**chữ**)"><strong>B</strong></button>
              <button type="button" class="zen-tb-btn" data-action="italic" title="In nghiêng (*chữ*)"><em>I</em></button>
              <button type="button" class="zen-tb-btn" data-action="h3" title="Tiêu đề phân đoạn (### Tiêu đề)"><strong>H3</strong></button>
              <button type="button" class="zen-tb-btn" data-action="quote" title="Trích dẫn lãng mạn (&gt; Trích dẫn)">❝</button>
              <button type="button" class="zen-tb-btn" data-action="poem" title="Khổ thơ tình yêu">📜 Thơ</button>
              <button type="button" class="zen-tb-btn" data-action="vocab" title="Chèn cú pháp từ vựng">📖 Vocab</button>
              <button type="button" class="zen-tb-btn" data-action="list" title="Danh sách (- việc đã học)">• List</button>
              
              <div class="zen-emoji-strip">
                <button type="button" class="zen-emoji-btn" data-emoji="💖">💖</button>
                <button type="button" class="zen-emoji-btn" data-emoji="🌸">🌸</button>
                <button type="button" class="zen-emoji-btn" data-emoji="🚀">🚀</button>
                <button type="button" class="zen-emoji-btn" data-emoji="🌌">🌌</button>
                <button type="button" class="zen-emoji-btn" data-emoji="✨">✨</button>
                <button type="button" class="zen-emoji-btn" data-emoji="⭐">⭐</button>
                <button type="button" class="zen-emoji-btn" data-emoji="📖">📖</button>
                <button type="button" class="zen-emoji-btn" data-emoji="🥰">🥰</button>
              </div>
            </div>

            <div class="zen-view-toggle-group">
              <button type="button" class="zen-toggle-btn is-active" data-mode="editor" id="btn-habit-mode-editor">✍️ Soạn thảo</button>
              <button type="button" class="zen-toggle-btn" data-mode="preview" id="btn-habit-mode-preview">👁️ Xem trang báo</button>
            </div>
          </div>

          <!-- Zen Workspace: Editor or Preview -->
          <div class="zen-workspace-container mode-editor" id="habit-studio-workspace">
            
            <!-- Editor View -->
            <div class="zen-editor-view" id="habit-workspace-editor-col">
              
              <!-- 2 Separate Spaces for Maze and AI -->
              <div class="habit-dual-notes-grid">
                
                <!-- Maze's Space -->
                <div class="habit-partner-pane habit-maze-pane" id="pane-maze-learned-wrap">
                  <div class="habit-pane-header">
                    <div class="habit-pane-title-wrap">
                      <span class="habit-pane-avatar">🌸</span>
                      <div>
                        <h4 class="habit-pane-title">Không Gian Của Maze</h4>
                        <span class="habit-pane-sub">Nàng Tinh Cầu ghi lại những điều tâm đắc</span>
                      </div>
                    </div>
                  </div>
                  <textarea
                    id="form-maze-learned"
                    class="zen-pane-textarea"
                    rows="4"
                    placeholder="Hôm nay Maze đã học được những từ, câu hoặc cảm nghĩ gì? (Hỗ trợ Markdown)..."
                  ></textarea>
                </div>

                <!-- AI's Space -->
                <div class="habit-partner-pane habit-ai-pane" id="pane-ai-learned-wrap">
                  <div class="habit-pane-header">
                    <div class="habit-pane-title-wrap">
                      <span class="habit-pane-avatar">🚀</span>
                      <div>
                        <h4 class="habit-pane-title">Không Gian Của AI</h4>
                        <span class="habit-pane-sub">Chàng Kỹ Sư ghi lại bài học &amp; lời gửi Maze</span>
                      </div>
                    </div>
                  </div>
                  <textarea
                    id="form-ai-learned"
                    class="zen-pane-textarea"
                    rows="4"
                    placeholder="Hôm nay AI đã học được điều gì và muốn nhắn nhủ gì tới Maze? (Hỗ trợ Markdown)..."
                  ></textarea>
                </div>

              </div>

              <!-- Key Vocabulary Section -->
              <div class="zen-card-section">
                <div class="zen-section-header">
                  <span class="zen-section-icon">📖</span>
                  <h4 class="zen-section-title">Từ Vựng &amp; Điểm Ngữ Pháp Tâm Đắc</h4>
                </div>
                <p class="zen-section-sub">Nhập mỗi từ trên 1 dòng theo cú pháp: <code>Từ - Nghĩa - Câu ví dụ</code></p>
                <textarea
                  id="form-day-vocab"
                  class="zen-vocab-textarea"
                  rows="3"
                  placeholder="Cherish - Yêu thương trân trọng - I cherish every second with you.
Routine - Thói quen ngọt ngào - Learning English with you is my sweetest routine."
                ></textarea>
              </div>

              <!-- Romantic Note Section -->
              <div class="zen-card-section">
                <div class="zen-section-header">
                  <span class="zen-section-icon">💌</span>
                  <h4 class="zen-section-title">Lời Nhắn Gửi Yêu Thương</h4>
                </div>
                <textarea
                  id="form-romantic-note"
                  class="zen-caption-textarea"
                  rows="2"
                  placeholder="Lời khích lệ ngọt ngào hoặc câu thơ dành tặng đối phương sau buổi học..."
                ></textarea>
              </div>

            </div>

            <!-- Live Preview View -->
            <div class="zen-preview-view" id="habit-workspace-preview-col" style="display: none;">
              <div class="studio-live-preview-box zen-preview-content-box" id="habit-live-preview">
                <!-- Dynamically rendered -->
              </div>
            </div>

          </div>

        </div>

        <!-- Floating Footer -->
        <div class="zen-footer-bar">
          <div class="zen-footer-wordcount" id="habit-word-count">0 từ</div>
          <div class="zen-footer-buttons">
            <button type="button" class="btn-outline-love" id="btn-cancel-habit">Hủy Bỏ</button>
            <button type="submit" class="btn-love" id="btn-save-habit">💖 Lưu Bài Học</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<!-- Inject initial data -->
<script is:inline define:vars={{ defaultHabitJSON }}>
  window.__INITIAL_HABIT_21__ = JSON.parse(defaultHabitJSON);
</script>

<style>
  .habit-tracker-section {
    max-width: 980px;
    margin: 4rem auto;
    padding: 0 1.2rem;
  }

  .section-header-wrap {
    text-align: center;
    margin-bottom: 2.2rem;
  }

  .section-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 0.8rem;
    letter-spacing: -0.02em;
  }

  .section-desc {
    max-width: 680px;
    margin: 0 auto;
    color: #94a3b8;
    line-height: 1.6;
    font-size: 1rem;
  }

  /* Overview Card */
  .habit-overview-card {
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .progress-stats-row {
    display: flex;
    justify-content: space-around;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stat-number {
    font-size: 2.2rem;
    font-weight: 800;
    font-family: var(--mono);
    line-height: 1;
  }

  .stat-total {
    font-size: 1.2rem;
    color: #64748b;
  }

  .stat-name {
    font-size: 0.8rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .progress-bar-container {
    width: 100%;
    height: 10px;
    background: rgba(30, 41, 59, 0.8);
    border-radius: 9999px;
    overflow: hidden;
    margin-bottom: 1.8rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #f43f5e, #c084fc, #38bdf8);
    border-radius: 9999px;
    transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 16px rgba(244, 63, 94, 0.6);
  }

  /* 21 Nodes */
  .constellation-guide-text {
    font-size: 0.9rem;
    color: #cbd5e1;
    margin-bottom: 1rem;
    text-align: center;
  }

  .constellation-nodes-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  :global(.day-node-btn) {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(11, 17, 32, 0.8);
    backdrop-filter: blur(10px);
    color: #cbd5e1;
    font-size: 0.96rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    user-select: none;
  }

  :global(.day-node-btn:hover) {
    transform: translateY(-2px) scale(1.05);
    border-color: #fda4af;
    box-shadow: 0 0 16px rgba(244, 63, 94, 0.35);
    color: #ffffff;
  }

  :global(.day-node-btn.is-active) {
    border-color: #38bdf8;
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.6), inset 0 0 8px rgba(56, 189, 248, 0.3);
    color: #ffffff;
    transform: scale(1.12);
  }

  :global(.day-node-btn.is-completed) {
    background: linear-gradient(135deg, rgba(244, 63, 94, 0.35), rgba(192, 132, 252, 0.45));
    border-color: rgba(244, 63, 94, 0.6);
    color: #ffffff;
    box-shadow: 0 0 14px rgba(244, 63, 94, 0.25);
  }

  :global(.day-star-badge) {
    position: absolute;
    top: -4px;
    right: -4px;
    font-size: 0.72rem;
    color: #fbbf24;
    text-shadow: 0 0 8px rgba(251, 191, 36, 0.9);
  }

  /* Active Day Panel */
  .day-details-container {
    margin-top: 2rem;
  }

  .day-detail-panel {
    padding: 2.2rem;
    background: var(--card-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--card-border);
    border-radius: 18px;
    box-shadow: var(--card-glow);
  }

  :global(.panel-header-row) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }

  :global(.panel-title-area) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.day-heading) {
    font-size: 1.85rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
  }

  :global(.day-prefix) {
    color: #fda4af;
  }

  :global(.day-theme-label) {
    font-size: 0.96rem;
    color: #94a3b8;
    margin: 0;
  }

  :global(.panel-actions-group) {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    flex-wrap: wrap;
  }

  :global(.learning-columns-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
    margin-bottom: 2rem;
    align-items: stretch;
  }

  :global(.partner-learn-box) {
    background: rgba(7, 10, 19, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.6rem;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 220px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  :global(.maze-box) {
    border-left: 4px solid #f43f5e;
    background: linear-gradient(180deg, rgba(244, 63, 94, 0.08) 0%, rgba(11, 17, 32, 0.85) 100%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(244, 63, 94, 0.1);
  }

  :global(.ai-box) {
    border-left: 4px solid #38bdf8;
    background: linear-gradient(180deg, rgba(56, 189, 248, 0.08) 0%, rgba(11, 17, 32, 0.85) 100%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.1);
  }

  :global(.box-header) {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  :global(.partner-learn-avatar) {
    font-size: 1.8rem;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
  }

  :global(.partner-learn-title) {
    font-size: 1.12rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 2px;
  }

  :global(.partner-learn-sub) {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  :global(.learn-text) {
    font-size: 0.95rem;
    color: #cbd5e1;
    line-height: 1.7;
    margin: 0;
    flex: 1;
  }

  :global(.vocab-section-wrap) {
    margin-bottom: 2rem;
    background: rgba(7, 10, 19, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.6rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  :global(.vocab-title) {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 1.2rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :global(.vocab-chips-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  :global(.vocab-chip) {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: transform 0.2s, border-color 0.2s;
  }

  :global(.vocab-chip:hover) {
    transform: translateY(-2px);
    border-color: rgba(244, 63, 94, 0.4);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  :global(.vocab-word) {
    font-size: 1.05rem;
    font-weight: 700;
    color: #fda4af;
  }

  :global(.vocab-meaning) {
    font-size: 0.88rem;
    color: #f1f5f9;
  }

  :global(.vocab-example) {
    font-size: 0.82rem;
    color: #94a3b8;
    font-style: italic;
  }

  :global(.romantic-note-box) {
    display: flex;
    gap: 1.2rem;
    background: linear-gradient(135deg, rgba(244, 63, 94, 0.12), rgba(192, 132, 252, 0.12));
    border: 1px solid rgba(244, 63, 94, 0.3);
    border-radius: 14px;
    padding: 1.4rem 1.8rem;
    align-items: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  :global(.romantic-note-quote-icon) {
    font-size: 2.2rem;
    filter: drop-shadow(0 0 10px rgba(244, 63, 94, 0.4));
  }

  :global(.romantic-note-title) {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #fda4af;
    letter-spacing: 0.05em;
    margin: 0 0 4px;
  }

  :global(.romantic-note-text) {
    font-family: var(--body);
    font-style: italic;
    font-size: 1rem;
    color: #f1f5f9;
    line-height: 1.55;
    margin: 0;
  }

  /* =========================================================================
     NOTION / MEDIUM ZEN LOVE JOURNAL STUDIO MODAL (21 DAYS)
     ========================================================================= */
  .crud-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(5, 8, 18, 0.88);
    backdrop-filter: blur(14px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .crud-modal-overlay.is-open {
    display: flex;
    animation: fadeInModal 0.25s ease-out;
  }

  .zen-journal-card {
    max-width: 960px;
    width: 100%;
    height: 92vh;
    background: #090e1a;
    border: 1px solid rgba(244, 63, 94, 0.35);
    border-radius: 20px;
