<script>
  import { pushDataToFirebase } from '../lib/firebaseClient';

  const HABIT_STORAGE_KEY = 'couple_habit_21';
  const START_DATE_STORAGE_KEY = 'couple_habit_start_date';
  const START_DATE_LOCKED_KEY = 'couple_habit_start_date_locked';
  const SHIELDS_STORAGE_KEY = 'couple_habit_shields';
  const TARGET_DAYS_STORAGE_KEY = 'couple_habit_target_days';

  function getBoysAvatar(): string {
    try {
      const stored = localStorage.getItem('couple_avatars');
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed.ai) return parsed.ai;
      }
    } catch {}
    return (window as any).__COUPLE_BOYS_INFO__?.avatar || '/assets/ai.png';
  }

  function getGirlsAvatar(): string {
    try {
      const stored = localStorage.getItem('couple_avatars');
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed.maze) return parsed.maze;
      }
    } catch {}
    return (window as any).__COUPLE_GIRLS_INFO__?.avatar || '/assets/maze.jpg';
  }

  function getStoredStartDate(): string {
    try {
      const stored = localStorage.getItem(START_DATE_STORAGE_KEY);
      if (stored && /^\d{4}-\d{2}-\d{2}$/.test(stored)) return stored;
    } catch {}
    return (window as any).__DEFAULT_HABIT_START_DATE__ || '2026-08-20';
  }

  function saveStoredStartDate(dateStr: string) {
    localStorage.setItem(START_DATE_STORAGE_KEY, dateStr);
    pushDataToFirebase({ habitStartDate: dateStr, lastUpdatedBy: 'HabitTracker' }).catch(() => {});
  }

  function getStoredStartDateLocked(): boolean {
    const raw = localStorage.getItem(START_DATE_LOCKED_KEY);
    if (raw === null) {
      return true; // Mặc định khóa để giữ an toàn lịch trình
    }
    return raw === 'true';
  }

  function saveStoredStartDateLocked(locked: boolean) {
    localStorage.setItem(START_DATE_LOCKED_KEY, locked ? 'true' : 'false');
    pushDataToFirebase({ habitStartDateLocked: locked, lastUpdatedBy: 'HabitTracker' }).catch(() => {});
  }

  function getStoredTargetDays(): number {
    try {
      const stored = localStorage.getItem(TARGET_DAYS_STORAGE_KEY);
      if (stored && !isNaN(Number(stored))) return Number(stored);
    } catch {}
    return 21;
  }

  function saveStoredTargetDays(days: number) {
    localStorage.setItem(TARGET_DAYS_STORAGE_KEY, String(days));
    pushDataToFirebase({ habitTargetDays: days, lastUpdatedBy: 'HabitTracker' }).catch(() => {});
  }

  function getStoredShields(): { ai: number; maze: number } {
    try {
      const stored = localStorage.getItem(SHIELDS_STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        return {
          ai: typeof parsed.ai === 'number' ? parsed.ai : 2,
          maze: typeof parsed.maze === 'number' ? parsed.maze : 2
        };
      }
    } catch {}
    return { ai: 2, maze: 2 };
  }

  function saveStoredShields(shields: { ai: number; maze: number }) {
    localStorage.setItem(SHIELDS_STORAGE_KEY, JSON.stringify(shields));
    pushDataToFirebase({ habitShields: shields, lastUpdatedBy: 'HabitTracker' }).catch(() => {});
  }

  function getStoredHabits(targetDays: number): any[] {
    let list: any[] = [];
    try {
      const stored = localStorage.getItem(HABIT_STORAGE_KEY);
      if (stored) {
        list = JSON.parse(stored);
      }
    } catch {}

    if (!Array.isArray(list) || list.length === 0) {
      list = (window as any).__INITIAL_HABIT_21__ || [];
    }

    if (list.length < targetDays) {
      const currentLen = list.length;
      for (let i = currentLen + 1; i <= targetDays; i++) {
        list.push({
          day: i,
          aiCompleted: false,
          mazeCompleted: false,
          completed: false
        });
      }
    }

    return list.map((item: any, idx: number) => {
      const aiCompleted = Boolean(item.aiCompleted);
      const mazeCompleted = Boolean(item.mazeCompleted);
      const aiShieldUsed = Boolean(item.aiShieldUsed);
      const mazeShieldUsed = Boolean(item.mazeShieldUsed);
      const isAIHandled = aiCompleted || aiShieldUsed;
      const isMazeHandled = mazeCompleted || mazeShieldUsed;
      const completed = (isAIHandled && isMazeHandled) || Boolean(item.rescuedBy);

      return {
        day: item.day || idx + 1,
        aiCompleted,
        aiCompletedDate: item.aiCompletedDate,
        mazeCompleted,
        mazeCompletedDate: item.mazeCompletedDate,
        aiShieldUsed,
        mazeShieldUsed,
        rescuedBy: item.rescuedBy,
        rescueNote: item.rescueNote,
        completed,
        completedDate: item.completedDate
      };
    });
  }

  function saveStoredHabits(list: any[]) {
    localStorage.setItem(HABIT_STORAGE_KEY, JSON.stringify(list));
    pushDataToFirebase({ habit21: list, lastUpdatedBy: 'HabitTracker' }).catch(() => {});
  }

  function getDayCalendarInfo(startDateStr: string, dayNumber: number) {
    try {
      const [y, m, d] = startDateStr.split('-').map(Number);
      const date = new Date(y, m - 1, d);
      date.setDate(date.getDate() + (dayNumber - 1));

      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      const iso = `${year}-${month}-${day}`;
      const shortDisplay = `${day}/${month}`;
      const fullDisplay = `${day}/${month}/${year}`;

      const dayNames = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
      const dayOfWeek = dayNames[date.getDay()];

      return {
        iso,
        shortDisplay,
        fullDisplay,
        dayOfWeek,
        headingDate: `${dayOfWeek}, ${fullDisplay}`
      };
    } catch {
      return {
        iso: '',
        shortDisplay: `N+${dayNumber}`,
        fullDisplay: `Ngày ${dayNumber}`,
        dayOfWeek: '',
        headingDate: `Ngày ${dayNumber}`
      };
    }
  }

  function getTodayIso(): string {
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth() + 1).padStart(2, '0');
    const d = String(now.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }

  let currentSelectedDay = 1;
  let hasUserManuallySelectedDay = false;

  function renderHabitUI() {
    const targetDays = getStoredTargetDays();
    const list: any[] = getStoredHabits(targetDays).slice(0, targetDays);
    const startDate = getStoredStartDate();
    const isStartDateLocked = getStoredStartDateLocked();
    const shields = getStoredShields();
    const todayIso = getTodayIso();

    const startDayInfo = getDayCalendarInfo(startDate, 1);
    const endDayInfo = getDayCalendarInfo(startDate, targetDays);

    document.querySelectorAll('.milestone-tab-btn').forEach((btn: any) => {
      const btnDays = Number(btn.getAttribute('data-days'));
      btn.classList.toggle('is-active', btnDays === targetDays);
    });

    const milestones = (window as any).__HABIT_MILESTONES__ || [];
    const activeMilestone = milestones.find((m: any) => m.days === targetDays) || milestones[0];
    const descBoxIcon = document.getElementById('milestone-info-icon');
    const descBoxText = document.getElementById('milestone-info-text');

    if (descBoxIcon && activeMilestone) descBoxIcon.textContent = activeMilestone.icon;
    if (descBoxText && activeMilestone) {
      descBoxText.innerHTML = `<strong>${activeMilestone.badge} (${activeMilestone.days} Ngày):</strong> ${activeMilestone.description}`;
    }

    const inputStartDate = document.getElementById('habit-start-date-input') as HTMLInputElement | null;
    const saveStartDateBtn = document.getElementById('btn-save-start-date');
    const toggleStartLockBtn = document.getElementById('btn-toggle-start-lock');
    const quickPresetsContainer = document.getElementById('quick-presets-container');
    const datePickerRow = document.getElementById('date-picker-control-row');
    const lockBadge = document.getElementById('habit-start-lock-badge');

    if (inputStartDate) {
      inputStartDate.disabled = isStartDateLocked;
      if (inputStartDate.value !== startDate) {
        inputStartDate.value = startDate;
      }
    }

    if (datePickerRow) {
      datePickerRow.classList.toggle('is-locked', isStartDateLocked);
    }

    if (quickPresetsContainer) {
      quickPresetsContainer.style.display = isStartDateLocked ? 'none' : 'flex';
    }

    if (saveStartDateBtn) {
      saveStartDateBtn.style.display = isStartDateLocked ? 'none' : 'inline-flex';
    }

    if (lockBadge) {
      if (isStartDateLocked) {
        lockBadge.className = 'badge-love badge-locked-schedule';
        lockBadge.innerHTML = '🔒 Lịch trình đã niêm phong';
      } else {
        lockBadge.className = 'badge-love badge-editing-schedule';
        lockBadge.innerHTML = '✏️ Đang mở chỉnh sửa';
      }
    }

    if (toggleStartLockBtn) {
      if (isStartDateLocked) {
        toggleStartLockBtn.innerHTML = '<span>🔓 Mở Khóa Đổi Ngày</span>';
        toggleStartLockBtn.title = 'Bấm để mở khóa ô chọn ngày bắt đầu';
      } else {
        toggleStartLockBtn.innerHTML = '<span>🔒 Khóa Cố Định</span>';
        toggleStartLockBtn.title = 'Bấm để niêm phong cố định ngày bắt đầu';
      }
    }

    const displayStartEl = document.getElementById('display-start-date');
    const displayEndEl = document.getElementById('display-end-date');
    const displayEndLabel = document.getElementById('display-end-label');
    const displayCalendarProgress = document.getElementById('display-calendar-progress');
    const habitTodayPill = document.getElementById('habit-today-pill');

    if (displayStartEl) displayStartEl.textContent = startDayInfo.fullDisplay;
    if (displayEndEl) displayEndEl.textContent = endDayInfo.fullDisplay;
    if (displayEndLabel) displayEndLabel.textContent = `Ngày ${targetDays} (Về đích):`;

    let todayDayNum: number | null = null;
    for (let i = 1; i <= targetDays; i++) {
      const dInfo = getDayCalendarInfo(startDate, i);
      if (dInfo.iso === todayIso) {
        todayDayNum = i;
        break;
      }
    }

    if (!hasUserManuallySelectedDay && todayDayNum !== null) {
      currentSelectedDay = todayDayNum;
    } else if (currentSelectedDay > targetDays) {
      currentSelectedDay = targetDays;
    }

    if (habitTodayPill) {
      const [ty, tm, td] = todayIso.split('-');
      const formattedToday = `${td}/${tm}/${ty}`;
      if (todayDayNum !== null) {
        habitTodayPill.innerHTML = `✨ Hôm nay: <strong>${formattedToday} (Ngày ${todayDayNum}/${targetDays})</strong>`;
      } else {
        habitTodayPill.innerHTML = `✨ Hôm nay: <strong>${formattedToday}</strong>`;
      }
    }

    if (displayCalendarProgress) {
      if (todayDayNum !== null) {
        displayCalendarProgress.textContent = `Hôm nay là Ngày ${todayDayNum}/${targetDays} 🚀`;
      } else if (todayIso < startDayInfo.iso) {
        displayCalendarProgress.textContent = `Chưa đến ngày bắt đầu (sắp khởi hành!) ⏳`;
      } else {
        displayCalendarProgress.textContent = `Đã qua mốc ${targetDays} ngày 🎉`;
      }
    }

    const completedCount = list.filter((d) => d.completed).length;
    const aiCount = list.filter((d) => d.aiCompleted || d.aiShieldUsed || d.rescuedBy).length;
    const mazeCount = list.filter((d) => d.mazeCompleted || d.mazeShieldUsed || d.rescuedBy).length;
    const percentage = Math.round((completedCount / targetDays) * 100);

    const completedEl = document.getElementById('habit-stat-completed');
    const totalLabelEl = document.getElementById('habit-stat-total-label');
    const percentEl = document.getElementById('habit-stat-percent');
    const aiStatEl = document.getElementById('habit-stat-ai');
    const mazeStatEl = document.getElementById('habit-stat-maze');
    const progressBar = document.getElementById('habit-progress-bar');
    const aiShieldsEl = document.getElementById('display-ai-shields');
    const mazeShieldsEl = document.getElementById('display-maze-shields');

    if (completedEl) completedEl.innerHTML = `${completedCount}<span class="stat-total" id="habit-stat-total-label">/${targetDays}</span>`;
    if (totalLabelEl) totalLabelEl.textContent = `/${targetDays}`;
    if (percentEl) percentEl.textContent = `${percentage}%`;
    if (aiStatEl) aiStatEl.innerHTML = `${aiCount}<span class="stat-total">/${targetDays}</span>`;
    if (mazeStatEl) mazeStatEl.innerHTML = `${mazeCount}<span class="stat-total">/${targetDays}</span>`;
    if (progressBar) progressBar.style.width = `${percentage}%`;
    if (aiShieldsEl) aiShieldsEl.textContent = `🛡️ AI: ${shields.ai}/2`;
    if (mazeShieldsEl) mazeShieldsEl.textContent = `🛡️ Maze: ${shields.maze}/2`;

    const portalBox = document.getElementById('cosmic-portal-box');
    if (portalBox) {
      if (completedCount >= targetDays && targetDays < 365) {
        portalBox.style.display = 'block';
      } else {
        portalBox.style.display = 'none';
      }
    }

    const strip = document.getElementById('day-selector-strip');
    if (strip) {
      strip.innerHTML = '';
      list.forEach((dayItem) => {
        const dInfo = getDayCalendarInfo(startDate, dayItem.day);
        const isToday = dInfo.iso === todayIso;
        const isLocked = dInfo.iso > todayIso;

        let statusClass = 'is-pending';
        let badgeHtml = '';

        if (isLocked) {
          statusClass = 'is-locked';
          badgeHtml = '<span class="day-lock-badge" title="Chưa đến ngày - Đang khóa 🔒">🔒</span>';
        } else if (dayItem.rescuedBy) {
          statusClass = 'is-rescued';
          badgeHtml = '<span class="day-rescue-badge" title="Đã được học bù / gánh thay">💖</span>';
