</style>

<script>
  import { pushDataToFirebase } from '../lib/firebaseClient';

  const HABIT_STORAGE_KEY = 'couple_habit_21';

  function escapeHtml(str: string): string {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function renderMarkdownToHtml(markdown: string): string {
    if (!markdown) return '';
    const lines = markdown.split('\n');
    const htmlBlocks: string[] = [];
    let currentParagraph: string[] = [];
    let inList = false;
    let listItems: string[] = [];
    let inBlockquote = false;
    let blockquoteLines: string[] = [];

    const formatInline = (text: string) => {
      return text
        .replace(/\*\*(.+?)\*\*/g, '<strong style="color: #fda4af;">$1</strong>')
        .replace(/\*(.+?)\*/g, '<em style="color: #fbcfe8;">$1</em>')
        .replace(/`(.+?)`/g, '<code style="background: rgba(244,63,94,0.15); padding: 2px 6px; border-radius: 4px; color: #fda4af;">$1</code>');
    };

    const flushParagraph = () => {
      if (currentParagraph.length > 0) {
        htmlBlocks.push(`<p class="learn-text" style="margin-bottom: 0.8rem;">${formatInline(currentParagraph.join('<br/>'))}</p>`);
        currentParagraph = [];
      }
    };

    const flushList = () => {
      if (inList && listItems.length > 0) {
        const itemsHtml = listItems.map((it) => `<li style="margin-bottom: 4px; color: #cbd5e1;">${formatInline(it)}</li>`).join('');
        htmlBlocks.push(`<ul style="margin: 0.5rem 0 1rem 1.4rem; padding: 0;">${itemsHtml}</ul>`);
        listItems = [];
        inList = false;
      }
    };

    const flushBlockquote = () => {
      if (inBlockquote && blockquoteLines.length > 0) {
        const quoteContent = blockquoteLines.join('<br/>');
        htmlBlocks.push(`<blockquote style="border-left: 3px solid #fda4af; padding-left: 1rem; margin: 0.8rem 0; font-style: italic; color: #fbcfe8;">${formatInline(quoteContent)}</blockquote>`);
        blockquoteLines = [];
        inBlockquote = false;
      }
    };

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i].trim();

      if (!line) {
        flushParagraph();
        flushList();
        flushBlockquote();
        continue;
      }

      if (line.startsWith('### ')) {
        flushParagraph();
        flushList();
        flushBlockquote();
        htmlBlocks.push(`<h4 style="font-size: 1.1rem; color: #fda4af; margin: 1rem 0 0.4rem;">${formatInline(escapeHtml(line.slice(4)))}</h4>`);
        continue;
      }

      if (line.startsWith('>')) {
        flushParagraph();
        flushList();
        inBlockquote = true;
        blockquoteLines.push(escapeHtml(line.replace(/^>\s*/, '')));
        continue;
      } else if (inBlockquote) {
        flushBlockquote();
      }

      if (line.startsWith('- ') || line.startsWith('* ')) {
        flushParagraph();
        flushBlockquote();
        inList = true;
        listItems.push(escapeHtml(line.slice(2)));
        continue;
      } else if (inList) {
        flushList();
      }

      currentParagraph.push(escapeHtml(line));
    }

    flushParagraph();
    flushList();
    flushBlockquote();

    return htmlBlocks.join('\n');
  }

  function getStoredHabits() {
    try {
      const stored = localStorage.getItem(HABIT_STORAGE_KEY);
      if (stored) return JSON.parse(stored);
    } catch {}
    const initial = (window as any).__INITIAL_HABIT_21__ || [];
    localStorage.setItem(HABIT_STORAGE_KEY, JSON.stringify(initial));
    return initial;
  }

  function saveStoredHabits(list: any[]) {
    localStorage.setItem(HABIT_STORAGE_KEY, JSON.stringify(list));
    pushDataToFirebase({ habit21: list, lastUpdatedBy: 'HabitTracker' }).catch(() => {});
  }

  let currentSelectedDay = 1;
  let activeFocusTextarea: HTMLTextAreaElement | null = null;

  function renderHabitUI() {
    const list: any[] = getStoredHabits();
    const totalDays = 21;
    const completedCount = list.filter((d) => d.completed).length;
    const percentage = Math.round((completedCount / totalDays) * 100);

    // Update Overview Stats
    const completedEl = document.getElementById('habit-stat-completed');
    const percentEl = document.getElementById('habit-stat-percent');
    const remainingEl = document.getElementById('habit-stat-remaining');
    const progressBar = document.getElementById('habit-progress-bar');

    if (completedEl) completedEl.innerHTML = `${completedCount}<span class="stat-total">/${totalDays}</span>`;
    if (percentEl) percentEl.textContent = `${percentage}%`;
    if (remainingEl) remainingEl.textContent = `${totalDays - completedCount}`;
    if (progressBar) progressBar.style.width = `${percentage}%`;

    // Render 21 Constellation Node Buttons
    const strip = document.getElementById('day-selector-strip');
    if (strip) {
      strip.innerHTML = '';
      list.forEach((dayItem) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `day-node-btn ${dayItem.completed ? 'is-completed' : 'is-pending'} ${dayItem.day === currentSelectedDay ? 'is-active' : ''}`;
        btn.setAttribute('data-day', String(dayItem.day));
        btn.title = `Ngày ${dayItem.day}: ${dayItem.completed ? 'Đã hoàn thành' : 'Chờ hoàn thành'}`;
        btn.innerHTML = `
          <span class="day-num">${dayItem.day}</span>
          ${dayItem.completed ? '<span class="day-star-badge">★</span>' : ''}
        `;

        btn.addEventListener('click', () => {
          currentSelectedDay = dayItem.day;
          renderHabitUI();
        });

        strip.appendChild(btn);
      });
    }

    // Render Active Panel Detail
    const panel = document.getElementById('active-day-panel');
    const dayData = list.find((d) => d.day === currentSelectedDay) || list[0];
    if (!panel || !dayData) return;

    const formattedCompletedDate = dayData.completedDate
      ? dayData.completedDate.split('-').reverse().join('/')
      : 'Ghi nhận';

    let vocabHtml = '';
    if (dayData.keyVocabulary && dayData.keyVocabulary.length > 0) {
      const chips = dayData.keyVocabulary
        .map(
          (v: any) => `
          <div class="vocab-chip">
            <span class="vocab-word">${escapeHtml(v.word)}</span>
            <span class="vocab-meaning">${escapeHtml(v.meaning)}</span>
            ${v.example ? `<span class="vocab-example">"${escapeHtml(v.example)}"</span>` : ''}
          </div>
        `
        )
        .join('');

      vocabHtml = `
        <div class="vocab-section-wrap">
          <h4 class="vocab-title"><span>📖</span> Từ Vựng Tâm Đắc Của Ngày ${dayData.day}</h4>
          <div class="vocab-chips-grid">${chips}</div>
        </div>
      `;
    }

    const mazeRendered = renderMarkdownToHtml(dayData.mazeLearned) || '<p class="learn-text" style="color: #64748b; font-style: italic;">Maze chưa có ghi chép cho ngày này...</p>';
    const aiRendered = renderMarkdownToHtml(dayData.aiLearned) || '<p class="learn-text" style="color: #64748b; font-style: italic;">AI chưa có ghi chép cho ngày này...</p>';

    panel.innerHTML = `
      <div class="panel-header-row">
        <div class="panel-title-area">
          <span class="badge-love ${dayData.completed ? 'badge-green' : 'badge-gold'}" style="align-self: flex-start;">
            ${dayData.completed ? `✓ Đã Hoàn Thành (${formattedCompletedDate})` : '⏳ Đang Chờ Hoàn Thành'}
          </span>
          <h3 class="day-heading">
            <span class="day-prefix">Ngày ${dayData.day}:</span> ${escapeHtml(dayData.title)}
          </h3>
          <p class="day-theme-label">Chủ đề: <strong>${escapeHtml(dayData.theme)}</strong></p>
        </div>

        <div class="panel-actions-group">
          <button type="button" class="btn-card-action btn-toggle-day-status btn-outline-love" id="btn-toggle-day">
            ${dayData.completed ? '★ Bỏ đánh dấu' : '★ Đánh dấu hoàn thành'}
          </button>
          <button type="button" class="btn-love btn-edit-day" id="btn-open-edit-day">
            ✏️ Ghi Chép Bài Học
          </button>
        </div>
      </div>

      <div class="learning-columns-grid">
        <div class="partner-learn-box maze-box">
          <div class="box-header">
            <span class="partner-learn-avatar">🌸</span>
            <div class="box-title-wrap">
              <h4 class="partner-learn-title">Maze Đã Học Hôm Nay</h4>
              <span class="partner-learn-sub">Ghi chép của Nàng Tinh Cầu</span>
            </div>
          </div>
          <div class="learn-body-content">
            ${mazeRendered}
          </div>
        </div>

        <div class="partner-learn-box ai-box">
          <div class="box-header">
            <span class="partner-learn-avatar">🚀</span>
            <div class="box-title-wrap">
              <h4 class="partner-learn-title">AI Đã Học Hôm Nay</h4>
              <span class="partner-learn-sub">Ghi chép của Chàng Kỹ Sư</span>
            </div>
          </div>
          <div class="learn-body-content">
            ${aiRendered}
          </div>
        </div>
      </div>

      ${vocabHtml}

      ${
        dayData.romanticNote
          ? `
        <div class="romantic-note-box">
          <div class="romantic-note-quote-icon">💌</div>
          <div class="romantic-note-content">
            <p class="romantic-note-title">Lời Nhắn Gửi Yêu Thương:</p>
            <p class="romantic-note-text">"${escapeHtml(dayData.romanticNote)}"</p>
          </div>
        </div>
      `
          : ''
      }
    `;

    // Toggle button event
    const toggleBtn = panel.querySelector('#btn-toggle-day');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        dayData.completed = !dayData.completed;
        if (dayData.completed && !dayData.completedDate) {
          dayData.completedDate = new Date().toISOString().slice(0, 10);
        }
        saveStoredHabits(list);
        renderHabitUI();
      });
    }

    // Open Edit Modal event
    const openEditBtn = panel.querySelector('#btn-open-edit-day');
    if (openEditBtn) {
      openEditBtn.addEventListener('click', () => openHabitModal(dayData));
    }
  }

  // =========================================================================
  // HABIT ZEN STUDIO MODAL CONTROLS
  // =========================================================================
  function setHabitStudioViewMode(mode: 'editor' | 'preview') {
    const workspace = document.getElementById('habit-studio-workspace');
    const editorCol = document.getElementById('habit-workspace-editor-col');
    const previewCol = document.getElementById('habit-workspace-preview-col');
    const editorBtn = document.getElementById('btn-habit-mode-editor');
    const previewBtn = document.getElementById('btn-habit-mode-preview');

    if (editorBtn && previewBtn) {
      if (mode === 'preview') {
        editorBtn.classList.remove('is-active');
        previewBtn.classList.add('is-active');
      } else {
        editorBtn.classList.add('is-active');
        previewBtn.classList.remove('is-active');
      }
    }

    if (workspace) {
      workspace.classList.remove('mode-editor', 'mode-preview');
      workspace.classList.add(`mode-${mode}`);
    }

    if (editorCol && previewCol) {
      if (mode === 'preview') {
        editorCol.style.display = 'none';
        previewCol.style.display = 'block';
        updateHabitLivePreview();
      } else {
        editorCol.style.display = 'block';
        previewCol.style.display = 'none';
      }
    }
  }

  function updateHabitLivePreview() {
    const previewBox = document.getElementById('habit-live-preview');
    const wordCountEl = document.getElementById('habit-word-count');
    if (!previewBox) return;

    const dayNum = (document.getElementById('form-day-num') as HTMLInputElement)?.value || '1';
    const title = (document.getElementById('form-day-title') as HTMLTextAreaElement)?.value.trim() || `Ngày ${dayNum}`;
    const theme = (document.getElementById('form-day-theme') as HTMLInputElement)?.value.trim() || 'Chủ đề bài học';
    const author = (document.getElementById('form-habit-author') as HTMLSelectElement)?.value || 'both';
    const isCompleted = (document.getElementById('form-day-completed') as HTMLInputElement)?.checked;
    const completedDate = (document.getElementById('form-day-completed-date') as HTMLInputElement)?.value;
    const mazeText = (document.getElementById('form-maze-learned') as HTMLTextAreaElement)?.value || '';
    const aiText = (document.getElementById('form-ai-learned') as HTMLTextAreaElement)?.value || '';
    const vocabRaw = (document.getElementById('form-day-vocab') as HTMLTextAreaElement)?.value || '';
    const romanticNote = (document.getElementById('form-romantic-note') as HTMLTextAreaElement)?.value || '';

    // Word counter
    const totalWords = `${mazeText} ${aiText} ${romanticNote}`.trim()
      ? `${mazeText} ${aiText} ${romanticNote}`.trim().split(/\s+/).length
      : 0;
    if (wordCountEl) wordCountEl.textContent = `${totalWords} từ`;

    // Process Vocab
    let vocabChipsHtml = '';
    if (vocabRaw.trim()) {
      const lines = vocabRaw.trim().split('\n');
      const chips = lines
        .map((line) => {
          const parts = line.split('-').map((p) => p.trim());
          if (!parts[0]) return '';
          return `
            <div class="vocab-chip">
              <span class="vocab-word">${escapeHtml(parts[0])}</span>
              <span class="vocab-meaning">${escapeHtml(parts[1] || '')}</span>
              ${parts[2] ? `<span class="vocab-example">"${escapeHtml(parts[2])}"</span>` : ''}
            </div>
          `;
        })
        .filter(Boolean)
        .join('');
      if (chips) {
        vocabChipsHtml = `
          <div class="vocab-section-wrap" style="margin-top: 1.5rem;">
            <h4 class="vocab-title"><span>📖</span> Từ Vựng Tâm Đắc</h4>
            <div class="vocab-chips-grid">${chips}</div>
          </div>
        `;
      }
    }

    let authorBadge = '✍️ Cả hai đứa cùng chắp bút 💖';
    if (author === 'maze') authorBadge = '✍️ Chắp bút bởi Maze 🌸';
    else if (author === 'ai') authorBadge = '✍️ Chắp bút bởi AI 🚀';

    previewBox.innerHTML = `
      <div style="border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 1rem; margin-bottom: 1.5rem;">
        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 0.6rem; align-items: center;">
          <span class="journal-pill" style="font-size: 0.78rem; padding: 3px 12px; background: rgba(244,63,94,0.15); color: #fda4af;">🗓️ Ngày ${dayNum} / 21</span>
          <span class="journal-pill" style="font-size: 0.78rem; padding: 3px 12px; border-color: rgba(255,255,255,0.2);">${authorBadge}</span>
          ${isCompleted ? `<span class="journal-pill" style="font-size: 0.78rem; padding: 3px 12px; background: rgba(34,197,94,0.15); color: #86efac;">✓ Hoàn thành ${completedDate ? `(${completedDate})` : ''}</span>` : '<span class="journal-pill" style="font-size: 0.78rem; padding: 3px 12px; color: #fbbf24;">⏳ Đang học</span>'}
        </div>
        <h2 style="font-size: 1.8rem; font-weight: 800; color: #ffffff; margin: 0 0 0.3rem;" class="gradient-love-text">${escapeHtml(title)}</h2>
        <p style="color: #38bdf8; font-size: 0.95rem; margin: 0; font-weight: 600;">Chủ đề: ${escapeHtml(theme)}</p>
      </div>

      <div class="learning-columns-grid">
        <div class="partner-learn-box maze-box">
          <div class="box-header">
            <span class="partner-learn-avatar">🌸</span>
            <div class="box-title-wrap">
              <h4 class="partner-learn-title">Maze Đã Học</h4>
              <span class="partner-learn-sub">Ghi chép của Nàng Tinh Cầu</span>
            </div>
          </div>
          <div class="learn-body-content">
            ${renderMarkdownToHtml(mazeText) || '<p class="learn-text" style="color: #64748b; font-style: italic;">Chưa có ghi chép...</p>'}
          </div>
        </div>

        <div class="partner-learn-box ai-box">
          <div class="box-header">
            <span class="partner-learn-avatar">🚀</span>
            <div class="box-title-wrap">
              <h4 class="partner-learn-title">AI Đã Học</h4>
              <span class="partner-learn-sub">Ghi chép của Chàng Kỹ Sư</span>
            </div>
          </div>
          <div class="learn-body-content">
            ${renderMarkdownToHtml(aiText) || '<p class="learn-text" style="color: #64748b; font-style: italic;">Chưa có ghi chép...</p>'}
          </div>
        </div>
      </div>

      ${vocabChipsHtml}

      ${
        romanticNote
          ? `
        <div class="romantic-note-box" style="margin-top: 1.5rem;">
          <div class="romantic-note-quote-icon">💌</div>
          <div class="romantic-note-content">
            <p class="romantic-note-title">Lời Nhắn Gửi Yêu Thương:</p>
            <p class="romantic-note-text">"${escapeHtml(romanticNote)}"</p>
          </div>
        </div>
      `
          : ''
      }
    `;
  }

  function insertHabitMarkdown(prefix: string, suffix = '', defaultText = '') {
    const targetTextarea = activeFocusTextarea || (document.getElementById('form-maze-learned') as HTMLTextAreaElement);
    if (!targetTextarea) return;

    const start = targetTextarea.selectionStart;
    const end = targetTextarea.selectionEnd;
    const selectedText = targetTextarea.value.substring(start, end);
    const replacement = selectedText ? `${prefix}${selectedText}${suffix}` : `${prefix}${defaultText}${suffix}`;

    targetTextarea.setRangeText(replacement, start, end, 'select');
    targetTextarea.focus();

    if (!selectedText && defaultText) {
      targetTextarea.setSelectionRange(start + prefix.length, start + prefix.length + defaultText.length);
    }
    updateHabitLivePreview();
  }

  function insertHabitEmoji(emoji: string) {
    const targetTextarea = activeFocusTextarea || (document.getElementById('form-maze-learned') as HTMLTextAreaElement);
    if (!targetTextarea) return;

    const start = targetTextarea.selectionStart;
    const end = targetTextarea.selectionEnd;
    targetTextarea.setRangeText(` ${emoji} `, start, end, 'end');
    targetTextarea.focus();
    updateHabitLivePreview();
  }

  function openHabitModal(dayData: any) {
    const modal = document.getElementById('habit-edit-modal');
    const dayBadge = document.getElementById('habit-cover-day-badge');
    const pillDayText = document.getElementById('habit-pill-day-text');
    if (!modal) return;

    if (dayBadge) dayBadge.textContent = `⭐ Chặng Học Ngày ${dayData.day} / 21`;
    if (pillDayText) pillDayText.textContent = `Ngày ${dayData.day} / 21`;

    (document.getElementById('form-day-num') as HTMLInputElement).value = String(dayData.day);
    (document.getElementById('form-day-title') as HTMLTextAreaElement).value = dayData.title || '';
    (document.getElementById('form-day-theme') as HTMLInputElement).value = dayData.theme || '';
    (document.getElementById('form-day-completed') as HTMLInputElement).checked = !!dayData.completed;
    (document.getElementById('form-day-completed-date') as HTMLInputElement).value = dayData.completedDate || '';
    (document.getElementById('form-maze-learned') as HTMLTextAreaElement).value = dayData.mazeLearned || '';
    (document.getElementById('form-ai-learned') as HTMLTextAreaElement).value = dayData.aiLearned || '';
    (document.getElementById('form-romantic-note') as HTMLTextAreaElement).value = dayData.romanticNote || '';

    // Vocab string
    const vocabStr = (dayData.keyVocabulary || [])
      .map((v: any) => `${v.word} - ${v.meaning}${v.example ? ` - ${v.example}` : ''}`)
      .join('\n');
    (document.getElementById('form-day-vocab') as HTMLTextAreaElement).value = vocabStr;

    toggleHabitCompletedDateRow(!!dayData.completed);
    setHabitStudioViewMode('editor');
    updateHabitLivePreview();
    modal.classList.add('is-open');
  }

  function toggleHabitCompletedDateRow(show: boolean) {
    const row = document.getElementById('group-day-completed-date');
    if (row) row.style.display = show ? 'inline-flex' : 'none';
  }

  function initHabitInteractive() {
    const modal = document.getElementById('habit-edit-modal');
    const closeBtn = document.getElementById('habit-modal-close');
    const cancelBtn = document.getElementById('btn-cancel-habit');

    if (closeBtn && modal) closeBtn.addEventListener('click', () => modal.classList.remove('is-open'));
    if (cancelBtn && modal) cancelBtn.addEventListener('click', () => modal.classList.remove('is-open'));
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.remove('is-open');
      });
    }

    // Track active textarea focus
    const textareas = ['form-maze-learned', 'form-ai-learned', 'form-day-vocab', 'form-romantic-note'];
    textareas.forEach((id) => {
      const el = document.getElementById(id) as HTMLTextAreaElement | null;
      if (el) {
        el.addEventListener('focus', () => {
          activeFocusTextarea = el;
        });
        el.addEventListener('input', updateHabitLivePreview);
      }
    });

    const liveInputs = ['form-day-title', 'form-day-theme', 'form-habit-author', 'form-day-completed-date'];
    liveInputs.forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', updateHabitLivePreview);
        el.addEventListener('change', updateHabitLivePreview);
      }
    });

    // Author selector visual focus
    const authorSelect = document.getElementById('form-habit-author') as HTMLSelectElement | null;
    const mazePaneWrap = document.getElementById('pane-maze-learned-wrap');
    const aiPaneWrap = document.getElementById('pane-ai-learned-wrap');
    if (authorSelect) {
      authorSelect.addEventListener('change', () => {
        const val = authorSelect.value;
        if (mazePaneWrap && aiPaneWrap) {
          if (val === 'maze') {
            mazePaneWrap.style.borderColor = '#f43f5e';
            aiPaneWrap.style.borderColor = 'rgba(255, 255, 255, 0.1)';
            (document.getElementById('form-maze-learned') as HTMLTextAreaElement)?.focus();
          } else if (val === 'ai') {
            aiPaneWrap.style.borderColor = '#38bdf8';
            mazePaneWrap.style.borderColor = 'rgba(255, 255, 255, 0.1)';
            (document.getElementById('form-ai-learned') as HTMLTextAreaElement)?.focus();
          } else {
            mazePaneWrap.style.borderColor = 'rgba(255, 255, 255, 0.1)';
            aiPaneWrap.style.borderColor = 'rgba(255, 255, 255, 0.1)';
          }
        }
        updateHabitLivePreview();
      });
    }

    // View mode switch
    const editorBtn = document.getElementById('btn-habit-mode-editor');
    const previewBtn = document.getElementById('btn-habit-mode-preview');
    if (editorBtn) editorBtn.addEventListener('click', () => setHabitStudioViewMode('editor'));
    if (previewBtn) previewBtn.addEventListener('click', () => setHabitStudioViewMode('preview'));

    // Markdown Toolbar actions
    const toolbarTools = document.querySelectorAll('.zen-tb-btn');
    toolbarTools.forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const action = btn.getAttribute('data-action');
        switch (action) {
          case 'bold':
            insertHabitMarkdown('**', '**', 'từ quan trọng');
            break;
          case 'italic':
            insertHabitMarkdown('*', '*', 'chữ in nghiêng');
            break;
          case 'h3':
            insertHabitMarkdown('\n### ', '\n', 'Điểm ngữ pháp hôm nay');
            break;
          case 'quote':
            insertHabitMarkdown('\n> "', '"\n', 'Câu nói tâm đắc...');
            break;
          case 'poem':
            insertHabitMarkdown('\n> 📜 Khổ thơ:\n> ', '\n', 'Dòng 1...\n> Dòng 2...');
            break;
          case 'vocab':
            insertHabitMarkdown('\n- **', '**: Nghĩa - "Example sentence"\n', 'Vocabulary');
            break;
          case 'list':
            insertHabitMarkdown('\n- ', '\n', 'Nội dung đã học');
            break;
        }
      });
    });

    // Emoji buttons
    const emojiBtns = document.querySelectorAll('.zen-emoji-btn');
    emojiBtns.forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const emoji = btn.getAttribute('data-emoji') || '';
        if (emoji) insertHabitEmoji(emoji);
      });
    });

    // Completed Checkbox
    const completedCheck = document.getElementById('form-day-completed') as HTMLInputElement | null;
    if (completedCheck) {
      completedCheck.addEventListener('change', () => {
        toggleHabitCompletedDateRow(completedCheck.checked);
        const dateInput = document.getElementById('form-day-completed-date') as HTMLInputElement | null;
        if (completedCheck.checked && dateInput && !dateInput.value) {
          dateInput.value = new Date().toISOString().slice(0, 10);
        }
        updateHabitLivePreview();
      });
    }

    // Form submit
    const form = document.getElementById('habit-edit-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const dayNum = parseInt((document.getElementById('form-day-num') as HTMLInputElement).value, 10);
        const title = (document.getElementById('form-day-title') as HTMLTextAreaElement).value.trim();
        const theme = (document.getElementById('form-day-theme') as HTMLInputElement).value.trim();
        const completed = (document.getElementById('form-day-completed') as HTMLInputElement).checked;
        const completedDate = (document.getElementById('form-day-completed-date') as HTMLInputElement).value;
        const mazeLearned = (document.getElementById('form-maze-learned') as HTMLTextAreaElement).value.trim();
        const aiLearned = (document.getElementById('form-ai-learned') as HTMLTextAreaElement).value.trim();
        const romanticNote = (document.getElementById('form-romantic-note') as HTMLTextAreaElement).value.trim();
        const vocabRaw = (document.getElementById('form-day-vocab') as HTMLTextAreaElement).value.trim();

        const keyVocabulary: any[] = [];
        if (vocabRaw) {
          vocabRaw.split('\n').forEach((line) => {
            const parts = line.split('-').map((p) => p.trim());
            if (parts[0]) {
              keyVocabulary.push({
                word: parts[0],
                meaning: parts[1] || '',
                example: parts[2] || undefined
              });
            }
          });
        }

        const list: any[] = getStoredHabits();
        const idx = list.findIndex((d) => d.day === dayNum);
        if (idx !== -1) {
          list[idx] = {
            ...list[idx],
            title,
            theme,
            completed,
            completedDate: completed ? completedDate : undefined,
            mazeLearned,
            aiLearned,
            romanticNote,
            keyVocabulary
          };
          saveStoredHabits(list);
          renderHabitUI();
          if (modal) modal.classList.remove('is-open');
        }
      });
    }

    // Listen for Realtime Cloud Updates from Firebase
    window.addEventListener('couple-cloud-updated', () => {
      renderHabitUI();
    });

    renderHabitUI();
  }

  initHabitInteractive();
  document.addEventListener('astro:after-swap', initHabitInteractive);
</script>
