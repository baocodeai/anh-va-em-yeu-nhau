---
import { COUPLE_CONFIG } from '../couple.config';

const { boysInfo, girlsInfo, anniversaryDate, loveDeclaration } = COUPLE_CONFIG;
---

<div class="love-counter-container romantic-card" id="love-counter-box">
  <div class="couple-avatars-row">
    <!-- Boy Avatar: AI -->
    <div class="partner-avatar-wrap">
      <div class="avatar-ring avatar-ring-ai">
        <img
          id="avatar-img-ai"
          src={boysInfo.avatar}
          alt={boysInfo.name}
          class="avatar-img"
          width="180"
          height="180"
          loading="eager"
        />
        <button type="button" class="avatar-edit-overlay-btn" id="btn-edit-avatar-ai" title="Đổi ảnh đại diện AI">
          📷
        </button>
      </div>
      <div class="partner-info-mini">
        <span class="partner-name gradient-cyan-text">{boysInfo.name}</span>
        <span class="partner-tagline">{boysInfo.nickname}</span>
        <span class="partner-bday">🎂 {boysInfo.birthday.split('-').reverse().join('/')}</span>
      </div>
    </div>

    <!-- Center Love Beacon -->
    <div class="love-center-beacon">
      <div class="orbit-container">
        <div class="orbit-ring"></div>
        <div class="orbit-heart animate-heart">
          <svg viewBox="0 0 24 24" width="54" height="54" fill="#f43f5e">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </div>
      </div>
      <div class="anniversary-badge badge-love">
        <span>Từ 15/08/2026</span>
      </div>
    </div>

    <!-- Girl Avatar: Maze -->
    <div class="partner-avatar-wrap">
      <div class="avatar-ring avatar-ring-maze">
        <img
          id="avatar-img-maze"
          src={girlsInfo.avatar}
          alt={girlsInfo.name}
          class="avatar-img"
          width="180"
          height="180"
          loading="eager"
        />
        <button type="button" class="avatar-edit-overlay-btn" id="btn-edit-avatar-maze" title="Đổi ảnh đại diện Maze">
          📷
        </button>
      </div>
      <div class="partner-info-mini">
        <span class="partner-name gradient-rose-text">{girlsInfo.name}</span>
        <span class="partner-tagline">{girlsInfo.nickname}</span>
        <span class="partner-bday">🎂 {girlsInfo.birthday.split('-').reverse().join('/')}</span>
      </div>
    </div>
  </div>

  <!-- Live Counter Display -->
  <div class="timer-section">
    <p class="timer-title">Thời Gian Chúng Mình Đã Cùng Đi Qua</p>
    
    <div class="time-blocks-grid">
      <div class="time-block">
        <span class="time-val" id="days-val">--</span>
        <span class="time-label">Ngày</span>
      </div>
      <span class="time-colon">:</span>
      <div class="time-block">
        <span class="time-val" id="hours-val">--</span>
        <span class="time-label">Giờ</span>
      </div>
      <span class="time-colon">:</span>
      <div class="time-block">
        <span class="time-val" id="minutes-val">--</span>
        <span class="time-label">Phút</span>
      </div>
      <span class="time-colon">:</span>
      <div class="time-block">
        <span class="time-val" id="seconds-val">--</span>
        <span class="time-label">Giây</span>
      </div>
    </div>

    <!-- Poetic Quote -->
    <p class="love-declaration-text">
      "{loveDeclaration}"
    </p>
  </div>

  <!-- Birthday Countdowns -->
  <div class="birthday-pill-row">
    <div class="bday-card">
      <span class="bday-icon">🎂</span>
      <div class="bday-text">
        <span class="bday-who">Sinh nhật AI (28/09):</span>
        <span class="bday-count" id="bday-ai-counter">Đang tính...</span>
      </div>
    </div>
    <div class="bday-card">
      <span class="bday-icon">🌸</span>
      <div class="bday-text">
        <span class="bday-who">Sinh nhật Maze (11/12):</span>
        <span class="bday-count" id="bday-maze-counter">Đang tính...</span>
      </div>
    </div>
  </div>

  <!-- Avatar Change Modal -->
  <div class="avatar-modal-overlay" id="avatar-modal" aria-hidden="true">
    <div class="avatar-modal-card romantic-card">
      <div class="avatar-modal-header">
        <h3 class="modal-title gradient-love-text" id="avatar-modal-title">Đổi Ảnh Đại Diện</h3>
        <button type="button" class="modal-close-btn" id="avatar-modal-close">&times;</button>
      </div>

      <div class="avatar-modal-body">
        <p class="avatar-modal-desc">
          Tải ảnh selfie hoặc khoảnh khắc thật của hai bạn từ điện thoại / máy tính:
        </p>

        <!-- Dedicated Image Selection / Dropzone Frame (Avatar Style) -->
        <div class="image-dropzone-box avatar-style-preview" id="avatar-dropzone">
          <input type="file" id="avatar-file-input" class="dropzone-file-input" accept="image/*" />
          
          <div class="dropzone-empty-state" id="avatar-dropzone-empty">
            <div class="dropzone-icon">✨📸</div>
            <p class="dropzone-prompt"><strong>Nhấn để chọn ảnh</strong> hoặc kéo thả ảnh vào khung này</p>
            <span class="dropzone-hint">Khung hiển thị hình tròn tối ưu cho ảnh selfie của AI & Maze</span>
          </div>

          <div class="dropzone-preview-state" id="avatar-dropzone-preview" style="display: none;">
            <div class="avatar-ring" id="avatar-modal-ring">
              <img id="avatar-modal-preview" src="" alt="Avatar Preview" class="avatar-img dropzone-preview-img" />
            </div>
            <div class="dropzone-overlay-actions">
              <label class="btn-dz-action" title="Đổi ảnh khác">
                <span>🔄 Đổi ảnh</span>
                <input type="file" id="btn-change-avatar-file" accept="image/*" style="display: none;" />
              </label>
              <button type="button" class="btn-dz-action btn-dz-remove" id="btn-clear-avatar-photo" title="Xóa ảnh">
                <span>🗑️ Xóa ảnh</span>
              </button>
            </div>
          </div>
        </div>

        <div class="dropzone-url-row">
          <span class="url-row-prefix">🌐 Hoặc dán link:</span>
          <input
            type="text"
            id="avatar-url-input"
            class="form-input flex-1 url-row-input"
            placeholder="Dán link ảnh https://... hoặc /photos/..."
          />
        </div>

        <div class="avatar-modal-actions">
          <button type="button" class="btn-outline-love" id="btn-cancel-avatar">Hủy</button>
          <button type="button" class="btn-love" id="btn-save-avatar">Lưu Ảnh Đại Diện</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .love-counter-container {
    padding: 3.2rem 2.4rem;
    margin: 1.5rem auto 2.5rem;
    max-width: 960px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, rgba(244, 63, 94, 0.22) 0%, rgba(11, 17, 32, 0.9) 75%);
    border-radius: 26px;
  }

  .couple-avatars-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3.2rem;
    flex-wrap: wrap;
    margin-bottom: 2.6rem;
  }

  .partner-avatar-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .avatar-ring {
    position: relative;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .avatar-ring:hover {
    transform: scale(1.06);
  }

  .avatar-ring-ai {
    background: linear-gradient(135deg, #0284c7, #38bdf8, #818cf8);
    box-shadow: 0 0 45px rgba(56, 189, 248, 0.6), 0 0 90px rgba(56, 189, 248, 0.28);
  }

  .avatar-ring-maze {
    background: linear-gradient(135deg, #e11d48, #fb7185, #f472b6);
    box-shadow: 0 0 45px rgba(251, 113, 133, 0.6), 0 0 90px rgba(251, 113, 133, 0.28);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #070a13;
    object-fit: cover;
  }

  .avatar-edit-overlay-btn {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background: rgba(11, 17, 32, 0.95);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.15rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.75);
    transition: transform 0.25s, background 0.25s, box-shadow 0.25s;
  }

  .avatar-edit-overlay-btn:hover {
    transform: scale(1.18);
    background: #f43f5e;
    box-shadow: 0 0 20px rgba(244, 63, 94, 0.85);
  }

  .partner-info-mini {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .partner-name {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .partner-tagline {
    font-size: 0.95rem;
    color: #94a3b8;
  }

  .partner-bday {
    font-size: 0.88rem;
    color: #cbd5e1;
    font-family: var(--mono);
  }

  .love-center-beacon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    padding: 0 0.8rem;
  }

  .orbit-container {
    position: relative;
    width: 104px;
    height: 104px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .orbit-ring {
    position: absolute;
    inset: 0;
    border: 2px dashed rgba(244, 63, 94, 0.45);
    border-radius: 50%;
    animation: rotateOrbit 12s linear infinite;
  }

  .orbit-heart {
    filter: drop-shadow(0 0 22px rgba(244, 63, 94, 0.95));
  }

  @keyframes rotateOrbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .timer-section {
    padding: 1.2rem 0;
  }

  .timer-title {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fda4af;
    font-weight: 600;
    margin-bottom: 1.2rem;
  }

  .time-blocks-grid {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: rgba(7, 10, 19, 0.65);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(244, 63, 94, 0.3);
    border-radius: 16px;
    padding: 1.1rem 1.8rem;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.1);
  }

  .time-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 60px;
  }

  .time-val {
    font-size: 2.3rem;
    font-weight: 800;
    font-family: var(--mono);
    color: #ffffff;
    line-height: 1.1;
    text-shadow: 0 0 18px rgba(251, 113, 133, 0.55);
  }

  .time-label {
    font-size: 0.74rem;
    text-transform: uppercase;
    color: #94a3b8;
    letter-spacing: 0.05em;
    margin-top: 4px;
    font-weight: 600;
  }

  .time-colon {
    font-size: 1.8rem;
    font-weight: 700;
    color: #f43f5e;
    margin-bottom: 1rem;
    animation: blinkColon 1s ease-in-out infinite;
  }

  @keyframes blinkColon {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .love-declaration-text {
    margin: 1.6rem auto 0;
    max-width: 660px;
    font-family: var(--body);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.65;
    color: #cbd5e1;
  }

  .birthday-pill-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.8rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(244, 63, 94, 0.18);
  }

  .bday-card {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(11, 17, 32, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.55rem 1.1rem;
    border-radius: 9999px;
    font-size: 0.86rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }

  .bday-icon {
    font-size: 1.15rem;
  }

  .bday-who {
    color: #94a3b8;
    margin-right: 4px;
  }

  .bday-count {
    color: #fbbf24;
    font-weight: 700;
    font-family: var(--mono);
  }

  /* Modal */
  .avatar-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.2rem;
  }

  .avatar-modal-overlay.is-open {
    display: flex;
    animation: fadeInModal 0.25s ease-out;
  }

  .avatar-modal-card {
    max-width: 480px;
    width: 100%;
    background: #0f172a;
    padding: 1.8rem;
    border: 1px solid rgba(244, 63, 94, 0.4);
  }

  .avatar-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.6rem;
  }

  .avatar-modal-desc {
    font-size: 0.88rem;
    color: #94a3b8;
    margin-bottom: 1.2rem;
  }

  .avatar-preview-center {
    display: flex;
    justify-content: center;
    margin-bottom: 1.4rem;
  }

  .avatar-upload-tools {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .or-separator {
    font-size: 0.8rem;
    color: #64748b;
  }

  .avatar-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
  }

  @media (max-width: 768px) {
    .love-counter-container {
      padding: 2.4rem 1.6rem;
    }
    .avatar-ring {
      width: 145px;
      height: 145px;
    }
    .orbit-container {
      width: 84px;
      height: 84px;
    }
    .couple-avatars-row {
      gap: 1.8rem;
    }
    .partner-name {
      font-size: 1.4rem;
    }
  }

  @media (max-width: 520px) {
    .love-counter-container {
      padding: 2rem 1.1rem;
    }
    .time-blocks-grid {
      padding: 0.8rem 1rem;
      gap: 0.3rem;
    }
    .time-block {
      min-width: 44px;
    }
    .time-val {
      font-size: 1.55rem;
    }
    .avatar-ring {
      width: 115px;
      height: 115px;
      padding: 4px;
    }
    .avatar-edit-overlay-btn {
      width: 34px;
      height: 34px;
      font-size: 0.95rem;
    }
    .orbit-container {
      width: 66px;
      height: 66px;
    }
    .couple-avatars-row {
      gap: 0.9rem;
    }
    .partner-name {
      font-size: 1.25rem;
    }
    .partner-tagline {
      font-size: 0.82rem;
    }
  }
</style>

<script is:inline define:vars={{ anniversaryDate }}>
  function updateLoveTimers() {
    const startDate = new Date(anniversaryDate + 'T00:00:00');
    const now = new Date();

    let diffMs = now.getTime() - startDate.getTime();
    if (diffMs < 0) diffMs = 0;

    const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diffMs / (1000 * 60 * 60)) % 24);
    const minutes = Math.floor((diffMs / (1000 * 60)) % 60);
    const seconds = Math.floor((diffMs / 1000) % 60);

    const pad = (n) => String(n).padStart(2, '0');

    const daysEl = document.getElementById('days-val');
    const hoursEl = document.getElementById('hours-val');
    const minutesEl = document.getElementById('minutes-val');
    const secondsEl = document.getElementById('seconds-val');

    if (daysEl) daysEl.textContent = String(days);
    if (hoursEl) hoursEl.textContent = pad(hours);
    if (minutesEl) minutesEl.textContent = pad(minutes);
    if (secondsEl) secondsEl.textContent = pad(seconds);

    // Birthday countdown
    function calculateNextBirthday(month, day) {
      const currentYear = now.getFullYear();
      let nextBday = new Date(currentYear, month - 1, day, 0, 0, 0);
      if (now.getTime() > nextBday.getTime()) {
        nextBday = new Date(currentYear + 1, month - 1, day, 0, 0, 0);
      }
      const bdiff = nextBday.getTime() - now.getTime();
      const bDays = Math.ceil(bdiff / (1000 * 60 * 60 * 24));
      return bDays === 0 ? 'Hôm nay sinh nhật! 🎉' : `còn ${bDays} ngày nữa`;
    }

    const aiBdayEl = document.getElementById('bday-ai-counter');
    const mazeBdayEl = document.getElementById('bday-maze-counter');

    if (aiBdayEl) aiBdayEl.textContent = calculateNextBirthday(9, 28);
    if (mazeBdayEl) mazeBdayEl.textContent = calculateNextBirthday(12, 11);
  }

  updateLoveTimers();
  setInterval(updateLoveTimers, 1000);
  document.addEventListener('astro:after-swap', updateLoveTimers);
</script>

<script>
  import { pushDataToFirebase } from '../lib/firebaseClient';

  const AVATARS_STORAGE_KEY = 'couple_avatars';

  function getStoredAvatars(): { ai?: string; maze?: string } {
    try {
      const raw = localStorage.getItem(AVATARS_STORAGE_KEY);
      if (raw) return JSON.parse(raw);
    } catch {}
    return {};
  }

  function applyAvatars() {
    const avs = getStoredAvatars();
    const aiImg = document.getElementById('avatar-img-ai') as HTMLImageElement | null;
    const mazeImg = document.getElementById('avatar-img-maze') as HTMLImageElement | null;

    if (aiImg && avs.ai) aiImg.src = avs.ai;
    if (mazeImg && avs.maze) mazeImg.src = avs.maze;
  }

  let editingPerson: 'ai' | 'maze' = 'ai';
  let tempAvatarData = '';

  function updateAvatarDropzonePreview(src: string) {
    const emptyState = document.getElementById('avatar-dropzone-empty');
    const previewState = document.getElementById('avatar-dropzone-preview');
    const preview = document.getElementById('avatar-modal-preview') as HTMLImageElement | null;
    const urlInput = document.getElementById('avatar-url-input') as HTMLInputElement | null;

    if (src) {
      if (preview) preview.src = src;
      if (emptyState) emptyState.style.display = 'none';
      if (previewState) previewState.style.display = 'flex';
      if (urlInput && urlInput.value !== src && !src.startsWith('data:')) {
        urlInput.value = src;
      }
      tempAvatarData = src;
    } else {
      if (preview) preview.src = '';
      if (emptyState) emptyState.style.display = 'flex';
      if (previewState) previewState.style.display = 'none';
      if (urlInput) urlInput.value = '';
      tempAvatarData = '';
    }
  }

  function openAvatarModal(person: 'ai' | 'maze') {
    editingPerson = person;
    const modal = document.getElementById('avatar-modal');
    const title = document.getElementById('avatar-modal-title');
    const ring = document.getElementById('avatar-modal-ring');
    const urlInput = document.getElementById('avatar-url-input') as HTMLInputElement | null;
    if (!modal || !title || !ring) return;

    title.textContent = person === 'ai' ? 'Đổi Ảnh Đại Diện AI 🚀' : 'Đổi Ảnh Đại Diện Maze 🌸';
    ring.className = `avatar-ring ${person === 'ai' ? 'avatar-ring-ai' : 'avatar-ring-maze'}`;

    const currentAvatars = getStoredAvatars();
    const currentSrc = person === 'ai'
      ? (currentAvatars.ai || (document.getElementById('avatar-img-ai') as HTMLImageElement)?.src || '')
      : (currentAvatars.maze || (document.getElementById('avatar-img-maze') as HTMLImageElement)?.src || '');

    updateAvatarDropzonePreview(currentSrc);
    if (urlInput) urlInput.value = '';

    modal.classList.add('is-open');
  }

  function initAvatarChanger() {
    applyAvatars();

    const btnAi = document.getElementById('btn-edit-avatar-ai');
    const btnMaze = document.getElementById('btn-edit-avatar-maze');
    const modal = document.getElementById('avatar-modal');
    const closeBtn = document.getElementById('avatar-modal-close');
    const cancelBtn = document.getElementById('btn-cancel-avatar');
    const saveBtn = document.getElementById('btn-save-avatar');
    const fileInput = document.getElementById('avatar-file-input') as HTMLInputElement | null;
    const changeFileBtn = document.getElementById('btn-change-avatar-file') as HTMLInputElement | null;
    const urlInput = document.getElementById('avatar-url-input') as HTMLInputElement | null;
    const clearPhotoBtn = document.getElementById('btn-clear-avatar-photo');
    const dropzone = document.getElementById('avatar-dropzone');

    if (btnAi) btnAi.addEventListener('click', () => openAvatarModal('ai'));
    if (btnMaze) btnMaze.addEventListener('click', () => openAvatarModal('maze'));

    if (closeBtn && modal) closeBtn.addEventListener('click', () => modal.classList.remove('is-open'));
    if (cancelBtn && modal) cancelBtn.addEventListener('click', () => modal.classList.remove('is-open'));
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.remove('is-open');
      });
    }

    const handleFile = (file: File) => {
      if (!file || !file.type.startsWith('image/')) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        const result = event.target?.result as string;
        updateAvatarDropzonePreview(result);
      };
      reader.readAsDataURL(file);
    };

    if (fileInput) {
      fileInput.addEventListener('change', (e: any) => {
        const file = e.target.files?.[0];
        if (file) handleFile(file);
      });
    }

    if (changeFileBtn) {
      changeFileBtn.addEventListener('change', (e: any) => {
        const file = e.target.files?.[0];
        if (file) handleFile(file);
      });
    }

    if (dropzone) {
      ['dragenter', 'dragover'].forEach((evt) => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('is-dragover');
        });
      });

      ['dragleave', 'drop'].forEach((evt) => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('is-dragover');
        });
      });

      dropzone.addEventListener('drop', (e: any) => {
        const file = e.dataTransfer?.files?.[0];
        if (file) handleFile(file);
      });
    }

    if (urlInput) {
      urlInput.addEventListener('input', () => {
        const val = urlInput.value.trim();
        if (val) {
          updateAvatarDropzonePreview(val);
        }
      });
    }

    if (clearPhotoBtn) {
      clearPhotoBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (fileInput) fileInput.value = '';
        if (changeFileBtn) changeFileBtn.value = '';
        if (urlInput) urlInput.value = '';
        updateAvatarDropzonePreview('');
      });
    }

    if (saveBtn && modal) {
      saveBtn.addEventListener('click', async () => {
        if (!tempAvatarData) {
          modal.classList.remove('is-open');
          return;
        }

        const avs = getStoredAvatars();
        if (editingPerson === 'ai') avs.ai = tempAvatarData;
        if (editingPerson === 'maze') avs.maze = tempAvatarData;

        localStorage.setItem(AVATARS_STORAGE_KEY, JSON.stringify(avs));
        applyAvatars();

        // Push to Firebase Realtime
        pushDataToFirebase({ avatars: avs, lastUpdatedBy: editingPerson }).catch(() => {});

        modal.classList.remove('is-open');
      });
    }

    // Realtime update listener from Firebase
    window.addEventListener('couple-cloud-updated', (e: any) => {
      const cloudData = e.detail;
      if (cloudData && cloudData.avatars) {
        localStorage.setItem(AVATARS_STORAGE_KEY, JSON.stringify(cloudData.avatars));
        applyAvatars();
      }
    });
  }

  initAvatarChanger();
  document.addEventListener('astro:after-swap', initAvatarChanger);
</script>
