<script is:inline define:vars={{ anniversaryDate }}>
  function updateLoveTimers() {
    const startDate = new Date(anniversaryDate + 'T00:00:00');
    const now = new Date();

    let diffMs = now.getTime() - startDate.getTime();
    if (diffMs < 0) diffMs = 0;

    const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diffMs / (1000 * 60 * 60)) % 24);
    const minutes = Math.floor((diffMs / (1000 * 60)) % 60);
    const seconds = Math.floor((diffMs / 1000) % 60);

    const pad = (n) => String(n).padStart(2, '0');

    const daysEl = document.getElementById('days-val');
    const hoursEl = document.getElementById('hours-val');
    const minutesEl = document.getElementById('minutes-val');
    const secondsEl = document.getElementById('seconds-val');

    if (daysEl) daysEl.textContent = String(days);
    if (hoursEl) hoursEl.textContent = pad(hours);
    if (minutesEl) minutesEl.textContent = pad(minutes);
    if (secondsEl) secondsEl.textContent = pad(seconds);

    // Birthday countdown
    function calculateNextBirthday(month, day) {
      const currentYear = now.getFullYear();
      let nextBday = new Date(currentYear, month - 1, day, 0, 0, 0);
      if (now.getTime() > nextBday.getTime()) {
        nextBday = new Date(currentYear + 1, month - 1, day, 0, 0, 0);
      }
      const bdiff = nextBday.getTime() - now.getTime();
      const bDays = Math.ceil(bdiff / (1000 * 60 * 60 * 24));
      return bDays === 0 ? 'Hôm nay sinh nhật! 🎉' : `còn ${bDays} ngày`;
    }

    const aiBdayEl = document.getElementById('bday-ai-counter');
    const mazeBdayEl = document.getElementById('bday-maze-counter');

    if (aiBdayEl) aiBdayEl.textContent = calculateNextBirthday(9, 28);
    if (mazeBdayEl) mazeBdayEl.textContent = calculateNextBirthday(12, 11);
  }

  updateLoveTimers();
  setInterval(updateLoveTimers, 1000);
  document.addEventListener('astro:after-swap', updateLoveTimers);
</script>

<script>
  import { pushDataToFirebase } from '../lib/firebaseClient';

  const AVATARS_STORAGE_KEY = 'couple_avatars';

  function getStoredAvatars(): { ai?: string; maze?: string } {
    try {
      const raw = localStorage.getItem(AVATARS_STORAGE_KEY);
      if (raw) return JSON.parse(raw);
    } catch {}
    return {};
  }

  function applyAvatars() {
    const avs = getStoredAvatars();
    const aiImg = document.getElementById('avatar-img-ai') as HTMLImageElement | null;
    const mazeImg = document.getElementById('avatar-img-maze') as HTMLImageElement | null;

    if (aiImg && avs.ai) aiImg.src = avs.ai;
    if (mazeImg && avs.maze) mazeImg.src = avs.maze;
  }

  // Tự động nén và crop ảnh đại diện vuông 360x360px sắc nét cho Retina, dung lượng chỉ ~30KB (không nghẽn bộ nhớ)
  async function compressAvatarImage(file: File): Promise<string> {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = (event) => {
        const img = new Image();
        img.onload = () => {
          const MAX_SIZE = 360;
          const width = img.naturalWidth || img.width;
          const height = img.naturalHeight || img.height;

          // Crop vuông tâm ảnh để avatar tròn luôn đẹp nhất
          const minDim = Math.min(width, height);
          const sx = (width - minDim) / 2;
          const sy = (height - minDim) / 2;

          const canvas = document.createElement('canvas');
          const targetDim = Math.min(minDim, MAX_SIZE);
          canvas.width = targetDim;
          canvas.height = targetDim;

          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';
            ctx.drawImage(img, sx, sy, minDim, minDim, 0, 0, targetDim, targetDim);
            try {
              const compressed = canvas.toDataURL('image/jpeg', 0.88);
              resolve(compressed);
            } catch {
              resolve(event.target?.result as string);
            }
          } else {
            resolve(event.target?.result as string);
          }
        };
        img.onerror = () => resolve(event.target?.result as string);
        img.src = event.target?.result as string;
      };
      reader.onerror = () => resolve('');
      reader.readAsDataURL(file);
    });
  }

  let editingPerson: 'ai' | 'maze' = 'ai';
  let tempAvatarData = '';

  function updateAvatarDropzonePreview(src: string) {
    const emptyState = document.getElementById('avatar-dropzone-empty');
    const previewState = document.getElementById('avatar-dropzone-preview');
    const preview = document.getElementById('avatar-modal-preview') as HTMLImageElement | null;
    const urlInput = document.getElementById('avatar-url-input') as HTMLInputElement | null;

    if (src) {
      if (preview) preview.src = src;
      if (emptyState) emptyState.style.display = 'none';
      if (previewState) previewState.style.display = 'flex';
      if (urlInput && urlInput.value !== src && !src.startsWith('data:')) {
        urlInput.value = src;
      }
      tempAvatarData = src;
    } else {
      if (preview) preview.src = '';
      if (emptyState) emptyState.style.display = 'flex';
      if (previewState) previewState.style.display = 'none';
      if (urlInput) urlInput.value = '';
      tempAvatarData = '';
    }
  }

  function openAvatarModal(person: 'ai' | 'maze') {
    editingPerson = person;
    const modal = document.getElementById('avatar-modal');
    const title = document.getElementById('avatar-modal-title');
    const ring = document.getElementById('avatar-modal-ring');
    const urlInput = document.getElementById('avatar-url-input') as HTMLInputElement | null;
    if (!modal || !title || !ring) return;

    title.textContent = person === 'ai' ? 'Đổi Ảnh Đại Diện AI 🚀' : 'Đổi Ảnh Đại Diện Maze 🌸';
    ring.className = `avatar-ring ${person === 'ai' ? 'avatar-ring-ai' : 'avatar-ring-maze'}`;

    const currentAvatars = getStoredAvatars();
    const currentSrc = person === 'ai'
      ? (currentAvatars.ai || (document.getElementById('avatar-img-ai') as HTMLImageElement)?.src || '')
      : (currentAvatars.maze || (document.getElementById('avatar-img-maze') as HTMLImageElement)?.src || '');

    updateAvatarDropzonePreview(currentSrc);
    if (urlInput) urlInput.value = '';

    modal.classList.add('is-open');
  }

  function initAvatarChanger() {
    applyAvatars();

    const btnAi = document.getElementById('btn-edit-avatar-ai');
    const btnMaze = document.getElementById('btn-edit-avatar-maze');
    const modal = document.getElementById('avatar-modal');
    const closeBtn = document.getElementById('avatar-modal-close');
    const cancelBtn = document.getElementById('btn-cancel-avatar');
    const saveBtn = document.getElementById('btn-save-avatar') as HTMLButtonElement | null;
    const fileInput = document.getElementById('avatar-file-input') as HTMLInputElement | null;
    const changeFileBtn = document.getElementById('btn-change-avatar-file') as HTMLInputElement | null;
    const urlInput = document.getElementById('avatar-url-input') as HTMLInputElement | null;
    const clearPhotoBtn = document.getElementById('btn-clear-avatar-photo');
    const dropzone = document.getElementById('avatar-dropzone');

    if (btnAi) btnAi.addEventListener('click', () => openAvatarModal('ai'));
    if (btnMaze) btnMaze.addEventListener('click', () => openAvatarModal('maze'));

    if (closeBtn && modal) closeBtn.addEventListener('click', () => modal.classList.remove('is-open'));
    if (cancelBtn && modal) cancelBtn.addEventListener('click', () => modal.classList.remove('is-open'));
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.remove('is-open');
      });
    }

    const handleFile = async (file: File) => {
      if (!file || !file.type.startsWith('image/')) return;
      // Nén ảnh tức thì trước khi đưa vào preview & lưu
      const compressedData = await compressAvatarImage(file);
      if (compressedData) {
        updateAvatarDropzonePreview(compressedData);
      }
    };

    if (fileInput) {
      fileInput.addEventListener('change', (e: any) => {
        const file = e.target.files?.[0];
        if (file) handleFile(file);
      });
    }

    if (changeFileBtn) {
      changeFileBtn.addEventListener('change', (e: any) => {
        const file = e.target.files?.[0];
        if (file) handleFile(file);
      });
    }

    if (dropzone) {
      ['dragenter', 'dragover'].forEach((evt) => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('is-dragover');
        });
      });

      ['dragleave', 'drop'].forEach((evt) => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('is-dragover');
        });
      });

      dropzone.addEventListener('drop', (e: any) => {
        const file = e.dataTransfer?.files?.[0];
        if (file) handleFile(file);
      });
    }

    if (urlInput) {
      urlInput.addEventListener('input', () => {
        const val = urlInput.value.trim();
        if (val) {
          updateAvatarDropzonePreview(val);
        }
      });
    }

    if (clearPhotoBtn) {
      clearPhotoBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (fileInput) fileInput.value = '';
        if (changeFileBtn) changeFileBtn.value = '';
        if (urlInput) urlInput.value = '';
        updateAvatarDropzonePreview('');
      });
    }

    if (saveBtn && modal) {
      saveBtn.addEventListener('click', async () => {
        if (!tempAvatarData) {
          modal.classList.remove('is-open');
          return;
        }

        const originalText = saveBtn.textContent;
        saveBtn.textContent = '⏳ Đang lưu...';
        saveBtn.disabled = true;

        try {
          const avs = getStoredAvatars();
          if (editingPerson === 'ai') avs.ai = tempAvatarData;
          if (editingPerson === 'maze') avs.maze = tempAvatarData;

          try {
            localStorage.setItem(AVATARS_STORAGE_KEY, JSON.stringify(avs));
          } catch (storageErr) {
            console.warn('[Avatar] LocalStorage warning:', storageErr);
          }

          applyAvatars();

          // Push to Firebase Realtime Database
          await pushDataToFirebase({ avatars: avs, lastUpdatedBy: editingPerson });

          modal.classList.remove('is-open');
        } catch (err) {
          console.error('[Avatar] Error while saving avatar:', err);
          modal.classList.remove('is-open');
        } finally {
          saveBtn.textContent = originalText || 'Lưu Ảnh Đại Diện';
          saveBtn.disabled = false;
        }
      });
    }

    // Realtime update listener from Firebase
    window.addEventListener('couple-cloud-updated', (e: any) => {
      const cloudData = e.detail;
      if (cloudData && cloudData.avatars) {
        localStorage.setItem(AVATARS_STORAGE_KEY, JSON.stringify(cloudData.avatars));
        applyAvatars();
      }
    });
  }

  initAvatarChanger();
  document.addEventListener('astro:after-swap', initAvatarChanger);
</script>
