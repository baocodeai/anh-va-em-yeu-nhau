    author?: 'ai' | 'maze' | 'both';
    galleryImages?: JournalPhoto[];
    isPinned?: boolean;
  }

  const MEMORIES_STORAGE_KEY = 'couple_memories';

  let currentUploadedMemPhoto = '';
  let currentAttachedGallery: JournalPhoto[] = [];
  let currentViewingPhoto: PhotoMemory | null = null;
  let currentStudioViewMode: 'split' | 'editor' | 'preview' = 'split';

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // =========================================================================
  // LIGHTWEIGHT MARKDOWN PARSER (For Reader & Live Preview)
  // =========================================================================
  function renderMarkdownToHtml(raw: string, defaultAlt = 'Kỷ niệm', customGallery?: JournalPhoto[]): string {
    if (!raw || !raw.trim()) return '';

    const text = raw.replace(/\r\n/g, '\n');
    const lines = text.split('\n');
    const htmlBlocks: string[] = [];
    let currentParagraph: string[] = [];
    let inList = false;
    let listItems: string[] = [];
    let inBlockquote = false;
    let blockquoteLines: string[] = [];

    const formatInline = (str: string) => {
      let res = str
        .replace(/\*\*(.*?)\*\*/g, '<strong class="journal-bold">$1</strong>')
        .replace(/\*(.*?)\*/g, '<em class="journal-italic">$1</em>')
        .replace(/==(.*?)==/g, '<mark class="journal-mark">$1</mark>');

      // Handle inline [photo:X] or [ảnh:X]
      res = res.replace(/\[(?:photo|ảnh):(\d+)(?:\s*\|\s*(.*?))?\]/gi, (match, pNum, pCap) => {
        const pIdx = parseInt(pNum, 10) - 1;
        const galleryList = customGallery || currentAttachedGallery || [];
        const photoObj = galleryList[pIdx];
        if (photoObj && photoObj.url) {
          const alt = pCap?.trim() || photoObj.caption || defaultAlt || `Ảnh ${pIdx + 1}`;
          return `
            <figure class="journal-inline-img-wrap" data-src="${photoObj.url}" data-caption="${escapeHtml(alt)}">
              <img src="${photoObj.url}" alt="${escapeHtml(alt)}" class="journal-inline-img" loading="lazy" />
              <figcaption class="journal-inline-caption">📸 ${escapeHtml(alt)}</figcaption>
            </figure>
          `;
        }
        return match;
      });

      return res;
    };

    const flushParagraph = () => {
      if (currentParagraph.length > 0) {
        const pText = currentParagraph.join('<br/>');
        htmlBlocks.push(`<p class="journal-paragraph">${formatInline(pText)}</p>`);
        currentParagraph = [];
      }
    };

    const flushList = () => {
      if (inList && listItems.length > 0) {
        htmlBlocks.push(`<ul class="journal-list">${listItems.map((item) => `<li>${formatInline(item)}</li>`).join('')}</ul>`);
        listItems = [];
        inList = false;
      }
    };

    const flushBlockquote = () => {
      if (inBlockquote && blockquoteLines.length > 0) {
        const quoteContent = blockquoteLines.join('<br/>');
        htmlBlocks.push(`<blockquote class="journal-quote"><p class="journal-quote-text">${formatInline(quoteContent)}</p></blockquote>`);
        blockquoteLines = [];
        inBlockquote = false;
      }
    };

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i].trim();

      if (!line) {
        flushParagraph();
        flushList();
        flushBlockquote();
        continue;
      }

      // 1. Short photo tag: [photo:1] or [ảnh:1] or [photo:1 | Chú thích riêng]
      const photoTagMatch = line.match(/^\[(?:photo|ảnh):(\d+)(?:\s*\|\s*(.*?))?\]$/i);
      if (photoTagMatch) {
        flushParagraph();
        flushList();
        flushBlockquote();
        const photoIndex = parseInt(photoTagMatch[1], 10) - 1;
        const customCap = photoTagMatch[2]?.trim();
        const galleryList = customGallery || currentAttachedGallery || [];
        const photoObj = galleryList[photoIndex];
        if (photoObj && photoObj.url) {
          const alt = customCap || photoObj.caption || defaultAlt || `Ảnh ${photoIndex + 1}`;
          const src = photoObj.url;
          htmlBlocks.push(`
            <figure class="journal-inline-img-wrap" data-src="${src}" data-caption="${escapeHtml(alt)}">
              <img src="${src}" alt="${escapeHtml(alt)}" class="journal-inline-img" loading="lazy" />
              <figcaption class="journal-inline-caption">📸 ${escapeHtml(alt)}</figcaption>
            </figure>
          `);
        }
        continue;
      }

      // 2. Inline image: ![caption](url)
      const imgMatch = line.match(/^!\[(.*?)\]\((.*?)\)$/);
      if (imgMatch) {
        flushParagraph();
        flushList();
        flushBlockquote();
        const alt = imgMatch[1] || defaultAlt;
        const src = imgMatch[2];
        htmlBlocks.push(`
          <figure class="journal-inline-img-wrap" data-src="${src}" data-caption="${escapeHtml(alt)}">
            <img src="${src}" alt="${escapeHtml(alt)}" class="journal-inline-img" loading="lazy" />
            ${alt ? `<figcaption class="journal-inline-caption">📸 ${escapeHtml(alt)}</figcaption>` : ''}
          </figure>
        `);
        continue;
      }

      // Heading 3: ### Heading
      if (line.startsWith('### ')) {
        flushParagraph();
        flushList();
        flushBlockquote();
        htmlBlocks.push(`<h4 class="journal-subheading">${formatInline(escapeHtml(line.slice(4)))}</h4>`);
        continue;
      }

      // Heading 2 / 1: ## Heading or # Heading
      if (line.startsWith('## ') || line.startsWith('# ')) {
        flushParagraph();
        flushList();
        flushBlockquote();
        const headingText = line.startsWith('## ') ? line.slice(3) : line.slice(2);
        htmlBlocks.push(`<h3 class="journal-heading">${formatInline(escapeHtml(headingText))}</h3>`);
        continue;
      }

      // Blockquote: > text
      if (line.startsWith('>')) {
        flushParagraph();
        flushList();
        inBlockquote = true;
        blockquoteLines.push(escapeHtml(line.replace(/^>\s*/, '')));
        continue;
      } else if (inBlockquote) {
        flushBlockquote();
      }

      // List: - item or * item
      if (line.startsWith('- ') || line.startsWith('* ')) {
        flushParagraph();
        flushBlockquote();
        inList = true;
        listItems.push(escapeHtml(line.slice(2)));
        continue;
      } else if (inList) {
        flushList();
      }

      // Regular paragraph text
      currentParagraph.push(escapeHtml(line));
    }

    flushParagraph();
    flushList();
    flushBlockquote();

    return htmlBlocks.join('\n');
  }

  function getStoredMemories(): PhotoMemory[] {
    try {
      const stored = localStorage.getItem(MEMORIES_STORAGE_KEY);
      if (stored) return JSON.parse(stored);
    } catch {}
    const initial = (window as any).__INITIAL_MEMORIES__ || [];
    localStorage.setItem(MEMORIES_STORAGE_KEY, JSON.stringify(initial));
    return initial;
  }

  function saveStoredMemories(list: PhotoMemory[]) {
    localStorage.setItem(MEMORIES_STORAGE_KEY, JSON.stringify(list));
    pushDataToFirebase({ memories: list, lastUpdatedBy: 'Memories' }).catch(() => {});
  }

  // =========================================================================
  // ALL UPLOADED PHOTOS STREAM LOGIC
  // =========================================================================
  interface AggregatedPhotoItem {
    id: string;
    url: string;
    caption?: string;
    photoType: 'cover' | 'gallery';
    photoIndex?: number;
    memory: PhotoMemory;
  }

  let currentPhotoFilter = 'all'; // 'all' | 'cover' | 'gallery'
  let currentPhotoSearchQuery = '';

  function getAllUploadedPhotos(): AggregatedPhotoItem[] {
    const memories = getStoredMemories();
    const allPhotos: AggregatedPhotoItem[] = [];

    // Sort: Pinned memories first
    const sortedList = [...memories].sort((a, b) => {
      const pinA = a.isPinned ? 1 : 0;
      const pinB = b.isPinned ? 1 : 0;
      return pinB - pinA;
    });

    sortedList.forEach((mem) => {
      // 1. Cover Photo
      if (mem.imageUrl) {
        allPhotos.push({
          id: `${mem.id}-cover`,
          url: mem.imageUrl,
          caption: mem.caption || '',
          photoType: 'cover',
          memory: mem
        });
      }

      // 2. Attached Gallery Photos
      if (mem.galleryImages && Array.isArray(mem.galleryImages)) {
        mem.galleryImages.forEach((img, idx) => {
          if (img.url) {
            allPhotos.push({
              id: `${mem.id}-gallery-${img.id || idx}`,
              url: img.url,
              caption: img.caption || mem.caption || '',
              photoType: 'gallery',
              photoIndex: idx + 1,
              memory: mem
            });
          }
        });
      }
    });

    return allPhotos;
  }

  function renderAllPhotosStream() {
    const gridContainer = document.getElementById('all-photos-grid-container');
    const emptyState = document.getElementById('all-photos-empty');
    if (!gridContainer) return;

    const allPhotos = getAllUploadedPhotos();

    // Update counts in badges & filter chips
    const totalCount = allPhotos.length;
    const coverCount = allPhotos.filter((p) => p.photoType === 'cover').length;
    const galleryCount = allPhotos.filter((p) => p.photoType === 'gallery').length;

    const badgeCountAllPhotos = document.getElementById('count-all-photos-badge');
    if (badgeCountAllPhotos) badgeCountAllPhotos.textContent = String(totalCount);

    const filterCountAll = document.getElementById('filter-count-all');
    if (filterCountAll) filterCountAll.textContent = String(totalCount);

    const filterCountCover = document.getElementById('filter-count-cover');
    if (filterCountCover) filterCountCover.textContent = String(coverCount);

    const filterCountGallery = document.getElementById('filter-count-gallery');
    if (filterCountGallery) filterCountGallery.textContent = String(galleryCount);

    // Apply filters & search query
    let filtered = allPhotos;
    if (currentPhotoFilter === 'cover') {
      filtered = filtered.filter((p) => p.photoType === 'cover');
    } else if (currentPhotoFilter === 'gallery') {
      filtered = filtered.filter((p) => p.photoType === 'gallery');
    }

    if (currentPhotoSearchQuery.trim()) {
      const q = currentPhotoSearchQuery.toLowerCase().trim();
      filtered = filtered.filter((p) => {
        const title = (p.memory.title || '').toLowerCase();
        const loc = (p.memory.location || '').toLowerCase();
        const date = (p.memory.date || '').toLowerCase();
        const cap = (p.caption || '').toLowerCase();
        const author = (p.memory.author || '').toLowerCase();
        const mood = (p.memory.mood || '').toLowerCase();
        return (
          title.includes(q) ||
          loc.includes(q) ||
          date.includes(q) ||
          cap.includes(q) ||
          author.includes(q) ||
          mood.includes(q)
        );
      });
    }

    gridContainer.innerHTML = '';

    if (filtered.length === 0) {
      if (emptyState) emptyState.style.display = 'flex';
      return;
    } else {
      if (emptyState) emptyState.style.display = 'none';
    }

    filtered.forEach((item) => {
      const card = document.createElement('div');
      card.className = 'all-photo-card romantic-card';

      const isCover = item.photoType === 'cover';
      const typeBadgeText = isCover ? '📸 Ảnh Bìa' : `🖼️ Ảnh Chuyến Đi #${item.photoIndex || 1}`;
      const authorName =
        item.memory.author === 'ai' ? 'AI 🚀' : item.memory.author === 'maze' ? 'Maze 🌸' : 'Cả hai 💖';
      const displayCaption = item.caption || item.memory.caption || item.memory.title;

      card.innerHTML = `
        <div class="all-photo-image-frame" title="Nhấn để phóng to ảnh">
          <img
            src="${item.url}"
            alt="${escapeHtml(item.memory.title)}"
            class="all-photo-img"
            loading="lazy"
          />
          <span class="all-photo-type-badge ${isCover ? 'is-cover' : ''}">${typeBadgeText}</span>
          <div class="all-photo-zoom-hint">🔍 Nhấn để phóng to</div>
        </div>
        <div class="all-photo-info-body">
          <div class="all-photo-memory-meta">
            <span>🗓️ ${escapeHtml(item.memory.date || 'Kỷ niệm')}</span>
            <span>📍 ${escapeHtml(item.memory.location || 'Bên nhau')}</span>
            <span>✍️ ${escapeHtml(authorName)}</span>
          </div>
          <h3 class="all-photo-memory-title" title="Nhấn để mở nhật ký kỷ niệm">${escapeHtml(item.memory.title)}</h3>
          <p class="all-photo-caption-text">"${escapeHtml(displayCaption)}"</p>
        </div>
        <div class="all-photo-card-footer">
          <button type="button" class="all-photo-open-journal-btn" title="Mở trang nhật ký chứa bức ảnh này">
            <span>📖 Mở Nhật Ký</span>
          </button>
          <button type="button" class="all-photo-zoom-btn" title="Phóng to ảnh chất lượng cao">
            <span>🔍 Phóng To</span>
          </button>
        </div>
      `;

      // Click on photo frame -> Lightbox
      const imgFrame = card.querySelector('.all-photo-image-frame');
      if (imgFrame) {
        imgFrame.addEventListener('click', () => {
          openMemLightbox(item.url, `${item.memory.title} - ${displayCaption}`);
        });
      }

      // Click on zoom button -> Lightbox
      const zoomBtn = card.querySelector('.all-photo-zoom-btn');
      if (zoomBtn) {
        zoomBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          openMemLightbox(item.url, `${item.memory.title} - ${displayCaption}`);
        });
      }

      // Click on title -> Open Reader
      const titleEl = card.querySelector('.all-photo-memory-title');
      if (titleEl) {
        titleEl.addEventListener('click', () => {
          openJournalReader(item.memory);
        });
      }

      // Click on "Mở Nhật Ký" -> Open Reader
      const readBtn = card.querySelector('.all-photo-open-journal-btn');
      if (readBtn) {
        readBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          openJournalReader(item.memory);
        });
      }

      gridContainer.appendChild(card);
    });
  }

  function renderMemories() {
    const container = document.getElementById('memories-container');
    if (!container) return;

    const list = getStoredMemories();

    // Update stories tab count badge
    const badgeCountStories = document.getElementById('count-stories-badge');
    if (badgeCountStories) badgeCountStories.textContent = String(list.length);

    // Also sync all photos stream
    renderAllPhotosStream();

    // Sort: Pinned memories first
    const sortedList = [...list].sort((a, b) => {
      const pinA = a.isPinned ? 1 : 0;
      const pinB = b.isPinned ? 1 : 0;
      return pinB - pinA;
    });

    container.innerHTML = '';

    sortedList.forEach((photo, index) => {
      const card = document.createElement('div');
      const isPinned = !!photo.isPinned;
      card.className = `polaroid-card romantic-card tilt-${(index % 4) + 1} ${isPinned ? 'is-pinned' : ''}`;
      card.setAttribute('data-id', photo.id);

      const galleryCount = photo.galleryImages?.length || 0;
      const moodBadge = photo.mood ? `<span class="polaroid-mood-badge">${escapeHtml(photo.mood)}</span>` : '';
      const photoCountBadge = galleryCount > 0 ? `<span class="polaroid-photo-count">📸 +${galleryCount} ảnh</span>` : '';
      const pinBadge = isPinned ? `<div class="polaroid-pin-badge" title="Bài kỷ niệm được ghim lên đầu">📌 Đã ghim</div>` : '';

      card.innerHTML = `
        <div class="polaroid-pin">${isPinned ? '📌' : '📍'}</div>
        ${pinBadge}
        <div class="polaroid-photo-frame" title="Nhấn để mở nhật ký kỷ niệm">
          <img
            src="${photo.imageUrl}"
            alt="${escapeHtml(photo.title)}"
            class="polaroid-img"
            loading="lazy"
          />
          ${photoCountBadge}
          <div class="polaroid-read-hint">📖 Đọc nhật ký &amp; cảm xúc</div>
        </div>
        <div class="polaroid-caption-area">
          <div class="polaroid-meta-row">
            <span class="polaroid-date">🗓️ ${escapeHtml(photo.date || 'Kỷ niệm')}</span>
            <span class="polaroid-loc">📍 ${escapeHtml(photo.location || 'Bên nhau')}</span>
            ${moodBadge}
          </div>
          <h3 class="polaroid-title" style="cursor: pointer;" title="Nhấn để đọc nhật ký">${escapeHtml(photo.title)}</h3>
          <p class="polaroid-caption">"${escapeHtml(photo.caption || '')}"</p>
        </div>
        <div class="polaroid-card-footer">
          <button type="button" class="btn-read-journal" title="Mở nhật ký & cảm xúc">
            <span>📖 Đọc Nhật Ký</span>
          </button>
          <div class="polaroid-sub-actions">
            <button type="button" class="btn-card-icon-action btn-pin-mem ${isPinned ? 'is-pinned' : ''}" title="${isPinned ? 'Bỏ ghim khỏi đầu trang' : 'Ghim bài viết lên đầu trang'}">
              <span>${isPinned ? '⭐' : '📌'}</span>
            </button>
            <button type="button" class="btn-card-icon-action btn-edit-mem" title="Chỉnh sửa kỷ niệm">
              <span>✏️ Sửa</span>
            </button>
            <button type="button" class="btn-card-icon-action btn-delete-mem btn-card-delete" title="Xóa kỷ niệm">
              <span>🗑️ Xóa</span>
            </button>
          </div>
        </div>
      `;

      // Open Journal Reader events
      const frame = card.querySelector('.polaroid-photo-frame');
      if (frame) {
        frame.addEventListener('click', () => openJournalReader(photo));
      }

      const titleEl = card.querySelector('.polaroid-title');
      if (titleEl) {
        titleEl.addEventListener('click', () => openJournalReader(photo));
      }

      const readBtn = card.querySelector('.btn-read-journal');
      if (readBtn) {
        readBtn.addEventListener('click', () => openJournalReader(photo));
      }

      // Quick Pin toggle click
      const pinBtn = card.querySelector('.btn-pin-mem');
      if (pinBtn) {
        pinBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const target = list.find((p) => p.id === photo.id);
          if (target) {
            target.isPinned = !target.isPinned;
            saveStoredMemories(list);
            renderMemories();
          }
        });
      }

      // Edit click
      const editBtn = card.querySelector('.btn-edit-mem');
      if (editBtn) {
        editBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          openEditMemModal(photo);
        });
      }

      // Delete click
      const deleteBtn = card.querySelector('.btn-delete-mem');
      if (deleteBtn) {
        deleteBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const excerpt = (photo as any).quote || (photo as any).caption || ((photo as any).story ? (photo as any).story.replace(/<[^>]*>?/gm, '').slice(0, 110) + '...' : 'Một khoảnh khắc tuyệt đẹp giữa dải ngân hà của hai đứa...');
          const confirmed = (window as any).romanticConfirm
            ? await (window as any).romanticConfirm({
                heading: 'Tạm Cất Trang Nhật Ký Này Nhé?',
                subject: photo.title,
                subjectIcon: '📸',
                quote: excerpt,
                typeBadge: '📸 Kỷ Niệm Tình Yêu',
                sealEmoji: '💌',
                confirmText: 'Cất Đi 📦',
                cancelText: 'Để Lại Đây 🌸',
                notice: 'Kỷ niệm này sẽ được lưu giữ an toàn trong Thùng Rác và có thể khôi phục lại bất kỳ lúc nào.'
              })
            : confirm(`Bạn có chắc muốn chuyển kỷ niệm "${photo.title}" vào Thùng Rác không?`);

          if (confirmed) {
            moveItemToTrash(
              {
                originalId: photo.id,
                type: 'memory',
                title: photo.title,
                previewImage: photo.imageUrl,
                subtitle: photo.caption || photo.location || '',
                data: photo
              },
              {
                onUndo: () => renderMemories()
              }
            );
            const updated = list.filter((p) => p.id !== photo.id);
            saveStoredMemories(updated);
            renderMemories();
          }
        });
      }

      container.appendChild(card);
    });
  }

  // =========================================================================
  // JOURNAL READER MODAL
  // =========================================================================
  function openJournalReader(photo: PhotoMemory) {
    currentViewingPhoto = photo;
    const modal = document.getElementById('journal-reader-modal');
    if (!modal) return;

    // Cover Image
    const coverImg = document.getElementById('reader-cover-img') as HTMLImageElement | null;
    if (coverImg) {
      coverImg.src = photo.imageUrl;
      coverImg.alt = photo.title;
    }

    // Author badge
    const authorBadge = document.getElementById('reader-author-badge');
    const signoffNames = document.getElementById('reader-signoff-names');
    let authorText = '✍️ AI 🚀 & Maze 🌸';
    let coupleText = 'AI 🚀 & Maze 🌸';
    if (photo.author === 'ai') {
      authorText = '✍️ Chắp bút bởi AI 🚀';
      coupleText = 'Thương gửi Maze từ AI 🚀';
    } else if (photo.author === 'maze') {
      authorText = '✍️ Chắp bút bởi Maze 🌸';
      coupleText = 'Thương gửi AI từ Maze 🌸';
    }
    if (authorBadge) authorBadge.textContent = authorText;
    if (signoffNames) signoffNames.textContent = coupleText;

    // Meta row pills
    const datePill = document.getElementById('reader-date');
    const locPill = document.getElementById('reader-loc');
    const moodPill = document.getElementById('reader-mood');
    const weatherPill = document.getElementById('reader-weather');

    if (datePill) datePill.textContent = `🗓️ ${photo.date || 'Kỷ niệm'}`;
    if (locPill) locPill.textContent = `📍 ${photo.location || 'Bên nhau'}`;

    if (moodPill) {
      if (photo.mood) {
        moodPill.textContent = photo.mood;
        moodPill.style.display = 'inline-flex';
      } else {
        moodPill.style.display = 'none';
      }
    }

    if (weatherPill) {
      if (photo.weather) {
        weatherPill.textContent = photo.weather;
        weatherPill.style.display = 'inline-flex';
      } else {
        weatherPill.style.display = 'none';
      }
    }

    // Title
    const titleEl = document.getElementById('reader-title');
    if (titleEl) titleEl.textContent = photo.title;

    // Caption / Lead quote
    const captionWrap = document.getElementById('reader-caption-wrap');
    const captionEl = document.getElementById('reader-caption');
    if (captionWrap && captionEl) {
      if (photo.caption) {
        captionEl.textContent = `"${photo.caption}"`;
        captionWrap.style.display = 'block';
      } else {
        captionWrap.style.display = 'none';
      }
    }

    // Story Body with Markdown Parser
    const contentEl = document.getElementById('reader-content');
    if (contentEl) {
      const rawContent = photo.journalContent || photo.caption || '';
      const renderedHtml = renderMarkdownToHtml(rawContent, photo.title, photo.galleryImages || []);

      if (!renderedHtml) {
        contentEl.innerHTML = `
          <p class="journal-paragraph" style="font-style: italic; color: #94a3b8;">
            Trang nhật ký này chưa có bài viết chi tiết. Bạn có thể nhấn nút "Chỉnh Sửa Trang Nhật Ký Này" bên dưới để viết lại cảm xúc ngọt ngào của hai bạn nhé! ✨
          </p>
        `;
      } else {
        contentEl.innerHTML = renderedHtml;

        // Add Lightbox zoom on any inline images in story
        const inlineImgs = contentEl.querySelectorAll('.journal-inline-img-wrap');
        inlineImgs.forEach((wrap: any) => {
          wrap.addEventListener('click', () => {
            const src = wrap.getAttribute('data-src') || '';
            const cap = wrap.getAttribute('data-caption') || photo.title;
            if (src) openMemLightbox(src, cap);
          });
        });
      }
    }

    // Attached Gallery Showcase at bottom
    const gallerySec = document.getElementById('reader-gallery-section');
    const galleryGrid = document.getElementById('reader-gallery-grid');
    if (gallerySec && galleryGrid) {
      if (photo.galleryImages && photo.galleryImages.length > 0) {
        gallerySec.style.display = 'block';
        galleryGrid.innerHTML = '';
        photo.galleryImages.forEach((img) => {
          const itemCard = document.createElement('div');
          itemCard.className = 'gallery-photo-card';
          itemCard.innerHTML = `
            <img src="${img.url}" alt="${escapeHtml(img.caption || photo.title)}" class="gallery-photo-img" loading="lazy" />
            ${img.caption ? `<p class="gallery-photo-caption">${escapeHtml(img.caption)}</p>` : ''}
          `;
          itemCard.addEventListener('click', () => {
            openMemLightbox(img.url, img.caption || photo.title);
          });
          galleryGrid.appendChild(itemCard);
        });
      } else {
        gallerySec.style.display = 'none';
        galleryGrid.innerHTML = '';
      }
    }

    modal.classList.add('is-open');
  }

