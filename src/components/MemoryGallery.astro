  // =========================================================================
  // MARKDOWN TOOLBAR & TEXTAREA HELPERS
  // =========================================================================
  function insertMarkdown(prefix: string, suffix = '', defaultText = '') {
    const textarea = document.getElementById('form-mem-content') as HTMLTextAreaElement | null;
    if (!textarea) return;

    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const selectedText = textarea.value.substring(start, end);
    const replacement = selectedText ? `${prefix}${selectedText}${suffix}` : `${prefix}${defaultText}${suffix}`;

    textarea.setRangeText(replacement, start, end, 'select');
    textarea.focus();

    // Set cursor inside inserted text if defaultText was used
    if (!selectedText && defaultText) {
      textarea.setSelectionRange(start + prefix.length, start + prefix.length + defaultText.length);
    }

    updateLivePreview();
  }

  function insertAtCursor(text: string) {
    const textarea = document.getElementById('form-mem-content') as HTMLTextAreaElement | null;
    if (!textarea) return;

    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    textarea.setRangeText(text, start, end, 'end');
    textarea.focus();
    updateLivePreview();
  }

  function setStudioViewMode(mode: 'editor' | 'preview') {
    currentStudioViewMode = mode;
    const workspace = document.getElementById('studio-workspace');
    const editorCol = document.getElementById('workspace-editor-col');
    const previewCol = document.getElementById('workspace-preview-col');
    const editorBtn = document.getElementById('btn-zen-mode-editor');
    const previewBtn = document.getElementById('btn-zen-mode-preview');

    if (editorBtn && previewBtn) {
      if (mode === 'preview') {
        editorBtn.classList.remove('is-active');
        previewBtn.classList.add('is-active');
      } else {
        editorBtn.classList.add('is-active');
        previewBtn.classList.remove('is-active');
      }
    }

    if (workspace) {
      workspace.classList.remove('mode-editor', 'mode-preview');
      workspace.classList.add(`mode-${mode}`);
    }

    if (editorCol && previewCol) {
      if (mode === 'preview') {
        editorCol.style.display = 'none';
        previewCol.style.display = 'block';
        updateLivePreview();
      } else {
        editorCol.style.display = 'block';
        previewCol.style.display = 'none';
      }
    }
  }

  // =========================================================================
  // ATTACHED GALLERY STUDIO MANAGER (With 1-Click Markdown Insert)
  // =========================================================================
  function renderAttachedGalleryEditor() {
    const container = document.getElementById('form-gallery-items-container');
    const countBadge = document.getElementById('zen-gallery-count-badge');
    if (countBadge) {
      countBadge.textContent = `${currentAttachedGallery.length} ảnh`;
    }
    if (!container) return;
    container.innerHTML = '';

    if (currentAttachedGallery.length === 0) {
      container.innerHTML = `
        <div class="zen-gallery-empty-tip" style="padding: 10px; background: rgba(15, 23, 42, 0.4); border-radius: 10px; border: 1px dashed rgba(255, 255, 255, 0.1);">
          <p style="color: #94a3b8; font-size: 0.8rem; margin: 0; font-style: italic; line-height: 1.5; text-align: center;">
            Chưa có ảnh chèn thêm.<br/>Nhấn <strong>"+ Tải ảnh"</strong> hoặc dán URL bên dưới để đưa ảnh vào kho.
          </p>
        </div>
      `;
      return;
    }

    currentAttachedGallery.forEach((item, index) => {
      const itemNum = index + 1;
      const itemEl = document.createElement('div');
      itemEl.className = 'gallery-edit-item';
      itemEl.innerHTML = `
        <div class="gallery-thumb-wrap">
          <img src="${item.url}" alt="Ảnh ${itemNum}" class="gallery-edit-thumb" />
          <span class="gallery-thumb-tag">#${itemNum}</span>
        </div>
        <div class="gallery-edit-info">
          <div class="gallery-item-header">
            <span class="gallery-item-badge">📸 Ảnh ${itemNum}</span>
            <code class="gallery-token-code">[photo:${itemNum}]</code>
          </div>
          <input
            type="text"
            class="form-input gallery-caption-input"
            placeholder="Chú thích ảnh..."
            value="${escapeHtml(item.caption || '')}"
          />
        </div>
        <div class="gallery-item-actions">
          <button type="button" class="btn-insert-inline-img" title="Chèn mã ngắn [photo:${itemNum}] vào bài viết">
            <span>📋 Chèn</span>
          </button>
          <button type="button" class="btn-remove-gallery-item" title="Xóa ảnh khỏi kho">🗑️</button>
        </div>
      `;

      // Update caption on input
      const captionInput = itemEl.querySelector('.gallery-caption-input') as HTMLInputElement | null;
      if (captionInput) {
        captionInput.addEventListener('input', () => {
          currentAttachedGallery[index].caption = captionInput.value;
          updateLivePreview();
        });
      }

      // 1-Click Insert Markdown button
      const insertBtn = itemEl.querySelector('.btn-insert-inline-img');
      if (insertBtn) {
        insertBtn.addEventListener('click', () => {
          const photoToken = `[photo:${itemNum}]`;
          
          const textarea = document.getElementById('form-mem-content') as HTMLTextAreaElement | null;
          if (textarea) {
            let currentVal = textarea.value;
            // Clean out any huge raw base64 data URLs or placeholder if present
            const messyBase64Regex = /!\[.*?\]\(data:image\/[a-zA-Z]+;base64,[A-Za-z0-9+/=]{100,}\)/g;
            const placeholderRegex = /!\[.*?\]\(https?:\/\/(?:\.\.\.|\S*)\)/i;
            
            if (messyBase64Regex.test(currentVal)) {
              textarea.value = currentVal.replace(messyBase64Regex, photoToken);
              updateLivePreview();
            } else if (placeholderRegex.test(currentVal)) {
              textarea.value = currentVal.replace(placeholderRegex, photoToken);
              updateLivePreview();
            } else {
              insertAtCursor(`\n\n${photoToken}\n\n`);
            }
          } else {
            insertAtCursor(`\n\n${photoToken}\n\n`);
          }

          insertBtn.classList.add('is-inserted');
          insertBtn.innerHTML = '<span>✅ Đã chèn!</span>';
          setTimeout(() => {
            insertBtn.classList.remove('is-inserted');
            insertBtn.innerHTML = '<span>📋 Chèn</span>';
          }, 1500);
        });
      }

      // Remove photo
      const removeBtn = itemEl.querySelector('.btn-remove-gallery-item');
      if (removeBtn) {
        removeBtn.addEventListener('click', () => {
          currentAttachedGallery.splice(index, 1);
          renderAttachedGalleryEditor();
          updateLivePreview();
        });
      }

      container.appendChild(itemEl);
    });
  }

  function addPhotoToGallery(url: string, caption = '') {
    if (!url || !url.trim()) return;
    currentAttachedGallery.push({
      id: 'g-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6),
      url: url.trim(),
      caption
    });
    renderAttachedGalleryEditor();
    updateLivePreview();
  }

