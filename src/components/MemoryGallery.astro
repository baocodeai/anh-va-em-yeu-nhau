  function setMobilePane(pane: 'left' | 'right' | 'preview') {
    const studioCard = document.querySelector('.zen-journal-card.zen-split-studio');
    const tabMobileLeft = document.getElementById('btn-tab-pane-left');
    const tabMobileRight = document.getElementById('btn-tab-pane-right');
    const tabMobilePreview = document.getElementById('btn-tab-pane-preview');
    const mobileTabBtns = [tabMobileLeft, tabMobileRight, tabMobilePreview];

    if (studioCard) {
      studioCard.classList.remove('mobile-pane-left', 'mobile-pane-right', 'mobile-pane-preview');
      studioCard.classList.add(`mobile-pane-${pane}`);
    }

    mobileTabBtns.forEach((btn) => {
      if (!btn) return;
      const isSelected = btn.getAttribute('data-pane') === pane;
      btn.classList.toggle('is-active', isSelected);
      btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
    });

    if (pane === 'preview') {
      updateLivePreview();
    }
  }

  function updateMemPhotoPreview(url: string) {
    const emptyState = document.getElementById('memory-dropzone-empty');
    const activeActions = document.getElementById('zen-cover-active-actions');
    const img = document.getElementById('form-mem-preview') as HTMLImageElement | null;
    const urlInput = document.getElementById('form-mem-url') as HTMLInputElement | null;

    if (url) {
      if (img) {
        img.src = url;
        img.style.display = 'block';
      }
      if (emptyState) emptyState.style.display = 'none';
      if (activeActions) activeActions.style.display = 'flex';
      if (urlInput && urlInput.value !== url && !url.startsWith('data:')) {
        urlInput.value = url;
      }
    } else {
      if (img) {
        img.src = '';
        img.style.display = 'none';
      }
      if (emptyState) emptyState.style.display = 'flex';
      if (activeActions) activeActions.style.display = 'none';
      if (urlInput) urlInput.value = '';
    }
  }

  // =========================================================================
  // INITIALIZATION & EVENT BINDINGS
  // =========================================================================
  function initMemoryInteractive() {
    renderMemories();

    // Mobile Navigation Pane Switcher
    const tabMobileLeft = document.getElementById('btn-tab-pane-left');
    const tabMobileRight = document.getElementById('btn-tab-pane-right');
    const tabMobilePreview = document.getElementById('btn-tab-pane-preview');

    tabMobileLeft?.addEventListener('click', () => setMobilePane('left'));
    tabMobileRight?.addEventListener('click', () => setMobilePane('right'));
    tabMobilePreview?.addEventListener('click', () => setMobilePane('preview'));

    // Love Prompt Suggestion Clicks
    const promptBtns = document.querySelectorAll('.zen-prompt-btn');
    promptBtns.forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const promptText = btn.getAttribute('data-prompt') || '';
        if (promptText) {
          insertAtCursor(promptText);
        }
      });
    });

    // View Switcher (Stories Polaroid vs All Uploaded Photos)
    const btnViewStories = document.getElementById('btn-view-stories');
    const btnViewAllPhotos = document.getElementById('btn-view-all-photos');
    const containerStories = document.getElementById('memories-container');
    const containerAllPhotos = document.getElementById('all-photos-stream-wrap');

    const switchView = (view: 'stories' | 'all-photos') => {
      if (view === 'stories') {
        btnViewStories?.classList.add('is-active');
        btnViewStories?.setAttribute('aria-selected', 'true');
        btnViewAllPhotos?.classList.remove('is-active');
        btnViewAllPhotos?.setAttribute('aria-selected', 'false');

        if (containerStories) containerStories.style.display = 'grid';
        if (containerAllPhotos) containerAllPhotos.style.display = 'none';
      } else {
        btnViewAllPhotos?.classList.add('is-active');
        btnViewAllPhotos?.setAttribute('aria-selected', 'true');
        btnViewStories?.classList.remove('is-active');
        btnViewStories?.setAttribute('aria-selected', 'false');

        if (containerStories) containerStories.style.display = 'none';
        if (containerAllPhotos) {
          containerAllPhotos.style.display = 'flex';
          renderAllPhotosStream();
        }
      }
    };

    if (btnViewStories) btnViewStories.addEventListener('click', () => switchView('stories'));
    if (btnViewAllPhotos) btnViewAllPhotos.addEventListener('click', () => switchView('all-photos'));

    // Filter Chips for All Photos Stream
    const filterChips = document.querySelectorAll('#photo-type-filter-chips .photo-filter-chip');
    filterChips.forEach((chip: any) => {
      chip.addEventListener('click', () => {
        filterChips.forEach((c: any) => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        currentPhotoFilter = chip.getAttribute('data-filter') || 'all';
        renderAllPhotosStream();
      });
    });

    // Search input for All Photos Stream
    const searchInput = document.getElementById('photo-search-input') as HTMLInputElement | null;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentPhotoSearchQuery = searchInput.value;
        renderAllPhotosStream();
      });
    }

    const openAddBtn = document.getElementById('btn-open-add-memory');
    if (openAddBtn) openAddBtn.addEventListener('click', openAddMemModal);

    const crudModal = document.getElementById('memory-crud-modal');
    const closeCrudBtn = document.getElementById('memory-modal-close');
    const cancelCrudBtn = document.getElementById('btn-cancel-mem');

    if (closeCrudBtn && crudModal) closeCrudBtn.addEventListener('click', () => crudModal.classList.remove('is-open'));
    if (cancelCrudBtn && crudModal) cancelCrudBtn.addEventListener('click', () => crudModal.classList.remove('is-open'));
    if (crudModal) {
      crudModal.addEventListener('click', (e) => {
        if (e.target === crudModal) crudModal.classList.remove('is-open');
      });
    }

    // Markdown Toolbar actions
    const toolbarTools = document.querySelectorAll('.zen-tb-btn, .btn-tb-tool');
    toolbarTools.forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const action = btn.getAttribute('data-action');
        switch (action) {
          case 'bold':
            insertMarkdown('**', '**', 'chữ in đậm');
            break;
          case 'italic':
            insertMarkdown('*', '*', 'chữ in nghiêng');
            break;
          case 'h3':
            insertMarkdown('\n### ', '\n', 'Tiêu đề phân đoạn');
            break;
          case 'quote':
            insertMarkdown('\n> "', '"\n', 'Lời trích dẫn ngọt ngào...');
            break;
          case 'poem':
            insertMarkdown('\n> 📜 Khổ thơ:\n> ', '\n', 'Dòng thơ 1...\n> Dòng thơ 2...');
            break;
          case 'list':
            insertMarkdown('\n- ', '\n', 'Điều ngọt ngào hai đứa cùng làm');
            break;
          case 'img':
            const tbImgInput = document.getElementById('form-mem-toolbar-img-file') as HTMLInputElement | null;
            if (tbImgInput) {
              tbImgInput.click();
            } else {
              insertMarkdown('\n![', '](https://...)\n', 'Chú thích ảnh');
            }
            break;
        }
      });
    });

    async function compressAndResizeImage(file: File, maxDim = 1400, quality = 0.82): Promise<string> {
      if (!file || !file.type.startsWith('image/')) return '';
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            let width = img.naturalWidth || img.width;
            let height = img.naturalHeight || img.height;
            if (width <= 0 || height <= 0) {
              resolve((e.target?.result as string) || '');
              return;
            }
            
            // Giảm kích thước ảnh quá khổ (4K, 12MP...) về độ phân giải chuẩn Retina nhẹ nhàng
            if (width > maxDim || height > maxDim) {
              if (width > height) {
                height = Math.round((height * maxDim) / width);
                width = maxDim;
              } else {
                width = Math.round((width * maxDim) / height);
                height = maxDim;
              }
            }

            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            if (!ctx) {
              resolve((e.target?.result as string) || '');
              return;
            }

            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';
            ctx.drawImage(img, 0, 0, width, height);

            const mimeType = file.type === 'image/png' ? 'image/webp' : 'image/jpeg';
            try {
              const dataUrl = canvas.toDataURL(mimeType, quality);
              resolve(dataUrl);
            } catch {
              resolve(canvas.toDataURL('image/jpeg', quality));
            }
          };
          img.onerror = () => resolve((e.target?.result as string) || '');
          img.src = (e.target?.result as string) || '';
        };
        reader.onerror = () => resolve('');
        reader.readAsDataURL(file);
      });
    }

    let livePreviewTimer: ReturnType<typeof setTimeout> | null = null;
    function debouncedUpdateLivePreview(delay = 80) {
      if (livePreviewTimer) clearTimeout(livePreviewTimer);
      livePreviewTimer = setTimeout(updateLivePreview, delay);
    }

    // Toolbar direct image file picker handler (Supports multiple photos)
    const tbImgFilePicker = document.getElementById('form-mem-toolbar-img-file') as HTMLInputElement | null;
    if (tbImgFilePicker) {
      tbImgFilePicker.addEventListener('change', async (e: any) => {
        const files: FileList = e.target.files;
        if (!files || files.length === 0) return;
        const validFiles = Array.from(files).filter((f) => f.type.startsWith('image/'));
        if (validFiles.length === 0) return;

        const tokensToInsert: string[] = [];
        for (const file of validFiles) {
          const dataUrl = await compressAndResizeImage(file);
          if (dataUrl) {
            currentAttachedGallery.push({
              id: 'g-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6),
              url: dataUrl,
              caption: file.name.replace(/\.[^/.]+$/, '') || 'Kỷ niệm'
            });
            tokensToInsert.push(`[photo:${currentAttachedGallery.length}]`);
          }
        }
        renderAttachedGalleryEditor();
        if (tokensToInsert.length > 0) {
          insertAtCursor(`\n\n${tokensToInsert.join('\n\n')}\n\n`);
        }
        tbImgFilePicker.value = '';
      });
    }

    // Emoji buttons
    const emojiBtns = document.querySelectorAll('.zen-emoji-btn, .btn-tb-emoji');
    emojiBtns.forEach((btn: any) => {
      btn.addEventListener('click', () => {
        const emoji = btn.getAttribute('data-emoji') || '';
        if (emoji) insertAtCursor(` ${emoji} `);
      });
    });

    // View mode switcher buttons
    const zenEditorBtn = document.getElementById('btn-zen-mode-editor');
    const zenPreviewBtn = document.getElementById('btn-zen-mode-preview');
    if (zenEditorBtn) zenEditorBtn.addEventListener('click', () => setStudioViewMode('editor'));
    if (zenPreviewBtn) zenPreviewBtn.addEventListener('click', () => setStudioViewMode('preview'));

    // Live preview update on inputs (Debounced for 60fps smooth typing)
    const contentTextarea = document.getElementById('form-mem-content');
    if (contentTextarea) {
      contentTextarea.addEventListener('input', () => debouncedUpdateLivePreview(80));
    }

    const liveInputs = ['form-mem-title', 'form-mem-date', 'form-mem-loc', 'form-mem-author', 'form-mem-mood', 'form-mem-weather', 'form-mem-caption'];
    liveInputs.forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', () => debouncedUpdateLivePreview(80));
        el.addEventListener('change', updateLivePreview);
      }
    });

    // Reader Modal controls
    const readerModal = document.getElementById('journal-reader-modal');
    const closeReaderBtn = document.getElementById('journal-reader-close');
    const closeReaderBottom = document.getElementById('btn-reader-close-bottom');
    const editStoryBtn = document.getElementById('btn-reader-edit-story');

    if (closeReaderBtn) closeReaderBtn.addEventListener('click', closeJournalReader);
    if (closeReaderBottom) closeReaderBottom.addEventListener('click', closeJournalReader);
    if (readerModal) {
      readerModal.addEventListener('click', (e) => {
        if (e.target === readerModal) closeJournalReader();
      });
    }

    if (editStoryBtn) {
      editStoryBtn.addEventListener('click', () => {
        closeJournalReader();
        if (currentViewingPhoto) {
          openEditMemModal(currentViewingPhoto);
        }
      });
    }

    // Cover image zoom in reader
    const readerCoverImg = document.getElementById('reader-cover-img');
    if (readerCoverImg) {
      readerCoverImg.addEventListener('click', () => {
        if (currentViewingPhoto) {
          openMemLightbox(currentViewingPhoto.imageUrl, currentViewingPhoto.title);
        }
      });
      readerCoverImg.style.cursor = 'pointer';
      readerCoverImg.title = 'Nhấn để phóng to ảnh bìa';
    }

    // Lightbox close
    const lbModal = document.getElementById('mem-lightbox-modal');
    const lbClose = document.getElementById('mem-lightbox-close');
    if (lbClose && lbModal) lbClose.addEventListener('click', () => lbModal.classList.remove('is-open'));
    if (lbModal) {
      lbModal.addEventListener('click', (e) => {
        if (e.target === lbModal) lbModal.classList.remove('is-open');
      });
    }

    // Dropzone & Drag-and-drop & URL for Cover Image (Supports multiple photos)
    const heroWrap = document.getElementById('zen-cover-hero-wrap');
    const fileInput = document.getElementById('form-mem-file') as HTMLInputElement | null;
    const changeFileBtn = document.getElementById('btn-change-mem-file') as HTMLInputElement | null;
    const activeFileInput = document.getElementById('form-mem-file-active') as HTMLInputElement | null;
    const urlInput = document.getElementById('form-mem-url') as HTMLInputElement | null;
    const clearPhotoBtn = document.getElementById('btn-clear-mem-photo');
    const toggleCoverUrlBtn = document.getElementById('btn-toggle-cover-url');
    const toggleCoverUrlEmptyBtn = document.getElementById('btn-toggle-cover-url-empty');
    const coverUrlBar = document.getElementById('zen-cover-url-bar');
    const confirmCoverUrlBtn = document.getElementById('btn-confirm-cover-url');

    const handleCoverFiles = async (files: FileList | File[]) => {
      const validFiles = Array.from(files).filter((f) => f && f.type.startsWith('image/'));
      if (validFiles.length === 0) return;

      // 1. First image becomes Cover photo (tự động nén thông minh)
      const firstDataUrl = await compressAndResizeImage(validFiles[0]);
      if (firstDataUrl) {
        currentUploadedMemPhoto = firstDataUrl;
        updateMemPhotoPreview(currentUploadedMemPhoto);
      }

      // 2. Extra images (if uploaded multiple) automatically go to Attached Gallery
      if (validFiles.length > 1) {
        for (let i = 1; i < validFiles.length; i++) {
          const extraUrl = await compressAndResizeImage(validFiles[i]);
          if (extraUrl) {
            currentAttachedGallery.push({
              id: 'g-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6),
              url: extraUrl,
              caption: validFiles[i].name.replace(/\.[^/.]+$/, '') || 'Kỷ niệm'
            });
          }
        }
        renderAttachedGalleryEditor();
      }
      updateLivePreview();
    };

    if (fileInput) {
      fileInput.addEventListener('change', (e: any) => {
        if (e.target.files) handleCoverFiles(e.target.files);
      });
    }

    if (changeFileBtn) {
      changeFileBtn.addEventListener('change', (e: any) => {
        if (e.target.files) handleCoverFiles(e.target.files);
      });
    }

    if (activeFileInput) {
      activeFileInput.addEventListener('change', (e: any) => {
        if (e.target.files) handleCoverFiles(e.target.files);
      });
    }

    const toggleUrlBar = () => {
      if (!coverUrlBar) return;
      const isVisible = coverUrlBar.style.display === 'flex';
      coverUrlBar.style.display = isVisible ? 'none' : 'flex';
      if (!isVisible && urlInput) urlInput.focus();
    };

    if (toggleCoverUrlBtn) toggleCoverUrlBtn.addEventListener('click', toggleUrlBar);
    if (toggleCoverUrlEmptyBtn) toggleCoverUrlEmptyBtn.addEventListener('click', toggleUrlBar);

    if (confirmCoverUrlBtn && urlInput) {
      confirmCoverUrlBtn.addEventListener('click', () => {
        const val = urlInput.value.trim();
        if (val) {
          currentUploadedMemPhoto = val;
          updateMemPhotoPreview(val);
          updateLivePreview();
        }
        if (coverUrlBar) coverUrlBar.style.display = 'none';
      });
      urlInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          confirmCoverUrlBtn.click();
        }
      });
    }

    if (heroWrap) {
      ['dragenter', 'dragover'].forEach((evt) => {
        heroWrap.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          heroWrap.classList.add('is-dragover');
        });
      });

      ['dragleave', 'drop'].forEach((evt) => {
        heroWrap.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          heroWrap.classList.remove('is-dragover');
        });
      });

      heroWrap.addEventListener('drop', (e: any) => {
        const files = e.dataTransfer?.files;
        if (files) handleCoverFiles(files);
      });
    }

    if (clearPhotoBtn) {
      clearPhotoBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        currentUploadedMemPhoto = '';
        if (urlInput) urlInput.value = '';
        if (fileInput) fileInput.value = '';
        if (changeFileBtn) changeFileBtn.value = '';
        if (coverUrlBar) coverUrlBar.style.display = 'none';
        updateMemPhotoPreview('');
        updateLivePreview();
      });
    }

    // Attached Gallery: Add Multiple Files at once
    const addGalleryFileBtn = document.getElementById('form-mem-add-gallery-file') as HTMLInputElement | null;
    if (addGalleryFileBtn) {
      addGalleryFileBtn.addEventListener('change', async (e: any) => {
        const files: FileList = e.target.files;
        if (!files || files.length === 0) return;
        const validFiles = Array.from(files).filter((f) => f.type.startsWith('image/'));
        if (validFiles.length === 0) return;

        for (const file of validFiles) {
          const dataUrl = await compressAndResizeImage(file);
          if (dataUrl) {
            currentAttachedGallery.push({
              id: 'g-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6),
              url: dataUrl,
              caption: file.name.replace(/\.[^/.]+$/, '') || 'Kỷ niệm'
            });
          }
        }
        addGalleryFileBtn.value = '';
        renderAttachedGalleryEditor();
        updateLivePreview();
      });
    }

    // Attached Gallery: Add URL
    const addGalleryUrlBtn = document.getElementById('btn-add-gallery-url');
    const galleryUrlInput = document.getElementById('form-gallery-url-input') as HTMLInputElement | null;
    if (addGalleryUrlBtn && galleryUrlInput) {
      addGalleryUrlBtn.addEventListener('click', () => {
        const url = galleryUrlInput.value.trim();
        if (url) {
          addPhotoToGallery(url);
          galleryUrlInput.value = '';
        }
      });
      galleryUrlInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          addGalleryUrlBtn.click();
        }
      });
    }

    // Form submit & Save Memory handler
    const form = document.getElementById('memory-form');
    const btnSaveMem = document.getElementById('btn-save-mem');

    function handleSaveMemory(e?: Event) {
      if (e) e.preventDefault();

      const idEl = document.getElementById('form-mem-id') as HTMLInputElement | null;
      const titleEl = document.getElementById('form-mem-title') as HTMLTextAreaElement | null;
      const dateEl = document.getElementById('form-mem-date') as HTMLInputElement | null;
      const locEl = document.getElementById('form-mem-loc') as HTMLInputElement | null;
      const authorEl = document.getElementById('form-mem-author') as HTMLSelectElement | null;
      const moodEl = document.getElementById('form-mem-mood') as HTMLInputElement | null;
      const weatherEl = document.getElementById('form-mem-weather') as HTMLInputElement | null;
      const captionEl = document.getElementById('form-mem-caption') as HTMLTextAreaElement | null;
      const contentEl = document.getElementById('form-mem-content') as HTMLTextAreaElement | null;
      const pinnedEl = document.getElementById('form-mem-pinned') as HTMLInputElement | null;

      const id = idEl ? idEl.value : '';
      const title = titleEl ? titleEl.value.trim() : '';
      const date = dateEl ? dateEl.value.trim() : new Date().toLocaleDateString('vi-VN');
      const location = locEl ? locEl.value.trim() : 'Bên nhau';
      const author = ((authorEl?.value || 'both') as 'ai' | 'maze' | 'both');
      const mood = moodEl ? moodEl.value.trim() : '';
      const weather = weatherEl ? weatherEl.value.trim() : '';
      const caption = captionEl ? captionEl.value.trim() : '';
      const journalContent = contentEl ? contentEl.value.trim() : '';
      const isPinned = pinnedEl ? pinnedEl.checked : false;

      if (!title) {
        setMobilePane('right');
        if (titleEl) {
          titleEl.focus();
          titleEl.style.borderColor = '#f43f5e';
          titleEl.style.boxShadow = '0 0 16px rgba(244, 63, 94, 0.6)';
          setTimeout(() => {
            if (titleEl) {
              titleEl.style.borderColor = '';
              titleEl.style.boxShadow = '';
            }
          }, 2500);
        }
        alert('🌸 Vui lòng nhập tiêu đề cho trang nhật ký trước khi lưu nhé!');
        return;
      }

      const list = getStoredMemories();

      if (id) {
        const idx = list.findIndex((p) => p.id === id);
        if (idx !== -1) {
          const updatedItem: PhotoMemory = {
            ...list[idx],
            title,
            date,
            location,
            author,
            mood,
            weather,
            caption,
            journalContent,
            isPinned,
            imageUrl: currentUploadedMemPhoto || list[idx].imageUrl || '/photos/anniversary.svg',
            galleryImages: [...currentAttachedGallery]
          };
          list[idx] = updatedItem;

          // If currently viewing in reader, update reader view
          if (currentViewingPhoto && currentViewingPhoto.id === id) {
            currentViewingPhoto = updatedItem;
          }
        }
      } else {
        const newMem: PhotoMemory = {
          id: 'mem-' + Date.now(),
          title,
          date: date || new Date().toLocaleDateString('vi-VN'),
          location: location || 'Bên nhau',
          author,
          mood,
          weather,
          caption,
          journalContent,
          isPinned,
          imageUrl: currentUploadedMemPhoto || '/photos/anniversary.svg',
          galleryImages: [...currentAttachedGallery]
        };
        list.unshift(newMem);
      }

      saveStoredMemories(list);
      renderMemories();
      if (currentPhotoFilter || currentPhotoSearchQuery) {
        renderAllPhotosStream();
      }

      if (crudModal) crudModal.classList.remove('is-open');
    }

    if (form) {
      form.addEventListener('submit', handleSaveMemory);
    }
    if (btnSaveMem) {
      btnSaveMem.addEventListener('click', handleSaveMemory);
    }

    // Realtime sync listener
    window.addEventListener('couple-cloud-updated', (e: any) => {
      const cloudData = e.detail;
      if (cloudData && cloudData.memories) {
        localStorage.setItem(MEMORIES_STORAGE_KEY, JSON.stringify(cloudData.memories));
        renderMemories();
        if (currentViewingPhoto) {
          const refreshed = cloudData.memories.find((m: any) => m.id === currentViewingPhoto?.id);
          if (refreshed) {
            currentViewingPhoto = refreshed;
            const readerModal = document.getElementById('journal-reader-modal');
            if (readerModal && readerModal.classList.contains('is-open')) {
              openJournalReader(refreshed);
            }
          }
        }
      }
    });

    // Item restored from trash listener
    window.addEventListener('couple-item-restored', (e: any) => {
      if (e.detail?.type === 'memory') {
        renderMemories();
      }
    });
  }

  initMemoryInteractive();
  document.addEventListener('astro:page-load', initMemoryInteractive);
  document.addEventListener('astro:after-swap', initMemoryInteractive);
</script>
