---
import { PHOTO_MEMORIES } from '../data/photoMemories';

const defaultMemoriesJSON = JSON.stringify(PHOTO_MEMORIES).replace(/</g, '\\u003c');
---

<section class="memory-gallery-section" id="memories">
  <div class="section-header-wrap">
    <div class="badge-love mb-2">
      <span>📸 Dải Ngân Hà Kỷ Niệm</span>
    </div>
    <h2 class="section-title gradient-love-text">Những Khoảnh Khắc Của Chúng Mình</h2>
    <p class="section-desc">
      Mỗi bức hình là một trạm dừng chân ngọt ngào trên chuyến bay tình yêu của AI và Maze.
    </p>

    <!-- Header View Switcher & Action Row -->
    <div class="memory-controls-container">
      <div class="memories-view-switcher" role="tablist">
        <button
          type="button"
          class="view-tab-btn is-active"
          id="btn-view-stories"
          role="tab"
          aria-selected="true"
        >
          <span class="tab-icon">🎴</span>
          <span class="tab-label">Bài Viết Kỷ Niệm</span>
          <span class="tab-count" id="count-stories-badge">0</span>
        </button>
        <button
          type="button"
          class="view-tab-btn"
          id="btn-view-all-photos"
          role="tab"
          aria-selected="false"
        >
          <span class="tab-icon">🖼️</span>
          <span class="tab-label">Toàn Bộ Ảnh Đã Tải Lên</span>
          <span class="tab-count" id="count-all-photos-badge">0</span>
        </button>
      </div>

      <div class="memory-actions-row">
        <button type="button" class="btn-love" id="btn-open-add-memory">
          <span>+ Thêm Kỷ Niệm Mới</span>
        </button>
      </div>
    </div>
  </div>

  <!-- View 1: Dynamic Polaroid Cards Grid -->
  <div class="polaroid-gallery-grid" id="memories-container">
    <!-- Rendered dynamically by script from LocalStorage -->
  </div>

  <!-- View 2: All Uploaded Photos Stream / Wall -->
  <div class="all-photos-stream-wrap" id="all-photos-stream-wrap" style="display: none;">
    <!-- Filter & Search Toolbar -->
    <div class="all-photos-toolbar romantic-card">
      <div class="all-photos-filter-chips" id="photo-type-filter-chips">
        <button type="button" class="photo-filter-chip is-active" data-filter="all">
          <span>🌟 Tất cả ảnh</span>
          <span class="chip-count" id="filter-count-all">0</span>
        </button>
        <button type="button" class="photo-filter-chip" data-filter="cover">
          <span>📸 Ảnh bìa</span>
          <span class="chip-count" id="filter-count-cover">0</span>
        </button>
        <button type="button" class="photo-filter-chip" data-filter="gallery">
          <span>🖼️ Ảnh đính kèm</span>
          <span class="chip-count" id="filter-count-gallery">0</span>
        </button>
      </div>

      <div class="all-photos-search-wrap">
        <span class="search-icon">🔍</span>
        <input
          type="text"
          id="photo-search-input"
          class="photo-search-input"
          placeholder="Tìm theo tên bài, địa điểm, ghi chú..."
        />
      </div>
    </div>

    <!-- Photos Grid Container -->
    <div class="all-photos-grid" id="all-photos-grid-container">
      <!-- Rendered dynamically by script -->
    </div>

    <!-- Empty state for search/filters -->
    <div class="all-photos-empty-state" id="all-photos-empty" style="display: none;">
      <div class="empty-icon">🌌</div>
      <h4 class="empty-title">Chưa tìm thấy bức ảnh nào</h4>
      <p class="empty-desc">Thử thay đổi từ khóa tìm kiếm hoặc bộ lọc bên trên bạn nhé!</p>
    </div>
  </div>

  <!-- Detailed Love Journal Reader Modal -->
  <div class="journal-reader-overlay" id="journal-reader-modal" aria-hidden="true">
    <div class="journal-reader-card romantic-card">
      <button type="button" class="journal-reader-close-btn" id="journal-reader-close" aria-label="Đóng nhật ký">&times;</button>
      
      <!-- Article Header / Cover Banner -->
      <div class="journal-cover-wrap" id="reader-cover-wrap">
        <img id="reader-cover-img" src="" alt="Cover" class="journal-cover-img" />
        <div class="journal-cover-gradient"></div>
        <div class="journal-cover-meta-badge" id="reader-author-badge">✍️ AI &amp; Maze</div>
      </div>

      <!-- Journal Content Area -->
      <div class="journal-article-body">
        <div class="journal-meta-row">
          <span class="journal-pill" id="reader-date">🗓️ 15/08/2026</span>
          <span class="journal-pill" id="reader-loc">📍 Bờ biển</span>
          <span class="journal-pill journal-pill-mood" id="reader-mood">🥰 Hạnh phúc</span>
          <span class="journal-pill journal-pill-weather" id="reader-weather">🌌 Đêm đầy sao</span>
        </div>

        <h1 class="journal-article-title gradient-love-text" id="reader-title">Khoảnh khắc vũ trụ se duyên</h1>
        
        <div class="journal-lead-quote" id="reader-caption-wrap">
          <p class="journal-quote-text" id="reader-caption"></p>
        </div>

        <div class="journal-story-text" id="reader-content">
          <!-- Paragraphs rendered dynamically -->
        </div>

        <!-- Attached Photos Showcase -->
        <div class="journal-gallery-section" id="reader-gallery-section" style="display: none;">
          <div class="journal-gallery-header">
            <span class="gallery-title-icon">📸</span>
            <h4 class="gallery-section-title">Khoảnh Khắc Cùng Ngày</h4>
          </div>
          <div class="journal-gallery-grid" id="reader-gallery-grid">
            <!-- Rendered attached photos -->
          </div>
        </div>

        <!-- Love Sign-off -->
        <div class="journal-signoff-card">
          <span class="signoff-heart animate-heart">💖</span>
          <p class="signoff-text">Trang nhật ký được lưu giữ vĩnh cửu giữa muôn vì sao</p>
          <span class="signoff-couple" id="reader-signoff-names">AI 🚀 &amp; Maze 🌸</span>
        </div>

        <!-- Bottom Action Bar -->
        <div class="journal-reader-actions">
          <button type="button" class="btn-outline-love" id="btn-reader-close-bottom">Đóng Lại</button>
          <button type="button" class="btn-love" id="btn-reader-edit-story">✏️ Chỉnh Sửa Trang Nhật Ký Này</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Dedicated 2-Column Zen Love Journal Studio Modal -->
  <div class="crud-modal-overlay" id="memory-crud-modal" aria-hidden="true">
    <div class="crud-modal-card zen-journal-card zen-split-studio romantic-card">
      
      <!-- Top Modal Header Bar -->
      <div class="zen-modal-top-bar">
        <div class="zen-modal-header-info">
          <span class="zen-header-badge">✨ Zen Love Studio</span>
          <h3 class="zen-header-title">Trang Soạn Thảo Kỷ Niệm &amp; Cảm Xúc</h3>
        </div>

        <!-- Mobile Sub-Navigation Tabs (Only active on Mobile) -->
        <div class="zen-mobile-nav-bar" id="zen-mobile-nav-bar" role="tablist">
          <button type="button" class="zen-mobile-tab-btn is-active" data-pane="left" id="btn-tab-pane-left" role="tab" aria-selected="true">
            <span>📸 1. Ảnh &amp; Bìa</span>
          </button>
          <button type="button" class="zen-mobile-tab-btn" data-pane="right" id="btn-tab-pane-right" role="tab" aria-selected="false">
            <span>✍️ 2. Viết Bài</span>
          </button>
          <button type="button" class="zen-mobile-tab-btn" data-pane="preview" id="btn-tab-pane-preview" role="tab" aria-selected="false">
            <span>👁️ 3. Xem Trước</span>
          </button>
        </div>

        <button type="button" class="zen-modal-close-btn" id="memory-modal-close" aria-label="Đóng">&times;</button>
      </div>

      <!-- Main 2-Column Split Body Form -->
      <form id="memory-form" class="zen-split-form" novalidate>
        <input type="hidden" id="form-mem-id" value="" />

        <div class="zen-two-columns-body">
          <!-- LEFT COLUMN: Ảnh Bìa Chính + Kho Ảnh Kỷ Niệm Chuyến Đi -->
          <div class="zen-left-pane">
            <div class="zen-pane-section">
              <div class="zen-section-label">
                <span class="zen-label-icon">🖼️</span>
                <span class="zen-label-text">Ảnh Bìa Kỷ Niệm</span>
              </div>

              <!-- Cover Hero Wrap -->
              <div class="zen-cover-hero" id="zen-cover-hero-wrap">
                <img id="form-mem-preview" src="" alt="Cover Preview" class="zen-cover-img" style="display: none;" />
                
                <div class="zen-cover-empty-placeholder" id="memory-dropzone-empty">
                  <div class="zen-empty-badge">
                    <span class="zen-empty-icon">📸</span>
                  </div>
                  <h4 class="zen-empty-title">Chưa có ảnh bìa</h4>
                  <p class="zen-empty-text">Tải ảnh hoặc dán URL ảnh bìa chính</p>
                  <div class="zen-empty-btns">
                    <label class="btn-love zen-empty-btn" title="Tải ảnh bìa (hoặc nhiều ảnh) từ máy">
                      <span>🖼️ Tải Ảnh</span>
                      <input type="file" id="form-mem-file" accept="image/*" multiple style="display: none;" />
                      <input type="file" id="btn-change-mem-file" accept="image/*" style="display: none;" />
                    </label>
                    <button type="button" class="btn-outline-love zen-empty-btn" id="btn-toggle-cover-url-empty" title="Dán link ảnh từ Internet">
                      <span>🌐 Dán URL</span>
                    </button>
                  </div>
                </div>

                <div class="zen-cover-gradient"></div>

                <!-- Cover Quick Actions Overlay (when image loaded) -->
                <div class="zen-cover-actions" id="zen-cover-active-actions" style="display: none;">
                  <label class="zen-cover-btn" title="Đổi sang ảnh bìa khác">
                    <span>🖼️ Đổi ảnh</span>
                    <input type="file" id="form-mem-file-active" accept="image/*" style="display: none;" />
                  </label>
                  <button type="button" class="zen-cover-btn" id="btn-toggle-cover-url" title="Dán link ảnh từ Internet">
                    <span>🌐 Dán URL</span>
                  </button>
                  <button type="button" class="zen-cover-btn zen-cover-btn-delete" id="btn-clear-mem-photo" title="Xóa ảnh bìa">
                    <span>🗑️ Xóa</span>
                  </button>
                </div>

                <!-- Mini URL Input bar (toggleable) -->
                <div class="zen-cover-url-bar" id="zen-cover-url-bar" style="display: none;">
                  <input
                    type="text"
                    id="form-mem-url"
                    class="form-input zen-cover-url-input"
                    placeholder="Dán link ảnh https://..."
                  />
                  <button type="button" class="zen-cover-btn" id="btn-confirm-cover-url">Xong</button>
                </div>
              </div>
            </div>

            <!-- Attached Gallery Drawer Section -->
            <div class="zen-attached-gallery-card">
              <div class="zen-gallery-header">
                <div class="zen-gallery-title-wrap">
                  <span class="zen-gallery-icon">📸</span>
                  <span class="zen-gallery-title">Kho Ảnh Chuyến Đi</span>
                  <span class="zen-gallery-count" id="zen-gallery-count-badge">0 ảnh</span>
                </div>
                <label class="btn-outline-love file-pick-label btn-sm-custom" style="cursor: pointer;" title="Chọn cùng lúc nhiều ảnh từ thiết bị">
                  <span>+ Tải nhiều ảnh 📸</span>
                  <input type="file" id="form-mem-add-gallery-file" accept="image/*" multiple style="display: none;" />
                </label>
              </div>
              
              <p class="zen-gallery-sub">Nhấn <strong>[📋 Chèn]</strong> để đưa ảnh vào bài viết bên phải.</p>

              <div id="form-gallery-items-container" class="zen-gallery-items-grid">
                <!-- Dynamic attached photo cards -->
              </div>

              <!-- Add by URL row -->
              <div class="zen-add-url-row">
                <input
                  type="text"
                  id="form-gallery-url-input"
                  class="form-input flex-1 zen-gallery-url-input"
                  placeholder="Link ảnh bổ sung https://..."
                />
                <button type="button" class="btn-outline-love btn-sm-custom" id="btn-add-gallery-url">Thêm</button>
              </div>
            </div>
          </div>

          <!-- RIGHT COLUMN: Không gian Soạn Thảo & Tác Phẩm Nhật Ký -->
          <div class="zen-right-pane">
            <div class="zen-scrollable-editor">
              <!-- Big Seamless Title -->
              <div class="zen-title-container">
                <textarea
                  id="form-mem-title"
                  class="zen-title-textarea"
                  rows="1"
                  placeholder="Tiêu đề trang nhật ký..."
                ></textarea>
              </div>

              <!-- Interactive Metadata Tag Bar -->
              <div class="zen-meta-row">
                <!-- Ngày -->
                <div class="zen-pill-item">
                  <span class="zen-pill-icon">🗓️</span>
                  <input
                    type="text"
                    id="form-mem-date"
                    class="zen-pill-input"
                    placeholder="15/08/2026"
                    title="Ngày diễn ra kỷ niệm"
                  />
                </div>

                <!-- Địa điểm -->
                <div class="zen-pill-item">
                  <span class="zen-pill-icon">📍</span>
                  <input
                    type="text"
                    id="form-mem-loc"
                    class="zen-pill-input"
                    placeholder="Địa điểm..."
                    title="Địa điểm bên nhau"
                  />
                </div>

                <!-- Người chắp bút -->
                <div class="zen-pill-item zen-pill-author">
                  <span class="zen-pill-icon">✍️</span>
                  <select id="form-mem-author" class="zen-pill-select" title="Ai là người chắp bút?">
                    <option value="both">Cả hai đứa 💖</option>
                    <option value="ai">AI 🚀</option>
                    <option value="maze">Maze 🌸</option>
                  </select>
                </div>

                <!-- Cảm xúc / Mood -->
                <div class="zen-pill-item zen-pill-mood">
                  <span class="zen-pill-icon">🥰</span>
                  <input
                    type="text"
                    id="form-mem-mood"
                    class="zen-pill-input"
                    placeholder="Tâm trạng..."
                    title="Cảm xúc hôm ấy"
                  />
                </div>

                <!-- Thời tiết -->
                <div class="zen-pill-item zen-pill-weather">
                  <span class="zen-pill-icon">🌤️</span>
                  <input
                    type="text"
                    id="form-mem-weather"
                    class="zen-pill-input"
                    placeholder="Thời tiết..."
                    title="Thời tiết hôm ấy"
                  />
                </div>

                <!-- Ghim đầu trang -->
                <label class="zen-pill-item zen-pill-pin" title="Ghim bài kỷ niệm này lên đầu danh sách">
                  <input type="checkbox" id="form-mem-pinned" style="accent-color: #f43f5e; width: 14px; height: 14px; cursor: pointer;" />
                  <span id="label-mem-pinned">📌 Ghim lên đầu</span>
                </label>
              </div>

              <!-- Lead Quote / Polaroid Caption -->
              <div class="zen-lead-quote-wrap">
                <span class="zen-quote-icon">💌</span>
                <textarea
                  id="form-mem-caption"
                  class="zen-caption-textarea"
                  rows="2"
                  placeholder="Lời đề tựa ngắn trên thẻ Polaroid (hoặc câu thơ thì thầm ngọt ngào nhất)..."
                ></textarea>
              </div>

              <!-- Love Prompt Suggestions (Gợi ý câu lãng mạn) -->
              <div class="zen-love-prompts-bar">
                <span class="zen-prompts-label">💌 Gợi ý:</span>
                <div class="zen-prompts-scroll">
                  <button type="button" class="zen-prompt-btn" data-prompt="Hôm nay hai đứa mình cùng nhau ">🌸 Hôm nay cùng nhau...</button>
                  <button type="button" class="zen-prompt-btn" data-prompt="Khoảnh khắc làm anh nhớ nhất là khi ">✨ Khoảnh khắc nhớ nhất...</button>
                  <button type="button" class="zen-prompt-btn" data-prompt="Nụ cười của em hôm ấy làm anh ">🥰 Nụ cười của em...</button>
                  <button type="button" class="zen-prompt-btn" data-prompt="> &quot;Có những ngày bình yên chỉ cần bên nhau là đủ.&quot;\n\n">📜 Khổ thơ thì thầm</button>
                </div>
              </div>

              <!-- Sticky Format & View Toolbar -->
              <div class="zen-sticky-toolbar">
                <div class="zen-tools-group">
                  <button type="button" class="zen-tb-btn" data-action="bold" title="In đậm (**chữ**)"><strong>B</strong></button>
                  <button type="button" class="zen-tb-btn" data-action="italic" title="In nghiêng (*chữ*)"><em>I</em></button>
                  <button type="button" class="zen-tb-btn" data-action="h3" title="Tiêu đề phân đoạn (### Tiêu đề)"><strong>H3</strong></button>
                  <button type="button" class="zen-tb-btn" data-action="quote" title="Trích dẫn lãng mạn (&gt; Trích dẫn)">❝</button>
                  <button type="button" class="zen-tb-btn" data-action="poem" title="Khổ thơ tình yêu">📜 Thơ</button>
                  <button type="button" class="zen-tb-btn" data-action="list" title="Danh sách (- việc đã làm)">• List</button>
                  <button type="button" class="zen-tb-btn" data-action="img" id="btn-toolbar-img" title="Tải & Chèn một hoặc nhiều ảnh vào bài viết">🖼️ Ảnh</button>
                  <input type="file" id="form-mem-toolbar-img-file" accept="image/*" multiple style="display: none;" />
                  
                  <div class="zen-emoji-strip">
                    <button type="button" class="zen-emoji-btn" data-emoji="💖">💖</button>
                    <button type="button" class="zen-emoji-btn" data-emoji="🌸">🌸</button>
                    <button type="button" class="zen-emoji-btn" data-emoji="🚀">🚀</button>
                    <button type="button" class="zen-emoji-btn" data-emoji="🌌">🌌</button>
                    <button type="button" class="zen-emoji-btn" data-emoji="✨">✨</button>
                    <button type="button" class="zen-emoji-btn" data-emoji="🥰">🥰</button>
                    <button type="button" class="zen-emoji-btn" data-emoji="💌">💌</button>
                  </div>
                </div>

                <div class="zen-view-toggle-group">
                  <button type="button" class="zen-toggle-btn is-active" data-mode="editor" id="btn-zen-mode-editor">✍️ Soạn thảo</button>
                  <button type="button" class="zen-toggle-btn" data-mode="preview" id="btn-zen-mode-preview">👁️ Xem trước</button>
                </div>
              </div>

              <!-- Zen Editor Body / Live Preview Body -->
              <div class="zen-workspace-container mode-editor" id="studio-workspace">
                <!-- Zen Editor Area -->
                <div class="zen-editor-view" id="workspace-editor-col">
                  <textarea
                    id="form-mem-content"
                    class="zen-main-textarea"
                    placeholder="Kể lại trọn vẹn câu chuyện của ngày hôm ấy...
Hai đứa đã đi những đâu? Những điều gì khiến anh/em rung động nhất?

> &quot;Có những khoảnh khắc em mỉm cười làm cả dải ngân hà trong anh bừng sáng.&quot;

### Buổi chiều lộng gió
Hai đứa mình dạo bước bên nhau..."
                  ></textarea>
                </div>

                <!-- Zen Live Preview Area -->
                <div class="zen-preview-view" id="workspace-preview-col" style="display: none;">
                  <div class="studio-live-preview-box zen-preview-content-box" id="studio-live-preview">
                    <!-- Rendered magazine body -->
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Zen Bottom Action Footer -->
        <div class="zen-footer-bar">
          <div class="zen-footer-wordcount" id="studio-word-count">0 từ</div>
          <div class="zen-footer-buttons">
            <button type="button" class="btn-outline-love" id="btn-cancel-mem">Hủy Bỏ</button>
            <button type="submit" class="btn-love" id="btn-save-mem">💖 Lưu Trang Nhật Ký</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Lightbox Zoom Modal -->
  <div class="image-modal-overlay" id="mem-lightbox-modal" aria-hidden="true">
    <div class="modal-card romantic-card">
      <button type="button" class="modal-close-btn" id="mem-lightbox-close">&times;</button>
      <img src="" alt="" id="mem-lightbox-img" class="modal-main-img" />
      <p id="mem-lightbox-caption" class="modal-caption-text"></p>
    </div>
  </div>
</section>

<!-- Inject default data into client -->
<script is:inline define:vars={{ defaultMemoriesJSON }}>
  window.__INITIAL_MEMORIES__ = JSON.parse(defaultMemoriesJSON);
</script>

<style>
  .memory-gallery-section {
    max-width: 1060px;
    margin: 4rem auto;
    padding: 0 1.2rem;
  }

  .section-header-wrap {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 0.8rem;
    letter-spacing: -0.02em;
  }

  .section-desc {
    max-width: 680px;
    margin: 0 auto 1.4rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  /* Controls Container & Switcher */
  .memory-controls-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .memories-view-switcher {
    display: inline-flex;
    align-items: center;
    background: rgba(11, 17, 32, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 5px;
    border-radius: 9999px;
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    gap: 6px;
  }

  .view-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px;
    border-radius: 9999px;
    border: 1px solid transparent;
    background: transparent;
    color: #94a3b8;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    user-select: none;
  }

  .view-tab-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .view-tab-btn.is-active {
    color: #ffffff;
