    border-color: #fda4af;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(244, 63, 94, 0.2);
  }

  .zen-modal-close-btn {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    line-height: 1;
  }

  .zen-modal-close-btn:hover {
    background: rgba(244, 63, 94, 0.8);
    border-color: #fda4af;
    color: #ffffff;
    transform: scale(1.08);
  }

  /* Form & 2-Column Split Body Grid */
  .zen-split-form {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .zen-two-columns-body {
    display: grid;
    grid-template-columns: 460px 1fr;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: #080d1a;
  }

  /* =========================================================================
     LEFT PANE: Cover Photo & Attached Gallery Drawer
     ========================================================================= */
  .zen-left-pane {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.3rem;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(11, 17, 32, 0.55);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(244, 63, 94, 0.25) transparent;
  }

  .zen-pane-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .zen-section-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #fda4af;
  }

  .zen-label-icon {
    font-size: 0.9rem;
  }

  /* Left Pane Cover Hero */
  .zen-cover-hero {
    position: relative;
    width: 100%;
    height: 230px;
    min-height: 230px;
    border-radius: 14px;
    background: linear-gradient(135deg, #0d1224 0%, #171026 50%, #200d2b 100%);
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(244, 63, 94, 0.22);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
  }

  .zen-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .zen-cover-hero:hover .zen-cover-img {
    transform: scale(1.03);
  }

  .zen-cover-empty-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 1.1rem;
    text-align: center;
    z-index: 2;
    border: 1.5px dashed rgba(244, 63, 94, 0.35);
    border-radius: 12px;
    margin: 0.6rem;
    width: calc(100% - 1.2rem);
    height: calc(100% - 1.2rem);
    background: rgba(11, 17, 32, 0.65);
    backdrop-filter: blur(8px);
    transition: all 0.25s ease;
  }

  .zen-cover-empty-placeholder:hover {
    border-color: #fda4af;
    background: rgba(11, 17, 32, 0.85);
    box-shadow: 0 0 16px rgba(244, 63, 94, 0.18);
  }

  .zen-empty-badge {
    font-size: 1.6rem;
    filter: drop-shadow(0 0 8px rgba(244, 63, 94, 0.4));
  }

  .zen-empty-title {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .zen-empty-text {
    font-size: 0.78rem;
    color: #94a3b8;
    margin: 0 0 2px;
  }

  .zen-empty-btns {
    display: flex;
    gap: 6px;
    margin-top: 4px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .zen-empty-btn {
    min-height: 32px !important;
    padding: 4px 14px !important;
    font-size: 0.8rem !important;
    border-radius: 9999px !important;
  }

  .zen-cover-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(9, 14, 26, 0.05) 0%, rgba(9, 14, 26, 0.35) 60%, rgba(9, 14, 26, 0.92) 100%);
    pointer-events: none;
  }

  .zen-cover-actions {
    position: absolute;
    bottom: 10px;
    right: 10px;
    display: flex;
    gap: 5px;
    z-index: 5;
    background: rgba(11, 17, 32, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 4px 6px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
  }

  .zen-cover-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fda4af;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  .zen-cover-btn:hover {
    background: linear-gradient(135deg, #f43f5e, #9333ea);
    color: #ffffff;
    border-color: #fda4af;
    transform: translateY(-1px);
    box-shadow: 0 0 10px rgba(244, 63, 94, 0.4);
  }

  .zen-cover-btn-delete:hover {
    background: rgba(239, 68, 68, 0.85);
    border-color: #f87171;
  }

  .zen-cover-url-bar {
    position: absolute;
    bottom: 8px;
    left: 10px;
    right: 10px;
    display: flex;
    gap: 6px;
    z-index: 6;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(12px);
    padding: 5px 7px;
    border-radius: 10px;
    border: 1px solid rgba(244, 63, 94, 0.4);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
  }

  .zen-cover-url-input {
    font-size: 0.8rem !important;
    padding: 5px 9px !important;
    min-height: 32px !important;
  }

  /* Left Pane Attached Gallery Card */
  .zen-attached-gallery-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .zen-gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .zen-gallery-title-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: #fda4af;
    font-size: 0.88rem;
  }

  .zen-gallery-count {
    font-size: 0.72rem;
    background: rgba(244, 63, 94, 0.2);
    padding: 2px 7px;
    border-radius: 9999px;
    color: #fecdd3;
  }

  .zen-gallery-sub {
    font-size: 0.76rem;
    color: #94a3b8;
    margin: 0;
    font-style: italic;
    line-height: 1.35;
  }

  .zen-gallery-items-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 270px;
    overflow-y: auto;
    padding-right: 4px;
    scrollbar-width: thin;
    scrollbar-color: rgba(244, 63, 94, 0.25) transparent;
  }

  :global(.gallery-edit-item) {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.09);
    padding: 8px 10px;
    border-radius: 12px;
    transition: all 0.2s ease;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
  }

  :global(.gallery-edit-item:hover) {
    border-color: rgba(244, 63, 94, 0.4);
    background: rgba(15, 23, 42, 0.98);
  }

  :global(.gallery-thumb-wrap) {
    position: relative;
    width: 62px;
    height: 62px;
    flex-shrink: 0;
  }

  :global(.gallery-edit-thumb) {
    width: 62px !important;
    height: 62px !important;
    min-width: 62px !important;
    min-height: 62px !important;
    max-width: 62px !important;
    max-height: 62px !important;
    border-radius: 8px;
    object-fit: cover !important;
    flex-shrink: 0;
    border: 1px solid rgba(244, 63, 94, 0.3);
    background: #020617;
    display: block;
  }

  :global(.gallery-thumb-tag) {
    position: absolute;
    bottom: 2px;
    right: 2px;
    background: rgba(0, 0, 0, 0.85);
    color: #fda4af;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid rgba(244, 63, 94, 0.3);
  }

  :global(.gallery-edit-info) {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
    min-width: 0;
  }

  :global(.gallery-item-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
  }

  :global(.gallery-item-badge) {
    font-size: 0.78rem;
    font-weight: 700;
    color: #fda4af;
  }

  :global(.gallery-token-code) {
    font-size: 0.7rem;
    background: rgba(244, 63, 94, 0.15);
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #fbcfe8;
    padding: 1px 6px;
    border-radius: 4px;
    font-family: monospace;
    font-weight: 700;
  }

  :global(.gallery-caption-input) {
    font-size: 0.8rem !important;
    padding: 5px 8px !important;
    min-height: 30px !important;
    width: 100%;
    background: rgba(2, 6, 23, 0.7) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 6px !important;
    color: #f1f5f9 !important;
  }

  :global(.gallery-caption-input:focus) {
    border-color: #fda4af !important;
    background: rgba(2, 6, 23, 0.95) !important;
    box-shadow: 0 0 8px rgba(244, 63, 94, 0.25) !important;
  }

  :global(.gallery-item-actions) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: stretch;
    flex-shrink: 0;
  }

  :global(.btn-insert-inline-img) {
    background: linear-gradient(135deg, rgba(244, 63, 94, 0.25), rgba(147, 51, 234, 0.25));
    border: 1px solid rgba(244, 63, 94, 0.45);
    color: #fda4af;
    padding: 5px 9px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  :global(.btn-insert-inline-img:hover) {
    background: linear-gradient(135deg, #e11d48, #9333ea);
    color: #ffffff;
    border-color: #fda4af;
    transform: translateY(-1px);
    box-shadow: 0 0 10px rgba(244, 63, 94, 0.35);
  }

  :global(.btn-insert-inline-img.is-inserted) {
    background: linear-gradient(135deg, #059669, #10b981) !important;
    color: #ffffff !important;
    border-color: #34d399 !important;
  }

  :global(.btn-remove-gallery-item) {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #fca5a5;
    padding: 4px 6px;
    border-radius: 6px;
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
  }

  :global(.btn-remove-gallery-item:hover) {
    background: rgba(239, 68, 68, 0.85);
    color: #ffffff;
    border-color: #f87171;
  }

  .zen-add-url-row {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-top: 2px;
  }

  .zen-gallery-url-input {
    font-size: 0.78rem !important;
    padding: 4px 8px !important;
    min-height: 30px !important;
  }

  /* =========================================================================
     RIGHT PANE: Writing Studio / Markdown Editor / Live Preview
     ========================================================================= */
  .zen-right-pane {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #080d1a;
  }

  .zen-scrollable-editor {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1.4rem 2rem 2.2rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(244, 63, 94, 0.25) transparent;
  }

  /* Seamless Title Input */
  .zen-title-container {
    margin-bottom: 0.85rem;
  }

  .zen-title-textarea {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.85rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.3;
    font-family: var(--sans);
    resize: none;
    letter-spacing: -0.015em;
    padding: 0;
  }

  .zen-title-textarea::placeholder {
    color: rgba(148, 163, 184, 0.35);
    font-weight: 700;
  }

  /* Meta Pills Bar */
  .zen-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 1rem;
    align-items: center;
  }

  .zen-pill-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(30, 41, 59, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    padding: 4px 11px;
    font-size: 0.8rem;
    color: #cbd5e1;
    transition: all 0.2s;
    height: 32px;
    box-sizing: border-box;
  }

  .zen-pill-item:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(30, 41, 59, 0.75);
  }

  .zen-pill-item:focus-within {
    border-color: #fda4af;
    background: rgba(30, 41, 59, 0.95);
    box-shadow: 0 0 10px rgba(244, 63, 94, 0.25);
  }

  .zen-pill-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  .zen-pill-input {
    background: transparent;
    border: none;
    outline: none;
    color: #f1f5f9;
    font-size: 0.8rem;
    font-family: inherit;
    width: 95px;
  }

  .zen-pill-input::placeholder {
    color: #64748b;
  }

  .zen-pill-select {
    background: transparent;
    border: none;
    outline: none;
    color: #fda4af;
    font-size: 0.8rem;
    font-family: inherit;
    cursor: pointer;
    font-weight: 600;
  }

  .zen-pill-select option {
    background: #0f172a;
    color: #f8fafc;
  }

  .zen-pill-mood {
    border-color: rgba(244, 63, 94, 0.3);
    background: rgba(244, 63, 94, 0.1);
  }

  .zen-pill-weather {
    border-color: rgba(56, 189, 248, 0.3);
    background: rgba(56, 189, 248, 0.1);
  }

  .zen-pill-pin {
    cursor: pointer;
  }

  /* Lead Quote / Polaroid Caption */
  .zen-lead-quote-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    border-left: 3px solid #f43f5e;
    background: rgba(244, 63, 94, 0.06);
    padding: 0.6rem 1rem;
    border-radius: 0 12px 12px 0;
    margin-bottom: 1rem;
  }

  .zen-quote-icon {
    font-size: 1.05rem;
    opacity: 0.85;
  }

  .zen-caption-textarea {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--body);
    font-style: italic;
    font-size: 0.92rem;
    color: #fbcfe8;
    line-height: 1.45;
    resize: none;
    padding: 0;
  }

  .zen-caption-textarea::placeholder {
    color: rgba(244, 63, 94, 0.4);
  }

  /* Sticky Format & View Toolbar */
  .zen-sticky-toolbar {
    position: sticky;
    top: -1.4rem;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    background: rgba(15, 23, 42, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 6px 10px;
    margin-bottom: 1rem;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }

  .zen-tools-group {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .zen-tb-btn {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #f1f5f9;
    font-size: 0.8rem;
    padding: 4px 9px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.18s;
    font-weight: 600;
  }

  .zen-tb-btn:hover {
    background: rgba(244, 63, 94, 0.25);
    border-color: #fda4af;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .zen-emoji-strip {
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(2, 6, 23, 0.6);
    padding: 2px 6px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin-left: 4px;
  }

  .zen-emoji-btn {
    background: none;
    border: none;
    font-size: 1rem;
    cursor: pointer;
    padding: 2px 3px;
    border-radius: 4px;
    transition: transform 0.15s;
  }

  .zen-emoji-btn:hover {
    transform: scale(1.25);
    background: rgba(244, 63, 94, 0.2);
  }

  .zen-view-toggle-group {
    display: flex;
    gap: 2px;
    background: rgba(2, 6, 23, 0.7);
    padding: 3px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .zen-toggle-btn {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 11px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .zen-toggle-btn.is-active {
    background: linear-gradient(135deg, #e11d48, #9333ea);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(225, 29, 72, 0.4);
  }

  /* Workspace */
  .zen-workspace-container {
    margin-bottom: 1rem;
  }

  .zen-main-textarea {
    width: 100%;
    min-height: 380px;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--body), Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.85;
    color: #f1f5f9;
    resize: none;
    padding: 0;
  }

  .zen-main-textarea::placeholder {
    color: rgba(148, 163, 184, 0.35);
    font-style: italic;
  }

  .zen-preview-content-box {
    min-height: 380px;
    background: rgba(2, 6, 23, 0.4);
    border-radius: 12px;
    padding: 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Bottom Footer Bar */
  .zen-footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1.6rem;
    background: rgba(15, 23, 42, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  .zen-footer-wordcount {
    font-size: 0.8rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.05);
    padding: 3px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .zen-footer-buttons {
    display: flex;
    gap: 10px;
  }

  @media (max-width: 960px) {
    .zen-journal-card.zen-split-studio {
      width: 98vw;
      height: 96vh;
      max-height: 96vh;
    }
    .zen-two-columns-body {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
    .zen-left-pane {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      overflow-y: visible;
    }
    .zen-scrollable-editor {
      overflow-y: visible;
    }
  }

  /* Inline Markdown rendered elements (Reader & Preview) */
  :global(.journal-inline-img-wrap) {
    margin: 1.8rem 0;
    text-align: center;
  }

  :global(.journal-inline-img) {
    max-width: 100%;
    max-height: 400px;
    object-fit: contain;
    border-radius: 12px;
    border: 1px solid rgba(244, 63, 94, 0.35);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    display: block;
    margin: 0 auto;
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  :global(.journal-inline-img:hover) {
    transform: scale(1.02);
    border-color: #fda4af;
  }

  :global(.journal-inline-caption) {
    margin-top: 8px;
    font-size: 0.85rem;
    color: #fbcfe8;
    font-style: italic;
    font-family: var(--body);
  }

  :global(.journal-subheading) {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fda4af;
    margin: 1.6rem 0 0.8rem;
  }

  :global(.journal-heading) {
    font-size: 1.45rem;
    font-weight: 800;
    color: #fda4af;
    margin: 1.8rem 0 0.9rem;
  }

  :global(.journal-quote) {
    border-left: 3px solid #f43f5e;
    background: rgba(244, 63, 94, 0.1);
    padding: 0.8rem 1.2rem;
    border-radius: 0 10px 10px 0;
    margin: 1.4rem 0;
  }

