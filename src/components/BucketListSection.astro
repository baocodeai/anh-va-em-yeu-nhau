---
import { BUCKET_LIST } from '../data/bucketList';

const defaultBucketJSON = JSON.stringify(BUCKET_LIST).replace(/</g, '\\u003c');
const categories = [
  'Tất cả',
  'Đã hoàn thành',
  'Đang ấp ủ',
  'Hẹn hò lãng mạn',
  'Du lịch & Khám phá',
  'Trải nghiệm mới lạ',
  'Tương lai đôi lứa'
];
---

<section class="bucket-list-section" id="bucket-list">
  <div class="section-header-wrap">
    <div class="badge-love mb-2">
      <span>💫 Bản Đồ Nguyện Ước Của Hai Đứa</span>
    </div>
    <h2 class="section-title gradient-love-text">Những Điều Sẽ Làm Cùng Nhau Trong Lúc Yêu</h2>
    <p class="section-desc">
      Từng điều ước nhỏ bé là một tọa độ hạnh phúc mà AI &amp; Maze đã và đang cùng nhau chinh phục giữa dải ngân hà.
    </p>

    <!-- Header Actions & Counter -->
    <div class="header-actions-row">
      <div class="bucket-stats-card romantic-card">
        <div class="stats-counter-line">
          <span class="heart-pulse">💖</span>
          <span class="bucket-stats-text" id="bucket-counter-text">
            Đang tải dữ liệu...
          </span>
        </div>
        <div class="stats-progress-track">
          <div class="stats-progress-fill" id="bucket-progress-fill" style="width: 0%;"></div>
        </div>
      </div>

      <div class="bucket-header-btns">
        <button type="button" class="btn-love add-item-btn" id="btn-open-add-bucket">
          <span>+ Thêm Điều Ước Mới</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Filter & Sort Bar -->
  <div class="bucket-controls-bar">
    <div class="bucket-filters-wrap" id="bucket-filters-container">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`filter-btn ${idx === 0 ? 'is-active' : ''}`}
          data-filter={cat}
        >
          {cat === 'Đã hoàn thành' && '❤️ '}
          {cat === 'Đang ấp ủ' && '⏳ '}
          {cat}
        </button>
      ))}
    </div>

    <div class="bucket-sort-wrap">
      <button type="button" class="btn-outline-love btn-create-category-btn" id="btn-open-category-manager" title="Quản lý, thêm, sửa & xóa phân loại danh mục">
        <span>🏷️ Quản Lý Danh Mục</span>
      </button>
      <button type="button" class="btn-sort-toggle" id="btn-toggle-bucket-sort" title="Nhấn để đổi thứ tự: Mới nhất / Cũ nhất">
        <span class="sort-icon" id="bucket-sort-icon">⏳</span>
        <span id="bucket-sort-label">Mới tạo nhất trước</span>
        <span class="sort-arrow" id="bucket-sort-arrow">↓</span>
      </button>
    </div>
  </div>

  <!-- Dynamic Bucket Checklist Container -->
  <div class="bucket-checklist-container" id="bucket-cards-container">
    <!-- Rendered dynamically as checklist rows by client script from LocalStorage -->
  </div>

  <!-- Category Management Hub Modal -->
  <div class="crud-modal-overlay" id="category-manager-modal" aria-hidden="true">
    <div class="crud-modal-card category-manager-card romantic-card">
      <div class="compact-modal-header">
        <div class="modal-title-wrap">
          <span class="modal-title-icon">🏷️</span>
          <h3 class="modal-title gradient-love-text">Quản Lý Danh Mục Điều Ước</h3>
        </div>
        <button type="button" class="modal-close-btn" id="cat-mgr-close" aria-label="Đóng">&times;</button>
      </div>

      <div class="cat-mgr-body">
        <p class="cat-mgr-desc">
          Tạo mới, đổi tên hoặc xóa danh mục. Khi đổi tên, các điều ước cũ sẽ <strong>tự động đổi tên đồng loạt</strong> mà không bị mất.
        </p>

        <!-- Quick Add Row -->
        <div class="cat-mgr-add-row">
          <input
            type="text"
            id="cat-mgr-new-input"
            class="form-input flex-1"
            placeholder="Nhập tên danh mục mới (VD: 🏡 Tổ ấm, 🐾 Thú cưng...)"
          />
          <button type="button" class="btn-love" id="cat-mgr-btn-add">➕ Thêm</button>
        </div>

        <!-- Category List -->
        <div class="cat-mgr-list" id="cat-mgr-list-container">
          <!-- Dynamically rendered categories -->
        </div>

        <div class="form-actions compact-actions" style="margin-top: 1.4rem;">
          <button type="button" class="btn-outline-love" id="cat-mgr-btn-done">Đóng Bảng Quản Lý</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Category Delete & Interactive Migration Modal (Lựa chọn 2) -->
  <div class="crud-modal-overlay" id="category-migration-modal" aria-hidden="true">
    <div class="crud-modal-card category-migration-card romantic-card">
      <div class="compact-modal-header">
        <div class="modal-title-wrap">
          <span class="modal-title-icon">📦</span>
          <h3 class="modal-title gradient-rose-text">Dời Điều Ước Trước Khi Xóa</h3>
        </div>
        <button type="button" class="modal-close-btn" id="cat-mig-close" aria-label="Đóng">&times;</button>
      </div>

      <div class="cat-mig-body">
        <div class="cat-mig-notice-box">
          <p id="cat-mig-message" class="cat-mig-main-msg">
            Danh mục đang có <strong>3 điều ước</strong> cùng nhau.
          </p>
          <p class="cat-mig-sub-msg">
            Hãy chọn một danh mục mới để dời tất cả điều ước này sang trước khi xóa danh mục cũ nhé:
          </p>
        </div>

        <div class="form-group" style="margin-top: 1.1rem;">
          <label class="form-label" for="cat-mig-target-select">🌸 Chọn danh mục mới chuyển tới:</label>
          <select id="cat-mig-target-select" class="form-select"></select>
        </div>

        <div class="form-actions compact-actions" style="margin-top: 1.4rem;">
          <button type="button" class="btn-outline-love" id="cat-mig-btn-cancel">Hủy</button>
          <button type="button" class="btn-love is-danger-action" id="cat-mig-btn-confirm">
            <span>📦 Chuyển &amp; Xóa Danh Mục</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick & Clean Romantic Modal for Adding / Editing Bucket Item -->
  <div class="crud-modal-overlay" id="bucket-crud-modal" aria-hidden="true">
    <div class="crud-modal-card compact-bucket-modal romantic-card">
      <div class="compact-modal-header">
        <div class="modal-title-wrap">
          <span class="modal-title-icon">💫</span>
          <h3 class="modal-title gradient-love-text" id="bucket-modal-title">Thêm Điều Ước Mới</h3>
        </div>
        <button type="button" class="modal-close-btn" id="bucket-modal-close" aria-label="Đóng">&times;</button>
      </div>

      <form id="bucket-form" class="compact-bucket-form crud-form">
        <input type="hidden" id="form-item-id" value="" />

        <div class="form-group">
          <label class="form-label" for="form-title">✨ Tên điều ước / Việc muốn làm cùng nhau <span style="color: #fda4af;">*</span></label>
          <input
            type="text"
            id="form-title"
            class="form-input"
            required
            placeholder="Ví dụ: Cùng nhau ngắm hoàng hôn bên bờ biển..."
          />
        </div>

        <div class="modal-grid-row">
          <div class="form-group">
            <div class="category-label-row">
              <label class="form-label" for="form-category">Phân loại danh mục</label>
              <button type="button" class="btn-inline-cat-action" id="btn-toggle-inline-cat" title="Tạo danh mục mới">+ Tạo danh mục</button>
            </div>
            <select id="form-category" class="form-select">
              <option value="Hẹn hò lãng mạn">💖 Hẹn hò lãng mạn</option>
              <option value="Du lịch & Khám phá">🏖️ Du lịch &amp; Khám phá</option>
              <option value="Trải nghiệm mới lạ">✨ Trải nghiệm mới lạ</option>
              <option value="Tương lai đôi lứa">💍 Tương lai đôi lứa</option>
            </select>
            <!-- Inline Mini Drawer for Creating New Category inside Modal -->
            <div class="inline-new-cat-box" id="box-inline-new-cat" style="display: none;">
              <input
                type="text"
                id="input-new-cat-name"
                class="form-input new-cat-input"
                placeholder="Nhập tên danh mục (VD: 🏡 Tổ ấm, 🐾 Thú cưng...)"
              />
              <div class="inline-cat-btns">
                <button type="button" class="btn-love btn-sm" id="btn-apply-new-cat">Thêm</button>
                <button type="button" class="btn-outline-love btn-sm" id="btn-cancel-new-cat">Đóng</button>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="form-created-date">🌱 Ngày tạo điều ước</label>
            <input
              type="date"
              id="form-created-date"
              class="form-input"
            />
          </div>
        </div>

        <div class="modal-grid-row">
          <div class="form-group">
            <label class="form-label">Trạng thái thực hiện</label>
            <label class="checkbox-toggle-pill">
              <input type="checkbox" id="form-completed" />
              <span id="label-bucket-completed-text">🤍 Đang ấp ủ làm</span>
            </label>
          </div>

          <div class="form-group" id="group-completed-date" style="display: none;">
            <label class="form-label" for="form-completed-date">🗓️ Ngày hoàn thành</label>
            <input
              type="date"
              id="form-completed-date"
              class="form-input"
            />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="form-desc">Mô tả / Ghi chú cảm xúc (Tùy chọn)</label>
          <textarea
            id="form-desc"
            class="form-textarea"
            rows="3"
            placeholder="Ghi lại đôi dòng kỷ niệm, địa điểm hoặc cảm xúc của hai đứa..."
          ></textarea>
        </div>

        <!-- Sub-tasks / Milestones Checklist Builder -->
        <div class="form-group subtasks-builder-group">
          <div class="subtasks-builder-header">
            <label class="form-label" style="margin-bottom: 0;">📍 Các chặng mục tiêu con (Checklist đa tầng)</label>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <button type="button" class="btn-add-subtask-row" id="btn-add-form-group">+ Thêm Nhóm / Chặng</button>
              <button type="button" class="btn-add-subtask-row" id="btn-add-form-subtask" style="background: rgba(244, 63, 94, 0.15); border-color: rgba(244, 63, 94, 0.35); color: #fda4af;">+ Thêm Mục Đơn</button>
            </div>
          </div>
          <p class="subtasks-builder-sub">
            Tạo các nhóm chặng lớn (VD: Miền Bắc, Đông Nam Á...) và thêm các địa điểm nhỏ bên trong. Hoàn thành tất cả các mục nhỏ sẽ tự động hoàn thành nhóm và điều ước lớn!
          </p>
          <div class="subtasks-input-list" id="form-subtasks-container">
            <!-- Dynamically rendered subtask input rows & groups -->
          </div>
        </div>

        <div class="form-actions compact-actions">
          <button type="button" class="btn-outline-love" id="btn-cancel-bucket">Hủy Bỏ</button>
          <button type="button" class="btn-love" id="btn-save-bucket">💖 Lưu Điều Ước</button>
        </div>
      </form>
    </div>
  </div>
</section>

<!-- Inject default data into client -->
<script is:inline define:vars={{ defaultBucketJSON }}>
  window.__INITIAL_BUCKET_LIST__ = JSON.parse(defaultBucketJSON);
</script>

<style>
  .bucket-list-section {
    max-width: 920px;
    margin: 4.5rem auto;
    padding: 0 1.2rem;
  }

  .section-header-wrap {
    text-align: center;
    margin-bottom: 2.2rem;
  }

  .section-title {
    font-size: 2.3rem;
    font-weight: 800;
    margin-bottom: 0.8rem;
    letter-spacing: -0.02em;
  }

  .section-desc {
    max-width: 680px;
    margin: 0 auto 1.6rem;
    color: #94a3b8;
    line-height: 1.65;
    font-size: 1rem;
  }

  .header-actions-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .bucket-header-btns {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .bucket-stats-card {
    padding: 0.75rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 280px;
    background: rgba(11, 17, 32, 0.85);
    border: 1px solid rgba(244, 63, 94, 0.3);
    border-radius: 9999px;
  }

  .stats-counter-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.92rem;
    color: #fecdd3;
  }

  .stats-progress-track {
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
  }

  .stats-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #f43f5e, #c084fc, #38bdf8);
    border-radius: 9999px;
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 10px rgba(244, 63, 94, 0.6);
  }

  .heart-pulse {
    animation: heartBeat 1.8s infinite;
  }

  /* Controls Bar (Filters & Sorting) */
  .bucket-controls-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .bucket-filters-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .bucket-sort-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .btn-create-category-btn {
    padding: 7px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 9999px;
  }

  .btn-sort-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(11, 17, 32, 0.8);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 9999px;
    padding: 7px 18px;
    font-size: 0.88rem;
    color: #7dd3fc;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    font-weight: 600;
    user-select: none;
    backdrop-filter: blur(10px);
  }

  .btn-sort-toggle:hover {
    background: rgba(56, 189, 248, 0.15);
    border-color: #38bdf8;
    color: #ffffff;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.3);
    transform: translateY(-2px);
  }

  .btn-sort-toggle .sort-icon {
    font-size: 1rem;
  }

  .btn-sort-toggle .sort-arrow {
    font-size: 0.9rem;
    font-weight: 800;
  }

  :global(.filter-btn) {
    background: rgba(11, 17, 32, 0.8) !important;
    border: 1px solid rgba(255, 255, 255, 0.16) !important;
    border-radius: 9999px !important;
    padding: 8px 18px !important;
    font-size: 0.88rem !important;
    color: #cbd5e1 !important;
    cursor: pointer !important;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    user-select: none !important;
    white-space: nowrap !important;
    position: relative !important;
    backdrop-filter: blur(10px) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  :global(.filter-btn:hover) {
    border-color: #fda4af !important;
    color: #ffffff !important;
    box-shadow: 0 0 16px rgba(244, 63, 94, 0.4) !important;
    transform: translateY(-2px) !important;
  }

  :global(.filter-btn.is-active) {
    background: linear-gradient(135deg, #e11d48 0%, #f43f5e 50%, #9333ea 100%) !important;
    border-color: rgba(255, 255, 255, 0.5) !important;
    color: #ffffff !important;
    font-weight: 800 !important;
    box-shadow: 0 0 24px rgba(244, 63, 94, 0.85), 0 0 45px rgba(168, 85, 247, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.45) !important;
    transform: translateY(-2px) scale(1.06) !important;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.7) !important;
  }

  :global(.filter-btn.is-active::after) {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 18px;
    height: 3px;
    background: #fbbf24;
    border-radius: 9999px;
    box-shadow: 0 0 10px #fbbf24;
  }

  /* =========================================================================
     BUCKET CHECKLIST CONTAINER & ITEMS
     ========================================================================= */
  .bucket-checklist-container {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  :global(.bucket-check-row) {
    background: rgba(11, 17, 32, 0.78);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 1.1rem 1.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    box-shadow: var(--card-glow);
  }

  :global(.bucket-check-row:hover) {
    border-color: var(--card-border-hover);
    box-shadow: var(--card-glow-hover);
    transform: translateY(-2px);
  }

  :global(.bucket-check-row.is-completed) {
    border-left: 4px solid var(--love-rose);
    background: linear-gradient(90deg, rgba(244, 63, 94, 0.08) 0%, rgba(11, 17, 32, 0.85) 100%);
  }

  :global(.bucket-check-row.is-pending) {
    border-left: 4px solid var(--love-cyan);
    background: linear-gradient(90deg, rgba(56, 189, 248, 0.05) 0%, rgba(11, 17, 32, 0.85) 100%);
  }

  :global(.check-left-col) {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    flex: 1;
    min-width: 0;
  }

  :global(.check-toggle-btn) {
    background: rgba(255, 255, 255, 0.06);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.1rem;
    transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    margin-top: 2px;
  }

  :global(.check-toggle-btn:hover) {
    transform: scale(1.15);
    border-color: #fda4af;
    box-shadow: 0 0 16px rgba(244, 63, 94, 0.4);
  }

  :global(.check-toggle-btn.is-done) {
    background: linear-gradient(135deg, #e11d48, #f43f5e);
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: 0 0 16px rgba(244, 63, 94, 0.45);
  }

  :global(.check-info-block) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
    min-width: 0;
  }

  :global(.check-title-line) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  :global(.check-title-text) {
    font-size: 1.08rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.4;
    transition: color 0.2s;
  }

  :global(.check-title-text.is-done) {
    color: #fecdd3;
  }

  :global(.check-meta-line) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
  }

  :global(.check-cat-badge) {
    font-size: 0.75rem;
    padding: 2px 10px;
    border-radius: 9999px;
    font-weight: 600;
  }

  :global(.badge-cat-romantic) {
    background: rgba(244, 63, 94, 0.15);
    border: 1px solid rgba(244, 63, 94, 0.35);
    color: #fda4af;
  }

  :global(.badge-cat-travel) {
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #7dd3fc;
  }

  :global(.badge-cat-experience) {
    background: rgba(251, 191, 36, 0.15);
    border: 1px solid rgba(251, 191, 36, 0.35);
    color: #fde047;
  }

  :global(.badge-cat-future) {
    background: rgba(192, 132, 252, 0.15);
    border: 1px solid rgba(192, 132, 252, 0.35);
    color: #d8b4fe;
  }

  :global(.badge-cat-custom) {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(56, 189, 248, 0.15));
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #e9d5ff;
    box-shadow: 0 0 10px rgba(168, 85, 247, 0.15);
  }

  /* Inline Category Creation Box */
  .category-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .btn-inline-cat-action {
    background: none;
    border: none;
    color: #38bdf8;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .btn-inline-cat-action:hover {
