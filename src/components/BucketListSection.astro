</style>

<script>
  import { pushDataToFirebase } from '../lib/firebaseClient';
  import { moveItemToTrash } from '../lib/trashBin';

  const STORAGE_KEY = 'couple_bucket_list';
  const CATEGORIES_KEY = 'couple_bucket_categories';
  const DEFAULT_CATEGORIES = [
    'Hẹn hò lãng mạn',
    'Du lịch & Khám phá',
    'Trải nghiệm mới lạ',
    'Tương lai đôi lứa'
  ];

  let sortOrder: 'desc' | 'asc' = 'desc';
  let activeFilter = 'Tất cả';

  function escapeHtml(str: string): string {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function getStoredBucketList(): any[] {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) return JSON.parse(stored);
    } catch {}
    const initial = (window as any).__INITIAL_BUCKET_LIST__ || [];
    localStorage.setItem(STORAGE_KEY, JSON.stringify(initial));
    return initial;
  }

  function saveStoredBucketList(list: any[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    pushDataToFirebase({ bucketList: list, lastUpdatedBy: 'BucketList' }).catch(() => {});
  }

  function getStoredCategories(): string[] {
    let list: string[] = [];
    try {
      const stored = localStorage.getItem(CATEGORIES_KEY);
      if (stored) list = JSON.parse(stored);
    } catch {}

    // Ensure defaults and items' categories are included
    const set = new Set([...DEFAULT_CATEGORIES, ...list]);
    const items = getStoredBucketList();
    items.forEach((item) => {
      if (item.category && typeof item.category === 'string') {
        set.add(item.category.trim());
      }
    });

    const result = Array.from(set).filter(Boolean);
    return result;
  }

  function saveStoredCategories(cats: string[]) {
    localStorage.setItem(CATEGORIES_KEY, JSON.stringify(cats));
    pushDataToFirebase({ bucketCategories: cats, lastUpdatedBy: 'BucketCategory' }).catch(() => {});
  }

  function addCustomCategory(rawName: string): string | null {
    const name = (rawName || '').trim();
    if (!name) return null;

    const cats = getStoredCategories();
    if (!cats.includes(name)) {
      cats.push(name);
      saveStoredCategories(cats);
    }
    return name;
  }

  function getCategoryClass(cat: string) {
    switch (cat) {
      case 'Du lịch & Khám phá': return 'badge-cat-travel';
      case 'Trải nghiệm mới lạ': return 'badge-cat-experience';
      case 'Tương lai đôi lứa': return 'badge-cat-future';
      case 'Hẹn hò lãng mạn': return 'badge-cat-romantic';
      default: return 'badge-cat-custom';
    }
  }

  function getCategoryEmoji(cat: string): string {
    if (cat.includes('Hẹn hò') || cat.includes('lãng mạn')) return '💖 ';
    if (cat.includes('Du lịch') || cat.includes('Khám phá')) return '🏖️ ';
    if (cat.includes('Trải nghiệm')) return '✨ ';
    if (cat.includes('Tương lai')) return '💍 ';
    return '🌸 ';
  }

  function getCreationTimestamp(item: any): number {
    if (item.createdAt) {
      const t = new Date(item.createdAt).getTime();
      if (!isNaN(t)) return t;
    }
    if (item.completedDate) {
      const t = new Date(item.completedDate).getTime();
      if (!isNaN(t)) return t;
    }
    if (typeof item.id === 'string') {
      if (item.id.startsWith('bl-')) {
        const numeric = Number(item.id.replace('bl-', ''));
        if (numeric > 1000000000) return numeric;
        return new Date('2026-08-15').getTime() + (numeric || 1) * 86400000;
      }
    }
    return 0;
  }

  function populateCategoryDropdown(selectedCat = 'Hẹn hò lãng mạn') {
    const select = document.getElementById('form-category') as HTMLSelectElement | null;
    if (!select) return;

    const cats = getStoredCategories();
    select.innerHTML = '';

    cats.forEach((cat) => {
      const opt = document.createElement('option');
      opt.value = cat;
      opt.textContent = `${getCategoryEmoji(cat)}${cat}`;
      if (cat === selectedCat) opt.selected = true;
      select.appendChild(opt);
    });

    const newOpt = document.createElement('option');
    newOpt.value = '__create_new__';
    newOpt.textContent = '➕ Tạo danh mục mới...';
    select.appendChild(newOpt);
  }

  function renderCategoryFilters() {
    const filterContainer = document.getElementById('bucket-filters-container');
    if (!filterContainer) return;

    const cats = getStoredCategories();
    const standardFilterList = ['Tất cả', 'Đã hoàn thành', 'Đang ấp ủ', ...cats];

    filterContainer.innerHTML = '';

    standardFilterList.forEach((cat) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `filter-btn ${activeFilter === cat ? 'is-active' : ''}`;
      btn.setAttribute('data-filter', cat);

      let icon = '';
      if (cat === 'Đã hoàn thành') icon = '❤️ ';
      else if (cat === 'Đang ấp ủ') icon = '⏳ ';
      else if (cat !== 'Tất cả') icon = getCategoryEmoji(cat);

      btn.textContent = `${icon}${cat}`;

      btn.addEventListener('click', () => {
        activeFilter = cat;
        renderCategoryFilters();
        renderBucketChecklist(activeFilter);
      });

      filterContainer.appendChild(btn);
    });
  }

  function renderBucketChecklist(currentFilter = 'Tất cả') {
    const container = document.getElementById('bucket-cards-container');
    const counterText = document.getElementById('bucket-counter-text');
    const progressFill = document.getElementById('bucket-progress-fill');
    if (!container) return;

    const list: any[] = getStoredBucketList();
    const completedCount = list.filter((i) => i.completed).length;
    const totalCount = list.length;
    const pct = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;

    if (counterText) {
      counterText.innerHTML = `Đã hoàn thành <strong>${completedCount}/${totalCount}</strong> điều ước (${pct}%)`;
    }
    if (progressFill) {
      progressFill.style.width = `${pct}%`;
    }

    container.innerHTML = '';

    // Sắp xếp theo ngày tạo (sortOrder: 'desc' = Mới nhất trước, 'asc' = Cũ nhất trước)
    const sortedList = [...list].sort((a, b) => {
      const timeA = getCreationTimestamp(a);
      const timeB = getCreationTimestamp(b);
      return sortOrder === 'desc' ? timeB - timeA : timeA - timeB;
    });

    sortedList.forEach((item) => {
      const statusLabel = item.completed ? 'Đã hoàn thành' : 'Đang ấp ủ';
      const isVisible =
        currentFilter === 'Tất cả' ||
        currentFilter === statusLabel ||
        currentFilter === item.category;

      if (!isVisible) return;

      const row = document.createElement('div');
      row.className = `bucket-check-row romantic-card ${item.completed ? 'is-completed' : 'is-pending'}`;
      row.setAttribute('data-id', item.id);

      const formattedCompletedDate = item.completedDate
        ? item.completedDate.split('-').reverse().join('/')
        : '';

      const formattedCreatedDate = item.createdAt
        ? item.createdAt.split('-').reverse().join('/')
        : '';

      const catClass = getCategoryClass(item.category);

      row.innerHTML = `
        <div class="check-left-col">
          <button type="button" class="check-toggle-btn ${item.completed ? 'is-done' : ''}" title="${item.completed ? 'Đánh dấu chưa làm' : 'Đánh dấu đã hoàn thành'}">
            <span>${item.completed ? '❤️' : '🤍'}</span>
          </button>
          
          <div class="check-info-block">
            <div class="check-title-line">
              <span class="check-title-text ${item.completed ? 'is-done' : ''}">${escapeHtml(item.title)}</span>
            </div>
            
            <div class="check-meta-line">
              <span class="check-cat-badge ${catClass}">${escapeHtml(item.category)}</span>
              ${formattedCreatedDate ? `<span class="check-created-tag" title="Ngày tạo điều ước">🌱 Tạo: ${formattedCreatedDate}</span>` : ''}
              ${item.completed && formattedCompletedDate ? `<span class="check-date-tag" title="Ngày đã hoàn thành">💖 Xong: ${formattedCompletedDate}</span>` : ''}
              ${item.description ? `<span class="check-note-tag">${escapeHtml(item.description)}</span>` : ''}
              ${!item.description && item.memoryNote ? `<span class="check-note-tag">💭 ${escapeHtml(item.memoryNote)}</span>` : ''}
            </div>
          </div>
        </div>

        <div class="check-right-actions">
          <button type="button" class="btn-item-action btn-item-edit" title="Chỉnh sửa điều ước">✏️</button>
          <button type="button" class="btn-item-action btn-item-delete" title="Xóa điều ước">🗑️</button>
        </div>
      `;

      // 1. Toggle completed state
      const toggleBtn = row.querySelector('.check-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          item.completed = !item.completed;
          if (item.completed && !item.completedDate) {
            item.completedDate = new Date().toISOString().slice(0, 10);
          }
          // Update in main list
          const target = list.find((i) => i.id === item.id);
          if (target) {
            target.completed = item.completed;
            target.completedDate = item.completedDate;
          }
          saveStoredBucketList(list);
          renderBucketChecklist(currentFilter);
        });
      }

      // 2. Edit button
      const editBtn = row.querySelector('.btn-item-edit');
      if (editBtn) {
        editBtn.addEventListener('click', () => openEditModal(item));
      }

      // 3. Delete button
      const deleteBtn = row.querySelector('.btn-item-delete');
      if (deleteBtn) {
        deleteBtn.addEventListener('click', async () => {
          const confirmed = (window as any).romanticConfirm
            ? await (window as any).romanticConfirm({
                heading: 'Tạm Cất Điều Ước Này Nhé?',
                subject: item.title,
                subjectIcon: '💫',
                quote: item.description || item.memoryNote || 'Một điều ước ngọt ngào trong danh sách của hai đứa...',
                typeBadge: '💫 Điều Ước Đôi Lứa',
                sealEmoji: '💌',
                confirmText: 'Cất Đi 📦',
                cancelText: 'Để Lại Đây 🌸',
                notice: 'Điều ước này sẽ được cất giữ an toàn trong Thùng Rác và có thể khôi phục lại bất kỳ lúc nào.'
              })
            : confirm(`Bạn có chắc muốn chuyển điều ước "${item.title}" vào Thùng Rác không?`);

          if (confirmed) {
            moveItemToTrash(
              {
                originalId: item.id,
                type: 'bucket_list',
                title: item.title,
                subtitle: item.category,
                data: item
              },
              {
                onUndo: () => renderBucketChecklist(currentFilter)
              }
            );
            const updated = list.filter((i) => i.id !== item.id);
            saveStoredBucketList(updated);
            renderBucketChecklist(currentFilter);
          }
        });
      }

      container.appendChild(row);
    });
  }

  function initBucketSection() {
    const modal = document.getElementById('bucket-crud-modal');
    const modalCloseBtn = document.getElementById('bucket-modal-close');
    const cancelBtn = document.getElementById('btn-cancel-bucket');
    const openAddBtn = document.getElementById('btn-open-add-bucket');
    const form = document.getElementById('bucket-form') as HTMLFormElement;

    const formId = document.getElementById('form-item-id') as HTMLInputElement;
    const formTitle = document.getElementById('form-title') as HTMLInputElement;
    const formCategory = document.getElementById('form-category') as HTMLSelectElement;
    const formCreatedDate = document.getElementById('form-created-date') as HTMLInputElement;
    const formDesc = document.getElementById('form-desc') as HTMLTextAreaElement;
    const formCompleted = document.getElementById('form-completed') as HTMLInputElement;
    const formCompletedDate = document.getElementById('form-completed-date') as HTMLInputElement;
    const groupCompletedDate = document.getElementById('group-completed-date') as HTMLElement;
    const labelCompletedText = document.getElementById('label-bucket-completed-text') as HTMLElement;
    const modalTitle = document.getElementById('bucket-modal-title') as HTMLElement;

    // Category Creation UI Elements inside Modal
    const btnToggleInlineCat = document.getElementById('btn-toggle-inline-cat');
    const boxInlineNewCat = document.getElementById('box-inline-new-cat');
    const inputNewCatName = document.getElementById('input-new-cat-name') as HTMLInputElement;
    const btnApplyNewCat = document.getElementById('btn-apply-new-cat');
    const btnCancelNewCat = document.getElementById('btn-cancel-new-cat');

    // Quick Add Category from Filter Bar
    const btnQuickAddCategory = document.getElementById('btn-quick-add-category');

    const sortToggleBtn = document.getElementById('btn-toggle-bucket-sort');
    const sortLabel = document.getElementById('bucket-sort-label');
    const sortArrow = document.getElementById('bucket-sort-arrow');

    function openAddModal() {
      if (!modal) return;
      if (modalTitle) modalTitle.textContent = 'Thêm Điều Ước Mới';
      if (formId) formId.value = '';
      if (formTitle) formTitle.value = '';
      populateCategoryDropdown('Hẹn hò lãng mạn');
      if (boxInlineNewCat) boxInlineNewCat.style.display = 'none';
      if (inputNewCatName) inputNewCatName.value = '';
      if (formCreatedDate) formCreatedDate.value = new Date().toISOString().slice(0, 10);
      if (formDesc) formDesc.value = '';
      if (formCompleted) formCompleted.checked = false;
      if (formCompletedDate) formCompletedDate.value = '';
      if (groupCompletedDate) groupCompletedDate.style.display = 'none';
      if (labelCompletedText) labelCompletedText.textContent = '🤍 Đang ấp ủ làm';

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      if (formTitle) formTitle.focus();
    }

    (window as any).openBucketEditModal = function(item: any) {
      if (!modal) return;
      if (modalTitle) modalTitle.textContent = 'Chỉnh Sửa Điều Ước';
      if (formId) formId.value = item.id;
      if (formTitle) formTitle.value = item.title || '';
      populateCategoryDropdown(item.category || 'Hẹn hò lãng mạn');
      if (boxInlineNewCat) boxInlineNewCat.style.display = 'none';
      if (inputNewCatName) inputNewCatName.value = '';
      if (formCreatedDate) formCreatedDate.value = item.createdAt || new Date().toISOString().slice(0, 10);
      if (formDesc) formDesc.value = item.description || item.memoryNote || '';
      if (formCompleted) formCompleted.checked = !!item.completed;
      if (formCompletedDate) formCompletedDate.value = item.completedDate || '';

      if (groupCompletedDate) {
        groupCompletedDate.style.display = item.completed ? 'block' : 'none';
      }
      if (labelCompletedText) {
        labelCompletedText.textContent = item.completed ? '❤️ Đã hoàn thành' : '🤍 Đang ấp ủ làm';
      }

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      if (formTitle) formTitle.focus();
    };

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
    }

    // Inline Category creation in modal
    if (btnToggleInlineCat && boxInlineNewCat) {
      btnToggleInlineCat.addEventListener('click', () => {
        const isHidden = boxInlineNewCat.style.display === 'none';
        boxInlineNewCat.style.display = isHidden ? 'flex' : 'none';
        if (isHidden && inputNewCatName) inputNewCatName.focus();
      });
    }

    if (formCategory) {
      formCategory.addEventListener('change', () => {
        if (formCategory.value === '__create_new__') {
          if (boxInlineNewCat) boxInlineNewCat.style.display = 'flex';
          if (inputNewCatName) {
            inputNewCatName.focus();
            inputNewCatName.value = '';
          }
        }
      });
    }

    function handleApplyNewCategory() {
      if (!inputNewCatName) return;
      const val = inputNewCatName.value.trim();
      if (!val) {
        inputNewCatName.focus();
        return;
      }

      const created = addCustomCategory(val);
      if (created) {
        populateCategoryDropdown(created);
        renderCategoryFilters();
        if (boxInlineNewCat) boxInlineNewCat.style.display = 'none';
        inputNewCatName.value = '';
      }
    }

    if (btnApplyNewCat) btnApplyNewCat.addEventListener('click', handleApplyNewCategory);
    if (inputNewCatName) {
      inputNewCatName.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleApplyNewCategory();
        }
      });
    }

    if (btnCancelNewCat && boxInlineNewCat) {
      btnCancelNewCat.addEventListener('click', () => {
        boxInlineNewCat.style.display = 'none';
        populateCategoryDropdown(formCategory.value !== '__create_new__' ? formCategory.value : 'Hẹn hò lãng mạn');
      });
    }

    // Quick Add Category from Filter Bar Button
    if (btnQuickAddCategory) {
      btnQuickAddCategory.addEventListener('click', () => {
        const newCat = prompt('Nhập tên phân loại danh mục mới cho điều ước (Ví dụ: 🏡 Xây tổ ấm, 🐾 Nuôi thú cưng, 🎨 Nghệ thuật...):');
        if (newCat && newCat.trim()) {
          const created = addCustomCategory(newCat.trim());
          if (created) {
            activeFilter = created;
            renderCategoryFilters();
            renderBucketChecklist(activeFilter);
          }
        }
      });
    }

    if (openAddBtn) openAddBtn.addEventListener('click', openAddModal);
    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

    if (formCompleted) {
      formCompleted.addEventListener('change', () => {
        const isChecked = formCompleted.checked;
        if (groupCompletedDate) {
          groupCompletedDate.style.display = isChecked ? 'block' : 'none';
        }
        if (isChecked && !formCompletedDate.value) {
          formCompletedDate.value = new Date().toISOString().slice(0, 10);
        }
        if (labelCompletedText) {
          labelCompletedText.textContent = isChecked ? '❤️ Đã hoàn thành' : '🤍 Đang ấp ủ làm';
        }
      });
    }

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const list = getStoredBucketList();
        const id = formId ? formId.value.trim() : '';
        const title = formTitle ? formTitle.value.trim() : '';
        let category = formCategory ? formCategory.value : 'Hẹn hò lãng mạn';
        if (category === '__create_new__') {
          category = 'Hẹn hò lãng mạn';
        }
        const createdAt = formCreatedDate ? (formCreatedDate.value || new Date().toISOString().slice(0, 10)) : new Date().toISOString().slice(0, 10);
        const description = formDesc ? formDesc.value.trim() : '';
        const completed = formCompleted ? formCompleted.checked : false;
        const completedDate = completed ? (formCompletedDate.value || new Date().toISOString().slice(0, 10)) : '';

        if (!title) return;

        if (id) {
          // Edit existing
          const idx = list.findIndex((i: any) => i.id === id);
          if (idx !== -1) {
            list[idx] = {
              ...list[idx],
              title,
              category,
              createdAt,
              description,
              completed,
              completedDate
            };
          }
        } else {
          // Add new item
          const newItem = {
            id: `bl-${Date.now()}`,
            title,
            category,
            createdAt,
            description,
            completed,
            completedDate
          };
          list.unshift(newItem);
        }

        saveStoredBucketList(list);
        renderCategoryFilters();
        renderBucketChecklist(activeFilter);
        closeModal();
      });
    }

    // Sort Toggle Button
    if (sortToggleBtn) {
      sortToggleBtn.addEventListener('click', () => {
        sortOrder = sortOrder === 'desc' ? 'asc' : 'desc';
        if (sortLabel) {
          sortLabel.textContent = sortOrder === 'desc' ? 'Mới tạo nhất trước' : 'Cũ nhất trước';
        }
        if (sortArrow) {
          sortArrow.textContent = sortOrder === 'desc' ? '↓' : '↑';
        }
        renderBucketChecklist(activeFilter);
      });
    }

    // Listen for Realtime Cloud Updates from Firebase
    window.addEventListener('couple-cloud-updated', () => {
      renderCategoryFilters();
      renderBucketChecklist(activeFilter);
    });

    // Listen for Item Restored from Trash
    window.addEventListener('couple-item-restored', (e: any) => {
      if (e.detail?.type === 'bucket_list') {
        renderCategoryFilters();
        renderBucketChecklist(activeFilter);
      }
    });

    // Initial render
    renderCategoryFilters();
    renderBucketChecklist(activeFilter);
  }

  function openEditModal(item: any) {
    if ((window as any).openBucketEditModal) {
      (window as any).openBucketEditModal(item);
    }
  }

  initBucketSection();
  document.addEventListener('astro:after-swap', initBucketSection);
</script>
