<script>
  import { pushDataToFirebase } from '../lib/firebaseClient';
  import { moveItemToTrash } from '../lib/trashBin';

  const STORAGE_KEY = 'couple_bucket_list';
  const CATEGORIES_KEY = 'couple_bucket_categories';
  const DEFAULT_CATEGORIES = [
    'Hẹn hò lãng mạn',
    'Du lịch & Khám phá',
    'Trải nghiệm mới lạ',
    'Tương lai đôi lứa'
  ];

  let sortOrder: 'desc' | 'asc' = 'desc';
  let activeFilter = 'Tất cả';

  function escapeHtml(str: string): string {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function getStoredBucketList(): any[] {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) return JSON.parse(stored);
    } catch {}
    const initial = (window as any).__INITIAL_BUCKET_LIST__ || [];
    localStorage.setItem(STORAGE_KEY, JSON.stringify(initial));
    return initial;
  }

  function saveStoredBucketList(list: any[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    pushDataToFirebase({ bucketList: list, lastUpdatedBy: 'BucketList' }).catch(() => {});
  }

  function getStoredCategories(): string[] {
    try {
      const stored = localStorage.getItem(CATEGORIES_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      }
    } catch {}
    // First time initialization
    localStorage.setItem(CATEGORIES_KEY, JSON.stringify(DEFAULT_CATEGORIES));
    return [...DEFAULT_CATEGORIES];
  }

  function saveStoredCategories(cats: string[]) {
    localStorage.setItem(CATEGORIES_KEY, JSON.stringify(cats));
    pushDataToFirebase({ bucketCategories: cats, lastUpdatedBy: 'BucketCategory' }).catch(() => {});
  }

  function addCustomCategory(rawName: string): string | null {
    const name = (rawName || '').trim();
    if (!name) return null;

    const cats = getStoredCategories();
    if (!cats.includes(name)) {
      cats.push(name);
      saveStoredCategories(cats);
    }
    return name;
  }

  function getCategoryClass(cat: string) {
    switch (cat) {
      case 'Du lịch & Khám phá': return 'badge-cat-travel';
      case 'Trải nghiệm mới lạ': return 'badge-cat-experience';
      case 'Tương lai đôi lứa': return 'badge-cat-future';
      case 'Hẹn hò lãng mạn': return 'badge-cat-romantic';
      default: return 'badge-cat-custom';
    }
  }

  function getCategoryEmoji(cat: string): string {
    if (cat.includes('Hẹn hò') || cat.includes('lãng mạn')) return '💖 ';
    if (cat.includes('Du lịch') || cat.includes('Khám phá')) return '🏖️ ';
    if (cat.includes('Trải nghiệm')) return '✨ ';
    if (cat.includes('Tương lai')) return '💍 ';
    return '🌸 ';
  }

  function getCreationTimestamp(item: any): number {
    if (item.createdAt) {
      const t = new Date(item.createdAt).getTime();
      if (!isNaN(t)) return t;
    }
    if (item.completedDate) {
      const t = new Date(item.completedDate).getTime();
      if (!isNaN(t)) return t;
    }
    if (typeof item.id === 'string') {
      if (item.id.startsWith('bl-')) {
        const numeric = Number(item.id.replace('bl-', ''));
        if (numeric > 1000000000) return numeric;
        return new Date('2026-08-15').getTime() + (numeric || 1) * 86400000;
      }
    }
    return 0;
  }

  function populateCategoryDropdown(selectedCat = 'Hẹn hò lãng mạn') {
    const select = document.getElementById('form-category') as HTMLSelectElement | null;
    if (!select) return;

    const cats = getStoredCategories();
    select.innerHTML = '';

    cats.forEach((cat) => {
      const opt = document.createElement('option');
      opt.value = cat;
      opt.textContent = `${getCategoryEmoji(cat)}${cat}`;
      if (cat === selectedCat) opt.selected = true;
      select.appendChild(opt);
    });

    const newOpt = document.createElement('option');
    newOpt.value = '__create_new__';
    newOpt.textContent = '➕ Tạo danh mục mới...';
    select.appendChild(newOpt);
  }

  function renderCategoryFilters() {
    const filterContainer = document.getElementById('bucket-filters-container');
    if (!filterContainer) return;

    const cats = getStoredCategories();
    const standardFilterList = ['Tất cả', 'Đã hoàn thành', 'Đang ấp ủ', ...cats];

    filterContainer.innerHTML = '';

    standardFilterList.forEach((cat) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `filter-btn ${activeFilter === cat ? 'is-active' : ''}`;
      btn.setAttribute('data-filter', cat);

      let icon = '';
      if (cat === 'Đã hoàn thành') icon = '❤️ ';
      else if (cat === 'Đang ấp ủ') icon = '⏳ ';
      else if (cat !== 'Tất cả') icon = getCategoryEmoji(cat);

      btn.textContent = `${icon}${cat}`;

      btn.addEventListener('click', () => {
        activeFilter = cat;
        renderCategoryFilters();
        renderBucketChecklist(activeFilter);
      });

      filterContainer.appendChild(btn);
    });
  }

  // =========================================================================
  // RECURSIVE MULTI-LEVEL TREE SUBTASK HELPERS
  // =========================================================================
  function countLeaves(node: any): { total: number; completed: number } {
    if (node.children && Array.isArray(node.children) && node.children.length > 0) {
      let t = 0;
      let c = 0;
      node.children.forEach((child: any) => {
        const res = countLeaves(child);
        t += res.total;
        c += res.completed;
      });
      return { total: t, completed: c };
    }
    return { total: 1, completed: node.completed ? 1 : 0 };
  }

  function countItemProgress(item: any): { total: number; completed: number; pct: number } {
    if (!item.subTasks || !Array.isArray(item.subTasks) || item.subTasks.length === 0) {
      return {
        total: 1,
        completed: item.completed ? 1 : 0,
        pct: item.completed ? 100 : 0
      };
    }
    let t = 0;
    let c = 0;
    item.subTasks.forEach((st: any) => {
      const res = countLeaves(st);
      t += res.total;
      c += res.completed;
    });
    return {
      total: t,
      completed: c,
      pct: t > 0 ? Math.round((c / t) * 100) : (item.completed ? 100 : 0)
    };
  }

  function setNodeCompletionRecursive(node: any, completed: boolean, dateStr?: string) {
    const d = dateStr || new Date().toISOString().slice(0, 10);
    node.completed = completed;
    node.completedDate = completed ? d : undefined;
    if (node.children && Array.isArray(node.children)) {
      node.children.forEach((child: any) => {
        setNodeCompletionRecursive(child, completed, d);
      });
    }
  }

  function recalculateNodeCompletion(node: any): boolean {
    if (node.children && Array.isArray(node.children) && node.children.length > 0) {
      node.children.forEach((child: any) => recalculateNodeCompletion(child));
      const allChildrenDone = node.children.every((child: any) => child.completed);
      node.completed = allChildrenDone;
      if (allChildrenDone) {
        if (!node.completedDate) node.completedDate = new Date().toISOString().slice(0, 10);
      } else {
        node.completedDate = undefined;
      }
      return node.completed;
    }
    return !!node.completed;
  }

  function recalculateItem(item: any) {
    if (item.subTasks && Array.isArray(item.subTasks) && item.subTasks.length > 0) {
      item.subTasks.forEach((st: any) => recalculateNodeCompletion(st));
      const allDone = item.subTasks.every((st: any) => st.completed);
      item.completed = allDone;
      if (allDone) {
        if (!item.completedDate) item.completedDate = new Date().toISOString().slice(0, 10);
      } else {
        item.completedDate = undefined;
      }
    }
  }

  function findAndToggleNode(nodes: any[], targetId: string): boolean {
    for (const node of nodes) {
      if (node.id === targetId) {
        const willBeDone = !node.completed;
        setNodeCompletionRecursive(node, willBeDone);
        return true;
      }
      if (node.children && Array.isArray(node.children) && node.children.length > 0) {
        const found = findAndToggleNode(node.children, targetId);
        if (found) {
          const allDone = node.children.every((c: any) => c.completed);
          node.completed = allDone;
          if (allDone) {
            if (!node.completedDate) node.completedDate = new Date().toISOString().slice(0, 10);
          } else {
            node.completedDate = undefined;
          }
          return true;
        }
      }
    }
    return false;
  }

  function renderNodeHtml(node: any, itemId: string, depth = 0): string {
    const hasChildren = node.children && Array.isArray(node.children) && node.children.length > 0;
    if (hasChildren) {
      const stats = countLeaves(node);
      const isGroupDone = stats.total > 0 && stats.completed === stats.total;
      const groupPct = stats.total > 0 ? Math.round((stats.completed / stats.total) * 100) : 0;
      const childrenHtml = node.children.map((c: any) => renderNodeHtml(c, itemId, depth + 1)).join('');

      return `
        <div class="subtask-group-card ${isGroupDone ? 'is-completed' : ''}" data-node-id="${escapeHtml(node.id)}">
          <div class="subtask-group-header">
            <div class="subtask-group-left">
              <span class="subtask-group-chevron">▾</span>
              <button type="button" class="subtask-checkbox-btn ${isGroupDone ? 'is-checked' : ''}" data-item-id="${escapeHtml(itemId)}" data-node-id="${escapeHtml(node.id)}" title="${isGroupDone ? 'Bỏ đánh dấu cả nhóm này' : 'Đánh dấu hoàn thành toàn bộ nhóm này'}">
                <span>${isGroupDone ? '✓' : ''}</span>
              </button>
              <span class="subtask-group-title">${escapeHtml(node.title)}</span>
            </div>
            <div class="subtask-group-right">
              <span class="subtask-group-badge ${isGroupDone ? 'is-done' : ''}">${stats.completed}/${stats.total} (${groupPct}%)</span>
            </div>
          </div>
          <div class="subtask-group-children">
            ${childrenHtml}
          </div>
        </div>
      `;
    } else {
      const formattedSubDate = node.completedDate ? node.completedDate.split('-').reverse().join('/') : '';
      return `
        <div class="subtask-item ${node.completed ? 'is-completed' : 'is-pending'}" data-node-id="${escapeHtml(node.id)}">
          <button type="button" class="subtask-checkbox-btn ${node.completed ? 'is-checked' : ''}" data-item-id="${escapeHtml(itemId)}" data-node-id="${escapeHtml(node.id)}" title="${node.completed ? 'Bỏ đánh dấu mục này' : 'Đánh dấu hoàn thành mục này'}">
            <span>${node.completed ? '✓' : ''}</span>
          </button>
          <span class="subtask-label ${node.completed ? 'is-checked' : ''}">${escapeHtml(node.title)}</span>
          ${node.completed && formattedSubDate ? `<span class="subtask-date-tag">✓ ${formattedSubDate}</span>` : ''}
        </div>
      `;
    }
  }

  function renderBucketChecklist(currentFilter = 'Tất cả') {
    const container = document.getElementById('bucket-cards-container');
    const counterText = document.getElementById('bucket-counter-text');
    const progressFill = document.getElementById('bucket-progress-fill');
    if (!container) return;

    const list: any[] = getStoredBucketList();
    const completedCount = list.filter((i) => i.completed).length;
    const totalCount = list.length;
    const pct = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;

    if (counterText) {
      counterText.innerHTML = `Đã hoàn thành <strong>${completedCount}/${totalCount}</strong> điều ước (${pct}%)`;
    }
    if (progressFill) {
      progressFill.style.width = `${pct}%`;
    }

    container.innerHTML = '';

    // Sắp xếp theo ngày tạo (sortOrder: 'desc' = Mới nhất trước, 'asc' = Cũ nhất trước)
    const sortedList = [...list].sort((a, b) => {
      const timeA = getCreationTimestamp(a);
      const timeB = getCreationTimestamp(b);
      return sortOrder === 'desc' ? timeB - timeA : timeA - timeB;
    });

    sortedList.forEach((item) => {
      const statusLabel = item.completed ? 'Đã hoàn thành' : 'Đang ấp ủ';
      const isVisible =
        currentFilter === 'Tất cả' ||
        currentFilter === statusLabel ||
        currentFilter === item.category;

      if (!isVisible) return;

      const catClass = getCategoryClass(item.category || '');
      const row = document.createElement('div');
      row.className = `bucket-check-row romantic-card ${item.completed ? 'is-completed' : 'is-pending'}`;
      row.setAttribute('data-id', item.id);

      const formattedCompletedDate = item.completedDate
        ? item.completedDate.split('-').reverse().join('/')
        : '';

      const formattedCreatedDate = item.createdAt
        ? item.createdAt.split('-').reverse().join('/')
        : '';

      let subtasksHtml = '';
      if (item.subTasks && item.subTasks.length > 0) {
        const itemStats = countItemProgress(item);
        const allDone = itemStats.total > 0 && itemStats.completed === itemStats.total;
        const subItemsHtml = item.subTasks.map((st: any) => renderNodeHtml(st, item.id)).join('');

        subtasksHtml = `
          <div class="subtasks-section-wrap" data-item-id="${item.id}">
            <div class="subtasks-header-bar" title="Nhấn để mở / đóng danh sách chặng">
              <div class="subtasks-header-left">
                <span class="subtasks-progress-badge ${allDone ? 'is-all-done' : ''}">
                  ${allDone ? '🎉 Đã hoàn tất tất cả chặng!' : `🎯 Tiến độ chặng: ${itemStats.completed}/${itemStats.total} (${itemStats.pct}%)`}
                </span>
                <div class="subtasks-mini-track">
                  <div class="subtasks-mini-fill" style="width: ${itemStats.pct}%;"></div>
                </div>
              </div>
              <button type="button" class="btn-toggle-subtasks-view">
                <span class="toggle-subtasks-label">Danh sách chặng</span>
                <span class="toggle-subtasks-chevron">▾</span>
              </button>
            </div>
            <div class="subtasks-list">
              ${subItemsHtml}
            </div>
          </div>
        `;
      }

      row.innerHTML = `
        <div class="check-left-col">
          <button type="button" class="check-toggle-btn ${item.completed ? 'is-done' : ''}" title="${item.completed ? 'Đánh dấu chưa làm' : 'Đánh dấu đã hoàn thành'}">
            <span>${item.completed ? '❤️' : '🤍'}</span>
          </button>
          
          <div class="check-info-block">
            <div class="check-title-line">
              <span class="check-title-text ${item.completed ? 'is-done' : ''}">${escapeHtml(item.title)}</span>
            </div>
            
            <div class="check-meta-line">
              <span class="check-cat-badge ${catClass}">${escapeHtml(item.category)}</span>
              ${formattedCreatedDate ? `<span class="check-created-tag" title="Ngày tạo điều ước">🌱 Tạo: ${formattedCreatedDate}</span>` : ''}
              ${item.completed && formattedCompletedDate ? `<span class="check-date-tag" title="Ngày đã hoàn thành">💖 Xong: ${formattedCompletedDate}</span>` : ''}
              ${item.description ? `<span class="check-note-tag">${escapeHtml(item.description)}</span>` : ''}
              ${!item.description && item.memoryNote ? `<span class="check-note-tag">💭 ${escapeHtml(item.memoryNote)}</span>` : ''}
            </div>

            ${subtasksHtml}
          </div>
        </div>

        <div class="check-right-actions">
          <button type="button" class="btn-item-action btn-item-edit" title="Chỉnh sửa điều ước">✏️</button>
          <button type="button" class="btn-item-action btn-item-delete" title="Xóa điều ước">🗑️</button>
        </div>
      `;

      // 1. Toggle entire item completion
      const toggleBtn = row.querySelector('.check-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const willComplete = !item.completed;
          item.completed = willComplete;
          if (willComplete) {
            if (!item.completedDate) item.completedDate = new Date().toISOString().slice(0, 10);
            if (item.subTasks && item.subTasks.length > 0) {
              item.subTasks.forEach((st: any) => {
                setNodeCompletionRecursive(st, true, item.completedDate);
              });
            }
          } else {
            item.completedDate = undefined;
            if (item.subTasks && item.subTasks.length > 0) {
              item.subTasks.forEach((st: any) => {
                setNodeCompletionRecursive(st, false);
              });
            }
          }

          const target = list.find((i) => i.id === item.id);
          if (target) {
            target.completed = item.completed;
            target.completedDate = item.completedDate;
            target.subTasks = item.subTasks;
          }
          saveStoredBucketList(list);
          renderBucketChecklist(currentFilter);
        });
      }

      // 2. Subtasks section collapse / expand toggle (header or button click)
      const subtaskHeaderBar = row.querySelector('.subtasks-header-bar');
      if (subtaskHeaderBar) {
        subtaskHeaderBar.addEventListener('click', () => {
          const wrap = row.querySelector('.subtasks-section-wrap');
          if (wrap) {
            wrap.classList.toggle('is-collapsed');
            const label = wrap.querySelector('.toggle-subtasks-label');
            const isCollapsed = wrap.classList.contains('is-collapsed');
            if (label) {
              label.textContent = isCollapsed ? 'Mở xem chặng' : 'Thu gọn chặng';
            }
          }
        });
      }

      // 3. Subtask node checkboxes event listeners (both group and leaf checkboxes)
      const subtaskBtns = row.querySelectorAll('.subtask-checkbox-btn');
      subtaskBtns.forEach((sBtn) => {
        sBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const nodeId = sBtn.getAttribute('data-node-id');
          if (!nodeId || !item.subTasks) return;

          const updated = findAndToggleNode(item.subTasks, nodeId);
          if (updated) {
            recalculateItem(item);

            const target = list.find((i) => i.id === item.id);
            if (target) {
              target.completed = item.completed;
              target.completedDate = item.completedDate;
              target.subTasks = item.subTasks;
            }
            saveStoredBucketList(list);
            renderBucketChecklist(currentFilter);
          }
        });
      });

      // 4. Subtask group accordion collapse/expand toggler
      const groupHeaders = row.querySelectorAll('.subtask-group-header');
      groupHeaders.forEach((gHeader) => {
        gHeader.addEventListener('click', (e) => {
          const targetEl = e.target as HTMLElement;
          if (targetEl.closest('.subtask-checkbox-btn')) return;
          const groupCard = gHeader.closest('.subtask-group-card');
          if (groupCard) {
            groupCard.classList.toggle('is-collapsed');
          }
        });
      });

      // 4. Edit button
      const editBtn = row.querySelector('.btn-item-edit');
      if (editBtn) {
        editBtn.addEventListener('click', () => openEditModal(item));
      }

      // 5. Delete button
      const deleteBtn = row.querySelector('.btn-item-delete');
      if (deleteBtn) {
        deleteBtn.addEventListener('click', async () => {
          const confirmed = (window as any).romanticConfirm
            ? await (window as any).romanticConfirm({
                heading: 'Tạm Cất Điều Ước Này Nhé?',
                subject: item.title,
                subjectIcon: '💫',
                quote: item.description || item.memoryNote || 'Một điều ước ngọt ngào trong danh sách của hai đứa...',
                typeBadge: '💫 Điều Ước Đôi Lứa',
                sealEmoji: '💌',
                confirmText: 'Cất Đi 📦',
                cancelText: 'Để Lại Đây 🌸',
                notice: 'Điều ước này sẽ được cất giữ an toàn trong Thùng Rác và có thể khôi phục lại bất kỳ lúc nào.'
              })
            : confirm(`Bạn có chắc muốn chuyển điều ước "${item.title}" vào Thùng Rác không?`);

          if (confirmed) {
            moveItemToTrash(
              {
                originalId: item.id,
                type: 'bucket_list',
                title: item.title,
                subtitle: item.category,
                data: item
              },
              {
                onUndo: () => renderBucketChecklist(currentFilter)
              }
            );
            const updated = list.filter((i) => i.id !== item.id);
            saveStoredBucketList(updated);
            renderBucketChecklist(currentFilter);
          }
        });
      }

      container.appendChild(row);
    });
  }

  function initBucketSection() {
    const modal = document.getElementById('bucket-crud-modal');
    const modalCloseBtn = document.getElementById('bucket-modal-close');
    const cancelBtn = document.getElementById('btn-cancel-bucket');
    const openAddBtn = document.getElementById('btn-open-add-bucket');
    const form = document.getElementById('bucket-form') as HTMLFormElement;

    const formId = document.getElementById('form-item-id') as HTMLInputElement;
    const formTitle = document.getElementById('form-title') as HTMLInputElement;
    const formCategory = document.getElementById('form-category') as HTMLSelectElement;
    const formCreatedDate = document.getElementById('form-created-date') as HTMLInputElement;
    const formDesc = document.getElementById('form-desc') as HTMLTextAreaElement;
    const formCompleted = document.getElementById('form-completed') as HTMLInputElement;
    const formCompletedDate = document.getElementById('form-completed-date') as HTMLInputElement;
    const groupCompletedDate = document.getElementById('group-completed-date') as HTMLElement;
    const labelCompletedText = document.getElementById('label-bucket-completed-text') as HTMLElement;
    const modalTitle = document.getElementById('bucket-modal-title') as HTMLElement;

    // Category Creation UI Elements inside Modal
    const btnToggleInlineCat = document.getElementById('btn-toggle-inline-cat');
    const boxInlineNewCat = document.getElementById('box-inline-new-cat');
    const inputNewCatName = document.getElementById('input-new-cat-name') as HTMLInputElement;
    const btnApplyNewCat = document.getElementById('btn-apply-new-cat');
    const btnCancelNewCat = document.getElementById('btn-cancel-new-cat');

    const sortToggleBtn = document.getElementById('btn-toggle-bucket-sort');
    const sortLabel = document.getElementById('bucket-sort-label');
    const sortArrow = document.getElementById('bucket-sort-arrow');

    // Subtask Tree Builder inside Modal
    const formSubtasksContainer = document.getElementById('form-subtasks-container');
    const btnAddFormGroup = document.getElementById('btn-add-form-group');
    const btnAddFormSubtask = document.getElementById('btn-add-form-subtask');

    function renderModalGroupBlock(groupTitle = '', children: any[] = [], groupId = '', insertBeforeEl: HTMLElement | null = null) {
      if (!formSubtasksContainer) return null;
      const gId = groupId || `st-g-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`;
      const groupBlock = document.createElement('div');
      groupBlock.className = 'modal-group-block';
      groupBlock.setAttribute('data-group-id', gId);

      groupBlock.innerHTML = `
        <div class="modal-group-head-row">
          <span style="font-size: 1.05rem;">🏷️</span>
          <input
            type="text"
            class="form-input modal-group-title-input"
            placeholder="Tên nhóm / chặng lớn (VD: Miền Nam, Miền Bắc...)"
            value="${escapeHtml(groupTitle)}"
            style="flex: 1; font-weight: 700; color: #7dd3fc;"
          />
          <button type="button" class="btn-remove-subtask btn-remove-group" title="Xóa cả nhóm này">🗑️</button>
        </div>
        <div class="modal-group-children-list">
          <!-- Child subtasks rendered here -->
        </div>
        <button type="button" class="btn-add-child-subtask">+ Thêm địa điểm / mục nhỏ vào nhóm này</button>
      `;

      const childrenContainer = groupBlock.querySelector('.modal-group-children-list') as HTMLElement;
      const btnAddChild = groupBlock.querySelector('.btn-add-child-subtask');
      const btnRemoveGroup = groupBlock.querySelector('.btn-remove-group');

      if (btnAddChild && childrenContainer) {
        btnAddChild.addEventListener('click', () => {
          renderModalChildRow(childrenContainer);
        });
      }

      if (btnRemoveGroup) {
        btnRemoveGroup.addEventListener('click', () => {
          groupBlock.remove();
        });
      }

      if (children && children.length > 0 && childrenContainer) {
        children.forEach((c) => {
          renderModalChildRow(childrenContainer, c.title, c.completed, c.id);
        });
      } else if (childrenContainer) {
        renderModalChildRow(childrenContainer);
      }

      if (insertBeforeEl && insertBeforeEl.parentNode === formSubtasksContainer) {
        formSubtasksContainer.insertBefore(groupBlock, insertBeforeEl);
      } else {
        formSubtasksContainer.appendChild(groupBlock);
      }

      const input = groupBlock.querySelector('.modal-group-title-input') as HTMLInputElement;
      if (input && !groupTitle) input.focus();
      return groupBlock;
    }

    function renderModalChildRow(container: HTMLElement, title = '', completed = false, id = '') {
      const cId = id || `st-c-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`;
      const row = document.createElement('div');
      row.className = 'subtask-input-row is-child-row';
      row.setAttribute('data-subtask-id', cId);

      row.innerHTML = `
        <span style="color: #38bdf8; font-size: 0.9rem; font-weight: bold;">↳</span>
        <input 
          type="text" 
          class="form-input subtask-input-field" 
          placeholder="Địa điểm / mục nhỏ (VD: Sài Gòn, Vũng Tàu...)"
          value="${escapeHtml(title)}"
          style="min-height: 38px; padding: 6px 12px; font-size: 0.88rem;"
        />
        <label class="checkbox-toggle-pill" style="min-width: auto; padding: 4px 8px; font-size: 0.78rem;" title="Đánh dấu đã hoàn thành mục này">
          <input type="checkbox" class="subtask-input-completed" ${completed ? 'checked' : ''} />
          <span>✓ Xong</span>
        </label>
        <button type="button" class="btn-remove-subtask" style="width: 34px; height: 34px; min-width: 34px;" title="Xóa mục nhỏ này">🗑️</button>
      `;

      const btnRemove = row.querySelector('.btn-remove-subtask');
      if (btnRemove) {
        btnRemove.addEventListener('click', () => {
          row.remove();
        });
      }

      container.appendChild(row);
      const input = row.querySelector('.subtask-input-field') as HTMLInputElement;
      if (input && !title) input.focus();
      return row;
    }

    function renderModalStandaloneSubtaskRow(title = '', completed = false, id = '', insertBeforeEl: HTMLElement | null = null) {
      if (!formSubtasksContainer) return null;
      const rowId = id || `st-s-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`;
      const subRow = document.createElement('div');
      subRow.className = 'subtask-input-row is-standalone';
      subRow.setAttribute('data-subtask-id', rowId);

      subRow.innerHTML = `
        <span class="subtask-input-num">📍</span>
        <input 
          type="text" 
          class="form-input subtask-input-field" 
          placeholder="Nhập chặng / mục tiêu (VD: Miền Nam, Miền Bắc...)"
          value="${escapeHtml(title)}"
        />
        <button type="button" class="btn-convert-to-group" title="Tạo các địa điểm / mục nhỏ hơn bên trong chặng này">
          + Mục con ↳
        </button>
        <label class="checkbox-toggle-pill" style="min-width: auto; padding: 4px 8px; font-size: 0.78rem;" title="Đánh dấu đã hoàn thành">
          <input type="checkbox" class="subtask-input-completed" ${completed ? 'checked' : ''} />
          <span>✓ Xong</span>
        </label>
        <button type="button" class="btn-remove-subtask" title="Xóa mục này">🗑️</button>
      `;

      // Convert to Group with sub-items when clicking "+ Mục con ↳"
      const btnConvertToGroup = subRow.querySelector('.btn-convert-to-group');
      if (btnConvertToGroup) {
        btnConvertToGroup.addEventListener('click', () => {
          const inputField = subRow.querySelector('.subtask-input-field') as HTMLInputElement | null;
          const currentVal = inputField ? inputField.value.trim() : '';
          renderModalGroupBlock(currentVal || title, [], rowId, subRow);
          subRow.remove();
        });
      }

      const btnRemove = subRow.querySelector('.btn-remove-subtask');
      if (btnRemove) {
        btnRemove.addEventListener('click', () => {
          subRow.remove();
        });
      }

      if (insertBeforeEl && insertBeforeEl.parentNode === formSubtasksContainer) {
        formSubtasksContainer.insertBefore(subRow, insertBeforeEl);
      } else {
        formSubtasksContainer.appendChild(subRow);
      }

      const input = subRow.querySelector('.subtask-input-field') as HTMLInputElement;
      if (input && !title) input.focus();
      return subRow;
    }

    if (btnAddFormGroup) {
      btnAddFormGroup.addEventListener('click', () => renderModalGroupBlock());
    }
    if (btnAddFormSubtask) {
      btnAddFormSubtask.addEventListener('click', () => renderModalStandaloneSubtaskRow());
    }

    function openAddModal() {
      if (!modal) return;
      if (modalTitle) modalTitle.textContent = 'Thêm Điều Ước Mới';
      if (formId) formId.value = '';
      if (formTitle) formTitle.value = '';
      populateCategoryDropdown('Hẹn hò lãng mạn');
      if (boxInlineNewCat) boxInlineNewCat.style.display = 'none';
      if (inputNewCatName) inputNewCatName.value = '';
      if (formCreatedDate) formCreatedDate.value = new Date().toISOString().slice(0, 10);
      if (formDesc) formDesc.value = '';
      if (formCompleted) formCompleted.checked = false;
      if (formCompletedDate) formCompletedDate.value = '';
      if (groupCompletedDate) groupCompletedDate.style.display = 'none';
      if (labelCompletedText) labelCompletedText.textContent = '🤍 Đang ấp ủ làm';
      if (formSubtasksContainer) formSubtasksContainer.innerHTML = '';

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      if (formTitle) formTitle.focus();
    }

    (window as any).openBucketEditModal = function(item: any) {
      if (!modal) return;
      if (modalTitle) modalTitle.textContent = 'Chỉnh Sửa Điều Ước';
      if (formId) formId.value = item.id;
      if (formTitle) formTitle.value = item.title || '';
      populateCategoryDropdown(item.category || 'Hẹn hò lãng mạn');
      if (boxInlineNewCat) boxInlineNewCat.style.display = 'none';
      if (inputNewCatName) inputNewCatName.value = '';
      if (formCreatedDate) formCreatedDate.value = item.createdAt || new Date().toISOString().slice(0, 10);
      if (formDesc) formDesc.value = item.description || item.memoryNote || '';
      if (formCompleted) formCompleted.checked = !!item.completed;
      if (formCompletedDate) formCompletedDate.value = item.completedDate || '';

      if (groupCompletedDate) {
        groupCompletedDate.style.display = item.completed ? 'block' : 'none';
      }
      if (labelCompletedText) {
        labelCompletedText.textContent = item.completed ? '❤️ Đã hoàn thành' : '🤍 Đang ấp ủ làm';
      }

      if (formSubtasksContainer) {
        formSubtasksContainer.innerHTML = '';
        if (item.subTasks && item.subTasks.length > 0) {
          item.subTasks.forEach((st: any) => {
            if (st.children && st.children.length > 0) {
              renderModalGroupBlock(st.title, st.children, st.id);
            } else {
              renderModalStandaloneSubtaskRow(st.title, st.completed, st.id);
            }
          });
        }
      }

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      if (formTitle) formTitle.focus();
    };

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
    }

    // Inline Category creation in modal
    if (btnToggleInlineCat && boxInlineNewCat) {
      btnToggleInlineCat.addEventListener('click', () => {
        const isHidden = boxInlineNewCat.style.display === 'none';
        boxInlineNewCat.style.display = isHidden ? 'flex' : 'none';
        if (isHidden && inputNewCatName) inputNewCatName.focus();
      });
    }

    if (formCategory) {
      formCategory.addEventListener('change', () => {
        if (formCategory.value === '__create_new__') {
          if (boxInlineNewCat) boxInlineNewCat.style.display = 'flex';
          if (inputNewCatName) {
            inputNewCatName.focus();
            inputNewCatName.value = '';
          }
        }
      });
    }

    function handleApplyNewCategory() {
      if (!inputNewCatName) return;
      const val = inputNewCatName.value.trim();
      if (!val) {
        inputNewCatName.focus();
        return;
      }

      const created = addCustomCategory(val);
      if (created) {
        populateCategoryDropdown(created);
        renderCategoryFilters();
        if (boxInlineNewCat) boxInlineNewCat.style.display = 'none';
        inputNewCatName.value = '';
      }
    }

    if (btnApplyNewCat) btnApplyNewCat.addEventListener('click', handleApplyNewCategory);
    if (inputNewCatName) {
      inputNewCatName.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleApplyNewCategory();
        }
      });
    }

    if (btnCancelNewCat && boxInlineNewCat) {
      btnCancelNewCat.addEventListener('click', () => {
        boxInlineNewCat.style.display = 'none';
        populateCategoryDropdown(formCategory.value !== '__create_new__' ? formCategory.value : 'Hẹn hò lãng mạn');
      });
    }

    // =========================================================================
    // CATEGORY MANAGEMENT HUB (Add, Rename with Cascade, Delete with Migration)
    // =========================================================================
    const btnOpenCategoryManager = document.getElementById('btn-open-category-manager');
    const catMgrModal = document.getElementById('category-manager-modal');
    const catMgrClose = document.getElementById('cat-mgr-close');
    const catMgrDone = document.getElementById('cat-mgr-btn-done');
    const catMgrNewInput = document.getElementById('cat-mgr-new-input') as HTMLInputElement | null;
    const catMgrBtnAdd = document.getElementById('cat-mgr-btn-add');
    const catMgrListContainer = document.getElementById('cat-mgr-list-container');

    const catMigModal = document.getElementById('category-migration-modal');
    const catMigClose = document.getElementById('cat-mig-close');
    const catMigBtnCancel = document.getElementById('cat-mig-btn-cancel');
    const catMigBtnConfirm = document.getElementById('cat-mig-btn-confirm');
    const catMigMessage = document.getElementById('cat-mig-message');
    const catMigTargetSelect = document.getElementById('cat-mig-target-select') as HTMLSelectElement | null;

    let pendingDeleteCategory = '';

    function renderCategoryManagerList() {
      if (!catMgrListContainer) return;
      const cats = getStoredCategories();
      const items = getStoredBucketList();

      const countMap: Record<string, number> = {};
      items.forEach((item) => {
        const c = item.category || 'Hẹn hò lãng mạn';
        countMap[c] = (countMap[c] || 0) + 1;
      });

      catMgrListContainer.innerHTML = '';

      if (cats.length === 0) {
        catMgrListContainer.innerHTML = '<p style="color: #64748b; font-size: 0.88rem; text-align: center; padding: 1rem 0;">Chưa có danh mục nào.</p>';
        return;
      }

      cats.forEach((cat) => {
        const count = countMap[cat] || 0;
        const row = document.createElement('div');
        row.className = 'cat-item-row';
        row.setAttribute('data-category', cat);

        const renderDefaultRow = () => {
          row.innerHTML = `
            <div class="cat-item-left">
              <span class="cat-item-name">${getCategoryEmoji(cat)}${escapeHtml(cat)}</span>
              <span class="cat-item-count-badge">${count} điều ước</span>
            </div>
            <div class="cat-item-actions">
              <button type="button" class="btn-cat-action btn-cat-edit" title="Đổi tên danh mục này">✏️</button>
              <button type="button" class="btn-cat-action btn-cat-del" title="Xóa danh mục này">🗑️</button>
            </div>
          `;

          const btnEdit = row.querySelector('.btn-cat-edit');
          if (btnEdit) {
            btnEdit.addEventListener('click', () => {
              row.innerHTML = `
                <div class="cat-inline-edit-box" style="display: flex; gap: 8px; width: 100%; align-items: center;">
                  <input type="text" class="form-input flex-1 cat-rename-input" value="${escapeHtml(cat)}" style="min-height: 38px; padding: 6px 12px; font-size: 0.9rem;" />
                  <button type="button" class="btn-love btn-sm btn-save-cat-rename" style="white-space: nowrap; padding: 6px 14px; min-height: 36px;">💾 Lưu</button>
                  <button type="button" class="btn-outline-love btn-sm btn-cancel-cat-rename" style="white-space: nowrap; padding: 6px 10px; min-height: 36px;">✖</button>
                </div>
              `;

              const input = row.querySelector('.cat-rename-input') as HTMLInputElement;
              const btnSave = row.querySelector('.btn-save-cat-rename');
              const btnCancel = row.querySelector('.btn-cancel-cat-rename');

              if (input) {
                input.focus();
                input.select();
              }

              const handleSaveRename = () => {
                if (!input) return;
                const trimmedNewName = input.value.trim();
                if (!trimmedNewName || trimmedNewName === cat) {
                  renderDefaultRow();
                  return;
                }

                let currentCats = getStoredCategories();
                currentCats = currentCats.map((c) => (c === cat ? trimmedNewName : c));
                currentCats = Array.from(new Set(currentCats));
                saveStoredCategories(currentCats);

                const allItems = getStoredBucketList();
                allItems.forEach((item) => {
                  if (item.category === cat) {
                    item.category = trimmedNewName;
                  }
                });
                saveStoredBucketList(allItems);

                if (activeFilter === cat) activeFilter = trimmedNewName;

                renderCategoryManagerList();
                renderCategoryFilters();
                renderBucketChecklist(activeFilter);
              };

              if (btnSave) btnSave.addEventListener('click', handleSaveRename);
              if (btnCancel) btnCancel.addEventListener('click', renderDefaultRow);
              if (input) {
                input.addEventListener('keydown', (e) => {
                  if (e.key === 'Enter') {
                    e.preventDefault();
                    handleSaveRename();
                  } else if (e.key === 'Escape') {
                    renderDefaultRow();
                  }
                });
              }
            });
          }

          const btnDel = row.querySelector('.btn-cat-del');
          if (btnDel) {
            btnDel.addEventListener('click', async () => {
              if (count === 0) {
                const confirmed = (window as any).romanticConfirm
                  ? await (window as any).romanticConfirm({
                      heading: 'Xóa Danh Mục Này Nhé?',
                      subject: cat,
                      subjectIcon: '🏷️',
                      quote: `Danh mục "${cat}" hiện chưa có điều ước nào. Bạn có muốn xóa khỏi danh sách không?`,
                      typeBadge: '🏷️ Phân Loại Danh Mục',
                      sealEmoji: '🗑️',
                      confirmText: 'Xóa Danh Mục 🗑️',
                      cancelText: 'Giữ Lại 🌸',
                      isDanger: true,
                      notice: 'Danh mục sẽ được gỡ khỏi bộ lọc của hai đứa.'
                    })
                  : true;

                if (confirmed) {
                  const currentCats = getStoredCategories().filter((c) => c !== cat);
                  saveStoredCategories(currentCats);
                  if (activeFilter === cat) activeFilter = 'Tất cả';
                  renderCategoryManagerList();
                  renderCategoryFilters();
                  renderBucketChecklist(activeFilter);
                }
              } else {
                pendingDeleteCategory = cat;
                if (catMigMessage) {
                  catMigMessage.innerHTML = `Danh mục <strong>"${escapeHtml(cat)}"</strong> đang có <strong>${count} điều ước</strong> cùng nhau.`;
                }
                if (catMigTargetSelect) {
                  catMigTargetSelect.innerHTML = '';
                  const otherCats = getStoredCategories().filter((c) => c !== cat);
                  if (otherCats.length === 0) otherCats.push('Hẹn hò lãng mạn');
                  otherCats.forEach((oc) => {
                    const opt = document.createElement('option');
                    opt.value = oc;
                    opt.textContent = `${getCategoryEmoji(oc)}${oc}`;
                    catMigTargetSelect.appendChild(opt);
                  });
                }
                if (catMigModal) catMigModal.classList.add('is-open');
              }
            });
          }
        };

        renderDefaultRow();
        catMgrListContainer.appendChild(row);
      });
    }

    function openCategoryManagerModal() {
      if (!catMgrModal) return;
      if (catMgrNewInput) catMgrNewInput.value = '';
      renderCategoryManagerList();
      catMgrModal.classList.add('is-open');
    }

    function closeCategoryManagerModal() {
      if (!catMgrModal) return;
      catMgrModal.classList.remove('is-open');
    }

    if (btnOpenCategoryManager) btnOpenCategoryManager.addEventListener('click', openCategoryManagerModal);
    if (catMgrClose) catMgrClose.addEventListener('click', closeCategoryManagerModal);
    if (catMgrDone) catMgrDone.addEventListener('click', closeCategoryManagerModal);
    if (catMgrModal) {
      catMgrModal.addEventListener('click', (e) => {
        if (e.target === catMgrModal) closeCategoryManagerModal();
      });
    }

    function handleAddNewCatFromManager() {
      if (!catMgrNewInput) return;
      const val = catMgrNewInput.value.trim();
      if (!val) {
        catMgrNewInput.focus();
        return;
      }
      const created = addCustomCategory(val);
      if (created) {
        catMgrNewInput.value = '';
        renderCategoryManagerList();
        renderCategoryFilters();
        renderBucketChecklist(activeFilter);
      }
    }

    if (catMgrBtnAdd) catMgrBtnAdd.addEventListener('click', handleAddNewCatFromManager);
    if (catMgrNewInput) {
      catMgrNewInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleAddNewCatFromManager();
        }
      });
    }

    if (catMigClose) catMigClose.addEventListener('click', () => catMigModal?.classList.remove('is-open'));
    if (catMigBtnCancel) catMigBtnCancel.addEventListener('click', () => catMigModal?.classList.remove('is-open'));
    if (catMigBtnConfirm) {
      catMigBtnConfirm.addEventListener('click', () => {
        if (!pendingDeleteCategory || !catMigTargetSelect) return;
        const targetCat = catMigTargetSelect.value;
        const catToDelete = pendingDeleteCategory;

        const allItems = getStoredBucketList();
        allItems.forEach((item) => {
          if (item.category === catToDelete) {
            item.category = targetCat;
          }
        });
        saveStoredBucketList(allItems);

        const currentCats = getStoredCategories().filter((c) => c !== catToDelete);
        saveStoredCategories(currentCats);

        if (activeFilter === catToDelete) activeFilter = targetCat;

        if (catMigModal) catMigModal.classList.remove('is-open');
        pendingDeleteCategory = '';
        renderCategoryManagerList();
        renderCategoryFilters();
        renderBucketChecklist(activeFilter);
      });
    }

    if (openAddBtn) openAddBtn.addEventListener('click', openAddModal);
    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

    if (formCompleted) {
      formCompleted.addEventListener('change', () => {
        const isChecked = formCompleted.checked;
        if (groupCompletedDate) {
          groupCompletedDate.style.display = isChecked ? 'block' : 'none';
        }
        if (isChecked && !formCompletedDate.value) {
          formCompletedDate.value = new Date().toISOString().slice(0, 10);
        }
        if (labelCompletedText) {
          labelCompletedText.textContent = isChecked ? '❤️ Đã hoàn thành' : '🤍 Đang ấp ủ làm';
        }
      });
    }

    const btnSaveBucket = document.getElementById('btn-save-bucket');

    function handleSaveBucket(e?: Event) {
      if (e) {
        e.preventDefault();
      }

      const list = getStoredBucketList();
      const formIdEl = document.getElementById('form-item-id') as HTMLInputElement | null;
      const formTitleEl = document.getElementById('form-title') as HTMLInputElement | null;
      const formCatEl = document.getElementById('form-category') as HTMLSelectElement | null;
      const formCreatedDateEl = document.getElementById('form-created-date') as HTMLInputElement | null;
      const formDescEl = document.getElementById('form-desc') as HTMLTextAreaElement | null;
      const formCompletedEl = document.getElementById('form-completed') as HTMLInputElement | null;
      const formCompletedDateEl = document.getElementById('form-completed-date') as HTMLInputElement | null;

      const id = formIdEl ? formIdEl.value.trim() : '';
      const title = formTitleEl ? formTitleEl.value.trim() : '';
      let category = formCatEl ? formCatEl.value : 'Hẹn hò lãng mạn';
      if (category === '__create_new__') {
        category = 'Hẹn hò lãng mạn';
      }
      const createdAt = formCreatedDateEl?.value || new Date().toISOString().slice(0, 10);
      const description = formDescEl ? formDescEl.value.trim() : '';

      if (!title) {
        if (formTitleEl) {
          formTitleEl.focus();
          formTitleEl.style.borderColor = '#f43f5e';
          formTitleEl.style.boxShadow = '0 0 16px rgba(244, 63, 94, 0.6)';
          setTimeout(() => {
            if (formTitleEl) {
              formTitleEl.style.borderColor = '';
              formTitleEl.style.boxShadow = '';
            }
          }, 2500);
        }
        alert('🌸 Vui lòng nhập tên điều ước trước khi lưu nhé!');
        return;
      }

      // Collect multi-level subtasks from builder
      const subTasks: any[] = [];
      const subContainer = document.getElementById('form-subtasks-container');
      if (subContainer) {
        Array.from(subContainer.children).forEach((childEl) => {
          if (childEl.classList.contains('modal-group-block')) {
            const gId = childEl.getAttribute('data-group-id') || `st-g-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`;
            const gTitleInput = childEl.querySelector('.modal-group-title-input') as HTMLInputElement | null;
            const gTitle = gTitleInput ? gTitleInput.value.trim() : '';
            if (!gTitle) return;

            const childrenNodes: any[] = [];
            const childRows = childEl.querySelectorAll('.modal-group-children-list .subtask-input-row');
            childRows.forEach((cRow) => {
              const cId = cRow.getAttribute('data-subtask-id') || `st-c-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`;
              const cInput = cRow.querySelector('.subtask-input-field') as HTMLInputElement | null;
              const cCheck = cRow.querySelector('.subtask-input-completed') as HTMLInputElement | null;
              const cTitle = cInput ? cInput.value.trim() : '';
              const cDone = cCheck ? cCheck.checked : false;
              if (cTitle) {
                childrenNodes.push({
                  id: cId,
                  title: cTitle,
                  completed: cDone,
                  completedDate: cDone ? new Date().toISOString().slice(0, 10) : undefined
                });
              }
            });

            const allChildDone = childrenNodes.length > 0 && childrenNodes.every((c) => c.completed);
            subTasks.push({
              id: gId,
              title: gTitle,
              completed: allChildDone,
              completedDate: allChildDone ? new Date().toISOString().slice(0, 10) : undefined,
              children: childrenNodes.length > 0 ? childrenNodes : undefined
            });
          } else if (childEl.classList.contains('subtask-input-row')) {
            const sId = childEl.getAttribute('data-subtask-id') || `st-s-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`;
            const sInput = childEl.querySelector('.subtask-input-field') as HTMLInputElement | null;
            const sCheck = childEl.querySelector('.subtask-input-completed') as HTMLInputElement | null;
            const sTitle = sInput ? sInput.value.trim() : '';
            const sDone = sCheck ? sCheck.checked : false;
            if (sTitle) {
              subTasks.push({
                id: sId,
                title: sTitle,
                completed: sDone,
                completedDate: sDone ? new Date().toISOString().slice(0, 10) : undefined
              });
            }
          }
        });
      }

      let completed = formCompletedEl ? formCompletedEl.checked : false;
      if (subTasks.length > 0) {
        let totalLeaves = 0;
        let completedLeaves = 0;
        subTasks.forEach((st) => {
          const res = countLeaves(st);
          totalLeaves += res.total;
          completedLeaves += res.completed;
        });
        completed = totalLeaves > 0 && completedLeaves === totalLeaves;
      }
      const completedDate = completed
        ? (formCompletedDateEl?.value || new Date().toISOString().slice(0, 10))
        : '';

      if (id) {
        // Edit existing
        const idx = list.findIndex((i: any) => String(i.id) === String(id));
        if (idx !== -1) {
          list[idx] = {
            ...list[idx],
            title,
            category,
            createdAt,
            description,
            completed,
            completedDate: completed ? completedDate : undefined,
            subTasks: subTasks.length > 0 ? subTasks : undefined
          };
        } else {
          list.unshift({
            id,
            title,
            category,
            createdAt,
            description,
            completed,
            completedDate: completed ? completedDate : undefined,
            subTasks: subTasks.length > 0 ? subTasks : undefined
          });
        }
      } else {
        // Add new item
        const newItem = {
          id: `bl-${Date.now()}`,
          title,
          category,
          createdAt,
          description,
          completed,
          completedDate: completed ? completedDate : undefined,
          subTasks: subTasks.length > 0 ? subTasks : undefined
        };
        list.unshift(newItem);
      }

      saveStoredBucketList(list);
      renderCategoryFilters();
      renderBucketChecklist(activeFilter);
      closeModal();
    }

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        handleSaveBucket(e);
      });
    }
    if (btnSaveBucket) {
      btnSaveBucket.addEventListener('click', (e) => {
        e.preventDefault();
        handleSaveBucket(e);
      });
    }

    // Sort Toggle Button
    if (sortToggleBtn) {
      sortToggleBtn.addEventListener('click', () => {
        sortOrder = sortOrder === 'desc' ? 'asc' : 'desc';
        if (sortLabel) {
          sortLabel.textContent = sortOrder === 'desc' ? 'Mới tạo nhất trước' : 'Cũ nhất trước';
        }
        if (sortArrow) {
          sortArrow.textContent = sortOrder === 'desc' ? '↓' : '↑';
        }
        renderBucketChecklist(activeFilter);
      });
    }

    // Listen for Realtime Cloud Updates from Firebase
    window.addEventListener('couple-cloud-updated', () => {
      renderCategoryFilters();
      renderBucketChecklist(activeFilter);
    });

    // Listen for Item Restored from Trash
    window.addEventListener('couple-item-restored', (e: any) => {
      if (e.detail?.type === 'bucket_list') {
        renderCategoryFilters();
        renderBucketChecklist(activeFilter);
      }
    });

    // Initial render
    renderCategoryFilters();
    renderBucketChecklist(activeFilter);
  }

  function openEditModal(item: any) {
    if ((window as any).openBucketEditModal) {
      (window as any).openBucketEditModal(item);
    }
  }

  initBucketSection();
  document.addEventListener('astro:after-swap', initBucketSection);
</script>
