</style>

<script>
  import {
    isFirebaseConfigured,
    getSavedFirebaseConfig,
    saveFirebaseConfig,
    subscribeToRealtimeSync,
    pushDataToFirebase,
    convertDriveLinkToDirectAudio,
    type SurpriseLetterPayload
  } from '../lib/firebaseClient';

  function initSyncHub() {
    const modal = document.getElementById('sync-hub-modal');
    const openBtn = document.getElementById('open-sync-hub');
    const closeBtn = document.getElementById('close-sync-hub');

    if (!modal) return;

    const openModal = () => {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      updateStorageUsage();
      const isConfigured = isFirebaseConfigured();
      updateFirebaseStatusUI(isConfigured);
    };
    const closeModal = () => {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
    };

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    document.querySelectorAll('.btn-open-sync-trigger').forEach((btn: any) => {
      btn.addEventListener('click', openModal);
    });

    // Expose helpers globally
    (window as any).openSyncHub = openModal;
    (window as any).closeSyncHub = closeModal;

    // Open automatically if hash is #sync or #cloud
    const handleSyncHash = () => {
      const h = window.location.hash.toLowerCase();
      if (h === '#sync' || h === '#sync-hub' || h === '#cloud' || h === '#firebase') {
        openModal();
      }
    };
    handleSyncHash();
    window.addEventListener('hashchange', handleSyncHash);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Tab switching
    const tabBtns = modal.querySelectorAll('.tab-btn');
    const tabContents = modal.querySelectorAll('.tab-content');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => b.classList.remove('is-active'));
        tabContents.forEach((c) => c.classList.remove('is-active'));

        btn.classList.add('is-active');
        const targetTab = btn.getAttribute('data-tab');
        if (targetTab) {
          const content = modal.querySelector(`#${targetTab}`);
          if (content) content.classList.add('is-active');
        }
      });
    });

    // Update Status Banner
    const globalDot = document.getElementById('global-sync-dot');
    const headerDot = document.getElementById('header-sync-dot');
    const statusDot = document.getElementById('status-indicator-dot');
    const statusText = document.getElementById('status-banner-text');

    function updateFirebaseStatusUI(connected: boolean) {
      if (connected) {
        if (globalDot) globalDot.classList.add('is-live');
        if (headerDot) headerDot.classList.add('is-live');
        if (statusDot) {
          statusDot.className = 'status-indicator-dot dot-connected';
        }
        if (statusText) {
          statusText.innerHTML = '🟢 <strong>Firebase Realtime Đang Hoạt Động!</strong> Mọi thay đổi của Maze & AI đang được đồng bộ trực tiếp.';
        }
      } else {
        if (globalDot) globalDot.classList.remove('is-live');
        if (headerDot) headerDot.classList.remove('is-live');
        if (statusDot) {
          statusDot.className = 'status-indicator-dot dot-offline';
        }
        if (statusText) {
          statusText.textContent = '⚪ Đang lưu trên bộ nhớ máy (Chưa kích hoạt Firebase).';
        }
      }
    }

    const isConfigured = isFirebaseConfigured();
    updateFirebaseStatusUI(isConfigured);

    // Pre-fill Firebase config textarea
    const fbTextarea = document.getElementById('firebase-config-json') as HTMLTextAreaElement | null;
    const currentCfg = getSavedFirebaseConfig();
    if (fbTextarea && currentCfg) {
      fbTextarea.value = JSON.stringify(currentCfg, null, 2);
    }

    // Save Firebase Config Button
    const saveFbBtn = document.getElementById('btn-save-firebase');
    if (saveFbBtn && fbTextarea) {
      saveFbBtn.addEventListener('click', async () => {
        const raw = fbTextarea.value.trim();
        if (!raw) {
          alert('Vui lòng dán đoạn mã cấu hình Firebase vào ô!');
          return;
        }

        try {
          // Parse loose JSON or JS object
          let configObj: any;
          try {
            configObj = JSON.parse(raw);
          } catch {
            // Attempt to clean JS object syntax (e.g. apiKey: "...")
            const cleaned = raw
              .replace(/(['"])?([a-zA-Z0-9_]+)(['"])?:/g, '"$2":')
              .replace(/'/g, '"');
            configObj = JSON.parse(cleaned);
          }

          saveFirebaseConfig(configObj);
          alert('✅ Đã lưu cấu hình Firebase! Đang kích hoạt kết nối Realtime...');
          window.location.reload();
        } catch (err: any) {
          alert('❌ Định dạng cấu hình chưa chính xác. Vui lòng kiểm tra lại dấu ngoặc nhọn {} và dấu phẩy!');
        }
      });
    }

    // Force Push current data to Firebase
    const forcePushBtn = document.getElementById('btn-force-push-firebase');
    if (forcePushBtn) {
      forcePushBtn.addEventListener('click', async () => {
        if (!isFirebaseConfigured()) {
          alert('⚠️ Vui lòng kết nối Firebase trước!');
          return;
        }

        const bucketList = JSON.parse(localStorage.getItem('couple_bucket_list') || '[]');
        const bucketCategories = JSON.parse(localStorage.getItem('couple_bucket_categories') || '[]');
        const habit21 = JSON.parse(localStorage.getItem('couple_habit_21') || '[]');
        const habitStartDate = localStorage.getItem('couple_habit_start_date') || undefined;
        const habitStartDateLocked = localStorage.getItem('couple_habit_start_date_locked') === 'true';
        const habitShields = JSON.parse(localStorage.getItem('couple_habit_shields') || '{"ai":2,"maze":2}');
        const habitTargetDays = Number(localStorage.getItem('couple_habit_target_days') || '21');
        const memories = JSON.parse(localStorage.getItem('couple_memories') || '[]');
        const trashBin = JSON.parse(localStorage.getItem('couple_trash_bin') || '[]');
        const avatars = JSON.parse(localStorage.getItem('couple_avatars') || '{}');

        forcePushBtn.textContent = '⏳ Đang đẩy...';
        const ok = await pushDataToFirebase({
          bucketList,
          bucketCategories,
          habit21,
          habitStartDate,
          habitStartDateLocked,
          habitShields,
          habitTargetDays,
          memories,
          trashBin,
          avatars,
          lastUpdatedBy: 'Manual Sync'
        });

        if (ok) {
          alert('✅ Đã đẩy toàn bộ dữ liệu hiện tại lên Firebase thành công!');
        } else {
          alert('❌ Có lỗi khi đẩy dữ liệu. Hãy kiểm tra quy tắc Realtime Database (Rules) đã cho phép read/write chưa.');
        }
        forcePushBtn.innerHTML = '<span>⬆️ Đẩy Dữ Liệu Hiện Tại Lên Firebase</span>';
      });
    }

    // Start Realtime Subscription
    if (isConfigured) {
      subscribeToRealtimeSync((cloudData) => {
        if (!cloudData) return;

        let shouldNotify = false;

        if (cloudData.bucketList && Array.isArray(cloudData.bucketList)) {
          const currentLocal = localStorage.getItem('couple_bucket_list');
          const newCloud = JSON.stringify(cloudData.bucketList);
          if (currentLocal !== newCloud) {
            localStorage.setItem('couple_bucket_list', newCloud);
            shouldNotify = true;
          }
        }

        if (cloudData.bucketCategories && Array.isArray(cloudData.bucketCategories)) {
          const currentCats = localStorage.getItem('couple_bucket_categories');
          const newCats = JSON.stringify(cloudData.bucketCategories);
          if (currentCats !== newCats) {
            localStorage.setItem('couple_bucket_categories', newCats);
            shouldNotify = true;
          }
        }

        if (cloudData.habit21 && Array.isArray(cloudData.habit21)) {
          const currentHabit = localStorage.getItem('couple_habit_21');
          const newHabit = JSON.stringify(cloudData.habit21);
          if (currentHabit !== newHabit) {
            localStorage.setItem('couple_habit_21', newHabit);
            shouldNotify = true;
          }
        }

        if (cloudData.habitStartDate && typeof cloudData.habitStartDate === 'string') {
          const currentStartDate = localStorage.getItem('couple_habit_start_date');
          if (currentStartDate !== cloudData.habitStartDate) {
            localStorage.setItem('couple_habit_start_date', cloudData.habitStartDate);
            shouldNotify = true;
          }
        }

        if (cloudData.habitStartDateLocked !== undefined && typeof cloudData.habitStartDateLocked === 'boolean') {
          const currentLocked = localStorage.getItem('couple_habit_start_date_locked');
          const nextLocked = cloudData.habitStartDateLocked ? 'true' : 'false';
          if (currentLocked !== nextLocked) {
            localStorage.setItem('couple_habit_start_date_locked', nextLocked);
            shouldNotify = true;
          }
        }

        if (cloudData.habitShields && typeof cloudData.habitShields === 'object') {
          const currentShields = localStorage.getItem('couple_habit_shields');
          const newShields = JSON.stringify(cloudData.habitShields);
          if (currentShields !== newShields) {
            localStorage.setItem('couple_habit_shields', newShields);
            shouldNotify = true;
          }
        }

        if (cloudData.habitTargetDays !== undefined && typeof cloudData.habitTargetDays === 'number') {
          const currentTarget = localStorage.getItem('couple_habit_target_days');
          const newTarget = String(cloudData.habitTargetDays);
          if (currentTarget !== newTarget) {
            localStorage.setItem('couple_habit_target_days', newTarget);
            shouldNotify = true;
          }
        }

        if (cloudData.memories && Array.isArray(cloudData.memories)) {
          const currentMems = localStorage.getItem('couple_memories');
          const newMems = JSON.stringify(cloudData.memories);
          if (currentMems !== newMems) {
            localStorage.setItem('couple_memories', newMems);
            shouldNotify = true;
          }
        }

        if (cloudData.trashBin && Array.isArray(cloudData.trashBin)) {
          const currentTrash = localStorage.getItem('couple_trash_bin');
          const newTrash = JSON.stringify(cloudData.trashBin);
          if (currentTrash !== newTrash) {
            localStorage.setItem('couple_trash_bin', newTrash);
            shouldNotify = true;
          }
        }

        if (cloudData.avatars) {
          const currentAvs = localStorage.getItem('couple_avatars');
          const newAvs = JSON.stringify(cloudData.avatars);
          if (currentAvs !== newAvs) {
            localStorage.setItem('couple_avatars', newAvs);
            shouldNotify = true;
          }
        }

        if (shouldNotify) {
          // Notify components to re-render without full reload
          window.dispatchEvent(new CustomEvent('couple-cloud-updated', { detail: cloudData }));
        }
      });
    }

    // Export Backup JSON
    const exportBtn = document.getElementById('btn-export-json');
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const data = {
          couple: 'AI & Maze',
          exportDate: new Date().toISOString(),
          habit21: JSON.parse(localStorage.getItem('couple_habit_21') || '[]'),
          habitStartDate: localStorage.getItem('couple_habit_start_date') || null,
          habitStartDateLocked: localStorage.getItem('couple_habit_start_date_locked') === 'true',
          habitShields: JSON.parse(localStorage.getItem('couple_habit_shields') || '{"ai":2,"maze":2}'),
          habitTargetDays: Number(localStorage.getItem('couple_habit_target_days') || '21'),
          bucketList: JSON.parse(localStorage.getItem('couple_bucket_list') || '[]'),
          memories: JSON.parse(localStorage.getItem('couple_memories') || '[]'),
          trashBin: JSON.parse(localStorage.getItem('couple_trash_bin') || '[]'),
          avatars: JSON.parse(localStorage.getItem('couple_avatars') || '{}')
        };
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `ai-maze-backup-${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
      });
    }

    // Import Backup JSON
    const importInput = document.getElementById('file-import-json') as HTMLInputElement | null;
    if (importInput) {
      importInput.addEventListener('change', (e: any) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (event) => {
          try {
            const data = JSON.parse(event.target?.result as string);
            if (data.bucketList) localStorage.setItem('couple_bucket_list', JSON.stringify(data.bucketList));
            if (data.habit21) localStorage.setItem('couple_habit_21', JSON.stringify(data.habit21));
            if (data.habitStartDate) localStorage.setItem('couple_habit_start_date', data.habitStartDate);
            if (data.habitStartDateLocked !== undefined) localStorage.setItem('couple_habit_start_date_locked', data.habitStartDateLocked ? 'true' : 'false');
            if (data.habitShields) localStorage.setItem('couple_habit_shields', JSON.stringify(data.habitShields));
            if (data.habitTargetDays) localStorage.setItem('couple_habit_target_days', String(data.habitTargetDays));
            if (data.memories) localStorage.setItem('couple_memories', JSON.stringify(data.memories));
            if (data.trashBin) localStorage.setItem('couple_trash_bin', JSON.stringify(data.trashBin));
            if (data.avatars) localStorage.setItem('couple_avatars', JSON.stringify(data.avatars));
            alert('✅ Đã nhập dữ liệu thành công! Đang làm mới...');
            window.location.reload();
          } catch {
            alert('❌ Tệp JSON không đúng định dạng!');
          }
        };
        reader.readAsText(file);
      });
    }

    // Reset Defaults
    const resetBtn = document.getElementById('btn-reset-defaults');
    if (resetBtn) {
      resetBtn.addEventListener('click', async () => {
        const confirmed = (window as any).romanticConfirm
          ? await (window as any).romanticConfirm({
              heading: 'Khôi Phục Dữ Liệu Ban Đầu?',
              subject: 'Thiết lập lại toàn bộ dữ liệu mẫu',
              subjectIcon: '🔄',
              quote: 'Tất cả các thay đổi tùy chỉnh trên máy của bạn sẽ được đặt lại về phiên bản gốc mặc định của hai đứa.',
              typeBadge: '⚙️ Trung Tâm Dữ Liệu',
              sealEmoji: '💌',
              confirmText: 'Khôi Phục Gốc 🔄',
              cancelText: 'Giữ Lại 🌸',
              isDanger: true,
              notice: '⚠️ Dữ liệu bộ nhớ tạm sẽ được làm mới về mặc định và tải lại trang.'
            })
          : confirm('Bạn có chắc muốn khôi phục về dữ liệu gốc không?');

        if (confirmed) {
          localStorage.removeItem('couple_bucket_list');
          localStorage.removeItem('couple_habit_21');
          localStorage.removeItem('couple_habit_start_date');
          localStorage.removeItem('couple_habit_shields');
          localStorage.removeItem('couple_habit_target_days');
          window.location.reload();
        }
      });
    }

    // Copy Code
    const copyBucketBtn = document.getElementById('btn-copy-bucket-code');
    const copyHabitBtn = document.getElementById('btn-copy-habit-code');
    const codePreview = document.getElementById('code-export-preview') as HTMLTextAreaElement | null;

    if (copyBucketBtn && codePreview) {
      copyBucketBtn.addEventListener('click', () => {
        const list = localStorage.getItem('couple_bucket_list') || '[]';
        const formatted = 'export const BUCKET_LIST: BucketItem[] = ' + JSON.stringify(JSON.parse(list), null, 2) + ';';
        codePreview.value = formatted;
        navigator.clipboard.writeText(formatted);
        alert('📋 Đã sao chép mã BUCKET_LIST vào clipboard!');
      });
    }

    if (copyHabitBtn && codePreview) {
      copyHabitBtn.addEventListener('click', () => {
        const list = localStorage.getItem('couple_habit_21') || '[]';
        const formatted = 'export const HABIT_21_DAYS: DayHabit[] = ' + JSON.stringify(JSON.parse(list), null, 2) + ';';
        codePreview.value = formatted;
        navigator.clipboard.writeText(formatted);
        alert('📋 Đã sao chép mã HABIT_21_DAYS vào clipboard!');
      });
    }

    // Music Settings Handler (Google Drive & MP3)
    const musicUrlInput = document.getElementById('music-input-url') as HTMLInputElement | null;
    const musicTitleInput = document.getElementById('music-input-title') as HTMLInputElement | null;
    const saveMusicBtn = document.getElementById('btn-save-custom-music');
    const resetMusicBtn = document.getElementById('btn-reset-default-music');

    if (musicUrlInput) {
      musicUrlInput.value = localStorage.getItem('couple_custom_music_url') || '';
    }
    if (musicTitleInput) {
      musicTitleInput.value = localStorage.getItem('couple_custom_music_title') || '';
    }

    if (saveMusicBtn && musicUrlInput) {
      saveMusicBtn.addEventListener('click', async () => {
        const rawUrl = musicUrlInput.value.trim();
        if (!rawUrl) {
          alert('⚠️ Vui lòng nhập link bài hát Google Drive hoặc link MP3!');
          return;
        }

        const directUrl = convertDriveLinkToDirectAudio(rawUrl);
        const title = musicTitleInput?.value.trim() || 'Giai Điệu Tình Yêu Của Hai Đứa 🎶';

        localStorage.setItem('couple_custom_music_url', directUrl);
        localStorage.setItem('couple_custom_music_title', title);

        await pushDataToFirebase({ musicUrl: directUrl, musicTitle: title, lastUpdatedBy: 'MusicSettings' });

        window.dispatchEvent(new CustomEvent('couple-music-updated', {
          detail: { url: directUrl, title }
        }));

        alert('✅ Đã cập nhật và đồng bộ bài hát thành công! Nhạc đang phát...');
      });
    }

    if (resetMusicBtn) {
      resetMusicBtn.addEventListener('click', async () => {
        localStorage.removeItem('couple_custom_music_url');
        localStorage.removeItem('couple_custom_music_title');
        const defaultUrl = 'https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3';
        const defaultTitle = 'Giai Điệu Tình Yêu Của Hai Đứa 🎶';
        await pushDataToFirebase({ musicUrl: defaultUrl, musicTitle: defaultTitle, lastUpdatedBy: 'MusicSettings' });
        window.dispatchEvent(new CustomEvent('couple-music-updated', {
          detail: { url: defaultUrl, title: defaultTitle }
        }));
        if (musicUrlInput) musicUrlInput.value = '';
        if (musicTitleInput) musicTitleInput.value = '';
        alert('🔄 Đã khôi phục bài hát mặc định!');
      });
    }

    // Storage Health Monitor
    function updateStorageHealthUI() {
      let totalChars = 0;
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k) {
          const val = localStorage.getItem(k) || '';
          totalChars += (k.length + val.length);
        }
      }
      // Browser LocalStorage quota is standard 5,000,000 to 10,000,000 characters (5MB to 10MB text)
      const usedMB = (totalChars / (1024 * 1024)).toFixed(2);
      const maxMB = 5.0; // standard 5MB text limit
      const percent = Math.min(100, Math.round((Number(usedMB) / maxMB) * 100));

      const textEl = document.getElementById('storage-usage-text');
      const barEl = document.getElementById('storage-usage-bar');
      const hintEl = document.getElementById('storage-usage-hint');

      if (textEl) textEl.textContent = `${usedMB} MB / 5.0 MB (${percent}%)`;
      if (barEl) {
        barEl.style.width = `${percent}%`;
        barEl.classList.toggle('is-warning', percent >= 75);
      }
      if (hintEl) {
        if (percent >= 90) {
          hintEl.innerHTML = '⚠️ <strong>Lưu ý:</strong> Dung lượng bộ nhớ LocalStorage sắp đầy (~5MB). Hãy tải file JSON sao lưu ở Tab "Sao Lưu" hoặc kết nối Cloudinary/Firebase để lưu không giới hạn!';
          hintEl.style.color = '#fda4af';
        } else if (percent >= 75) {
          hintEl.innerHTML = '⚡ Bộ nhớ LocalStorage đã dùng hơn 75%. Bạn có thể xuất file JSON sao lưu để bảo vệ kỷ niệm an toàn.';
          hintEl.style.color = '#fef08a';
        } else {
          hintEl.innerHTML = '💡 Bộ nhớ an toàn. Ảnh và bài viết kỷ niệm đang được lưu trữ mượt mà!';
          hintEl.style.color = '#94a3b8';
        }
      }
    }

    updateStorageHealthUI();

    // Cloudinary / Cloud CDN config
    const cloudNameInput = document.getElementById('cloudinary-cloud-name') as HTMLInputElement | null;
    const uploadPresetInput = document.getElementById('cloudinary-upload-preset') as HTMLInputElement | null;
    const saveCloudStorageBtn = document.getElementById('btn-save-cloud-storage');

    if (cloudNameInput) {
      cloudNameInput.value = localStorage.getItem('couple_cloudinary_name') || '';
    }
    if (uploadPresetInput) {
      uploadPresetInput.value = localStorage.getItem('couple_cloudinary_preset') || '';
    }

    if (saveCloudStorageBtn && cloudNameInput && uploadPresetInput) {
      saveCloudStorageBtn.addEventListener('click', () => {
        const name = cloudNameInput.value.trim();
        const preset = uploadPresetInput.value.trim();
        if (name && preset) {
          localStorage.setItem('couple_cloudinary_name', name);
          localStorage.setItem('couple_cloudinary_preset', preset);
          alert('✅ Đã lưu cấu hình Cloudinary! Ảnh mới tải lên sẽ tự động lưu trữ trên Cloud CDN.');
        } else {
          localStorage.removeItem('couple_cloudinary_name');
          localStorage.removeItem('couple_cloudinary_preset');
          alert('ℹ️ Đã xóa cấu hình Cloudinary. Hệ thống sẽ sử dụng bộ nén ảnh Retina mặc định.');
        }
      });
    }

    // ==========================================
    // Tab: Surprise Love Letter (Thư Tay Hoàng Gia)
    // ==========================================
    const btnToggleMaster = document.getElementById('btn-toggle-letter-master') as HTMLButtonElement | null;
    const switchDesc = document.getElementById('letter-switch-desc');
    const toggleLabel = document.getElementById('toggle-letter-label');
    const readReceiptBox = document.getElementById('letter-read-receipt-box');
    const receiptText = document.getElementById('letter-receipt-text');
    const inputLetterTitle = document.getElementById('letter-edit-title') as HTMLInputElement | null;
    const selectRecipient = document.getElementById('letter-edit-recipient') as HTMLSelectElement | null;
    const selectWax = document.getElementById('letter-edit-wax') as HTMLSelectElement | null;
    const checkShowOnce = document.getElementById('letter-edit-show-once') as HTMLInputElement | null;
    const textareaLetterContent = document.getElementById('letter-edit-content') as HTMLTextAreaElement | null;
    const wordCountEl = document.getElementById('letter-word-count');
    const btnSaveLetter = document.getElementById('btn-save-surprise-letter');
    const btnPreviewLetter = document.getElementById('btn-preview-surprise-letter');

    let currentLetterState: SurpriseLetterPayload = {
      enabled: false,
      title: 'Gửi Bé Yêu Của Anh 💌',
      content: 'Chào em, hôm nay anh có một bức thư nhỏ gửi tặng em. Chúc em một ngày thật an yên và nhiều niềm vui nhé! Anh yêu em rất nhiều 💖',
      sender: 'ai',
      recipient: 'maze',
      waxColor: 'ruby',
      showOnce: false,
      updatedAt: new Date().toISOString()
    };

    function loadSurpriseLetterUI() {
      try {
        const raw = localStorage.getItem('couple_surprise_letter');
        if (raw) {
          const parsed = JSON.parse(raw);
          currentLetterState = { ...currentLetterState, ...parsed };
        }
      } catch (err) {
        console.warn('Failed to parse couple_surprise_letter from storage:', err);
      }

      if (inputLetterTitle) inputLetterTitle.value = currentLetterState.title || '';
      if (selectRecipient) selectRecipient.value = currentLetterState.recipient || 'maze';
      if (selectWax) selectWax.value = currentLetterState.waxColor || 'ruby';
      if (checkShowOnce) checkShowOnce.checked = !!currentLetterState.showOnce;
      if (textareaLetterContent) {
        textareaLetterContent.value = currentLetterState.content || '';
        updateLetterWordCount();
      }

      renderToggleUI(currentLetterState.enabled);
      renderReceiptUI();
    }

    function renderToggleUI(enabled: boolean) {
      if (!btnToggleMaster) return;
      btnToggleMaster.setAttribute('data-enabled', enabled ? 'true' : 'false');
      btnToggleMaster.classList.toggle('is-active', enabled);
      if (toggleLabel) {
        toggleLabel.textContent = enabled ? 'BẬT' : 'TẮT';
      }
      if (switchDesc) {
        if (enabled) {
          switchDesc.innerHTML = '✨ <strong style="color: #fda4af;">Thư đang BẬT.</strong> Nàng mở bất kỳ trang nào của website sẽ thấy phong thư con dấu sáp hiện ra ngay lập tức!';
        } else {
          switchDesc.textContent = 'Thư đang TẮT. Bấm công tắc để kích hoạt hiển thị cho nàng khi mở web.';
        }
      }
      if (btnSaveLetter) {
        const span = btnSaveLetter.querySelector('span');
        if (span) {
          span.textContent = enabled ? '💾 Lưu & Bật Gửi Cho Nàng Ngay 💖' : '💾 Lưu Nội Dung (Đang Tắt) 📁';
        }
      }
    }

    function renderReceiptUI() {
      if (!readReceiptBox || !receiptText) return;
      if (currentLetterState.readAt) {
        try {
          const date = new Date(currentLetterState.readAt);
          const timeStr = date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
          const dateStr = date.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
          readReceiptBox.classList.add('is-read');
          receiptText.innerHTML = `✨ <strong>Bé đã mở đọc thư</strong> lúc <strong>${timeStr} - ${dateStr}</strong> 💕`;
        } catch {
          readReceiptBox.classList.add('is-read');
          receiptText.textContent = `✨ Nàng đã mở đọc bức thư này 💕`;
        }
      } else {
        readReceiptBox.classList.remove('is-read');
        receiptText.textContent = `Trạng thái: Nàng chưa mở đọc bức thư này.`;
      }
    }

    function updateLetterWordCount() {
      if (!textareaLetterContent || !wordCountEl) return;
      wordCountEl.textContent = `${textareaLetterContent.value.length} ký tự`;
    }

    if (btnToggleMaster) {
      btnToggleMaster.addEventListener('click', () => {
        const isCurrentlyEnabled = btnToggleMaster.getAttribute('data-enabled') === 'true';
        const nextState = !isCurrentlyEnabled;
        currentLetterState.enabled = nextState;
        renderToggleUI(nextState);
      });
    }

    if (textareaLetterContent) {
      textareaLetterContent.addEventListener('input', updateLetterWordCount);
    }

    // Quick prompt pills
    modal.querySelectorAll('.btn-prompt-pill').forEach((pill: any) => {
      pill.addEventListener('click', () => {
        const prompt = pill.getAttribute('data-prompt');
        if (prompt && textareaLetterContent) {
          if (textareaLetterContent.value.trim().length > 0) {
            textareaLetterContent.value += '\n\n' + prompt;
          } else {
            textareaLetterContent.value = prompt;
          }
          updateLetterWordCount();
          textareaLetterContent.focus();
        }
      });
    });

    // Save & push letter to Firebase
    if (btnSaveLetter) {
      btnSaveLetter.addEventListener('click', async () => {
        const isEnabled = btnToggleMaster ? btnToggleMaster.getAttribute('data-enabled') === 'true' : false;
        const newTitle = inputLetterTitle ? inputLetterTitle.value.trim() : currentLetterState.title;
        const newContent = textareaLetterContent ? textareaLetterContent.value.trim() : currentLetterState.content;
        const newRecipient = selectRecipient ? (selectRecipient.value as any) : currentLetterState.recipient;
        const newWax = selectWax ? (selectWax.value as any) : currentLetterState.waxColor;
        const newShowOnce = checkShowOnce ? checkShowOnce.checked : false;

        // If content was modified and user re-enables, reset read receipt so partner can read the new version
        const hasContentChanged = newContent !== currentLetterState.content || newTitle !== currentLetterState.title;

        currentLetterState = {
          ...currentLetterState,
          enabled: isEnabled,
          title: newTitle || 'Thư Tình Gửi Em 💌',
          content: newContent || 'Anh yêu em nhiều lắm!',
          recipient: newRecipient,
          waxColor: newWax,
          showOnce: newShowOnce,
          updatedAt: new Date().toISOString(),
          readAt: hasContentChanged ? undefined : currentLetterState.readAt,
          readBy: hasContentChanged ? undefined : currentLetterState.readBy
        };

        // Save locally
        localStorage.setItem('couple_surprise_letter', JSON.stringify(currentLetterState));

        // Push to Firebase RTDB
        const prevBtnHtml = btnSaveLetter.innerHTML;
        btnSaveLetter.innerHTML = '<span>⏳ Đang gửi lên Cloud...</span>';
        btnSaveLetter.style.pointerEvents = 'none';

        try {
          const pushRes = await pushDataToFirebase({ surpriseLetter: currentLetterState });
          if (pushRes) {
            window.dispatchEvent(new CustomEvent('couple-letter-updated', { detail: currentLetterState }));
            alert(isEnabled
              ? '💌 Tuyệt vời! Bức thư tay đã được BẬT và đồng bộ lên Cloud. Nàng vào web sẽ thấy ngay!'
              : '📁 Bức thư đã được lưu lại (ở chế độ TẮT). Khi nào muốn nàng thấy, bạn chỉ cần bấm BẬT nhé!');
          } else {
            window.dispatchEvent(new CustomEvent('couple-letter-updated', { detail: currentLetterState }));
            alert('⚠️ Đã lưu bức thư trên máy này, nhưng Cloud Firebase chưa kết nối hoặc cấu hình sai. Vui lòng kiểm tra Tab Firebase!');
          }
        } catch (e: any) {
          alert('⚠️ Lỗi khi đồng bộ lên Cloud: ' + (e?.message || e));
        } finally {
          btnSaveLetter.innerHTML = prevBtnHtml;
          btnSaveLetter.style.pointerEvents = 'auto';
          renderReceiptUI();
        }
      });
    }

    // Preview button
    if (btnPreviewLetter) {
      btnPreviewLetter.addEventListener('click', () => {
        const previewLetter: SurpriseLetterPayload = {
          ...currentLetterState,
          enabled: true,
          title: inputLetterTitle ? inputLetterTitle.value.trim() || 'Thư Tình Gửi Em 💌' : 'Thư Tình Gửi Em 💌',
          content: textareaLetterContent ? textareaLetterContent.value.trim() || 'Đây là bản xem thử nội dung thư...' : 'Nội dung thư xem thử...',
          sender: 'ai',
          recipient: selectRecipient ? (selectRecipient.value as any) : 'maze',
          waxColor: selectWax ? (selectWax.value as any) : 'ruby',
          showOnce: false,
          updatedAt: new Date().toISOString()
        };

        // Close modal first
        closeModal();

        // Dispatch preview event for SurpriseLoveLetter component
        setTimeout(() => {
          window.dispatchEvent(new CustomEvent('open-surprise-letter-preview', { detail: previewLetter }));
        }, 150);
      });
    }

    // Listen for realtime updates to update the read receipt in real time
    window.addEventListener('couple-letter-updated', (e: any) => {
      if (e?.detail) {
        currentLetterState = { ...currentLetterState, ...e.detail };
        renderReceiptUI();
        if (e.detail.enabled !== undefined) {
          renderToggleUI(e.detail.enabled);
        }
      }
    });

    loadSurpriseLetterUI();
  }

  initSyncHub();
  document.addEventListener('astro:after-swap', initSyncHub);
</script>
