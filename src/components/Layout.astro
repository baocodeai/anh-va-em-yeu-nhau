---
import { ClientRouter } from 'astro:transitions';
import 'katex/dist/katex.min.css';
import CosmosBackground from './CosmosBackground.astro';
import LoveLockScreen from './LoveLockScreen.astro';
import { COUPLE_CONFIG } from '../couple.config';
import '../styles/couple-theme.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
}

const {
  title = `${COUPLE_CONFIG.title} — ${COUPLE_CONFIG.subtitle}`,
  description = COUPLE_CONFIG.description,
  canonicalPath = '/',
  ogType = 'website',
} = Astro.props;

const site = 'https://baocodeai.github.io';
const canonicalUrl = new URL(canonicalPath, site).toString();
// Replace public/assets/og.png with your own 1200x630 social preview image.
const ogImageUrl = new URL('/assets/og.png', site).toString();
---

<!doctype html>
<html lang="vi" data-palette="tokyo-night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <link rel="alternate" type="application/rss+xml" title="AI & Maze" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="AI & Maze" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..700&display=swap" rel="stylesheet" />

    <link rel="preload" href="/assets/jbm.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/lit-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/lit-vietnamese.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
    <script is:inline>
      (() => {
        const apply = () => {
          document.documentElement.setAttribute('data-palette', 'tokyo-night');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <link rel="stylesheet" href="/css/style.css" />
    <ClientRouter />
  </head>
  <body>
    <CosmosBackground />
    <header class="site-header couple-site-header">
      <nav class="nav" aria-label="Couple navigation">
        <a class="brand couple-header-brand" href="/#overview" data-target="tab-pane-overview" aria-label="AI & Maze">
          <span class="brand-heart-icon">💖</span>
          <span class="brand-name gradient-love-text" style="font-weight: 800; font-size: 1.15rem; letter-spacing: 0.05em;">AI &amp; MAZE</span>
        </a>

        <!-- Unified Romantic Header Tab Navigation -->
        <div class="header-tabs-nav" id="header-tabs-container">
          <button type="button" class="header-tab-btn is-active" data-target="tab-pane-overview">
            <span class="tab-icon">💖</span>
            <span class="tab-label">Tinh Cầu Tình Yêu</span>
          </button>
          <button type="button" class="header-tab-btn" data-target="tab-pane-habits">
            <span class="tab-icon">✨</span>
            <span class="tab-label">Tinh Cầu Số 21</span>
          </button>
          <button type="button" class="header-tab-btn" data-target="tab-pane-bucket">
            <span class="tab-icon">💫</span>
            <span class="tab-label">Nguyện Ước</span>
          </button>
          <button type="button" class="header-tab-btn" data-target="tab-pane-memories">
            <span class="tab-icon">📸</span>
            <span class="tab-label">Kỷ Niệm Của Hai Đứa</span>
          </button>
        </div>

        <!-- Right Tools: Lock & Trash -->
        <div class="header-couple-tools">
          <button type="button" class="header-lock-btn" id="header-btn-lock" title="Khóa Màn Hình Tình Yêu">
            <span>🔒 Khóa</span>
          </button>
          <button type="button" class="header-trash-btn" id="header-btn-open-trash" title="Khôi Phục Ký Ức">
            <span>🗑️ Thùng rác</span>
            <span class="trash-badge-count" id="header-trash-count">0</span>
          </button>
        </div>

        <!-- Mobile Drawer Navigation -->
        <details class="nav-menu" id="header-mobile-menu">
          <summary class="nav-menu-button" aria-label="Mở menu">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <div class="nav-menu-panel">
            <button type="button" class="mobile-tab-btn is-active" data-target="tab-pane-overview">
              <span>💖 Tinh Cầu Tình Yêu</span>
            </button>
            <button type="button" class="mobile-tab-btn" data-target="tab-pane-habits">
              <span>✨ Tinh Cầu Số 21</span>
            </button>
            <button type="button" class="mobile-tab-btn" data-target="tab-pane-bucket">
              <span>💫 Nguyện Ước</span>
            </button>
            <button type="button" class="mobile-tab-btn" data-target="tab-pane-memories">
              <span>📸 Kỷ Niệm Của Hai Đứa</span>
            </button>
            <button type="button" class="mobile-tab-btn btn-open-trash-trigger" style="color: #fca5a5;">
              <span>🗑️ Thùng Rác &amp; Khôi Phục</span>
            </button>
            <button type="button" class="mobile-tab-btn btn-lock-app-trigger" style="color: #fda4af;">
              <span>🔒 Khóa Tinh Cầu</span>
            </button>
            <div class="mobile-menu-footer">
              <span style="color: #fda4af; font-size: 0.8rem; font-weight: 600;">AI 🚀 &amp; Maze 🌸 · 15/08/2026</span>
            </div>
          </div>
        </details>
      </nav>
    </header>

    <slot />


    <div class="theme-overlay" id="search-overlay" hidden>
      <div class="theme-overlay-panel" role="dialog" aria-label="Search" aria-modal="true">
        <div class="search-input-row">
          <span class="search-prompt" aria-hidden="true">$</span>
          <input id="search-input" type="search" autocomplete="off" spellcheck="false" aria-label="Search query" />
          <span class="search-caret" aria-hidden="true"></span>
        </div>
        <div class="search-results" id="search-results" role="listbox" aria-label="Search results">
          <p class="search-empty">Type to search</p>
        </div>
        <div class="theme-overlay-footer">
          <span class="theme-overlay-actions">
            <button class="theme-close-btn" type="button" id="search-close-btn">esc</button>
          </span>
        </div>
      </div>
    </div>

    <script>
      let searchController: AbortController | undefined;
      let pagefind: { search: (q: string) => Promise<any>; init: () => void } | null = null;
      let pagefindFailed = false;

      async function loadPagefind() {
        if (pagefind || pagefindFailed) return pagefind;
        try {
          // The index only exists in the build output; new Function keeps the
          // bundler from rewriting this runtime-only import.
          pagefind = await new Function("return import('/pagefind/pagefind.js')")();
          pagefind?.init();
        } catch {
          pagefindFailed = true;
        }
        return pagefind;
      }

      function initSearch() {
        searchController?.abort();
        searchController = new AbortController();
        const { signal } = searchController;

        const overlay = document.getElementById('search-overlay');
        const input = document.getElementById('search-input') as HTMLInputElement | null;
        const results = document.getElementById('search-results');
        const openBtn = document.getElementById('search-open');
        const closeBtn = document.getElementById('search-close-btn');
        if (!overlay || !input || !results || !openBtn || !closeBtn) return;

        let items: HTMLAnchorElement[] = [];
        let activeIndex = -1;
        let debounceTimer: ReturnType<typeof setTimeout> | undefined;
        let queryId = 0;
        // Shell-style history: -1 = not browsing, 0 = most recent search.
        let historyIndex = -1;
        const HISTORY_KEY = 'site-search-history';

        function loadHistory(): string[] {
          try {
            const raw = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]');
            return Array.isArray(raw) ? raw.filter((q) => typeof q === 'string') : [];
          } catch {
            return [];
          }
        }

        function saveHistory(query: string) {
          const q = query.trim();
          if (!q) return;
          const history = [q, ...loadHistory().filter((h) => h !== q)].slice(0, 20);
          localStorage.setItem(HISTORY_KEY, JSON.stringify(history));
        }

        function recallHistory(index: number) {
          const history = loadHistory();
          if (index < 0) {
            historyIndex = -1;
            input!.value = '';
            setEmpty('Type to search');
            return;
          }
          if (index >= history.length) return;
          historyIndex = index;
          input!.value = history[index] ?? '';
          void runSearch(input!.value);
        }

        function setEmpty(message: string) {
          if (!results) return;
          results.innerHTML = '';
          const p = document.createElement('p');
          p.className = 'search-empty';
          p.textContent = message;
          results.append(p);
          items = [];
          activeIndex = -1;
        }

        function setActive(index: number) {
          activeIndex = index;
          items.forEach((item, i) => {
            item.setAttribute('aria-selected', String(i === index));
          });
          items[index]?.scrollIntoView({ block: 'nearest' });
        }

        async function runSearch(query: string) {
          const id = ++queryId;
          if (!query.trim()) {
            setEmpty('Type to search');
            return;
          }
          const pf = await loadPagefind();
          if (!pf) {
            setEmpty('Search index not found: run npm run build to generate it.');
            return;
          }
          const res = await pf.search(query);
          if (id !== queryId || !results) return;
          const top = await Promise.all(res.results.slice(0, 8).map((r: any) => r.data()));
          if (id !== queryId) return;
          if (top.length === 0) {
            setEmpty(`No matches for "${query}"`);
            return;
          }
          results.innerHTML = '';
          items = top.map((data: any) => {
            const link = document.createElement('a');
            link.className = 'search-result';
            link.href = data.url;
            link.setAttribute('role', 'option');
            const title = document.createElement('span');
            title.className = 'search-result-title';
            title.textContent = data.meta?.title ?? data.url;
            const excerpt = document.createElement('span');
            excerpt.className = 'search-result-excerpt';
            excerpt.innerHTML = data.excerpt ?? '';
            link.append(title, excerpt);
            link.addEventListener('click', () => saveHistory(input!.value), { signal });
            results.append(link);
            return link;
          });
          setActive(0);
        }

        function openOverlay() {
          overlay!.hidden = false;
          document.body.style.overflow = 'hidden';
          input!.value = '';
          historyIndex = -1;
          setEmpty('Type to search');
          input!.focus();
          void loadPagefind();
        }

        function closeOverlay() {
          overlay!.hidden = true;
          document.body.style.overflow = '';
        }

        input.addEventListener('input', () => {
          historyIndex = -1;
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => runSearch(input.value), 150);
        }, { signal });

        openBtn.addEventListener('click', openOverlay, { signal });
        closeBtn.addEventListener('click', closeOverlay, { signal });
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) closeOverlay();
        }, { signal });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'k' && (e.ctrlKey || e.metaKey)) {
            e.preventDefault();
            if (overlay.hidden) openOverlay();
            else closeOverlay();
            return;
          }
          if (overlay.hidden) return;
          if (e.key === 'Escape') {
            e.preventDefault();
            closeOverlay();
          } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (historyIndex >= 0) {
              // Symmetric with ArrowUp: down walks toward newer history
              // entries and finally back to the empty prompt.
              recallHistory(historyIndex - 1);
            } else if (items.length > 0) {
              setActive(Math.min(items.length - 1, activeIndex + 1));
            }
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (historyIndex >= 0 || input.value.trim() === '') {
              recallHistory(historyIndex + 1);
            } else if (items.length > 0) {
              setActive(Math.max(0, activeIndex - 1));
            }
          } else if (e.key === 'Enter') {
            const active = items[activeIndex];
            if (active) {
              e.preventDefault();
              active.click();
            }
          } else if (e.key === 'Tab') {
            // Trap focus inside the dialog while it is open.
            const focusables = [input, ...items, closeBtn].filter(Boolean) as HTMLElement[];
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (!first || !last) return;
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }, { signal });
      }

      document.addEventListener('astro:page-load', initSearch);
    </script>

    <LoveLockScreen />

    <!-- Secret Creator PIN Unlock Modal -->
    <div class="creator-secret-modal-overlay" id="creator-secret-modal" style="display: none;">
      <div class="creator-secret-modal-card romantic-card">
        <div class="creator-secret-header">
          <span class="creator-modal-crown">👑</span>
          <h3 class="creator-modal-title gradient-love-text">Xác Thực Quyền Creator</h3>
          <p class="creator-modal-desc">Nhập mã PIN bí mật của Anh để mở toàn quyền chỉnh sửa và xem trước các trang đang khóa.</p>
        </div>

        <form id="form-creator-secret-auth" class="creator-modal-form">
          <input
            type="password"
            id="input-creator-secret-pin"
            class="form-input creator-pin-input"
            maxlength="6"
            placeholder="••••"
            autocomplete="off"
            required
          />
          <p class="creator-auth-error" id="creator-auth-error" style="display: none;">Mã PIN chưa đúng rồi!</p>
          <div class="creator-modal-btns">
            <button type="button" class="btn-outline-love" id="btn-close-creator-modal">Hủy</button>
            <button type="submit" class="btn-love">🚀 Kích Hoạt</button>
          </div>
        </form>
      </div>
    </div>

    <style>
      .creator-secret-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 100000;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.2rem;
      }
      .creator-secret-modal-card {
        background: #0f172a;
        border: 1px solid rgba(244, 63, 94, 0.4);
        border-radius: 20px;
        padding: 1.8rem;
        max-width: 360px;
        width: 100%;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9), 0 0 30px rgba(244, 63, 94, 0.25);
        animation: fadeInModal 0.2s ease-out;
      }
      .creator-modal-crown {
        font-size: 2rem;
        display: block;
        margin-bottom: 6px;
        filter: drop-shadow(0 0 8px rgba(244, 63, 94, 0.5));
      }
      .creator-modal-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0 0 6px;
      }
      .creator-modal-desc {
        font-size: 0.82rem;
        color: #94a3b8;
        margin: 0 0 1.2rem;
        line-height: 1.5;
      }
      .creator-pin-input {
        text-align: center;
        font-size: 1.15rem !important;
        letter-spacing: 0.2em;
        margin-bottom: 0.8rem;
      }
      .creator-auth-error {
        color: #f87171;
        font-size: 0.78rem;
        margin: -4px 0 8px;
      }
      .creator-modal-btns {
        display: flex;
        gap: 8px;
        justify-content: center;
      }
    </style>

    <script>
      import { initGlobalSyncEngine } from '../lib/globalSyncEngine';
      initGlobalSyncEngine();
      document.addEventListener('astro:page-load', initGlobalSyncEngine);
      document.addEventListener('astro:after-swap', initGlobalSyncEngine);

      function initHeaderLockAction() {
        const lockBtn = document.getElementById('header-btn-lock');
        const mobileLockBtns = document.querySelectorAll('.btn-lock-app-trigger');
        const triggerLock = () => {
          if (typeof (window as any).lockCoupleApp === 'function') {
            (window as any).lockCoupleApp();
          }
        };

        if (lockBtn) lockBtn.addEventListener('click', triggerLock);
        mobileLockBtns.forEach((btn) => btn.addEventListener('click', triggerLock));

        // Secret Creator Mode Trigger (Triple tap on Logo or Ctrl+Shift+A)
        const brandLogo = document.querySelector('.couple-header-brand');
        const creatorModal = document.getElementById('creator-secret-modal');
        const btnCloseModal = document.getElementById('btn-close-creator-modal');
        const formAuth = document.getElementById('form-creator-secret-auth');
        const pinInput = document.getElementById('input-creator-secret-pin') as HTMLInputElement | null;
        const errorMsg = document.getElementById('creator-auth-error');

        let tapCount = 0;
        let tapTimer: any = null;

        function openCreatorModal() {
          if (creatorModal) {
            creatorModal.style.display = 'flex';
            if (pinInput) {
              pinInput.value = '';
              setTimeout(() => pinInput.focus(), 150);
            }
            if (errorMsg) errorMsg.style.display = 'none';
          }
        }

        function closeCreatorModal() {
          if (creatorModal) creatorModal.style.display = 'none';
        }

        if (brandLogo) {
          brandLogo.addEventListener('click', (e) => {
            tapCount++;
            clearTimeout(tapTimer);
            if (tapCount >= 3) {
              e.preventDefault();
              tapCount = 0;
              openCreatorModal();
            } else {
              tapTimer = setTimeout(() => { tapCount = 0; }, 1200);
            }
          });
        }

        // Shortcut: Ctrl + Shift + A
        document.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'A' || e.key === 'a')) {
            e.preventDefault();
            openCreatorModal();
          }
        });

        if (btnCloseModal) {
          btnCloseModal.addEventListener('click', closeCreatorModal);
        }

        if (creatorModal) {
          creatorModal.addEventListener('click', (e) => {
            if (e.target === creatorModal) closeCreatorModal();
          });
        }

        if (formAuth) {
          formAuth.addEventListener('submit', (e) => {
            e.preventDefault();
            const entered = pinInput?.value.trim() || '';
            const customPin = localStorage.getItem('couple_custom_passcode');

            if (entered === '2908' || (customPin && entered === customPin.trim())) {
              localStorage.setItem('couple_creator_access', 'true');
              closeCreatorModal();
              window.dispatchEvent(new CustomEvent('couple-creator-access-granted'));
            } else {
              if (errorMsg) errorMsg.style.display = 'block';
              if (pinInput) {
                pinInput.focus();
                pinInput.select();
              }
            }
          });
        }
      }

      initHeaderLockAction();
      document.addEventListener('astro:page-load', initHeaderLockAction);
      document.addEventListener('astro:after-swap', initHeaderLockAction);
    </script>
    <!-- Native-like Mobile Bottom Navigation Bar -->
    <nav class="mobile-bottom-app-bar" id="mobile-bottom-bar" aria-label="Mobile bottom navigation">
      <button type="button" class="bottom-tab-btn is-active" data-target="tab-pane-overview">
        <span class="bottom-tab-icon">💖</span>
        <span class="bottom-tab-label">Tinh Cầu</span>
      </button>
      <button type="button" class="bottom-tab-btn" data-target="tab-pane-habits">
        <span class="bottom-tab-icon">✨</span>
        <span class="bottom-tab-label">21 Ngày</span>
      </button>
      <button type="button" class="bottom-tab-btn" data-target="tab-pane-bucket">
        <span class="bottom-tab-icon">💫</span>
        <span class="bottom-tab-label">Bucket</span>
      </button>
      <button type="button" class="bottom-tab-btn" data-target="tab-pane-memories">
        <span class="bottom-tab-icon">📸</span>
        <span class="bottom-tab-label">Kỷ Niệm</span>
      </button>
    </nav>
  </body>
</html>
