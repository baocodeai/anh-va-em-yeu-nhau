---
import { ClientRouter } from 'astro:transitions';
import 'katex/dist/katex.min.css';
import CosmosBackground from './CosmosBackground.astro';
import LoveLockScreen from './LoveLockScreen.astro';
import SyncHubModal from './SyncHubModal.astro';
import RomanticMusicPlayer from './RomanticMusicPlayer.astro';
import SurpriseLoveLetter from './SurpriseLoveLetter.astro';
import { COUPLE_CONFIG } from '../couple.config';
import '../styles/couple-theme.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
}

const {
  title = `${COUPLE_CONFIG.title} — ${COUPLE_CONFIG.subtitle}`,
  description = COUPLE_CONFIG.description,
  canonicalPath = '/',
  ogType = 'website',
} = Astro.props;

const site = 'https://baocodeai.github.io';
const canonicalUrl = new URL(canonicalPath, site).toString();
// Replace public/assets/og.png with your own 1200x630 social preview image.
const ogImageUrl = new URL('/assets/og.png', site).toString();
---

<!doctype html>
<html lang="vi" data-palette="tokyo-night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <link rel="alternate" type="application/rss+xml" title="AI & Maze" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="AI & Maze" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..700&display=swap" rel="stylesheet" />

    <link rel="preload" href="/assets/jbm.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/lit-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/lit-vietnamese.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
    <script is:inline>
      (() => {
        const apply = () => {
          document.documentElement.setAttribute('data-palette', 'tokyo-night');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <link rel="stylesheet" href="/css/style.css" />
    <ClientRouter />
  </head>
  <body>
    <CosmosBackground />
    <header class="site-header couple-site-header">
      <nav class="nav" aria-label="Couple navigation">
        <a class="brand couple-header-brand" href="/#overview" data-target="tab-pane-overview" aria-label="AI & Maze">
          <span class="brand-heart-icon">💖</span>
          <span class="brand-name gradient-love-text" style="font-weight: 800; font-size: 1.15rem; letter-spacing: 0.05em;">AI &amp; MAZE</span>
        </a>

        <!-- Unified Romantic Header Tab Navigation -->
        <div class="header-tabs-nav" id="header-tabs-container">
          <button type="button" class="header-tab-btn is-active" data-target="tab-pane-overview">
            <span class="tab-icon">💖</span>
            <span class="tab-label">Tinh Cầu Tình Yêu</span>
          </button>
          <button type="button" class="header-tab-btn" data-target="tab-pane-habits">
            <span class="tab-icon">✨</span>
            <span class="tab-label">Tinh Cầu Số 21</span>
          </button>
          <button type="button" class="header-tab-btn" data-target="tab-pane-bucket">
            <span class="tab-icon">💫</span>
            <span class="tab-label">Nguyện Ước</span>
          </button>
          <button type="button" class="header-tab-btn" data-target="tab-pane-memories">
            <span class="tab-icon">📸</span>
            <span class="tab-label">Kỷ Niệm Của Hai Đứa</span>
          </button>
        </div>

        <!-- Right Tools: Lock & Trash -->
        <div class="header-couple-tools">
          <button type="button" class="header-lock-btn" id="header-btn-lock" title="Khóa Màn Hình Tình Yêu">
            <span>🔒 Khóa</span>
          </button>
          <button type="button" class="header-trash-btn" id="header-btn-open-trash" title="Khôi Phục Ký Ức">
            <span>🗑️ Thùng rác</span>
            <span class="trash-badge-count" id="header-trash-count">0</span>
          </button>
        </div>

        <!-- Mobile Drawer Navigation -->
        <details class="nav-menu" id="header-mobile-menu">
          <summary class="nav-menu-button" aria-label="Mở menu">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <div class="nav-menu-panel">
            <button type="button" class="mobile-tab-btn is-active" data-target="tab-pane-overview">
              <span>💖 Tinh Cầu Tình Yêu</span>
            </button>
            <button type="button" class="mobile-tab-btn" data-target="tab-pane-habits">
              <span>✨ Tinh Cầu Số 21</span>
            </button>
            <button type="button" class="mobile-tab-btn" data-target="tab-pane-bucket">
              <span>💫 Nguyện Ước</span>
            </button>
            <button type="button" class="mobile-tab-btn" data-target="tab-pane-memories">
              <span>📸 Kỷ Niệm Của Hai Đứa</span>
            </button>
            <button type="button" class="mobile-tab-btn btn-open-trash-trigger" style="color: #fca5a5;">
              <span>🗑️ Thùng Rác &amp; Khôi Phục</span>
            </button>
            <button type="button" class="mobile-tab-btn btn-lock-app-trigger" style="color: #fda4af;">
              <span>🔒 Khóa Tinh Cầu</span>
            </button>
            <div class="mobile-menu-footer">
              <span style="color: #fda4af; font-size: 0.8rem; font-weight: 600;">AI 🚀 &amp; Maze 🌸 · 15/08/2026</span>
            </div>
          </div>
        </details>
      </nav>
    </header>

    <slot />

    <LoveLockScreen />
    <SyncHubModal />
    <RomanticMusicPlayer />
    <SurpriseLoveLetter />

    <script>
      import { initGlobalSyncEngine } from '../lib/globalSyncEngine';
      initGlobalSyncEngine();
      document.addEventListener('astro:page-load', initGlobalSyncEngine);
      document.addEventListener('astro:after-swap', initGlobalSyncEngine);

      function initHeaderActions() {
        const lockBtn = document.getElementById('header-btn-lock');
        const mobileLockBtns = document.querySelectorAll('.btn-lock-app-trigger');
        const triggerLock = () => {
          if (typeof (window as any).lockCoupleApp === 'function') {
            (window as any).lockCoupleApp();
          }
        };

        if (lockBtn) lockBtn.addEventListener('click', triggerLock);
        mobileLockBtns.forEach((btn) => btn.addEventListener('click', triggerLock));

        // Auto close mobile drawer menu when any item is clicked
        const mobileDrawer = document.getElementById('header-mobile-menu') as HTMLDetailsElement | null;
        if (mobileDrawer) {
          const drawerLinks = mobileDrawer.querySelectorAll('.mobile-tab-btn');
          drawerLinks.forEach((item) => {
            item.addEventListener('click', () => {
              mobileDrawer.removeAttribute('open');
            });
          });
        }

        // Secret Boyfriend Access: Click 3 times on brand logo within 1.5s to open Sync Hub
        let brandClickCount = 0;
        let brandClickTimer: any = null;
        const brandLinks = document.querySelectorAll('.couple-header-brand');
        brandLinks.forEach((brand) => {
          brand.addEventListener('click', (e) => {
            brandClickCount++;
            if (brandClickCount === 1) {
              brandClickTimer = setTimeout(() => {
                brandClickCount = 0;
              }, 1500);
            } else if (brandClickCount >= 3) {
              e.preventDefault();
              clearTimeout(brandClickTimer);
              brandClickCount = 0;
              if (typeof (window as any).openSyncHub === 'function') {
                (window as any).openSyncHub();
              }
            }
          });
        });

        // Secret Boyfriend Hotkey: Ctrl + Shift + S to open Sync Hub
        if (!(window as any).__sync_hotkey_registered) {
          (window as any).__sync_hotkey_registered = true;
          window.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'S' || e.key === 's')) {
              e.preventDefault();
              if (typeof (window as any).openSyncHub === 'function') {
                (window as any).openSyncHub();
              }
            }
          });
        }
      }

      initHeaderActions();
      document.addEventListener('astro:page-load', initHeaderActions);
      document.addEventListener('astro:after-swap', initHeaderActions);
    </script>
    <!-- Native-like Mobile Bottom Navigation Bar -->
    <nav class="mobile-bottom-app-bar" id="mobile-bottom-bar" aria-label="Mobile bottom navigation">
      <button type="button" class="bottom-tab-btn is-active" data-target="tab-pane-overview">
        <span class="bottom-tab-icon">💖</span>
        <span class="bottom-tab-label">Tinh Cầu</span>
      </button>
      <button type="button" class="bottom-tab-btn" data-target="tab-pane-habits">
        <span class="bottom-tab-icon">✨</span>
        <span class="bottom-tab-label">21 Ngày</span>
      </button>
      <button type="button" class="bottom-tab-btn" data-target="tab-pane-bucket">
        <span class="bottom-tab-icon">💫</span>
        <span class="bottom-tab-label">Bucket</span>
      </button>
      <button type="button" class="bottom-tab-btn" data-target="tab-pane-memories">
        <span class="bottom-tab-icon">📸</span>
        <span class="bottom-tab-label">Kỷ Niệm</span>
      </button>
    </nav>
  </body>
</html>
